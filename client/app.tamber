tamber vela

axes
  pack = house | installed

theme
  AccentColor = #a65b38  scheme=fixed
  surface.page = #090b0e  scheme=fixed
    when pack=installed: #090b0efe
  surface.raised = #15191e  scheme=fixed
    when pack=installed: #15191efe
  surface.glass = #1b2028dd  scheme=fixed
    when pack=installed: #1b2028dc
  surface.line = #ffffff24  scheme=fixed
    when pack=installed: #ffffff23
  ink.primary = #f5f1e9  scheme=fixed
    when pack=installed: #f5f1e9fe
  ink.secondary = #b6b8bb  scheme=fixed
    when pack=installed: #b6b8bbfe
  ink.quiet = #858d98  scheme=fixed
    when pack=installed: #858d98fe
  ink.inverse = #111419  scheme=fixed
    when pack=installed: #111419fe
  brand.warm = #dcb998  scheme=fixed
  // The Vela mark: its light and shadow beams on dark grounds and on paper, and the splash's lift.
  brand.light = #f5f1e9  scheme=fixed
  brand.shadow = #dcb998  scheme=fixed
  brand.paper-light = #111419  scheme=fixed
  brand.paper-shadow = #a65b38  scheme=fixed
  brand.lift = #131820  scheme=fixed
    when pack=installed: #dcb998fe

  // Cinematic type and geometry a runtime skin pack may replace (docs/skin-distribution.md).
  cinematic.display = "Instrument Serif", "Iowan Old Style", Georgia, serif
    when pack=installed: "Instrument Serif", "Iowan Old Style", Georgia, ui-serif, serif
  cinematic.radius-card = 14px
    when pack=installed: 14.01px
  cinematic.radius-panel = 28px
    when pack=installed: 28.01px
  cinematic.radius-pill = 999px
    when pack=installed: 999.01px

  index.page = #f3f0e8  scheme=fixed
  index.ink = #22221e  scheme=fixed

  // Cinematic dark media palette; fixed colors preserve its authored appearance.
  cinematic.control = #ffffff16  scheme=fixed
    when pack=installed: #ffffff15
  cinematic.scrim-strong = #090b0ed9  scheme=fixed
    when pack=installed: #090b0ed8
