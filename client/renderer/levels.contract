// The renderer's element: every node draws through it (docs/skin-schema.md).
component BoxEl
  props
    s: Style
    pos: string
    anim: string
    fade: bool
    dw: string
    dbg: string
    dbi: string
    dc: string
    dop: string
    dtr: string
    test: string
    domId: string
    role: string
    label: string
    lt: string
    se: string
    exitAnim: string
    hovering: action
    pointing: action
    keying: action
  slot
  view
    box id=domId hover=hovering pointerdown=pointing key=keying tabindex=-1 testId=test role=role aria-label=label -exact-layout-transition=lt sharedElement=se -exact-exit-animation=exitAnim display=s.display position=pos top=s.top right=s.right bottom=s.bottom left=s.left z-index=s.zIndex width=(dw != "" ? dw : s.width) height=s.height min-width=s.minWidth min-height=s.minHeight max-width=s.maxWidth max-height=s.maxHeight aspect-ratio=s.aspectRatio box-sizing=s.boxSizing flex-grow=s.flexGrow flex-basis=s.flexBasis flex-direction=s.flexDirection flex-wrap=s.flexWrap flex-shrink=s.flexShrink align-items=s.alignItems align-self=s.alignSelf justify-content=s.justifyContent gap=s.gap column-gap=s.columnGap row-gap=s.rowGap order=s.order grid-template-columns=s.gridTemplateColumns grid-template-rows=s.gridTemplateRows grid-column=s.gridColumn grid-row=s.gridRow padding-top=s.paddingTop padding-right=s.paddingRight padding-bottom=s.paddingBottom padding-left=s.paddingLeft margin-top=s.marginTop margin-right=s.marginRight margin-bottom=s.marginBottom margin-left=s.marginLeft overflow-x=s.overflowX overflow-y=s.overflowY scroll-snap-type=s.scrollSnapType scroll-snap-align=s.scrollSnapAlign scrollbar-width=s.scrollbarWidth scroll-behavior=s.scrollBehavior scroll-padding-left=s.scrollPaddingLeft color-scheme=s.colorScheme color=(dc != "" ? dc : s.color) background-color=(dbg != "" ? dbg : s.backgroundColor) background-image=(dbi != "" ? dbi : s.backgroundImage) opacity=(fade ? 0 : dop != "" ? num(dop) : s.opacity) border-width=s.borderWidth border-style=s.borderStyle border-color=s.borderColor border-radius=s.borderRadius border-top-width=s.borderTopWidth border-top-color=s.borderTopColor border-bottom-width=s.borderBottomWidth border-bottom-color=s.borderBottomColor border-left-width=s.borderLeftWidth border-left-color=s.borderLeftColor box-shadow=s.boxShadow filter=s.filter backdrop-filter=s.backdropFilter mask-image=s.maskImage font-family=s.fontFamily font-size=s.fontSize font-weight=s.fontWeight font-style=s.fontStyle line-height=s.lineHeight letter-spacing=s.letterSpacing text-transform=s.textTransform text-align=s.textAlign text-shadow=s.textShadow -webkit-text-stroke=s.textStroke text-overflow=s.textOverflow white-space=s.whiteSpace font-variant-numeric=s.fontVariantNumeric transform-origin=s.transformOrigin translate=(dtr != "" ? dtr : s.translate) scale=s.scale rotate=s.rotate perspective=s.perspective transition=s.transition animation=(anim != "" ? anim : s.animation) pointer-events=s.pointerEvents cursor=s.cursor
      children

component V1
  props
    n: N1
    c: Ctx
    e: Env
    act: action
    obs: action
  inject
    tileMessage: action
    mediaAuthJson: string
    tileNativeMedia: string
  state over = false
  state focused = false
  state ready = false
  action hovering(v: bool)
    over = v
  state pointed = false
  // Keyboard focus only (focus-visible): a focus that follows a pointer press draws no focus overlay.
  action pointing
    pointed = true
  action focusing
    focused = not pointed
  action blurring
    focused = false
    pointed = false
  action pressing(arg: string, to: string)
    act(n.act, arg)
    if to != ""
      focus(to)
  action escaping(to: string, k: string)
    if k == "Escape" and n.esc != ""
      preventDefault()
      act("close", n.esc)
      if to != ""
        focus(to)
  action loaded
    ready = true
  view
    for cx in [c] key="c"
      for vals in [binds(cx, e)] key="v"
        if shows(n.cond, vals, e)
          for sr in [stateOf(n.sts, n.base, vals, e)] key="r"
            for dis in [n.dis.length > 0 and shows(n.dis, vals, e)] key="d"
              for st in [styleAt(e, dis ? sr.ds : over and n.hh ? (e.still ? sr.hs2 : sr.hs) : focused and n.hf ? (e.still ? sr.fs2 : sr.fs) : cx.fhot and n.gf ? (e.still ? sr.gfs2 : sr.gfs) : cx.hot and n.hg ? (e.still ? sr.gs2 : sr.gs) : sr.s)] key="s"
                if n.t == "install"
                  vela-install pwaAction=n.sym buttonLabel=fill(n.label, vals, e)
                else if n.t == "liveTile"
                  for t in e.tile key=t.channelId
                    if t.planJson != "" and (t.state == "connecting" or t.state == "playing")
                      vela-player plan=t.planJson mediaAuth=mediaAuthJson nativeMedia=tileNativeMedia playerCommand=t.commandJson message=tileMessage ambient="true" position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
                else
                  if n.t == "observe"
                    column width=1 height=1 position="absolute" top=0 left=0 pointer-events="none" aria-hidden=true intersect=obs(fill(n.arg, vals, e))
                  else
                    BoxEl(s=st, pos=(sr.pos == 1 ? "absolute" : sr.pos == 2 ? "sticky" : "relative"), anim=(n.mk == "" ? "" : motion(n.mk, n.md, n.mdl, n.me, n.mf, n.mit, n.mdir, n.msk, n.msd, n.step, n.cap, cx.index, e)), fade=false, dw=fill(n.dw, vals, e), dbg=fill(n.dbg, vals, e), dbi=fill(n.dbi, vals, e), dc=fill(n.dc, vals, e), dop=fill(n.dop, vals, e), dtr=fill(n.dtr, vals, e), test=(n.t == "box" ? fill(n.test, vals, e) : ""), domId=fill(n.dom, vals, e), role=(n.t == "box" ? n.role : ""), label=(n.t == "box" and n.act == "" ? fill(n.label, vals, e) : ""), lt=(e.still ? "none" : n.lt), se=n.se, exitAnim=(e.still ? n.exs : n.ex), hovering=hovering, pointing=pointing, keying=escaping(fill(n.escTo, vals, e)))
                      if n.t == "text"
                        text fill(n.parts, vals, e) role=n.role aria-level=n.level testId=fill(n.test, vals, e) line-clamp=st.lineClamp overflow-x=st.overflowX text-overflow=st.textOverflow
                      else
                        if n.t == "image"
                          image fill(n.src, vals, e) alt=fill(n.label, vals, e) testId=fill(n.test, vals, e) load=loaded width="100%" height="100%" object-fit=st.objectFit opacity=(n.fade and not ready ? 0 : 1) transition=(n.fade ? "opacity 420ms cubic-bezier(0.16, 1, 0.3, 1)" : "none")
                        else
                          if n.t == "icon"
                            if n.sym != ""
                              image `symbol:${n.sym}` aria-hidden=true width="100%" height="100%"
                            else
                              svg viewBox=n.ivb width="100%" height="100%" aria-hidden=true
                                for p, pi in n.ipaths key=`${pi}`
                                  path d=p fill="currentColor" fill-rule=(n.fr == "evenodd" ? "evenodd" : "nonzero")
                          else
                            for k, ki in n.kids key=`${ki}`
                              for cc, j in ctxs2(k, cx, e) key=ctxKey(cc, j)
                                V2(n=k, c=Ctx(cc, index=(k.rep == "" ? cc.index : j), hot=(n.grp ? over or focused : cc.hot), fhot=(n.grp ? focused : cc.fhot)), e=e, act=act, obs=obs)
                            if n.act != ""
                              if n.aexp.length > 0 or n.asel.length > 0
                                button press=pressing(fill(n.arg, vals, e), fill(n.pfocus, vals, e)) disabled=dis aria-label=fill(n.label, vals, e) role=n.brole title=fill(n.atitle, vals, e) aria-expanded=(n.aexp.length > 0 and shows(n.aexp, vals, e)) aria-selected=(n.asel.length > 0 and shows(n.asel, vals, e)) aria-current=aria(n.acur, vals, e) aria-pressed=aria(n.aprs, vals, e) aria-haspopup=n.ahp focus=focusing blur=blurring outline=(n.hf or n.hg or n.gf ? "none" : "") position="absolute" inset=0 z-index=1 margin=0 padding=0 border="none" background-color="transparent" background-image="none" color="inherit" cursor="pointer"
                              else
                                button press=pressing(fill(n.arg, vals, e), fill(n.pfocus, vals, e)) disabled=dis aria-label=fill(n.label, vals, e) role=n.brole title=fill(n.atitle, vals, e) aria-current=aria(n.acur, vals, e) aria-pressed=aria(n.aprs, vals, e) aria-haspopup=n.ahp focus=focusing blur=blurring outline=(n.hf or n.hg or n.gf ? "none" : "") position="absolute" inset=0 z-index=1 margin=0 padding=0 border="none" background-color="transparent" background-image="none" color="inherit" cursor="pointer"

