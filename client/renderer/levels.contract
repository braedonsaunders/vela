// One slot's tree: its root container's style, its top-level nodes, and the flex
// order of the foundation's content among them (the route a shell wraps, the
// search field a home holds), so the renderer is inlined at one call site per slot.
shape DocSlot
  present: bool
  root: number
  slotStyle: number
  slotInner: number
  slotOrder: string
  nodes: N1[]

// A skin document as the renderer takes it (src/skin resolves it for one viewport class).
shape SkinDoc
  id: string
  styles: Style[]
  shell: DocSlot
  home: DocSlot
  detailWide: string
  detailSmall: string

keyframes vr-rise
  from opacity=0 translate="0px 22px"

keyframes vr-dissolve
  from opacity=0

keyframes vr-vanish
  to opacity=0

keyframes vr-pop
  from opacity=0 scale=0.94 translate="0px -6px"

keyframes vr-open
  from opacity=0 scale=0.94 translate="0px 28px"

keyframes vr-expose
  from opacity=0 scale=1.08

keyframes vr-drift
  from scale=1.04 translate="0px 0px"
  to scale=1.14 translate="-2.4% -1.6%"

keyframes vr-fill
  from translate="-100% 0px"
  to translate="0px 0px"

keyframes vr-shimmer
  from translate="-100% 0px"
  to translate="100% 0px"

keyframes vr-spin
  from rotate=0
  to rotate=360

keyframes vr-breathe
  50% opacity=0.45

keyframes vr-glow
  50% opacity=0.75 scale=1.06

keyframes vr-float
  50% translate="0px -8px"

keyframes vr-bounce
  30% translate="0px -14px" scale=1.04
  60% translate="0px 0px" scale=0.98

keyframes vr-twinkle
  50% opacity=0.2 scale=0.7

keyframes vr-slideUp
  from translate="0px 100%"

keyframes vr-slideIn
  from opacity=0 translate="-24px 0px"

keyframes vr-zoom
  from opacity=0 scale=0.8

keyframes vr-wiggle
  25% rotate=-4
  75% rotate=4

keyframes vr-auroraA
  from translate="-8% -6%" scale=1
  to translate="10% 8%" scale=1.25

keyframes vr-auroraB
  from translate="12% 6%" scale=1.2
  to translate="-10% -8%" scale=0.95

keyframes vr-auroraC
  from translate="0% 10%" scale=0.9
  to translate="-6% -12%" scale=1.2

keyframes vr-scan
  from translate="0px -100%"
  to translate="0px 100%"

fn noStyle(): Style = Style(display="", position="", inset="", top="", right="", bottom="", left="", zIndex="", width="", height="", minWidth="", minHeight="", maxWidth="", maxHeight="", aspectRatio="", boxSizing="", flexGrow=0, flexBasis="", flexDirection="", flexWrap="", flexShrink=1, alignItems="", alignSelf="", justifyContent="", gap="", order=0, gridTemplateColumns="", gridTemplateRows="", gridColumn="", gridRow="", margin="", padding="", paddingTop="", paddingRight="", paddingBottom="", paddingLeft="", marginTop="", marginRight="", marginBottom="", marginLeft="", overflowX="", overflowY="", scrollSnapType="", scrollSnapAlign="", scrollbarWidth="", color="", backgroundColor="", backgroundImage="", opacity=1, borderWidth="", borderStyle="", borderColor="", borderRadius="", boxShadow="", filter="", backdropFilter="", maskImage="", fontFamily="", fontSize="", fontWeight=400, fontStyle="", lineHeight="", letterSpacing="", textTransform="", textAlign="", textShadow="", lineClamp=0, whiteSpace="", fontVariantNumeric="", objectFit="", transformOrigin="", translate="", scale=1, transition="", animation="", pointerEvents="", cursor="")
// The document's distinct styles, shared by index (nodes name theirs by position).
fn styleAt(styles: Style[], i: number): Style = match styles.at(i) { case some(s) => s, case none => noStyle() }
fn pct(at: number, of: number): string = (of > 0 ? min(100, at / of * 100).toString() : "0")
fn val0(k: string, c: Ctx, e: Env): string = (k == "card.id" ? c.card.map(x => x.id).join("") : k == "hero.id" ? c.hero.map(x => x.id).join("") : k == "card.kind" ? c.card.map(x => x.kind).join("") : k == "hero.kind" ? c.hero.map(x => x.kind).join("") : k == "card.name" ? c.card.map(x => x.name).join("") : k == "hero.name" ? c.hero.map(x => x.name).join("") : k == "card.summary" ? c.card.map(x => x.summary).join("") : k == "hero.summary" ? c.hero.map(x => x.summary).join("") : k == "card.facts" ? c.card.map(x => x.facts).join("") : k == "hero.facts" ? c.hero.map(x => x.facts).join("") : k == "card.yearLabel" ? c.card.map(x => x.yearLabel).join("") : k == "hero.yearLabel" ? c.hero.map(x => x.yearLabel).join("") : k == "card.rating" ? c.card.map(x => x.rating).join("") : k == "hero.rating" ? c.hero.map(x => x.rating).join("") : k == "card.progressLabel" ? c.card.map(x => x.progressLabel).join("") : k == "hero.progressLabel" ? c.hero.map(x => x.progressLabel).join("") : k == "card.poster" ? c.card.map(x => x.poster).join("") : k == "hero.poster" ? c.hero.map(x => x.poster).join("") : k == "card.backdrop" ? c.card.map(x => x.backdrop).join("") : k == "hero.backdrop" ? c.hero.map(x => x.backdrop).join("") : k == "card.logo" ? c.card.map(x => x.logo).join("") : k == "hero.logo" ? c.hero.map(x => x.logo).join("") : k == "card.accent" ? c.card.map(x => x.accent).join("") : k == "hero.accent" ? c.hero.map(x => x.accent).join("") : val1(k, c, e))
fn val1(k: string, c: Ctx, e: Env): string = (k == "card.receipt" ? c.card.map(x => x.receipt).join("") : k == "hero.receipt" ? c.hero.map(x => x.receipt).join("") : k == "card.played" ? c.card.map(x => (x.played ? "true" : "false")).join("") : k == "card.progressPct" ? c.card.map(x => pct(x.progressSeconds, x.durationSeconds)).join("") : k == "card.hasProgress" ? c.card.map(x => (x.progressSeconds > 0 and x.durationSeconds > 0 and not x.played ? "true" : "false")).join("") : k == "card.label" ? c.card.map(x => cardName(x)).join("") : k == "card.kindId" ? c.card.map(x => `${x.id}|${x.kind}|${x.receipt}`).join("") : k == "hero.kindId" ? c.hero.map(x => `${x.id}|${x.kind}|${x.receipt}`).join("") : k == "card.factsLine" ? c.card.map(x => [x.facts].concat(x.genres.slice(0, 3)).filter(f => f != "").join(" · ")).join("") : k == "hero.factsLine" ? c.hero.map(x => [x.facts].concat(x.genres.slice(0, 3)).filter(f => f != "").join(" · ")).join("") : k == "row.id" ? c.row.map(x => x.id).join("") : k == "row.name" ? c.row.map(x => x.name).join("") : k == "row.presentation" ? c.row.map(x => x.presentation).join("") : k == "row.hasMore" ? c.row.map(x => (x.nextCursor != "" ? "true" : "false")).join("") : k == "heroAct.reasonLabel" ? c.heroAct.map(x => x.reasonLabel).join("") : k == "heroAct.actionLabel" ? c.heroAct.map(x => x.actionLabel).join("") : k == "heroAct.actionDetail" ? c.heroAct.map(x => x.actionDetail).join("") : k == "heroAct.action" ? c.heroAct.map(x => x.action).join("") : k == "heroAct.targetId" ? c.heroAct.map(x => x.targetId).join("") : k == "heroAct.progressPct" ? c.heroAct.map(x => (x.progress * 100).toString()).join("") : k == "heroAct.hasProgress" ? c.heroAct.map(x => (x.progress > 0 ? "true" : "false")).join("") : k == "heroAct.playable" ? c.heroAct.map(x => (x.action != "details" and x.targetId != "" ? "true" : "false")).join("") : k == "dest.id" ? c.dest.map(x => x.id).join("") : k == "dest.name" ? c.dest.map(x => x.name).join("") : val2(k, c, e))
fn val2(k: string, c: Ctx, e: Env): string = (k == "dest.kind" ? c.dest.map(x => x.kind).join("") : k == "dest.on" ? c.dest.map(x => (e.section == x.id ? "true" : "false")).join("") : k == "env.viewer" ? e.viewer : k == "env.viewerInitial" ? e.viewer.slice(0, 1).toUpperCase() : k == "env.section" ? e.section : k == "env.query" ? e.query : k == "env.small" ? (e.small ? "true" : "false") : k == "env.still" ? (e.still ? "true" : "false") : k == "env.searching" ? (e.query != "" ? "true" : "false") : k == "env.canLive" ? (e.canLive ? "true" : "false") : k == "env.heroCount" ? e.home.map(x => x.hero.length.toString()).join("") : k == "env.heroIndex" ? e.heroIndex.toString() : k == "env.rowCount" ? e.home.map(x => x.rows.length.toString()).join("") : k == "env.rotating" ? e.home.map(x => (x.hero.length > 1 and not e.still and e.query == "" ? "true" : "false")).join("") : k == "index" ? c.index.toString() : k == "index.label" ? (c.index + 1).toString() : k == "index.current" ? (c.index == e.heroIndex ? "true" : "false") : k.startsWith("flag:") ? (e.flags.includes(k.slice(5)) ? "true" : "false") : "")
fn val(k: string, c: Ctx, e: Env): string = val0(k, c, e)
fn fill(parts: Part[], c: Ctx, e: Env): string = parts.map(p => (p.k == "" ? p.l : val(p.k, c, e))).join("")
fn num(s: string): number = match parseNumber(s) { case some(x) => x, case none => 0 }
fn holds(k: Cond, c: Ctx, e: Env): bool = (k.is == "eq" ? val(k.k, c, e) == k.v : k.is == "ne" ? val(k.k, c, e) != k.v : k.is == "gt" ? num(val(k.k, c, e)) > num(k.v) : k.is == "lt" ? num(val(k.k, c, e)) < num(k.v) : val(k.k, c, e) != "" and val(k.k, c, e) != "false" and val(k.k, c, e) != "0")
fn shows(conds: Cond[], c: Ctx, e: Env): bool = not conds.map(k => holds(k, c, e) == k.not).includes(true)
fn motion(mk: string, md: number, mdl: number, me: string, mf: string, mit: string, mdir: string, msk: string, msd: number, step: number, cap: number, i: number, e: Env): string = (e.still ? (msk == "" ? "none" : `${msk} ${msd}ms linear both`) : `${mk} ${md}ms ${me} ${mdl + min(i, cap) * step}ms ${mit} ${mdir} ${mf}`)
fn heroActFor(home: HomeModel, id: string): HeroAction[] = home.heroActions.filter(a => a.heroId == id).slice(0, 1)
fn rootCtx(): Ctx = Ctx(hot=false, card=[], row=[], hero=[], heroAct=[], dest=[], index=0)
fn ctxKey(c: Ctx, j: number): string = `${j}:${c.card.map(x => x.id).join("")}:${c.row.map(x => x.id).join("")}:${c.hero.map(x => x.id).join("")}:${c.dest.map(x => x.id).join("")}`
fn ctxs1(n: N1, c: Ctx, e: Env): Ctx[] = (n.rep == "" ? [c] : n.rep == "home.rows" ? match first(e.home) { case some(h) => h.rows.slice(0, n.lim).map(r => Ctx(c, row=[r])), case none => [] } : n.rep == "row.items" ? match first(c.row) { case some(r) => r.items.slice(0, n.lim).map(x => Ctx(c, card=[x])), case none => [] } : n.rep == "home.heroes" ? match first(e.home) { case some(h) => h.hero.slice(0, n.lim).map(x => Ctx(c, hero=[x], heroAct=heroActFor(h, x.id))), case none => [] } : n.rep == "home.hero" ? match first(e.home) { case some(h) => h.hero.slice(e.heroIndex, e.heroIndex + 1).map(x => Ctx(c, hero=[x], heroAct=heroActFor(h, x.id))), case none => [] } : n.rep == "nav.destinations" ? e.libraries.slice(0, n.lim).map(l => Ctx(c, dest=[l])) : [])
