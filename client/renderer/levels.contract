keyframes vr-rise
  from opacity=0 translate="0px 22px"

keyframes vr-dissolve
  from opacity=0

keyframes vr-vanish
  to opacity=0

keyframes vr-pop
  from opacity=0 scale=0.94 translate="0px -6px"

keyframes vr-open
  from opacity=0 scale=0.94 translate="0px 28px"

keyframes vr-expose
  from opacity=0 scale=1.08

keyframes vr-drift
  from scale=1.04 translate="0px 0px"
  to scale=1.14 translate="-2.4% -1.6%"

keyframes vr-fill
  from translate="-100% 0px"
  to translate="0px 0px"

keyframes vr-shimmer
  from translate="-100% 0px"
  to translate="100% 0px"

keyframes vr-spin
  from rotate=0
  to rotate=360

keyframes vr-breathe
  50% opacity=0.45

keyframes vr-glow
  50% opacity=0.75 scale=1.06

keyframes vr-float
  50% translate="0px -8px"

keyframes vr-bounce
  30% translate="0px -14px" scale=1.04
  60% translate="0px 0px" scale=0.98

keyframes vr-twinkle
  50% opacity=0.2 scale=0.7

keyframes vr-slideUp
  from translate="0px 100%"

keyframes vr-slideIn
  from opacity=0 translate="-24px 0px"

keyframes vr-zoom
  from opacity=0 scale=0.8

keyframes vr-wiggle
  25% rotate=-4
  75% rotate=4

keyframes vr-auroraA
  from translate="-8% -6%" scale=1
  to translate="10% 8%" scale=1.25

keyframes vr-auroraB
  from translate="12% 6%" scale=1.2
  to translate="-10% -8%" scale=0.95

keyframes vr-auroraC
  from translate="0% 10%" scale=0.9
  to translate="-6% -12%" scale=1.2

keyframes vr-scan
  from translate="0px -100%"
  to translate="0px 100%"

