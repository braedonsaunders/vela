        else
          if n.t == "icon"
            image `symbol:${n.sym}` aria-hidden=true display=st.display position=(n.pos == 1 ? "absolute" : n.pos == 2 ? "sticky" : "relative") inset=st.inset top=st.top right=st.right bottom=st.bottom left=st.left z-index=st.zIndex width=(n.dw.length > 0 ? fill(n.dw, c, e) : st.width) height=st.height min-width=st.minWidth min-height=st.minHeight max-width=st.maxWidth max-height=st.maxHeight aspect-ratio=st.aspectRatio box-sizing=st.boxSizing flex-grow=st.flexGrow flex-basis=st.flexBasis flex-direction=st.flexDirection flex-wrap=st.flexWrap flex-shrink=st.flexShrink align-items=st.alignItems align-self=st.alignSelf justify-content=st.justifyContent gap=st.gap order=st.order grid-template-columns=st.gridTemplateColumns grid-template-rows=st.gridTemplateRows grid-column=st.gridColumn grid-row=st.gridRow margin=st.margin padding=st.padding padding-top=st.paddingTop padding-right=st.paddingRight padding-bottom=st.paddingBottom padding-left=st.paddingLeft margin-top=st.marginTop margin-right=st.marginRight margin-bottom=st.marginBottom margin-left=st.marginLeft overflow-x=st.overflowX overflow-y=st.overflowY scroll-snap-type=st.scrollSnapType scroll-snap-align=st.scrollSnapAlign scrollbar-width=st.scrollbarWidth color=(n.dc.length > 0 ? fill(n.dc, c, e) : st.color) background-color=(n.dbg.length > 0 ? fill(n.dbg, c, e) : st.backgroundColor) background-image=(n.dbi.length > 0 ? fill(n.dbi, c, e) : st.backgroundImage) opacity=(n.dop.length > 0 ? num(fill(n.dop, c, e)) : st.opacity) border-width=st.borderWidth border-style=st.borderStyle border-color=st.borderColor border-radius=st.borderRadius box-shadow=st.boxShadow filter=st.filter backdrop-filter=st.backdropFilter mask-image=st.maskImage font-family=st.fontFamily font-size=st.fontSize font-weight=st.fontWeight font-style=st.fontStyle line-height=st.lineHeight letter-spacing=st.letterSpacing text-transform=st.textTransform text-align=st.textAlign text-shadow=st.textShadow line-clamp=st.lineClamp white-space=st.whiteSpace font-variant-numeric=st.fontVariantNumeric object-fit=st.objectFit transform-origin=st.transformOrigin translate=(n.dtr.length > 0 ? fill(n.dtr, c, e) : st.translate) scale=st.scale transition=st.transition animation=(n.mk == "" ? st.animation : motion(n.mk, n.md, n.mdl, n.me, n.mf, n.mit, n.mdir, n.msk, n.msd, n.step, n.cap, c.index, e)) pointer-events=st.pointerEvents cursor=st.cursor
          else
            if n.t == "install"
              vela-install pwaAction=n.sym buttonLabel=fill(n.label, c, e)
            else
              if n.t == "observe"
                column width=1 height=1 position="absolute" top=0 left=0 pointer-events="none" aria-hidden=true intersect=obs(fill(n.arg, c, e))
              else
                column hover=hovering testId=fill(n.test, c, e) role=n.role aria-label=(n.act == "" ? fill(n.label, c, e) : "") display=st.display position=(n.pos == 1 ? "absolute" : n.pos == 2 ? "sticky" : "relative") inset=st.inset top=st.top right=st.right bottom=st.bottom left=st.left z-index=st.zIndex width=(n.dw.length > 0 ? fill(n.dw, c, e) : st.width) height=st.height min-width=st.minWidth min-height=st.minHeight max-width=st.maxWidth max-height=st.maxHeight aspect-ratio=st.aspectRatio box-sizing=st.boxSizing flex-grow=st.flexGrow flex-basis=st.flexBasis flex-direction=st.flexDirection flex-wrap=st.flexWrap flex-shrink=st.flexShrink align-items=st.alignItems align-self=st.alignSelf justify-content=st.justifyContent gap=st.gap order=st.order grid-template-columns=st.gridTemplateColumns grid-template-rows=st.gridTemplateRows grid-column=st.gridColumn grid-row=st.gridRow margin=st.margin padding=st.padding padding-top=st.paddingTop padding-right=st.paddingRight padding-bottom=st.paddingBottom padding-left=st.paddingLeft margin-top=st.marginTop margin-right=st.marginRight margin-bottom=st.marginBottom margin-left=st.marginLeft overflow-x=st.overflowX overflow-y=st.overflowY scroll-snap-type=st.scrollSnapType scroll-snap-align=st.scrollSnapAlign scrollbar-width=st.scrollbarWidth color=(n.dc.length > 0 ? fill(n.dc, c, e) : st.color) background-color=(n.dbg.length > 0 ? fill(n.dbg, c, e) : st.backgroundColor) background-image=(n.dbi.length > 0 ? fill(n.dbi, c, e) : st.backgroundImage) opacity=(n.dop.length > 0 ? num(fill(n.dop, c, e)) : st.opacity) border-width=st.borderWidth border-style=st.borderStyle border-color=st.borderColor border-radius=st.borderRadius box-shadow=st.boxShadow filter=st.filter backdrop-filter=st.backdropFilter mask-image=st.maskImage font-family=st.fontFamily font-size=st.fontSize font-weight=st.fontWeight font-style=st.fontStyle line-height=st.lineHeight letter-spacing=st.letterSpacing text-transform=st.textTransform text-align=st.textAlign text-shadow=st.textShadow line-clamp=st.lineClamp white-space=st.whiteSpace font-variant-numeric=st.fontVariantNumeric object-fit=st.objectFit transform-origin=st.transformOrigin translate=(n.dtr.length > 0 ? fill(n.dtr, c, e) : st.translate) scale=st.scale transition=st.transition animation=(n.mk == "" ? st.animation : motion(n.mk, n.md, n.mdl, n.me, n.mf, n.mit, n.mdir, n.msk, n.msd, n.step, n.cap, c.index, e)) pointer-events=st.pointerEvents cursor=st.cursor
                  for k, ki in n.kids key=`${ki}`
                    for cc, j in ctxs1(n, c, e) key=ctxKey(cc, j)
                      L2(n=k, c=Ctx(cc, index=(n.rep == "" ? cc.index : j), hot=(n.grp ? over or focused : cc.hot)), e=e, act=act, obs=obs)
                  if n.act != ""
                    button press=act(n.act, fill(n.arg, c, e)) aria-label=fill(n.label, c, e) focus=focusing blur=blurring position="absolute" inset=0 z-index=1 margin=0 padding=0 border="none" background-color="transparent" color="inherit" cursor="pointer"

