  l: string
  k: string

shape Cond
  k: string
  is: string
  v: string
  not: bool

// Where a node is drawn: the records repeat nodes stepped into, and the item's index.
shape Ctx
  hot: bool
  card: Card[]
  row: FeedRow[]
  hero: Card[]
  heroAct: HeroAction[]
  dest: LibraryNav[]
  index: number

