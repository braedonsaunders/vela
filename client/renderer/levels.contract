component L1
  props
    n: N1
    c: Ctx
    e: Env
    act: action
    obs: action
  state over = false
  state focused = false
  state ready = false
  derive st = styleAt(e.styles, over and n.hh ? n.hs : focused and n.hf ? n.fs : c.hot and n.hg ? n.gs : n.s)
  action hovering(v: bool)
    over = v
  action focusing
    focused = true
  action blurring
    focused = false
  action loaded
    ready = true
  view
    if shows(n.cond, c, e)
      if n.t == "text"
        text fill(n.parts, c, e) role=n.role aria-level=n.level testId=fill(n.test, c, e) display=st.display position=(n.pos == 1 ? "absolute" : n.pos == 2 ? "sticky" : "relative") inset=st.inset top=st.top right=st.right bottom=st.bottom left=st.left z-index=st.zIndex width=(n.dw.length > 0 ? fill(n.dw, c, e) : st.width) height=st.height min-width=st.minWidth min-height=st.minHeight max-width=st.maxWidth max-height=st.maxHeight aspect-ratio=st.aspectRatio box-sizing=st.boxSizing flex-grow=st.flexGrow flex-basis=st.flexBasis flex-direction=st.flexDirection flex-wrap=st.flexWrap flex-shrink=st.flexShrink align-items=st.alignItems align-self=st.alignSelf justify-content=st.justifyContent gap=st.gap order=st.order grid-template-columns=st.gridTemplateColumns grid-template-rows=st.gridTemplateRows grid-column=st.gridColumn grid-row=st.gridRow margin=st.margin padding=st.padding padding-top=st.paddingTop padding-right=st.paddingRight padding-bottom=st.paddingBottom padding-left=st.paddingLeft margin-top=st.marginTop margin-right=st.marginRight margin-bottom=st.marginBottom margin-left=st.marginLeft overflow-x=st.overflowX overflow-y=st.overflowY scroll-snap-type=st.scrollSnapType scroll-snap-align=st.scrollSnapAlign scrollbar-width=st.scrollbarWidth color=(n.dc.length > 0 ? fill(n.dc, c, e) : st.color) background-color=(n.dbg.length > 0 ? fill(n.dbg, c, e) : st.backgroundColor) background-image=(n.dbi.length > 0 ? fill(n.dbi, c, e) : st.backgroundImage) opacity=(n.dop.length > 0 ? num(fill(n.dop, c, e)) : st.opacity) border-width=st.borderWidth border-style=st.borderStyle border-color=st.borderColor border-radius=st.borderRadius box-shadow=st.boxShadow filter=st.filter backdrop-filter=st.backdropFilter mask-image=st.maskImage font-family=st.fontFamily font-size=st.fontSize font-weight=st.fontWeight font-style=st.fontStyle line-height=st.lineHeight letter-spacing=st.letterSpacing text-transform=st.textTransform text-align=st.textAlign text-shadow=st.textShadow line-clamp=st.lineClamp white-space=st.whiteSpace font-variant-numeric=st.fontVariantNumeric object-fit=st.objectFit transform-origin=st.transformOrigin translate=(n.dtr.length > 0 ? fill(n.dtr, c, e) : st.translate) scale=st.scale transition=st.transition animation=(n.mk == "" ? st.animation : motion(n.mk, n.md, n.mdl, n.me, n.mf, n.mit, n.mdir, n.msk, n.msd, n.step, n.cap, c.index, e)) pointer-events=st.pointerEvents cursor=st.cursor
      else
        if n.t == "image"
          image fill(n.src, c, e) alt=fill(n.label, c, e) testId=fill(n.test, c, e) load=loaded display=st.display position=(n.pos == 1 ? "absolute" : n.pos == 2 ? "sticky" : "relative") inset=st.inset top=st.top right=st.right bottom=st.bottom left=st.left z-index=st.zIndex width=(n.dw.length > 0 ? fill(n.dw, c, e) : st.width) height=st.height min-width=st.minWidth min-height=st.minHeight max-width=st.maxWidth max-height=st.maxHeight aspect-ratio=st.aspectRatio box-sizing=st.boxSizing flex-grow=st.flexGrow flex-basis=st.flexBasis flex-direction=st.flexDirection flex-wrap=st.flexWrap flex-shrink=st.flexShrink align-items=st.alignItems align-self=st.alignSelf justify-content=st.justifyContent gap=st.gap order=st.order grid-template-columns=st.gridTemplateColumns grid-template-rows=st.gridTemplateRows grid-column=st.gridColumn grid-row=st.gridRow margin=st.margin padding=st.padding padding-top=st.paddingTop padding-right=st.paddingRight padding-bottom=st.paddingBottom padding-left=st.paddingLeft margin-top=st.marginTop margin-right=st.marginRight margin-bottom=st.marginBottom margin-left=st.marginLeft overflow-x=st.overflowX overflow-y=st.overflowY scroll-snap-type=st.scrollSnapType scroll-snap-align=st.scrollSnapAlign scrollbar-width=st.scrollbarWidth color=(n.dc.length > 0 ? fill(n.dc, c, e) : st.color) background-color=(n.dbg.length > 0 ? fill(n.dbg, c, e) : st.backgroundColor) background-image=(n.dbi.length > 0 ? fill(n.dbi, c, e) : st.backgroundImage) opacity=(n.dop.length > 0 ? num(fill(n.dop, c, e)) : st.opacity) border-width=st.borderWidth border-style=st.borderStyle border-color=st.borderColor border-radius=st.borderRadius box-shadow=st.boxShadow filter=st.filter backdrop-filter=st.backdropFilter mask-image=st.maskImage font-family=st.fontFamily font-size=st.fontSize font-weight=st.fontWeight font-style=st.fontStyle line-height=st.lineHeight letter-spacing=st.letterSpacing text-transform=st.textTransform text-align=st.textAlign text-shadow=st.textShadow line-