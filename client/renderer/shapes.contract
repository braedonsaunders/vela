// One slot's tree: its root container's style, its top-level nodes, and the flex
// order of the foundation's content among them (the route a shell wraps, the
// search field a home holds), so the renderer is inlined at one call site per slot.
shape DocSlot
  present: bool
  root: number
  rootPos: number
  slotStyle: number
  slotPos: number
  slotInner: number
  slotOrder: string
  nodes: N1[]

shape ShellSlot
  present: bool
  root: number
  rootPos: number
  slotStyle: number
  slotPos: number
  slotInner: number
  slotOrder: string
  nodes: N5[]

// What the foundation hands the route view: the stack entry's route and its models.
shape RouteProps
  route: string
  entry: string
  load: string
  detail: DetailModel[]
  season: string
  small: bool
  tv: bool
  width: number
  still: bool

// A route's tree (the route view draws the one named after the current stack entry).
shape RouteTree
  name: string
  root: number
  rootPos: number
  slotStyle: number
  slotPos: number
  slotInner: number
  slotOrder: string
  nodes: N1[]

// A skin document as the renderer takes it (src/skin resolves it for one viewport class).
shape SkinDoc
  id: string
  fontsJson: string
  keyframesCss: string
  styles: Style[]
  shell: ShellSlot
  home: DocSlot
  routes: RouteTree[]
  liveHome: bool
  detailWide: string
  detailSmall: string
  detailFrom: number
  detailSplit: string

