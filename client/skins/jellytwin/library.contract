use LibraryModel from "../../foundation/models.contract"
use Grid, EmptyState from "./slots.contract"
use Icon, Spinner, IconBtn, Raised, Tab, MenuRow, Sheet, side from "./look.contract"

// A library: its tabs (everything, then each kind the server offers), a toolbar with
// favourites, sort and filter menus, then the titles in a grid in server order.
component Library
  props
    model: LibraryModel
    loading: bool
    moreLoading: bool
    small: bool
    still: bool
    close: action
    setSort: action
    setFilter: action
    more: action
    selectTitle: action
    observe: action
  derive directions = match first(model.sorts.filter(s => s.id == model.sort)) { case some(s) => s.directions, case none => [] }
  derive sortLabel = match first(model.sorts.filter(s => s.id == model.sort)) { case some(s) => s.label, case none => "" }
  derive filtering = model.playedFilter != "" or model.genreFilter != "" or model.yearFilter > 0
  derive hasFilters = model.canPlayed or model.genres.length > 0 or model.canYear
  action pickSort(id: string)
    match first(model.sorts.filter(s => s.id == id))
      case some(s)
        setSort(id, (s.directions.includes(model.direction) ? model.direction : match first(s.directions) { case some(d) => d, case none => "" }))
      case none
        setSort(id, "")
  action pickDirection(d: string)
    setSort(model.sort, d)
  action pickYear(v: string)
    setFilter("year", v.trim())
  action menuChanged(e: ToggleEvent)
    if e.newState == "closed"
      focus("jt-library-sort")
  view
    column min-height="100%" color="jellytwin.ink" font-family="\"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" padding-bottom=56
      column position="sticky" top=0 z-index=5 background-color="jellytwin.page" border-bottom="1px solid var(--jellytwin.line)"
        text model.name role="heading" aria-level=1 position="absolute" width=1 height=1 overflow="hidden" opacity=0 pointer-events="none"
        scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
          row role="tablist" aria-label=model.name min-width="100%" box-sizing="border-box" padding="6px 8px 0px"
            column flex=1
            LibraryTab(label=model.name, on=(model.kindFilter == ""), still=still, press=setFilter("kind", ""))
            if model.kinds.length > 1
              for kind in model.kinds key=kind.id
                LibraryTab(label=kind.label, on=(model.kindFilter == kind.id), still=still, press=setFilter("kind", kind.id))
            column flex=1
        row align-items="center" gap=4 padding-left=side(small) padding-right=side(small) padding-top=4 padding-bottom=6 role="toolbar" aria-label=t("jellytwin.libraryTools")
          if model.sorts.length > 0
            text sortLabel font-size=13 color="jellytwin.secondary" flex=1 min-width=0 line-clamp=1
          else
            column flex=1
          if model.canFavorite
            button press=setFilter("favorite", (model.favoriteFilter ? "" : "true")) aria-pressed=model.favoriteFilter aria-label=t("library.filter.favorites") testId="jt-favourites" class=IconBtn width=40 height=40 color=(model.favoriteFilter ? "jellytwin.accent" : "jellytwin.ink-strong")
              Icon(name=(model.favoriteFilter ? "symbol:heart-fill" : "symbol:heart"), size=21)
          if model.sorts.length > 1 or directions.length > 1
            button id="jt-library-sort" popovertarget="jt-sort-menu" aria-label=t("library.sortBy") testId="jt-sort" class=IconBtn width=40 height=40
              Icon(name="symbol:sort", size=21)
          if hasFilters
            button popovertarget="jt-filter-menu" aria-label=t("jellytwin.filters") testId="jt-filter" class=IconBtn width=40 height=40 color=(filtering ? "jellytwin.accent" : "jellytwin.ink-strong")
              Icon(name="symbol:filter", size=21)
      column id="jt-sort-menu" popover="auto" toggle=menuChanged position="absolute" position-area="bottom span-left" margin-top=4 role="dialog" aria-label=t("library.sortBy") class=Sheet width=(small ? "calc(100vw - 28px)" : 280) max-height="70vh" overflow-y="auto"
        text t("library.sortBy") font-size=13 font-weight=600 color="jellytwin.secondary" padding="8px 16px 4px"
        for sort in model.sorts key=sort.id
          ChoiceRow(label=sort.label, on=(sort.id == model.sort), press=pickSort(sort.id))
        if directions.length > 1
          column height=1 background-color="jellytwin.line" margin="6px 0px"
          text t("jellytwin.sortOrder") font-size=13 font-weight=600 color="jellytwin.secondary" padding="8px 16px 4px"
          for d in directions key=d
            ChoiceRow(label=(d == "asc" ? t("library.direction.asc") : t("library.direction.desc")), on=(d == model.direction), press=pickDirection(d))
      if hasFilters
        column id="jt-filter-menu" popover="auto" position="absolute" position-area="bottom span-left" margin-top=4 role="dialog" aria-label=t("jellytwin.filters") class=Sheet width=(small ? "calc(100vw - 28px)" : 300) max-height="70vh" overflow-y="auto"
          if model.canPlayed
            text t("jellytwin.status") font-size=13 font-weight=600 color="jellytwin.secondary" padding="8px 16px 4px"
            ChoiceRow(label=t("library.filter.all"), on=(model.playedFilter == ""), press=setFilter("played", ""))
            ChoiceRow(label=t("jellytwin.unplayed"), on=(model.playedFilter == "false"), press=setFilter("played", "false"))
            ChoiceRow(label=t("jellytwin.played"), on=(model.playedFilter == "true"), press=setFilter("played", "true"))
          if model.genres.length > 0
            column height=1 background-color="jellytwin.line" margin="6px 0px"
            text t("jellytwin.genres") font-size=13 font-weight=600 color="jellytwin.secondary" padding="8px 16px 4px"
            ChoiceRow(label=t("library.anyGenre"), on=(model.genreFilter == ""), press=setFilter("genre", ""))
            for genre in model.genres key=genre.id
              ChoiceRow(label=genre.label, on=(model.genreFilter == genre.id), press=setFilter("genre", genre.id))
          if model.canYear
            column height=1 background-color="jellytwin.line" margin="6px 0px"
            column gap=6 padding="8px 16px 10px"
              text t("library.year") font-size=13 font-weight=600 color="jellytwin.secondary"
              input type="number" inputmode="numeric" value=(model.yearFilter > 0 ? `${model.yearFilter}` : "") change=pickYear placeholder=t("library.anyYear") aria-label=t("library.year") box-sizing="border-box" width="100%" height=40 padding="0px 10px" border="1px solid var(--jellytwin.field)" border-radius=4 background-color="jellytwin.field" color="jellytwin.ink-strong" font-size=15
      column padding-top=(small ? 14 : 22)
        if loading and model.items.length == 0
          row justify-content="center" padding=64 role="status" aria-label=t("ui.findingTitles")
            Spinner(size=48, still=still)
        else
          if model.items.length == 0
            EmptyState(icon="symbol:filter", title=t("library.empty"), message=t("library.emptyHint"))
          else
            column aria-busy=loading opacity=(loading ? 0.6 : 1) transition=(still ? "none" : "opacity 160ms linear")
              Grid(items=model.items, small=small, still=still, selectTitle=selectTitle, observe=observe)
            if model.more
              row justify-content="center" padding-top=28
                if moreLoading
                  row role="status" aria-label=t("ui.loadingMore")
                    Spinner(size=36, still=still)
                else
                  button press=more() class=Raised testId="jt-more"
                    text t("library.loadMore")

component LibraryTab
  props
    label: string
    on: bool
    still: bool
    press: action
  view
    button press=press() role="tab" aria-selected=on class=Tab color=(on ? "jellytwin.accent" : "jellytwin.ink") font-weight=(on ? 600 : 400)
      text label
      if on
        column sharedElement="jt-library-tab" -exact-layout-transition=(still ? "none" : "300ms ease-out") position="absolute" left=12 right=12 bottom=0 height=3 border-radius=2 background-image="linear-gradient(90deg, var(--jellytwin.violet) 0%, var(--jellytwin.accent) 100%)" aria-hidden=true

// One choice in a menu, with a check beside the current one.
component ChoiceRow
  props
    label: string
    on: bool
    press: action
  view
    button press=press() role="menuitemradio" aria-checked=on class=MenuRow color=(on ? "jellytwin.accent" : "jellytwin.ink-strong")
      image "symbol:checkmark" width=18 height=18 flex-shrink=0 opacity=(on ? 1 : 0) aria-hidden=true
      text label line-clamp=1
