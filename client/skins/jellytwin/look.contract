// Jelly Twin's shared look: layout helpers, keyframes, its own line
// icons, the Vela mark in the cyan-to-violet gradient, and the control styles every page uses.

fn side(small: bool): string = (small ? "14px" : "3.3%")

// The default tile colour for an item without artwork, chosen from its identity so it stays stable.
fn tileColor(id: string): string = (id.length % 5 == 0 ? "jellytwin.tile-1" : id.length % 5 == 1 ? "jellytwin.tile-2" : id.length % 5 == 2 ? "jellytwin.tile-3" : id.length % 5 == 3 ? "jellytwin.tile-4" : "jellytwin.tile-5")

fn kindIcon(kind: string): string = (kind == "movies" or kind == "movie" ? "symbol:icon.jelly-film" : kind == "shows" or kind == "show" or kind == "season" or kind == "episode" ? "symbol:icon.jelly-tv" : kind == "live" ? "symbol:icon.jelly-live" : "symbol:icon.jelly-folder")

keyframes jtSpin
  from rotate=0
  to rotate=360

keyframes jtFade
  from opacity=0

keyframes jtGone
  to opacity=0

keyframes jtDrawer
  from translate="-100% 0px"

keyframes jtDrawerOut
  to translate="-100% 0px"

keyframes jtPop
  from opacity=0 scale=0.96

keyframes jtRise
  from opacity=0 translate="0px 12px"

fn fadeIn(still: bool): string = (still ? "none" : "jtFade 260ms ease-out both")
fn riseIn(still: bool): string = (still ? "jtFade 200ms linear both" : "jtRise 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both")

// An icon: a platform role (`symbol:search`) or one of the skin's single-path templates
// (`symbol:icon.jelly-film`, assets/icons/jelly-*.svg declared in app.tamber). One node.
component Icon
  props
    name: string
    size: number
  view
    image name width=size height=size flex-shrink=0 aria-hidden=true

// The Vela lockup (brand/README.md): the two-tone searchlight V and the wordmark, one image.
// `size` is its height; the lockup stays at least 72 px wide.
component Wordmark
  props
    size: number
  view
    image "assets/brand/vela-lockup.svg" alt="" height=max(28, size) width=max(28, size) * 2.629 flex-shrink=0 aria-hidden=true

// The indeterminate spinner: an accent arc turning on a faint ring. One node.
component Spinner
  props
    size: number
    still: bool
  view
    column width=size height=size class=SpinnerRing animation=(still ? "none" : "jtSpin 900ms linear infinite") aria-hidden=true

style SpinnerRing
  box-sizing = "border-box"
  flex-shrink = 0
  border-radius = 999
  border = "3px solid var(--jellytwin.track)"
  border-top-color = "jellytwin.accent"

// A round, transparent icon button that tints with the accent on hover and focus.
style IconBtn
  display = "flex"
  align-items = "center"
  justify-content = "center"
  box-sizing = "border-box"
  flex-shrink = 0
  padding = 0
  border = "none"
  border-radius = 999
  background-color = "transparent"
  color = "jellytwin.ink-strong"
  cursor = "pointer"
  transition = "background-color 160ms linear, color 160ms linear"
  :hover
    color = "jellytwin.accent"
    background-color = "jellytwin.accent-soft"
  :focus-visible
    color = "jellytwin.accent"
    background-color = "jellytwin.accent-soft"
  :disabled
    opacity = 0.35

// A raised grey button with a label.
style Raised
  display = "flex"
  align-items = "center"
  justify-content = "center"
  gap = 8
  box-sizing = "border-box"
  height = 40
  padding = "0px 18px"
  border = "none"
  border-radius = 4
  background-color = "jellytwin.raised"
  color = "jellytwin.ink-strong"
  font-size = 14
  font-weight = 500
  cursor = "pointer"
  :hover
    background-color = "jellytwin.raised-hover"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--jellytwin.accent)"
  :disabled
    opacity = 0.45

// The submit button: the accent filled, white label.
style Submit
  display = "flex"
  align-items = "center"
  justify-content = "center"
  gap = 10
  box-sizing = "border-box"
  height = 46
  padding = "0px 20px"
  border = "none"
  border-radius = 4
  background-color = "jellytwin.accent"
  color = "jellytwin.ink-strong"
  font-size = 15
  font-weight = 600
  cursor = "pointer"
  :hover
    opacity = 0.9
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--jellytwin.page), 0px 0px 0px 4px var(--jellytwin.accent)"
  :disabled
    opacity = 0.45

style Field
  box-sizing = "border-box"
  width = "100%"
  height = 44
  padding = "0px 12px"
  border = "1px solid var(--jellytwin.field)"
  border-radius = 4
  background-color = "jellytwin.field"
  color = "jellytwin.ink-strong"
  font-size = 16
  outline = "none"
  :focus-visible
    border-color = "jellytwin.accent"

style Select
  box-sizing = "border-box"
  height = 40
  padding = "0px 10px"
  border = "1px solid var(--jellytwin.field)"
  border-radius = 4
  background-color = "jellytwin.field"
  color = "jellytwin.ink-strong"
  font-size = 14
  :focus-visible
    border-color = "jellytwin.accent"

// A page tab: quiet until hovered, accent when current.
style Tab
  position = "relative"
  display = "flex"
  align-items = "center"
  box-sizing = "border-box"
  height = 40
  padding = "0px 14px"
  border = "none"
  background-color = "transparent"
  color = "jellytwin.ink"
  font-size = 15
  white-space = "nowrap"
  flex-shrink = 0
  cursor = "pointer"
  :hover
    color = "jellytwin.accent"
  :focus-visible
    color = "jellytwin.accent"

// A row in an action sheet or menu.
style MenuRow
  display = "flex"
  align-items = "center"
  gap = 14
  box-sizing = "border-box"
  width = "100%"
  min-height = 44
  padding = "0px 16px"
  border = "none"
  border-radius = 4
  background-color = "transparent"
  color = "jellytwin.ink-strong"
  font-size = 15
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "jellytwin.hover"
  :focus-visible
    background-color = "jellytwin.hover"
  :disabled
    opacity = 0.4

// A floating menu surface for popovers and sheets.
style Sheet
  box-sizing = "border-box"
  padding = "8px 0px"
  border = "none"
  border-radius = 6
  background-color = "jellytwin.popup"
  color = "jellytwin.ink-strong"
  box-shadow = "0px 12px 40px var(--jellytwin.shadow)"

// The played mark on a card: a check on an accent disc.
style PlayedBadge
  width = 24
  height = 24
  border-radius = 12
  align-items = "center"
  justify-content = "center"
  background-color = "jellytwin.accent"
  color = "jellytwin.ink-strong"
