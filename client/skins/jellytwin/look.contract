// Jelly Twin's shared look: layout helpers, keyframes, its own line
// icons, the Vela mark in the cyan-to-violet gradient, and the control styles every page uses.

fn side(small: bool): string = (small ? "14px" : "3.3%")

// The default tile colour for an item without artwork, chosen from its identity so it stays stable.
fn tileColor(id: string): string = (id.length % 5 == 0 ? "jellytwin.tile-1" : id.length % 5 == 1 ? "jellytwin.tile-2" : id.length % 5 == 2 ? "jellytwin.tile-3" : id.length % 5 == 3 ? "jellytwin.tile-4" : "jellytwin.tile-5")

fn kindIcon(kind: string): string = (kind == "movies" or kind == "movie" ? "movie" : kind == "shows" or kind == "show" or kind == "season" or kind == "episode" ? "tv" : kind == "live" ? "live" : "folder")

keyframes jtSpin
  from rotate=0
  to rotate=360

keyframes jtFade
  from opacity=0

keyframes jtGone
  to opacity=0

keyframes jtDrawer
  from translate="-100% 0px"

keyframes jtDrawerOut
  to translate="-100% 0px"

keyframes jtPop
  from opacity=0 scale=0.96

keyframes jtRise
  from opacity=0 translate="0px 12px"

fn fadeIn(still: bool): string = (still ? "none" : "jtFade 260ms ease-out both")
fn riseIn(still: bool): string = (still ? "jtFade 200ms linear both" : "jtRise 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both")

// Line icons drawn for this skin on a 24-unit grid; `currentcolor` follows the control.
component Icon
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" aria-hidden=true flex-shrink=0 fill="none" stroke="currentcolor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      if name == "menu"
        path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"
      if name == "search"
        circle cx=10.5 cy=10.5 r=6.5
        path d="M15.5 15.5 20.5 20.5"
      if name == "user"
        circle cx=12 cy=8.5 r=4
        path d="M4.5 20.5c0-4.2 3.4-6.5 7.5-6.5s7.5 2.3 7.5 6.5"
      if name == "back"
        path d="M20 12H5M11 5.5 4.5 12l6.5 6.5"
      if name == "home"
        path d="M3.5 11 12 4l8.5 7M6 9v11h4.5v-5.5h3V20H18V9"
      if name == "movie"
        rect x=3.5 y=4.5 width=17 height=15 rx=2
        path d="M7.5 4.5v15M16.5 4.5v15M3.5 9.5h4M3.5 14.5h4M16.5 9.5h4M16.5 14.5h4"
      if name == "tv"
        rect x=2.5 y=5 width=19 height=12.5 rx=2
        path d="M8 21h8M12 17.5V21"
      if name == "live"
        circle cx=12 cy=12 r=1.8 fill="currentcolor"
        path d="M8.2 8.2a5.4 5.4 0 0 0 0 7.6M15.8 8.2a5.4 5.4 0 0 1 0 7.6M5.3 5.3a9.5 9.5 0 0 0 0 13.4M18.7 5.3a9.5 9.5 0 0 1 0 13.4"
      if name == "folder"
        path d="M3.5 7A1.5 1.5 0 0 1 5 5.5h4l2 2.5h8A1.5 1.5 0 0 1 20.5 9.5v8A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z"
      if name == "play"
        path d="M8 5.5v13l10.5-6.5z" fill="currentcolor" stroke-width=1.5
      if name == "pause"
        path d="M7 5.5v13M17 5.5v13" stroke-width=3.6 stroke-linecap="butt"
      if name == "rewind"
        path d="M11.5 6.5v11L4 12zM20 6.5v11L12.5 12z" fill="currentcolor" stroke-width=1.4
      if name == "forward"
        path d="M12.5 6.5v11L20 12zM4 6.5v11l7.5-5.5z" fill="currentcolor" stroke-width=1.4
      if name == "subtitles"
        rect x=3 y=5 width=18 height=14 rx=2.5
        path d="M6.5 12.5h4M13 12.5h4.5M6.5 15.5h7M16 15.5h1.5"
      if name == "audio"
        path d="M9 17V5.5l10-2V15"
        circle cx=6.5 cy=17 r=2.5 fill="currentcolor"
        circle cx=16.5 cy=15 r=2.5 fill="currentcolor"
      if name == "settings"
        circle cx=12 cy=12 r=3
        circle cx=12 cy=12 r=7
        path d="M12 2.5V5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
      if name == "fullscreen"
        path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"
      if name == "pip"
        rect x=2.5 y=4.5 width=19 height=15 rx=2
        rect x=12 y=11.5 width=7 height=5.5 rx=1 fill="currentcolor" stroke-width=1
      if name == "volume"
        path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentcolor" stroke-width=1.5
        path d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11"
      if name == "muted"
        path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentcolor" stroke-width=1.5
        path d="M16 9.5l5 5M21 9.5l-5 5"
      if name == "check"
        path d="M5 12.5 9.5 17 19 7.5" stroke-width=2.6
      if name == "heart"
        path d="M12 19.5s-7.5-4.4-7.5-9.7A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.5c0 5.3-7.5 9.7-7.5 9.7z"
      if name == "heart-fill"
        path d="M12 19.5s-7.5-4.4-7.5-9.7A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.5c0 5.3-7.5 9.7-7.5 9.7z" fill="currentcolor"
      if name == "sort"
        path d="M7 4v16M3.5 16.5 7 20l3.5-3.5M17 20V4M13.5 7.5 17 4l3.5 3.5"
      if name == "filter"
        path d="M3.5 5h17l-6.5 8v6l-4 1.5V13z"
      if name == "left"
        path d="M15 5 8 12l7 7"
      if name == "right"
        path d="M9 5l7 7-7 7"
      if name == "up"
        path d="M5 15l7-7 7 7"
      if name == "down"
        path d="M5 9l7 7 7-7"
      if name == "close"
        path d="M6 6l12 12M18 6 6 18"
      if name == "info"
        circle cx=12 cy=12 r=9
        path d="M12 11v6M12 7.6v.2"
      if name == "star"
        path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z" fill="currentcolor" stroke-width=1.2
      if name == "guide"
        rect x=3 y=4.5 width=18 height=15 rx=2
        path d="M3 9.5h18M9 9.5v10M3 14.5h18"
      if name == "logout"
        path d="M14.5 4H18a1.5 1.5 0 0 1 1.5 1.5v13A1.5 1.5 0 0 1 18 20h-3.5M10 8l-4 4 4 4M6 12h10"
      if name == "palette"
        path d="M12 3.5a8.5 8.5 0 0 0 0 17c1.2 0 1.8-.8 1.5-1.8-.4-1.2.4-2.2 1.6-2.2H17a3.5 3.5 0 0 0 3.5-3.5c0-5-3.8-9.5-8.5-9.5z"
        circle cx=7.8 cy=11.5 r=1.1 fill="currentcolor" stroke="none"
        circle cx=10.5 cy=7.6 r=1.1 fill="currentcolor" stroke="none"
        circle cx=15 cy=8 r=1.1 fill="currentcolor" stroke="none"
      if name == "phone"
        rect x=6.5 y=2.5 width=11 height=19 rx=2.5
        path d="M10.5 18.5h3"
      if name == "alert"
        path d="M12 3.5 21.5 20h-19z"
        path d="M12 10v4.5M12 17.2v.2"
      if name == "chapters"
        path d="M4 6h16M4 12h10M4 18h13"
      if name == "lowdelay"
        path d="M13 3 5 13.5h6L10 21l8-10.5h-6z" fill="currentcolor" stroke-width=1.2

// The Vela mark (the four-pointed sail) and wordmark, painted in the skin's gradient.
component Wordmark
  props
    size: number
  view
    row align-items="center" gap=(size * 0.3) aria-hidden=true
      svg width=(size * 0.95) height=(size * 0.95) viewBox="0 0 24 24"
        linearGradient id="jt-mark" x1=0 y1=0 x2=1 y2=1
          stop offset="0%" stop-color="var(--jellytwin.violet)"
          stop offset="100%" stop-color="var(--jellytwin.accent)"
        path d="M12 0C12.9 7.6 16.4 11.1 24 12C16.4 12.9 12.9 16.4 12 24C11.1 16.4 7.6 12.9 0 12C7.6 11.1 11.1 7.6 12 0Z" fill="url(#jt-mark)"
      text t("jellytwin.wordmark") font-size=size font-weight=300 letter-spacing="0.12em" line-height=1 color="jellytwin.ink-strong"

// The indeterminate spinner: an accent arc turning on a faint ring.
component Spinner
  props
    size: number
    still: bool
  view
    svg width=size height=size viewBox="0 0 48 48" aria-hidden=true flex-shrink=0 animation=(still ? "none" : "jtSpin 900ms linear infinite")
      circle cx=24 cy=24 r=20 fill="none" stroke="var(--jellytwin.track)" stroke-width=4
      circle cx=24 cy=24 r=20 fill="none" stroke="var(--jellytwin.accent)" stroke-width=4 stroke-linecap="round" stroke-dasharray="40 126"

// A round, transparent icon button that tints with the accent on hover and focus.
style IconBtn
  display = "flex"
  align-items = "center"
  justify-content = "center"
  box-sizing = "border-box"
  flex-shrink = 0
  padding = 0
  border = "none"
  border-radius = 999
  background-color = "transparent"
  color = "jellytwin.ink-strong"
  cursor = "pointer"
  transition = "background-color 160ms linear, color 160ms linear"
  :hover
    color = "jellytwin.accent"
    background-color = "jellytwin.accent-soft"
  :focus-visible
    color = "jellytwin.accent"
    background-color = "jellytwin.accent-soft"
  :disabled
    opacity = 0.35

// A raised grey button with a label.
style Raised
  display = "flex"
  align-items = "center"
  justify-content = "center"
  gap = 8
  box-sizing = "border-box"
  height = 40
  padding = "0px 18px"
  border = "none"
  border-radius = 4
  background-color = "jellytwin.raised"
  color = "jellytwin.ink-strong"
  font-size = 14
  font-weight = 500
  cursor = "pointer"
  :hover
    background-color = "jellytwin.raised-hover"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--jellytwin.accent)"
  :disabled
    opacity = 0.45

// The submit button: the accent filled, white label.
style Submit
  display = "flex"
  align-items = "center"
  justify-content = "center"
  gap = 10
  box-sizing = "border-box"
  height = 46
  padding = "0px 20px"
  border = "none"
  border-radius = 4
  background-color = "jellytwin.accent"
  color = "jellytwin.ink-strong"
  font-size = 15
  font-weight = 600
  cursor = "pointer"
  :hover
    opacity = 0.9
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--jellytwin.page), 0px 0px 0px 4px var(--jellytwin.accent)"
  :disabled
    opacity = 0.45

style Field
  box-sizing = "border-box"
  width = "100%"
  height = 44
  padding = "0px 12px"
  border = "1px solid var(--jellytwin.field)"
  border-radius = 4
  background-color = "jellytwin.field"
  color = "jellytwin.ink-strong"
  font-size = 16
  outline = "none"
  :focus-visible
    border-color = "jellytwin.accent"

style Select
  box-sizing = "border-box"
  height = 40
  padding = "0px 10px"
  border = "1px solid var(--jellytwin.field)"
  border-radius = 4
  background-color = "jellytwin.field"
  color = "jellytwin.ink-strong"
  font-size = 14
  :focus-visible
    border-color = "jellytwin.accent"

// A page tab: quiet until hovered, accent when current.
style Tab
  position = "relative"
  display = "flex"
  align-items = "center"
  box-sizing = "border-box"
  height = 40
  padding = "0px 14px"
  border = "none"
  background-color = "transparent"
  color = "jellytwin.ink"
  font-size = 15
  white-space = "nowrap"
  flex-shrink = 0
  cursor = "pointer"
  :hover
    color = "jellytwin.accent"
  :focus-visible
    color = "jellytwin.accent"

// A row in an action sheet or menu.
style MenuRow
  display = "flex"
  align-items = "center"
  gap = 14
  box-sizing = "border-box"
  width = "100%"
  min-height = 44
  padding = "0px 16px"
  border = "none"
  border-radius = 4
  background-color = "transparent"
  color = "jellytwin.ink-strong"
  font-size = 15
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "jellytwin.hover"
  :focus-visible
    background-color = "jellytwin.hover"
  :disabled
    opacity = 0.4

// A floating menu surface for popovers and sheets.
style Sheet
  box-sizing = "border-box"
  padding = "8px 0px"
  border = "none"
  border-radius = 6
  background-color = "jellytwin.popup"
  color = "jellytwin.ink-strong"
  box-shadow = "0px 12px 40px var(--jellytwin.shadow)"
