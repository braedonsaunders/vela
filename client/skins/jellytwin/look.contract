// Jelly Twin's shared look: layout helpers, keyframes, its own line
// icons, the Vela mark in the cyan-to-violet gradient, and the control styles every page uses.

fn side(small: bool): string = (small ? "14px" : "3.3%")

// The default tile colour for an item without artwork, chosen from its identity so it stays stable.
fn tileColor(id: string): string = (id.length % 5 == 0 ? "jellytwin.tile-1" : id.length % 5 == 1 ? "jellytwin.tile-2" : id.length % 5 == 2 ? "jellytwin.tile-3" : id.length % 5 == 3 ? "jellytwin.tile-4" : "jellytwin.tile-5")

fn kindIcon(kind: string): string = (kind == "movies" or kind == "movie" ? "movie" : kind == "shows" or kind == "show" or kind == "season" or kind == "episode" ? "tv" : kind == "live" ? "live" : "folder")

keyframes jtSpin
  from rotate=0
  to rotate=360

keyframes jtFade
  from opacity=0

keyframes jtGone
  to opacity=0

keyframes jtDrawer
  from translate="-100% 0px"

keyframes jtDrawerOut
  to translate="-100% 0px"

keyframes jtPop
  from opacity=0 scale=0.96

keyframes jtRise
  from opacity=0 translate="0px 12px"

fn fadeIn(still: bool): string = (still ? "none" : "jtFade 260ms ease-out both")
fn riseIn(still: bool): string = (still ? "jtFade 200ms linear both" : "jtRise 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both")

// Icons: the platform's roles where one matches, else the skin's own single-path
// templates (assets/icons/jelly-*.svg, declared in app.tamber). One image node each.
fn iconSrc(name: string): string = (name == "menu" ? "symbol:menu" : name == "search" ? "symbol:search" : name == "user" ? "symbol:person" : name == "back" ? "symbol:back" : name == "home" ? "symbol:home" : name == "movie" ? "symbol:icon.jelly-film" : name == "tv" ? "symbol:icon.jelly-tv" : name == "live" ? "symbol:icon.jelly-live" : name == "folder" ? "symbol:icon.jelly-folder" : name == "play" ? "symbol:play-fill" : name == "pause" ? "symbol:pause-fill" : name == "rewind" ? "symbol:icon.jelly-rewind" : name == "forward" ? "symbol:icon.jelly-fastforward" : name == "subtitles" ? "symbol:icon.jelly-subtitles" : name == "audio" ? "symbol:waveform" : name == "settings" ? "symbol:settings" : name == "fullscreen" ? "symbol:icon.jelly-fullscreen" : name == "pip" ? "symbol:icon.jelly-pip" : name == "volume" ? "symbol:speaker" : name == "muted" ? "symbol:speaker-mute" : name == "check" ? "symbol:checkmark" : name == "heart" ? "symbol:heart" : name == "heart-fill" ? "symbol:heart-fill" : name == "sort" ? "symbol:sort" : name == "filter" ? "symbol:filter" : name == "left" ? "symbol:icon.jelly-left" : name == "right" ? "symbol:icon.jelly-right" : name == "up" ? "symbol:icon.jelly-up" : name == "down" ? "symbol:icon.jelly-down" : name == "close" ? "symbol:close" : name == "info" ? "symbol:info" : name == "star" ? "symbol:star-fill" : name == "logout" ? "symbol:sign-out" : name == "palette" ? "symbol:sparkles" : name == "phone" ? "symbol:smartphone" : name == "alert" ? "symbol:alert" : name == "chapters" ? "symbol:list" : name == "lowdelay" ? "symbol:icon.jelly-bolt" : "symbol:circle")

component Icon
  props
    name: string
    size: number
  view
    image iconSrc(name) width=size height=size flex-shrink=0 aria-hidden=true

// The Vela mark (the four-pointed sail) and wordmark, painted in the skin's gradient.
component Wordmark
  props
    size: number
  view
    row align-items="center" gap=(size * 0.3) aria-hidden=true
      svg width=(size * 0.95) height=(size * 0.95) viewBox="0 0 24 24"
        linearGradient id="jt-mark" x1=0 y1=0 x2=1 y2=1
          stop offset="0%" stop-color="var(--jellytwin.violet)"
          stop offset="100%" stop-color="var(--jellytwin.accent)"
        path d="M12 0C12.9 7.6 16.4 11.1 24 12C16.4 12.9 12.9 16.4 12 24C11.1 16.4 7.6 12.9 0 12C7.6 11.1 11.1 7.6 12 0Z" fill="url(#jt-mark)"
      text t("jellytwin.wordmark") font-size=size font-weight=300 letter-spacing="0.12em" line-height=1 color="jellytwin.ink-strong"

// The indeterminate spinner: an accent arc turning on a faint ring.
component Spinner
  props
    size: number
    still: bool
  view
    svg width=size height=size viewBox="0 0 48 48" aria-hidden=true flex-shrink=0 animation=(still ? "none" : "jtSpin 900ms linear infinite")
      circle cx=24 cy=24 r=20 fill="none" stroke="var(--jellytwin.track)" stroke-width=4
      circle cx=24 cy=24 r=20 fill="none" stroke="var(--jellytwin.accent)" stroke-width=4 stroke-linecap="round" stroke-dasharray="40 126"

// A round, transparent icon button that tints with the accent on hover and focus.
style IconBtn
  display = "flex"
  align-items = "center"
  justify-content = "center"
  box-sizing = "border-box"
  flex-shrink = 0
  padding = 0
  border = "none"
  border-radius = 999
  background-color = "transparent"
  color = "jellytwin.ink-strong"
  cursor = "pointer"
  transition = "background-color 160ms linear, color 160ms linear"
  :hover
    color = "jellytwin.accent"
    background-color = "jellytwin.accent-soft"
  :focus-visible
    color = "jellytwin.accent"
    background-color = "jellytwin.accent-soft"
  :disabled
    opacity = 0.35

// A raised grey button with a label.
style Raised
  display = "flex"
  align-items = "center"
  justify-content = "center"
  gap = 8
  box-sizing = "border-box"
  height = 40
  padding = "0px 18px"
  border = "none"
  border-radius = 4
  background-color = "jellytwin.raised"
  color = "jellytwin.ink-strong"
  font-size = 14
  font-weight = 500
  cursor = "pointer"
  :hover
    background-color = "jellytwin.raised-hover"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--jellytwin.accent)"
  :disabled
    opacity = 0.45

// The submit button: the accent filled, white label.
style Submit
  display = "flex"
  align-items = "center"
  justify-content = "center"
  gap = 10
  box-sizing = "border-box"
  height = 46
  padding = "0px 20px"
  border = "none"
  border-radius = 4
  background-color = "jellytwin.accent"
  color = "jellytwin.ink-strong"
  font-size = 15
  font-weight = 600
  cursor = "pointer"
  :hover
    opacity = 0.9
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--jellytwin.page), 0px 0px 0px 4px var(--jellytwin.accent)"
  :disabled
    opacity = 0.45

style Field
  box-sizing = "border-box"
  width = "100%"
  height = 44
  padding = "0px 12px"
  border = "1px solid var(--jellytwin.field)"
  border-radius = 4
  background-color = "jellytwin.field"
  color = "jellytwin.ink-strong"
  font-size = 16
  outline = "none"
  :focus-visible
    border-color = "jellytwin.accent"

style Select
  box-sizing = "border-box"
  height = 40
  padding = "0px 10px"
  border = "1px solid var(--jellytwin.field)"
  border-radius = 4
  background-color = "jellytwin.field"
  color = "jellytwin.ink-strong"
  font-size = 14
  :focus-visible
    border-color = "jellytwin.accent"

// A page tab: quiet until hovered, accent when current.
style Tab
  position = "relative"
  display = "flex"
  align-items = "center"
  box-sizing = "border-box"
  height = 40
  padding = "0px 14px"
  border = "none"
  background-color = "transparent"
  color = "jellytwin.ink"
  font-size = 15
  white-space = "nowrap"
  flex-shrink = 0
  cursor = "pointer"
  :hover
    color = "jellytwin.accent"
  :focus-visible
    color = "jellytwin.accent"

// A row in an action sheet or menu.
style MenuRow
  display = "flex"
  align-items = "center"
  gap = 14
  box-sizing = "border-box"
  width = "100%"
  min-height = 44
  padding = "0px 16px"
  border = "none"
  border-radius = 4
  background-color = "transparent"
  color = "jellytwin.ink-strong"
  font-size = 15
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "jellytwin.hover"
  :focus-visible
    background-color = "jellytwin.hover"
  :disabled
    opacity = 0.4

// A floating menu surface for popovers and sheets.
style Sheet
  box-sizing = "border-box"
  padding = "8px 0px"
  border = "none"
  border-radius = 6
  background-color = "jellytwin.popup"
  color = "jellytwin.ink-strong"
  box-shadow = "0px 12px 40px var(--jellytwin.shadow)"
