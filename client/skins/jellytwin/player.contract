use PlayerView from "../../foundation/player-models.contract"
use Icon, Spinner, IconBtn, Raised, Submit, MenuRow, Sheet from "./look.contract"
use PlayerProps from "../../foundation/slot-api.contract"

// The on-screen display: a top bar with the way back and the title, the accent spinner
// while the engine waits, and a bottom bar with the timeline and a row of round icon
// buttons; subtitles, audio and settings open action sheets above the bar.
component PlayerChrome
  props
    p: PlayerProps
  inject
    command: action
    seek: action
    editing: action
    close: action
  state scrubbing = false
  derive blocked = p.busy or p.model.state == "ended"
  derive failure = (p.serverError != "" ? p.serverError : p.model.reason)
  derive failed = p.model.state == "failed" or p.serverError != ""
  derive waiting = not failed and (p.model.waiting or p.model.state == "loading" or p.model.state == "buffering" or p.model.state == "recovering")
  derive shown = (p.visible or p.model.state != "playing")
  derive level = (p.model.muted ? 0 : max(0, min(1, p.model.volume)))
  derive hasSettings = p.model.qualities.length > 1 or p.model.paths.length > 1 or p.model.chapters.length > 0
  action menuChanged(e: ToggleEvent)
    editing(e.newState == "open")
  action scrubFocus(on: bool)
    scrubbing = on
    editing(on)
  action scrub(v: number)
    seek(v)
  action setVolume(v: number)
    command("volume", `${v}`)
  view
    column position="absolute" inset=0 justify-content="space-between" pointer-events="none" testId="player-chrome" color="jellytwin.ink-strong" font-family="\"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
      row padding=(p.small ? "10px 8px 48px" : "14px 20px 80px") gap=10 align-items="center" background-image="linear-gradient(180deg, var(--jellytwin.osd-top) 0%, transparent 100%)" opacity=(shown ? 1 : 0) transition=(p.still ? "none" : "opacity 300ms ease") pointer-events=(shown ? "auto" : "none") inert=(not shown)
        button press=close aria-label=t("ui.closePlayer") class=IconBtn width=46 height=46
          Icon(name="symbol:back", size=26)
        text p.title font-size=(p.small ? 17 : 20) font-weight=500 line-clamp=1 flex=1 min-width=0 text-shadow="0px 1px 6px var(--jellytwin.shadow)"
      if failed
        column pointer-events="auto" align-self="center" align-items="center" text-align="center" gap=14 padding=(p.small ? "24px 20px" : "30px 36px") margin="0px 16px" max-width=440 box-sizing="border-box" class=Sheet role="alert" testId="player-status"
          image "symbol:alert" width=34 height=34 flex-shrink=0 color="jellytwin.danger" aria-hidden=true
          text t("ui.playbackInterrupted") font-size=21 font-weight=600
          if failure != ""
            text failure font-size=14 line-height=1.5 color="jellytwin.ink"
          row gap=10 margin-top=6 flex-wrap="wrap" justify-content="center"
            button press=command("retry", "") class=Submit height=42
              text t("ui.tryAgain")
            button press=close class=Raised height=42
              text t("ui.closePlayer")
      else
        if waiting
          column align-self="center" align-items="center" gap=14 role="status" aria-label=(p.model.state == "recovering" ? t("ui.recoveringPlayback") : p.model.state == "loading" ? t("ui.preparingPlayback") : t("ui.buffering")) testId="player-status"
            Spinner(size=(p.small ? 52 : 64), still=p.still)
            if p.model.preparation != "" and p.model.state == "loading"
              text p.model.preparation font-size=14 color="jellytwin.ink" text-shadow="0px 1px 6px var(--jellytwin.shadow)"
      column padding=(p.small ? "48px 10px 10px" : "90px 24px 16px") gap=(p.small ? 4 : 6) background-image="linear-gradient(0deg, var(--jellytwin.osd-bottom) 0%, transparent 100%)" opacity=(shown ? 1 : 0) transition=(p.still ? "none" : "opacity 300ms ease") pointer-events=(shown ? "auto" : "none") inert=(not shown)
        if p.model.actionError != "" and failure == ""
          text p.model.actionError role="status" font-size=13 color="jellytwin.ink" padding="0px 8px 4px"
        row gap=12 align-items="center" padding="0px 8px"
          text p.model.elapsed font-size=13 font-variant-numeric="tabular-nums" min-width=44
          column position="relative" flex=1 min-width=0 height=24 justify-content="center"
            column position="absolute" left=0 right=0 height=(scrubbing ? 6 : 4) border-radius=3 background-color="jellytwin.track" overflow="hidden" transition=(p.still ? "none" : "height 140ms ease")
              for range in p.model.buffered key=range.id
                column position="absolute" top=0 bottom=0 left=`${range.left}%` width=`${range.width}%` background-color="jellytwin.buffer"
              column position="absolute" left=0 top=0 bottom=0 width=`${p.model.progress}%` background-image="linear-gradient(90deg, var(--jellytwin.violet) 0%, var(--jellytwin.accent) 100%)" background-color="jellytwin.accent"
            for chapter in p.model.chapters key=chapter.id
              column position="absolute" left=`${chapter.percent}%` width=3 height=(scrubbing ? 6 : 4) background-color="jellytwin.ink-strong" opacity=0.7 aria-hidden=true
            column position="absolute" left=`calc(${p.model.progress}% - 7px)` width=14 height=14 border-radius=7 background-color="jellytwin.accent" box-shadow="0px 1px 4px var(--jellytwin.shadow)" scale=(scrubbing ? 1.25 : 1) transition=(p.still ? "none" : "scale 140ms ease") aria-hidden=true
            input focus=scrubFocus(true) blur=scrubFocus(false) type="range" min=0 max=max(1, p.model.duration) step=0.1 value=p.model.position change=scrub aria-label=t("ui.playbackPosition") testId="player-scrub" disabled=(p.model.duration <= 0 or blocked) position="absolute" left=0 right=0 width="100%" height=24 margin=0 opacity=0 cursor="pointer"
          text p.model.remaining font-size=13 font-variant-numeric="tabular-nums" min-width=44 text-align="right"
        row align-items="center" gap=(p.small ? 0 : 2)
          button disabled=blocked press=command("seekBy", "-10") aria-label=t("ui.back10Seconds") class=IconBtn width=(p.small ? 42 : 48) height=(p.small ? 42 : 48)
            Icon(name="symbol:icon.jelly-rewind", size=(p.small ? 24 : 28))
          button disabled=(p.model.state == "ended") press=command(p.model.playing ? "pause" : "play", "") aria-label=(p.model.state == "ended" ? t("ui.finished") : p.model.playing ? t("ui.pause") : t("ui.play")) testId="player-toggle" class=IconBtn width=(p.small ? 48 : 56) height=(p.small ? 48 : 56)
            Icon(name=(p.model.playing ? "symbol:pause-fill" : "symbol:play-fill"), size=(p.small ? 30 : 36))
          button disabled=(p.model.duration <= 0 or blocked) press=command("seekBy", "10") aria-label=t("ui.forward10Seconds") class=IconBtn width=(p.small ? 42 : 48) height=(p.small ? 42 : 48)
            Icon(name="symbol:icon.jelly-fastforward", size=(p.small ? 24 : 28))
          column flex=1 min-width=0
            if not p.small
              text (p.model.quality != "" ? t("ui.pathQuality", path=p.model.path, quality=p.model.quality) : p.model.path) testId="player-quality" font-size=12 color="jellytwin.secondary" padding-left=10 line-clamp=1
          if p.model.subtitles.length > 0
            button popovertarget="jt-subtitles" aria-label=t("ui.subtitles") testId="player-subtitles-button" class=IconBtn width=44 height=44 color=(p.model.subtitleId != "" ? "jellytwin.accent" : "jellytwin.ink-strong")
              Icon(name="symbol:icon.jelly-subtitles", size=24)
          if p.model.audio.length > 1
            button popovertarget="jt-audio" aria-label=t("ui.audioTrack") testId="player-audio-button" class=IconBtn width=44 height=44
              Icon(name="symbol:waveform", size=22)
          if hasSettings
            button popovertarget="jt-settings" aria-label=t("ui.playbackSettings") testId="player-settings-button" class=IconBtn width=44 height=44
              Icon(name="symbol:settings", size=24)
          if p.model.pip and not p.small
            button press=command("pip", "") aria-label=t("ui.pictureInPicture") class=IconBtn width=44 height=44
              Icon(name="symbol:icon.jelly-pip", size=23)
          if p.model.fullscreen
            button press=command("fullscreen", "") aria-label=t("ui.fullscreen") class=IconBtn width=44 height=44
              Icon(name="symbol:icon.jelly-fullscreen", size=23)
          button press=command("mute", "") aria-label=(p.model.muted ? t("ui.unmute") : t("ui.mute")) aria-pressed=p.model.muted testId="player-mute" class=IconBtn width=44 height=44
            Icon(name=(p.model.muted or p.model.volume <= 0 ? "symbol:speaker-mute" : "symbol:speaker"), size=23)
          if not p.small
            column position="relative" width=96 height=24 justify-content="center" flex-shrink=0 margin-right=4
              column position="absolute" left=0 right=0 height=4 border-radius=2 background-color="jellytwin.track" overflow="hidden"
                column height=4 width=`${level * 100}%` background-color="jellytwin.accent"
              column position="absolute" left=`calc(${level * 100}% - 6px)` width=12 height=12 border-radius=6 background-color="jellytwin.accent" aria-hidden=true
              input type="range" min=0 max=1 step=0.01 value=level change=setVolume focus=editing(true) blur=editing(false) aria-label=t("ui.volume") testId="player-volume" position="absolute" left=0 width="100%" height=24 margin=0 opacity=0 cursor="pointer"
      if p.model.subtitles.length > 0
        column id="jt-subtitles" popover="auto" toggle=menuChanged position="absolute" position-area="top span-left" margin-bottom=10 pointer-events="auto" role="dialog" aria-label=t("ui.subtitles") class=Sheet width=(p.small ? "calc(100vw - 24px)" : 300) max-height="60vh" overflow-y="auto"
          SheetTitle(label=t("ui.subtitles"))
          TrackRow(label=t("ui.off"), on=(p.model.subtitleId == ""), disabled=blocked, press=command("subtitle", ""))
          for track in p.model.subtitles key=track.id
            TrackRow(label=track.label, on=(p.model.subtitleId == track.id), disabled=blocked, press=command("subtitle", track.id))
      if p.model.audio.length > 1
        column id="jt-audio" popover="auto" toggle=menuChanged position="absolute" position-area="top span-left" margin-bottom=10 pointer-events="auto" role="dialog" aria-label=t("ui.audioTrack") aria-busy=(p.model.pendingAudioId != "") class=Sheet width=(p.small ? "calc(100vw - 24px)" : 300) max-height="60vh" overflow-y="auto"
          SheetTitle(label=t("ui.audio"))
          for track in p.model.audio key=track.id
            TrackRow(label=track.label, on=((p.model.pendingAudioId != "" ? p.model.pendingAudioId : p.model.audioId) == track.id), disabled=blocked, press=command("audio", track.id))
          if p.model.pendingAudioId != ""
            row gap=10 align-items="center" padding="8px 16px" role="status"
              Spinner(size=16, still=p.still)
              text t("ui.switchingAudioSoon") font-size=13 color="jellytwin.secondary"
      if hasSettings
        column id="jt-settings" popover="auto" toggle=menuChanged position="absolute" position-area="top span-left" margin-bottom=10 pointer-events="auto" role="dialog" aria-label=t("ui.playbackSettings") class=Sheet width=(p.small ? "calc(100vw - 24px)" : 320) max-height="70vh" overflow-y="auto"
          if p.model.qualities.length > 1
            SheetTitle(label=t("ui.quality"))
            TrackRow(label=t("ui.autoAdaptToYourConnection"), on=(p.model.lockedQuality == ""), disabled=blocked, press=command("quality", ""))
            for quality in p.model.qualities key=quality.id
              TrackRow(label=quality.label, on=(p.model.lockedQuality == quality.id), disabled=blocked, press=command("quality", quality.id))
          if p.model.paths.length > 1
            SheetTitle(label=t("ui.delivery"))
            for path in p.model.paths key=path.id
              TrackRow(label=path.label, on=(p.model.pathId == path.id), disabled=blocked, press=command("switchPath", path.id))
          if p.model.chapters.length > 0
            SheetTitle(label=t("ui.chapters"))
            for chapter in p.model.chapters key=chapter.id
              button press=seek(chapter.seconds) disabled=blocked class=MenuRow
                image "symbol:list" width=18 height=18 flex-shrink=0 color="jellytwin.secondary" aria-hidden=true
                text chapter.label line-clamp=1
          text t("ui.pathQuality", path=p.model.path, quality=p.model.quality) font-size=12 color="jellytwin.secondary" padding="10px 16px 6px"

component SheetTitle
  props
    label: string
  view
    text label font-size=13 font-weight=600 color="jellytwin.secondary" padding="10px 16px 4px"

component TrackRow
  props
    label: string
    on: bool
    disabled: bool
    press: action
  view
    button press=press() disabled=disabled role="menuitemradio" aria-checked=on class=MenuRow color=(on ? "jellytwin.accent" : "jellytwin.ink-strong")
      image "symbol:checkmark" width=18 height=18 flex-shrink=0 opacity=(on ? 1 : 0) aria-hidden=true
      text label line-clamp=1
