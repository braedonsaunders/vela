use QuickModel from "../../foundation/models.contract"
use Wordmark, Spinner, Raised, Submit, Field, fadeIn, riseIn from "./look.contract"
use AuthNoticeProps, AuthStageProps, QuickConnectProps, SignInProps from "../../foundation/slot-api.contract"

// The signed-out page: the mark above a plain dark form, with a faint gradient wash.
component AuthStage
  props
    p: AuthStageProps
  slot
  view
    column position="relative" min-height="100dvh" width="100%" box-sizing="border-box" align-items="center" padding="max(48px, 12vh) 18px 48px" background-color="jellytwin.page" color="jellytwin.ink" color-scheme="dark" font-family="\"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" overflow="hidden"
      column position="absolute" left="-20%" right="-20%" top="-40%" height="80%" aria-hidden=true pointer-events="none" opacity=0.22 background-image="linear-gradient(90deg, var(--jellytwin.violet) 0%, var(--jellytwin.accent) 100%)" mask-image="radial-gradient(closest-side, black 0%, transparent 100%)"
      column position="relative" width="100%" max-width=420 gap=36 align-items="center" animation=riseIn(p.still)
        Wordmark(size=46)
        column width="100%" -exact-layout-transition=(p.still ? "none" : "300ms ease-out")
          children

// A signed-out moment with nothing to fill in: connecting, redeeming a web code, offline.
component AuthNotice
  props
    p: AuthNoticeProps
  view
    column gap=16 align-items="center" text-align="center" padding="12px 0px" role=(p.kind == "offline" ? "alert" : "status") animation=fadeIn(p.still)
      if p.kind == "offline"
        image "symbol:alert" width=40 height=40 color="jellytwin.danger" aria-hidden=true
        text t("ui.serverUnreachable") role="heading" aria-level=1 font-size=24 font-weight=600 color="jellytwin.ink-strong"
      else
        Spinner(size=48, still=p.still)
      text (p.kind == "offline" ? t("ui.yourServerCouldNotBeReachedReopenVelaWhenTheConnectionIsRestored") : p.kind == "redeeming" ? t("ui.signingYouIn") : t("ui.connectingToYourLibrary")) font-size=15 line-height=1.5 color="jellytwin.secondary"

component SignIn
  props
    p: SignInProps
  inject
    editUsername: action
    editPassword: action
    submit: action
    quick: action
  view
    column gap=8 animation=fadeIn(p.still)
      text t("jellytwin.pleaseSignIn") role="heading" aria-level=1 font-size=28 font-weight=500 color="jellytwin.ink-strong" text-align="center" margin-bottom=12
      if p.error != ""
        text p.error role="alert" font-size=14 line-height=1.45 color="jellytwin.ink-strong" padding="10px 12px" margin-bottom=8 border-radius=4 background-color="jellytwin.raised" border-left="4px solid var(--jellytwin.danger)"
      if p.passwordAvailable
        text t("jellytwin.user") class=FieldLabel
        input value=p.username input=editUsername autocomplete="username" autocapitalize="none" spellcheck=false aria-label=t("ui.username") testId="username" class=Field margin-bottom=10
        text t("ui.password") class=FieldLabel
        input type="password" value=p.password input=editPassword submit=submit autocomplete="current-password" aria-label=t("ui.password") testId="password" class=Field margin-bottom=18
        button press=submit disabled=(p.busy or p.username.trim() == "" or p.password == "") class=Submit testId="sign-in"
          text (p.busy ? t("ui.signingIn") : t("ui.signIn"))
      if p.quickAvailable
        button press=quick disabled=p.busy class=Raised height=46 testId="quick-connect" margin-top=12
          text t("jellytwin.quickConnect")
      if not p.passwordAvailable and not p.quickAvailable
        text t("ui.noSignInMethodsOffered") role="status" font-size=14 line-height=1.5 color="jellytwin.secondary" text-align="center"

style FieldLabel
  font-size = 14
  color = "jellytwin.secondary"

component QuickConnect
  props
    p: QuickConnectProps
  inject
    cancel: action
  view
    column gap=18 align-items="center" text-align="center" animation=fadeIn(p.still)
      text t("jellytwin.quickConnect") role="heading" aria-level=1 font-size=28 font-weight=500 color="jellytwin.ink-strong"
      text t("ui.approveThisCodeFromASignedInEtherDevice") font-size=15 line-height=1.5 color="jellytwin.secondary" max-width=320
      text p.model.code testId="connect-code" aria-label=p.model.code font-family="ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" font-size=44 font-weight=600 letter-spacing="0.18em" color="jellytwin.accent" padding="10px 18px" border-radius=6 background-color="jellytwin.raised"
      if p.error == ""
        Spinner(size=22, still=p.still)
      text (p.error == "" ? t("ui.waitingForApproval") : p.error) role="status" font-size=14 color=(p.error == "" ? "jellytwin.secondary" : "jellytwin.ink-strong")
      text t("ui.codeExpires", expiry=p.model.expiresLabel) font-size=13 color="jellytwin.quiet"
      button press=cancel class=Raised width="100%" height=46
        text t("ui.cancel")
