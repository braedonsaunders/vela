use Icon, IconBtn, Raised from "./look.contract"
use LiveControlsProps from "../../foundation/slot-api.contract"

// Live state over the player: the delivery mode, honest delivery states, low delay,
// catch-up and channel up/down, in the skin's popup surface.
component LiveControls
  props
    p: LiveControlsProps
  inject
    catchUp: action
    zap: action
  view
    column gap=10 padding="12px 14px" min-width=230 max-width=320 border-radius=6 background-color="jellytwin.popup" color="jellytwin.ink-strong" font-family="\"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" box-shadow="0px 8px 30px var(--jellytwin.shadow)"
      row gap=10 align-items="center"
        text t("live.liveBadge") font-size=10 font-weight=700 letter-spacing="0.06em" padding="2px 6px" border-radius=2 background-color="jellytwin.danger"
        column flex=1
        button press=zap(-1) aria-label=t("live.channelUp") class=IconBtn width=34 height=34
          Icon(name="symbol:icon.jelly-up", size=20)
        button press=zap(1) aria-label=t("live.channelDown") class=IconBtn width=34 height=34
          Icon(name="symbol:icon.jelly-down", size=20)
      if p.reconnecting
        text t("live.reconnecting") role="status" font-size=13 color="jellytwin.secondary"
      if p.delivery == "upstream-gap"
        text t("live.gap") role="status" font-size=13 color="jellytwin.secondary"
      if p.delivery == "segment-delayed"
        text t("live.delayed") role="status" font-size=13 color="jellytwin.secondary"
      if p.delivery == "waiting-for-publication"
        text t("live.publication") role="status" font-size=13 color="jellytwin.secondary"
      if p.drift > 0
        text t("live.behind", seconds=p.driftLabel) role="status" font-size=13 color="jellytwin.secondary" font-variant-numeric="tabular-nums"
      row gap=8 flex-wrap="wrap"
        if p.canCatchUp and p.drift > 0
          button press=catchUp class=Raised height=34 padding="0px 12px"
            text t("live.catchUp") font-size=13
