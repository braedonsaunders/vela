use PlayerView from "../../foundation/player-models.contract"
use PlayerProps from "../../foundation/slot-api.contract"

// The waiting ring's turn.
keyframes indexTurn
  from rotate=0
  to rotate=360

component PlayerChrome
  props
    p: PlayerProps
  inject
    command: action
    seek: action
    editing: action
    close: action
  derive shown = (p.visible or p.model.state != "playing")
  derive blocked = p.busy or p.model.state == "ended"
  derive hasSettings = p.model.audio.length > 1 or p.model.subtitles.length > 0 or p.model.qualities.length > 1 or p.model.paths.length > 1
  derive failure = (p.serverError != "" ? p.serverError : p.model.reason)
  action menuChanged(e: ToggleEvent)
    editing(e.newState == "open")
  action scrub(v: number)
    seek(v)
  action audio(v: string)
    command("audio", v)
  action subtitles(v: string)
    command("subtitle", v)
  action quality(v: string)
    command("quality", v)
  action delivery(v: string)
    command("switchPath", v)
  action chapter(v: string)
    match first(p.model.chapters.filter(c => c.id == v))
      case some(c)
        seek(c.seconds)
      case none
        editing(false)
  view
    column position="absolute" inset=0 pointer-events="none" color="index.on-video" font-family="Georgia, serif" justify-content="space-between" testId="player-chrome"
      row gap=18 padding=(p.small ? "20px 18px 54px" : "28px 36px 66px") align-items="flex-start" background-image="linear-gradient(180deg, var(--index.video-header), transparent)" opacity=(shown ? 1 : 0) inert=(not shown) transition=(p.still ? "none" : "opacity 180ms ease")
        button press=close pointer-events="auto" aria-label=t("ui.closePlayer") border="1px solid var(--index.video-line)" background-color="transparent" color="index.on-video" padding=8
          text t("ui.close")
        column gap=7 max-width=(p.small ? "50%" : "65%")
          image "assets/brand/vela-lockup.svg" alt=t("ui.vela") width=42 height=16
          text p.title font-size=(p.small ? 20 : 30) line-clamp=2
      if p.model.state == "failed" or p.serverError != ""
        column align-self="center" max-width="28rem" padding=24 gap=14 background-color="surface.glass" role="alert" testId="player-status"
          text t("ui.playbackInterrupted") font-size=26
          if failure != ""
            text failure font-size=14 line-height=1.5
          button press=command("retry", "") pointer-events="auto" border="1px solid var(--index.video-line)" background-color="transparent" color="index.on-video" padding="10px 18px"
            text t("ui.tryAgain")
      else
        if p.model.waiting or p.model.state == "loading" or p.model.state == "buffering" or p.model.state == "recovering"
          column align-self="center" width=40 height=40 box-sizing="border-box" border-radius=20 border="2px solid var(--index.video-line)" border-top-color="index.on-video" animation=(p.still ? "none" : "indexTurn 900ms linear infinite") role="status" aria-label=(p.model.state == "recovering" ? t("ui.recoveringPlayback") : t("ui.preparingPlayback")) testId="player-status"
      column gap=18 padding=(p.small ? "40px 18px 22px" : "64px 36px 30px") background-image="linear-gradient(0deg, var(--index.video-footer), transparent)" opacity=(shown ? 1 : 0) inert=(not shown) pointer-events=(shown ? "auto" : "none") transition=(p.still ? "none" : "opacity 180ms ease")
        if p.model.actionError != "" and failure == ""
          text p.model.actionError role="status" font-size=13
        row gap=14 align-items="center"
          text p.model.elapsed font-variant-numeric="tabular-nums" font-size=13
          input focus=editing(true) blur=editing(false) type="range" min=0 max=max(1, p.model.duration) step=0.1 value=p.model.position change=scrub disabled=(p.model.duration <= 0 or blocked) aria-label=t("ui.playbackPosition") testId="player-scrub" flex=1 min-width=0 accent-color="index.on-video"
          text p.model.remaining font-variant-numeric="tabular-nums" font-size=13
        row gap=18 align-items="center" flex-wrap="wrap"
          button disabled=(p.model.state == "ended") press=command(p.model.playing ? "pause" : "play", "") aria-label=(p.model.state == "ended" ? t("ui.finished") : p.model.playing ? t("ui.pause") : t("ui.play")) testId="player-toggle" padding="9px 18px" border="1px solid var(--index.video-line)" background-color="transparent" color="index.on-video"
            text (p.model.state == "ended" ? t("ui.finished") : p.model.playing ? t("ui.pause") : t("ui.play"))
          button disabled=blocked press=command("seekBy", "-10") aria-label=t("ui.back10Seconds") border="none" background-color="transparent" color="index.on-video" padding=6
            text t("ui.rewindAmount", seconds=formatNumber(10, "decimal"))
          button disabled=(blocked or p.model.duration <= 0) press=command("seekBy", "10") aria-label=t("ui.forward10Seconds") border="none" background-color="transparent" color="index.on-video" padding=6
            text t("ui.forwardAmount", seconds=formatNumber(10, "decimal"))
          text t("ui.pathQuality", path=p.model.path, quality=p.model.quality) flex=1 font-size=12 testId="player-quality"
          if p.model.pip
            button press=command("pip", "") aria-label=t("ui.pictureInPicture") border="none" background-color="transparent" color="index.on-video" padding=6
              text t("ui.pip")
          if p.model.fullscreen
            button press=command("fullscreen", "") aria-label=t("ui.fullscreen") border="none" background-color="transparent" color="index.on-video" padding=6
              text t("ui.fullscreen")
          if p.model.chapters.length > 0
            select disabled=blocked value="" change=chapter aria-label=t("ui.chapters")
              option value=""
                text t("ui.chapters")
              for item in p.model.chapters key=item.id
                option value=item.id
                  text item.label
          if hasSettings
            button popovertarget="index-player-settings" aria-label=t("ui.playbackSettings") testId="player-settings-button" border="none" background-color="transparent" color="index.on-video" padding=6
              text t("ui.tracksQuality")
      if hasSettings
        column id="index-player-settings" popover="auto" position="absolute" position-area="top span-left" margin-bottom=16 toggle=menuChanged pointer-events="auto" role="dialog" aria-label=t("ui.playbackSettings") width=(p.small ? "calc(100vw - 32px)" : 340) max-height="70vh" overflow-y="auto" box-sizing="border-box" padding=24 gap=16 border="1px solid var(--index.video-line)" background-color="index.video-ground" color="index.on-video"
          text t("ui.playbackSettings") font-size=24
          if p.model.audio.length > 1
            select disabled=blocked value=p.model.audioId change=audio aria-label=t("ui.audioTrack")
              for track in p.model.audio key=track.id
                option value=track.id
                  text track.label
          else
            text p.model.audioLabel font-size=13
          if p.model.subtitles.length > 0
            select disabled=blocked value=p.model.subtitleId change=subtitles aria-label=t("ui.subtitles") testId="player-subtitles"
              option value=""
                text t("ui.off")
              for track in p.model.subtitles key=track.id
                option value=track.id
                  text track.label
          if p.model.qualities.length > 1
            select disabled=blocked value=p.model.lockedQuality change=quality aria-label=t("ui.quality") testId="player-quality-select"
              option value=""
                text t("ui.autoAdaptToYourConnection")
              for quality in p.model.qualities key=quality.id
                option value=quality.id
                  text quality.label
          if p.model.paths.length > 1
            select disabled=blocked value=p.model.pathId change=delivery aria-label=t("ui.playbackPath") testId="player-path"
              for path in p.model.paths key=path.id
                option value=path.id
                  text path.label
