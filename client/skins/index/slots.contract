use Card, FeedRow, HomeModel, SearchModel, DetailModel, Viewport, cardName, LibraryNav, SkinManifest from "../../foundation/models.contract"
use SkinPicker from "../../foundation/skin-picker.contract"
use CollectionProps, DetailProps, HomeProps, LibraryProps, SearchFieldProps, SearchProps, ShellProps, StatusProps from "../../foundation/slot-api.contract"

fn detailPresentation(width: number): string = (width < 900 ? "fullscreen" : "")
fn detailSplit(width: number): string = (width < 900 ? "none" : "360")

component Navigation
  props
    viewer: string
    skin: string
    skins: SkinManifest[]
    chooseSkin: action
    signOut: action
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
    small: bool
    openPicker: action
  view
    row role="navigation" aria-label=t("ui.mainNavigation") flex-wrap="wrap" gap=12 align-items="center" padding=(small ? 12 : 20) background-color="index.rail"
      image "assets/brand/vela-lockup-paper.svg" alt=t("ui.vela") width=58 height=22
      if viewer != ""
        button press=home background-color="transparent" color="index.ink" border="none" padding=4
          text t("ui.home")
        button press=search background-color="transparent" color="index.ink" border="none" padding=4
          text t("ui.search")
      if canLive
        button press=live background-color="transparent" color="index.ink" border="none" padding=4
          text t("ui.live")
      if canLibrary
        button press=library background-color="transparent" color="index.ink" border="none" padding=4
          text t("ui.library")
      if skins.length > 1
        button press=openPicker testId="skin-picker" aria-haspopup="dialog" background-color="index.field" color="index.ink" border="1px solid var(--index.line)" padding="6px 12px"
          text t("skin.picker.choose") font-size=13
      vela-install pwaAction="install" buttonLabel=t("pwa.install")
      vela-install pwaAction="update" buttonLabel=t("pwa.update")
      if viewer != ""
        text viewer font-size=12
        button press=signOut background-color="transparent" color="index.ink" border="none" padding=4
          text t("ui.signOut")

component Shell
  props
    p: ShellProps
  inject
    chooseSkin: action
    signOut: action
    home: action
    search: action
    live: action
    library: action
    openLibrary: action
  slot
  state pickerOpen = false
  action openPicker
    pickerOpen = true
  action closePicker
    pickerOpen = false
    focus("skin-picker")
  action pickSkin(v: string)
    pickerOpen = false
    chooseSkin(v)
  view
    column position="relative" height="100%" min-height=0 background-color="index.page" color="index.ink" color-scheme="light" font-family="Georgia, serif"
      if p.viewport.width < 640
        Navigation(viewer=p.viewer, skin=p.skin, skins=p.skins, chooseSkin=chooseSkin, signOut=signOut, canLive=p.canLive, canLibrary=p.canLibrary, home=home, search=search, live=live, library=library, small=true, openPicker=openPicker)
        column flex=1 min-height=0
          children
      else
        row flex=1 min-height=0
          column width="11.25rem" flex-shrink=0 background-color="index.rail"
            Navigation(viewer=p.viewer, skin=p.skin, skins=p.skins, chooseSkin=chooseSkin, signOut=signOut, canLive=p.canLive, canLibrary=p.canLibrary, home=home, search=search, live=live, library=library, small=false, openPicker=openPicker)
          column flex=1 min-width=0 min-height=0
            children
      if pickerOpen
        SkinPicker(skins=p.skins, current=p.skin, small=p.viewport.width < 640, still=p.viewport.prefersReducedMotion, choose=pickSkin, dismiss=closePicker)

component SearchField
  props
    p: SearchFieldProps
  inject
    edit: action
  view
    row align-items="center" gap=12 border-bottom="2px solid var(--index.ink)" padding="8px 0px"
      text t("ui.search_a62a7") font-size=12 font-weight=700
      input value=p.query input=edit placeholder=t("ui.titlePersonOrDescription") aria-label=t("ui.searchYourLibrary") testId="search" flex=1 min-width=0 padding=8 border="none" background-color="transparent" color="index.ink"
      if p.query != ""
        button press=edit("") aria-label=t("ui.clearSearch") border="none" background-color="transparent" color="index.ink"
          text t("ui.clear")

component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    row intersect=observe(card.receipt) border-bottom="1px solid var(--index.line)" align-items="center" gap=12 padding="10px 0px"
      button press=selectTitle(card.id, card.kind, card.receipt) aria-label=cardName(card) testId=`title-${card.id}` flex=1 min-width=0 padding=4 border="none" background-color="transparent" color="index.ink" text-align="left"
        text card.name font-size=16 font-weight=600
      if not small
        text (card.kind == "movie" ? t("ui.film") : card.kind == "show" ? t("ui.series") : card.kind == "episode" ? t("ui.episode") : card.kind == "season" ? t("ui.season") : t("ui.collection")) width=80 font-size=12 color="index.secondary"
        text (card.year > 0 ? card.yearLabel : t("ui.symbol1b9379")) width=54 font-size=12 color="index.secondary"
        text card.rating width=50 font-size=12 color="index.secondary"
        text card.genres.join(", ") width=150 font-size=12 color="index.secondary" line-clamp=1
      else
        text card.facts width=100 font-size=12 color="index.secondary" line-clamp=1

component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column padding="20px 4%" gap=4
      text row.name role="heading" aria-level=2 font-size=24 font-weight=700
      for card in row.items key=card.id
        TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Home
  props
    p: HomeProps
  inject
    selectTitle: action
    observe: action
    pickHero: action
    reachEnd: action
    reachRowEnd: action
  slot
  view
    column background-color="index.page" color="index.ink"
      column padding="24px 4%" gap=18
        text t("ui.theViewingIndex") role="heading" aria-level=1 font-size=(p.small ? 28 : 42) font-weight=700
        children
        if p.query == ""
          for hero in p.model.hero.slice(p.heroIndex, p.heroIndex + 1) key=hero.id
            column gap=8 padding="16px 0px" intersect=observe(hero.receipt)
              text t("ui.featured") font-size=11 letter-spacing="2px"
              button press=selectTitle(hero.id, hero.kind, hero.receipt) aria-label=cardName(hero) background-color="transparent" color="index.ink" border="none" text-align="left" padding=0
                text hero.name font-size=26 font-weight=700
              text hero.facts font-size=12
              text hero.summary font-size=14 line-clamp=2
      if p.query == ""
        for row in p.model.rows key=row.id
          Row(row=row, small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
          if row.nextCursor != ""
            column height=1 intersect=reachRowEnd(row.id) intersect-margin="0px 0px 100% 0px" aria-hidden=true
            if p.rowMoreLoading.includes(row.id)
              text t("ui.loadingMore") role="status" color="index.secondary" padding="8px 4%"
        if p.model.nextCursor != ""
          column height=1 intersect=reachEnd intersect-margin="0px 0px 100% 0px" aria-hidden=true
          if p.homeMoreLoading
            text t("ui.loadingMore") role="status" color="index.secondary" padding="8px 4%"

component SearchSurface
  props
    p: SearchProps
  inject
    selectTitle: action
    observe: action
  view
    column gap=22 padding="0px 5% 40px"
      text t("ui.resultsForQuery", query=p.query) role="heading" aria-level=1 font-size=24
      if p.error
        text t("ui.searchIsUnavailableTryAnotherQuery") role="status" color="index.secondary"
      else
        if p.loading
          text t("ui.findingTitles") role="status" color="index.secondary"
        else
          if p.model.items.length == 0
            text t("ui.noTitleMatchesTryANameAMoodOrADifferentDescription") role="status" color="index.secondary"
          else
            Row(row=FeedRow(id="fast", name=t("ui.titleMatches"), receipt="", items=p.model.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
        if p.descriptive.query == p.query and p.descriptive.generation == p.generation and p.descriptive.items.length > 0
          Row(row=FeedRow(id="vibe", name=t("ui.theFeelingYouReLookingFor"), receipt="", items=p.descriptive.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
        if p.ai.query == p.query and p.ai.generation == p.generation and p.aiAvailable and p.ai.aiStatus != ""
          column gap=12
            text t("ui.aLittleFurtherAfield") role="heading" aria-level=2 font-size=22
            if p.ai.aiStatus == "queued" or p.ai.aiStatus == "running"
              text t("ui.exploringYourDescription") role="status" color="index.secondary"
            if p.ai.items.length > 0
              Row(row=FeedRow(id="ai", name=t("ui.discoveredForYou"), receipt="", items=p.ai.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
            if p.ai.aiStatus == "failed"
              text t("ui.discoveryCouldnTFinishYourTitleMatchesAreReadyAbove") color="index.secondary"

component Detail
  props
    p: DetailProps
  inject
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  view
    column gap=28 padding-bottom=48
      for title in p.model.title key=title.id
        row padding="32px 4%" gap=24 align-items="start"
          if not p.small and title.poster != ""
            image title.poster alt="" width=180 height=270 object-fit="cover"
          column flex=1 gap=16
            text (title.kind == "movie" ? t("ui.film") : title.kind == "show" ? t("ui.series") : title.kind == "episode" ? t("ui.episode") : t("ui.season")) font-size=11 letter-spacing="2px"
            text title.name role="heading" aria-level=1 font-size=(p.small ? 32 : 48) font-weight=700
            text title.facts font-size=13
            text title.summary font-size=16 line-height=1.6
            if p.model.canPlay
              button press=play(title.id) background-color="index.ink" color="index.page" border="none" padding="12px 20px" align-self="start" testId="detail-play"
                text (p.model.resumeSeconds > 0 ? t("ui.resumeWatching") : t("ui.play"))
      if p.model.seasons.length > 0
        Row(row=FeedRow(id="seasons", name=t("ui.seasons"), receipt="", items=p.model.seasons, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.model.episodes.length > 0
        Row(row=FeedRow(id="episodes", name=t("ui.episodes"), receipt="", items=p.model.episodes, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.model.extras.length > 0
        column padding="0px 7%" gap=14
          text t("ui.extras") role="heading" aria-level=2 font-size=24
          for extra in p.model.extras key=extra.id
            button press=playExtra(extra.id) disabled=(not extra.ready) background-color="index.rail" color="index.ink" border="none" padding=16 border-radius=0 text-align="left"
              text (extra.ready ? extra.name : t("ui.titleNotAvailable", title=extra.name))
      if p.model.cast.length > 0
        column padding="0px 7%" gap=12
          text t("ui.featuring") role="heading" aria-level=2 font-size=24
          text p.model.cast.join(" · ") color="index.secondary" line-height=1.6
      if p.model.crew.length > 0
        column padding="0px 7%" gap=12
          text t("ui.behindTheStory") role="heading" aria-level=2 font-size=24
          text p.model.crew.join(" · ") line-height=1.6
      if p.model.related.length > 0
        for related in p.model.related key=related.id
          Row(row=related, small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)

// Loading, empty and failure moments: the message, plainly.
component Status
  props
    p: StatusProps
  inject
    retry: action
  view
    column gap=12 padding=32 align-items="flex-start"
      text p.message role="status"
      if p.canRetry
        button press=retry() padding="8px 16px"
          text t("ui.tryAgain")

// A collection's titles in server order, under a way back.
component Collection
  props
    p: CollectionProps
  inject
    close: action
    selectTitle: action
    observe: action
  view
    column
      button press=close aria-label=t("ui.back") padding=16
        text t("ui.back")
      Row(row=FeedRow(id=p.id, name=p.name, receipt="", items=p.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)

// A library's titles in the server's order, a way back and a way to load more.
component Library
  props
    p: LibraryProps
  inject
    close: action
    more: action
    selectTitle: action
    observe: action
  view
    column
      button press=close aria-label=t("ui.back") padding=16
        text t("ui.back")
      Row(row=FeedRow(id=p.model.id, name=p.model.name, receipt="", items=p.model.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.model.more
        button press=more() disabled=p.moreLoading padding=16
          text t("library.loadMore")
