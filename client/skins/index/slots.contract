use Card, FeedRow, HomeModel, SearchModel, DetailModel from "../../foundation/models.contract"

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
  slot
  view
    row height="100%" min-height=0 background-color="#f3f0e8" color="#22221e" color-scheme="light" font-family="Georgia, serif"
      column width=150 flex-shrink=0 padding=20 gap=24 background-color="#e3dfd3"
        link href="/" color="#22221e" text-decoration="none" aria-label="Vela home"
          text "VELA / INDEX" font-size=18 font-weight=700
        link href="/" color="#22221e"
          text "Home"
        text viewer font-size=12
        button press=signOut background-color="transparent" color="#22221e" border="none" text-align="left" padding=0
          text "Sign out"
        if skins.length > 1
          select value=skin change=chooseSkin aria-label="Appearance" background-color="#ffffff" color="#22221e" padding=8
            for name in skins key=name
              option value=name
                text name
      column flex=1 min-width=0 min-height=0
        children

component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    row intersect=observe(card.receipt) border-bottom="1px solid #bcb8ae" align-items="center" gap=12 padding="10px 0px"
      button press=selectTitle(card.id, card.receipt) aria-label=`Details for ${card.name}` testId=`title-${card.id}` flex=1 min-width=0 padding=4 border="none" background-color="transparent" color="#22221e" text-align="left"
        text card.name font-size=16 font-weight=600
      if not small
        text card.kind width=90 font-size=12 color="#55554d"
      text card.facts width=(small ? 100 : 200) font-size=12 color="#55554d" line-clamp=1

component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column padding="20px 4%" gap=4
      text row.name role="heading" aria-level=2 font-size=24 font-weight=700
      for card in row.items key=card.id
        TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Home
  props
    model: HomeModel
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
  slot
  view
    column background-color="#f3f0e8" color="#22221e"
      column padding="24px 4%" gap=18
        text "THE VIEWING INDEX" role="heading" aria-level=1 font-size=(small ? 28 : 42) font-weight=700
        children
        if query == ""
          for hero in model.hero key=hero.id
            column gap=8 padding="16px 0px" intersect=observe(hero.receipt)
              text "FEATURED" font-size=11 letter-spacing="2px"
              button press=selectTitle(hero.id, hero.receipt) background-color="transparent" color="#22221e" border="none" text-align="left" padding=0
                text hero.name font-size=26 font-weight=700
              text hero.facts font-size=12
              text hero.summary font-size=14 line-clamp=2
      if query == ""
        for row in model.rows key=row.id
          Row(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component SearchSurface
  props
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column gap=22 padding="0px 5% 40px"
      if error
        text "Search is unavailable. Try another query." role="status" color="#55554d"
      else
        if loading
          text "Finding titles…" role="status" color="#55554d"
        else
          if model.items.length == 0
            text "No title matches. Try a name, a mood or a different description." role="status" color="#55554d"
          else
            Row(row=FeedRow(id="fast", name="Title matches", receipt="", items=model.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if descriptive.query == query and descriptive.generation == generation and descriptive.items.length > 0
          Row(row=FeedRow(id="vibe", name="The feeling you're looking for", receipt="", items=descriptive.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if ai.query == query and ai.generation == generation and aiAvailable and ai.aiStatus != ""
          column gap=12
            text "A little further afield" role="heading" aria-level=2 font-size=22
            if ai.aiStatus == "queued" or ai.aiStatus == "running"
              text "Exploring your description…" role="status" color="#55554d"
            if ai.items.length > 0
              Row(row=FeedRow(id="ai", name="Discovered for you", receipt="", items=ai.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
            if ai.aiStatus == "failed"
              text "Discovery couldn't finish. Your title matches are ready above." color="#55554d"

component Detail
  props
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  view
    column gap=28 padding-bottom=48
      for title in model.title key=title.id
        row padding="32px 4%" gap=24 align-items="start"
          if not small and title.poster != ""
            image title.poster alt="" width=180 height=270 object-fit="cover"
          column flex=1 gap=16
            text title.kind font-size=11 letter-spacing="2px"
            text title.name role="heading" aria-level=1 font-size=(small ? 32 : 48) font-weight=700
            text title.facts font-size=13
            text title.summary font-size=16 line-height=1.6
            if model.canPlay
              button press=play(title.id) background-color="#22221e" color="#f3f0e8" border="none" padding="12px 20px" align-self="start" testId="detail-play"
                text (model.resumeSeconds > 0 ? "Resume watching" : "Play")
      if model.seasons.length > 0
        Row(row=FeedRow(id="seasons", name="Seasons", receipt="", items=model.seasons), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if model.episodes.length > 0
        Row(row=FeedRow(id="episodes", name="Episodes", receipt="", items=model.episodes), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if model.extras.length > 0
        column padding="0px 7%" gap=14
          text "Extras" role="heading" aria-level=2 font-size=24
          for extra in model.extras key=extra.id
            button press=playExtra(extra.id) disabled=(not extra.ready) background-color="#e3dfd3" color="#22221e" border="none" padding=16 border-radius=0 text-align="left"
              text `${extra.name}${extra.ready ? "" : " · Not available"}`
      if model.cast.length > 0
        column padding="0px 7%" gap=12
          text "Featuring" role="heading" aria-level=2 font-size=24
          text model.cast.join(" · ") color="#55554d" line-height=1.6

component PlayerChrome
  props
    titleId: string
    command: action
  view
    row padding=20 gap=14 flex-wrap="wrap" justify-content="center" background-color="#e3dfd3"
      button press=command("play") aria-label="Play" buttonStyle="bordered"
        text "Play"
      button press=command("pause") aria-label="Pause" buttonStyle="bordered"
        text "Pause"
      button press=command("pip") aria-label="Picture in picture" buttonStyle="bordered"
        text "Picture in picture"
      button press=command("fullscreen") aria-label="Fullscreen" buttonStyle="bordered"
        text "Fullscreen"

component Guide
  view
    column padding=24
      text "Live guide is not available." role="status" color="#55554d"
