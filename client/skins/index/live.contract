component LiveControls
  props
    lowDelay: bool
    reconnecting: bool
    delivery: string
    drift: number
    driftLabel: string
    canCatchUp: bool
    toggleLowDelay: action
    catchUp: action
  view
    column gap=8 padding=14 background-color="#f3f0e8" color="#22221e" color-scheme="light" font-family="Georgia, serif" border-top="3px solid #813b31" max-width=360
      row gap=16 align-items="baseline"
        text t("live.index") font-family="system-ui, sans-serif" font-size=9 letter-spacing="1px"
        text (lowDelay ? t("live.lowDelay") : t("live.adaptive")) font-size=12 font-weight=700
      if reconnecting
        text t("live.reconnecting") role="status" font-size=12
      if delivery == "upstream-gap"
        text t("live.gap") role="status" font-size=12 color="#813b31"
      if delivery == "segment-delayed"
        text t("live.delayed") role="status" font-size=12
      if delivery == "waiting-for-publication"
        text t("live.publication") role="status" font-size=12
      if drift > 0
        text t("live.behind", seconds=driftLabel) font-size=11 color="#55554d"
      row gap=12 flex-wrap="wrap"
        button press=toggleLowDelay aria-pressed=lowDelay border="1px solid #bcb8ae" padding="8px 10px" background-color="transparent" color="#22221e"
          text t("live.lowDelay") font-size=12
        if canCatchUp and drift > 0
          button press=catchUp border="none" border-bottom="1px solid #22221e" padding="8px 0px" background-color="transparent" color="#22221e"
            text t("live.catchUp") font-size=12
