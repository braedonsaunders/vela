component LiveControls
  props
    lowDelay: bool
    reconnecting: bool
    delivery: string
    drift: number
    driftLabel: string
    canCatchUp: bool
    toggleLowDelay: action
    catchUp: action
  view
    column gap=8 padding=14 background-color="index.page" color="index.ink" color-scheme="light" font-family="Georgia, serif" border-top="3px solid var(--index.accent)" max-width=360
      row gap=16 align-items="baseline"
        text t("live.index") font-family="system-ui, sans-serif" font-size=9 letter-spacing="1px"
        text (lowDelay ? t("live.lowDelay") : t("live.adaptive")) font-size=12 font-weight=700
      if reconnecting
        text t("live.reconnecting") role="status" font-size=12
      if delivery == "upstream-gap"
        text t("live.gap") role="status" font-size=12 color="index.accent"
      if delivery == "segment-delayed"
        text t("live.delayed") role="status" font-size=12
      if delivery == "waiting-for-publication"
        text t("live.publication") role="status" font-size=12
      if drift > 0
        text t("live.behind", seconds=driftLabel) font-size=11 color="index.secondary"
      row gap=12 flex-wrap="wrap"
        button press=toggleLowDelay aria-pressed=lowDelay border="1px solid var(--index.line)" padding="8px 10px" background-color="transparent" color="index.ink"
          text t("live.lowDelay") font-size=12
        if canCatchUp and drift > 0
          button press=catchUp border="none" border-bottom="1px solid var(--index.ink)" padding="8px 0px" background-color="transparent" color="index.ink"
            text t("live.catchUp") font-size=12
