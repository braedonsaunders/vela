use GuideModel from "../../live/models.contract"
use GuideProps from "../../foundation/slot-api.contract"

component Guide
  props
    p: GuideProps
  inject
    watch: action
    previous: action
    next: action
  state selectedChannel = ""
  state selectedProgramme = ""
  action choose(channel: string, programme: string)
    selectedChannel = channel
    selectedProgramme = programme
    focus("index-programme")
  action dismiss
    let id = selectedProgramme
    selectedProgramme = ""
    focus(`guide-${id}`)
  action detailKey(k: string)
    if k == "Escape"
      preventDefault()
      dismiss()
  action move(channel: string, airing: bool, leftId: string, rightId: string, upId: string, downId: string, k: string, event: KeyboardEvent)
    if not event.metaKey and not event.ctrlKey and not event.altKey and not event.isComposing
      if k == "Enter" and airing
        preventDefault()
        watch(channel)
      if k == "ArrowLeft" or k == "ArrowRight" or k == "ArrowUp" or k == "ArrowDown"
        preventDefault()
        let target = (k == "ArrowLeft" ? leftId : (k == "ArrowRight" ? rightId : (k == "ArrowUp" ? upId : downId)))
        if target != ""
          focus(target)
  view
    scroll flex=1 min-height=0
      column padding=(p.small ? "24px 16px 40px" : "32px 4% 48px") gap=20 background-color="index.page" color="index.ink" color-scheme="light" font-family="Georgia, serif"
        column gap=8 border-bottom="3px solid var(--index.ink)" padding-bottom=20
          text t("live.index") font-size=10 letter-spacing="2px" font-family="system-ui, sans-serif"
          text t("live.schedule") role="heading" aria-level=1 font-size=(p.small ? 30 : 44) font-weight=700
          row gap=16 align-items="center" flex-wrap="wrap"
            text t("ui.startEnd_72d28", start=p.model.fromLabel, end=p.model.untilLabel) font-size=13 flex=1 font-variant-numeric="tabular-nums"
            button press=previous aria-label=t("live.previous") border="1px solid var(--index.line)" padding="8px 12px" background-color="transparent" color="index.ink"
              text t("live.previous") font-size=12
            button press=next aria-label=t("live.next") border="1px solid var(--index.line)" padding="8px 12px" background-color="transparent" color="index.ink"
              text t("live.next") font-size=12
        for channel in p.model.channels.filter(c => c.id == selectedChannel) key=`details-${channel.id}`
          for programme in channel.programmes.filter(entry => entry.id == selectedProgramme) key=programme.id
            column id="index-programme" tabindex=-1 key=detailKey role="region" aria-label=programme.name gap=10 padding=20 background-color="index.rail" border-left="3px solid var(--index.accent)"
              text channel.name font-size=11 font-family="system-ui, sans-serif" color="index.secondary"
              text programme.name font-size=24 font-weight=700
              text t("ui.startEnd_72d28", start=programme.startLabel, end=programme.endLabel) font-size=13
              if programme.summary != ""
                text programme.summary font-size=14 line-height=1.5
              row gap=18 align-items="center" flex-wrap="wrap"
                if programme.airing
                  button press=watch(channel.id) background-color="index.ink" color="index.page" border="none" padding="10px 16px"
                    text t("live.watch")
                else
                  text (programme.ended ? t("live.ended") : t("live.startsIn", minutes=programme.startsInLabel)) font-size=13
                button press=dismiss background-color="transparent" color="index.ink" border="none" padding=8
                  text t("live.close") font-size=12
        if p.model.channels.length == 0
          text t("live.noChannels") role="status" font-size=14
        column role="grid" aria-label=t("live.schedule") gap=0
          if not p.small
            row border-bottom="1px solid var(--index.ink)" padding="8px 0px" gap=20 font-family="system-ui, sans-serif" font-size=10 color="index.secondary" letter-spacing="1px"
              text t("live.channel") width=168 flex-shrink=0
              text t("live.time") width=132 flex-shrink=0
              text t("live.programme") flex=1
          for channel in p.model.channels key=channel.id
            column border-bottom="1px solid var(--index.ink)"
              row gap=(p.small ? 8 : 20) padding="12px 0px" align-items="start" flex-wrap=(p.small ? "wrap" : "nowrap")
                button press=watch(channel.id) aria-label=channel.name width=(p.small ? "100%" : "168px") box-sizing="border-box" flex-shrink=0 padding=0 border="none" background-color="transparent" color="index.ink" text-align="left"
                  row gap=10 align-items="center"
                    text channel.number font-size=12 width=28 color="index.secondary" font-variant-numeric="tabular-nums"
                    column gap=4 flex=1
                      text (channel.favorite ? t("ui.channel", channel=channel.name) : channel.name) font-size=15 font-weight=700
                      if p.small
                        text (channel.now == "" ? t("live.noProgrammes") : `${t("live.now")} · ${channel.now}`) font-size=12 color="index.secondary"
                        if channel.next != ""
                          text t("ui.nextProgramme_30572", programme=channel.next) font-size=11 color="index.secondary"
                column flex=1 min-width=0 width=(p.small ? "100%" : "auto")
                  if channel.programmes.length == 0
                    text t("live.noProgrammes") font-size=12 color="index.secondary" padding=8
                  for programme in channel.programmes key=programme.id
                    button id=`guide-${programme.id}` key=move(channel.id, programme.airing, programme.leftId, programme.rightId, programme.upId, programme.downId) press=choose(channel.id, programme.id) aria-label=t("ui.timeProgramme", time=programme.startLabel, programme=programme.name) width="100%" box-sizing="border-box" padding="10px 0px" border="none" border-bottom="1px solid var(--index.separator)" background-color=(programme.airing ? "index.airing" : "transparent") color="index.ink" text-align="left" opacity=(programme.ended ? 0.5 : 1)
                      row gap=(p.small ? 10 : 20) align-items="baseline"
                        text programme.startLabel width=(p.small ? 74 : 132) flex-shrink=0 font-size=12 font-variant-numeric="tabular-nums" color="index.secondary"
                        column flex=1 min-width=0 gap=4
                          text programme.name font-size=(p.small ? 14 : 16) font-weight=(programme.airing ? 700 : 400)
                          if p.small
                            text (programme.airing ? t("live.onAir") : programme.ended ? t("live.ended") : t("live.upcoming")) font-size=10 font-family="system-ui, sans-serif" color=(programme.airing ? "index.accent" : "index.secondary")
                        if not p.small
                          text (programme.airing ? t("live.onAir") : programme.ended ? t("live.ended") : t("live.upcoming")) width=72 font-size=10 font-family="system-ui, sans-serif" color=(programme.airing ? "index.accent" : "index.secondary")
