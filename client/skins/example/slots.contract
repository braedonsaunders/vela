use CollectionProps, DetailProps, HomeProps, LibraryProps, SearchFieldProps, SearchProps, ShellProps, StatusProps from "../../foundation/slot-api.contract"
// Minimal complete example: plain lists, no requests, ordering or playback engine.
use Card, FeedRow, HomeModel, SearchModel, DetailModel, Viewport, cardName, LibraryNav from "../../foundation/models.contract"
use SkinPicker from "../../foundation/skin-picker.contract"
use PlayerChrome from "../index/player.contract"
use Guide from "../index/guide.contract"
use LiveControls from "../index/live.contract"

fn detailPresentation(width: number): string = "fullscreen"
fn detailSplit(width: number): string = "none"

component Shell
  props
    p: ShellProps
  inject
    chooseSkin: action
    signOut: action
    home: action
    search: action
    live: action
    library: action
    openLibrary: action
  slot
  state pickerOpen = false
  action openPicker
    pickerOpen = true
  action closePicker
    pickerOpen = false
    focus("skin-picker")
  action pickSkin(v: string)
    pickerOpen = false
    chooseSkin(v)
  view
    column position="relative" height="100%" color="ink.primary" background-color="surface.page" gap=12
      row role="navigation" aria-label=t("ui.mainNavigation") gap=12 padding=16 flex-wrap="wrap"
        text t("example.name") role="heading" aria-level=1
        if p.viewer != ""
          button press=home
            text t("ui.home")
          button press=search
            text t("ui.search")
          if p.canLive
            button press=live
              text t("ui.live")
          button press=openPicker testId="skin-picker" aria-haspopup="dialog"
            text t("skin.picker.choose")
          button press=signOut
            text t("ui.signOut")
      children
      if pickerOpen
        SkinPicker(skins=p.skins, current=p.skin, small=p.viewport.width < 640, still=p.viewport.prefersReducedMotion, choose=pickSkin, dismiss=closePicker)

component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    row intersect=observe(card.receipt) gap=12 padding="10px 0px"
      button press=selectTitle(card.id, card.kind, card.receipt) aria-label=cardName(card) testId=`title-${card.id}` flex=1
        text card.name
      text card.facts

component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column padding=16 gap=8
      text row.name role="heading" aria-level=2
      for card in row.items key=card.id
        TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Home
  props
    p: HomeProps
  inject
    selectTitle: action
    observe: action
    pickHero: action
    reachEnd: action
    reachRowEnd: action
  slot
  view
    column padding=16 gap=16
      text t("example.heading") role="heading" aria-level=1
      children
      if p.query == ""
        for row in p.model.rows key=row.id
          Row(row=row, small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
          if row.nextCursor != ""
            column height=1 intersect=reachRowEnd(row.id) intersect-margin="0px 0px 100% 0px" aria-hidden=true
            if p.rowMoreLoading.includes(row.id)
              text t("ui.loadingMore") role="status" color="ink.secondary" padding="8px 4%"
        if p.model.nextCursor != ""
          column height=1 intersect=reachEnd intersect-margin="0px 0px 100% 0px" aria-hidden=true
          if p.homeMoreLoading
            text t("ui.loadingMore") role="status" color="ink.secondary" padding="8px 4%"

component SearchField
  props
    p: SearchFieldProps
  inject
    edit: action
  view
    input value=p.query input=edit aria-label=t("ui.searchYourLibrary") placeholder=t("ui.titlePersonOrDescription") testId="search"

component SearchSurface
  props
    p: SearchProps
  inject
    selectTitle: action
    observe: action
  view
    column padding=16 gap=12
      text t("ui.resultsForQuery", query=p.query) role="heading" aria-level=1
      if p.error
        text t("ui.searchIsUnavailableTryAnotherQuery") role="status"
      else
        if p.loading
          text t("ui.findingTitles") role="status"
        else
          Row(row=FeedRow(id="fast", name=t("ui.titleMatches"), receipt="", items=p.model.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.descriptive.query == p.query and p.descriptive.generation == p.generation
        Row(row=FeedRow(id="vibe", name=t("ui.theFeelingYouReLookingFor"), receipt="", items=p.descriptive.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.aiAvailable and p.ai.query == p.query and p.ai.generation == p.generation
        if p.ai.aiStatus == "running" or p.ai.aiStatus == "queued"
          text t("ui.exploringYourDescription") role="status"
        if p.ai.items.length > 0
          Row(row=FeedRow(id="ai", name=t("ui.discoveredForYou"), receipt="", items=p.ai.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)

component Detail
  props
    p: DetailProps
  inject
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  view
    column padding=24 gap=16
      for title in p.model.title key=title.id
        text title.name role="heading" aria-level=1
        text title.facts
        text title.summary
        if p.model.canPlay
          button press=play(title.id)
            text (p.model.resumeSeconds > 0 ? t("ui.resumeWatching") : t("ui.play"))
      if p.model.seasons.length > 0
        Row(row=FeedRow(id="seasons", name=t("ui.seasons"), receipt="", items=p.model.seasons, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.model.episodes.length > 0
        Row(row=FeedRow(id="episodes", name=t("ui.episodes"), receipt="", items=p.model.episodes, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      for extra in p.model.extras key=extra.id
        button press=playExtra(extra.id) disabled=(not extra.ready)
          text extra.name
      for row in p.model.related key=row.id
        Row(row=row, small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)

// Loading, empty and failure moments: the message, plainly.
component Status
  props
    p: StatusProps
  inject
    retry: action
  view
    column gap=12 padding=32 align-items="flex-start"
      text p.message role="status"
      if p.canRetry
        button press=retry() padding="8px 16px"
          text t("ui.tryAgain")

// A collection's titles in server order, under a way back.
component Collection
  props
    p: CollectionProps
  inject
    close: action
    selectTitle: action
    observe: action
  view
    column
      button press=close aria-label=t("ui.back") padding=16
        text t("ui.back")
      Row(row=FeedRow(id=p.id, name=p.name, receipt="", items=p.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)

// A library's titles in the server's order, a way back and a way to load more.
component Library
  props
    p: LibraryProps
  inject
    close: action
    more: action
    selectTitle: action
    observe: action
  view
    column
      button press=close aria-label=t("ui.back") padding=16
        text t("ui.back")
      Row(row=FeedRow(id=p.model.id, name=p.model.name, receipt="", items=p.model.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)
      if p.model.more
        button press=more() disabled=p.moreLoading padding=16
          text t("library.loadMore")
