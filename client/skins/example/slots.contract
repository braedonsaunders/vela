// Minimal complete example: plain lists, no requests, ordering or playback engine.
use Card, FeedRow, HomeModel, SearchModel, DetailModel, Viewport, cardName, skinLabel, LibraryNav from "../../foundation/models.contract"
use PlayerView from "../../foundation/player-models.contract"
use GuideModel from "../../live/models.contract"
use PlayerChrome as BasePlayer from "../index/player.contract"
use Guide as BaseGuide from "../index/guide.contract"
use LiveControls as BaseLive from "../index/live.contract"

fn detailPresentation(width: number): string = "fullscreen"
fn detailSplit(width: number): string = "none"

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
    viewport: Viewport
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
    libraries: LibraryNav[]
    section: string
    openLibrary: action
  slot
  view
    column height="100%" color="ink.primary" background-color="surface.page" gap=12
      row role="navigation" aria-label=t("ui.mainNavigation") gap=12 padding=16 flex-wrap="wrap"
        text t("example.name") role="heading" aria-level=1
        if viewer != ""
          button press=home
            text t("ui.home")
          button press=search
            text t("ui.search")
          if canLive
            button press=live
              text t("ui.live")
          select value=skin change=chooseSkin aria-label=t("ui.appearance")
            for id in skins key=id
              option value=id
                text skinLabel(id)
          button press=signOut
            text t("ui.signOut")
      children

component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    row intersect=observe(card.receipt) gap=12 padding="10px 0px"
      button press=selectTitle(card.id, card.kind, card.receipt) aria-label=cardName(card) testId=`title-${card.id}` flex=1
        text card.name
      text card.facts

component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column padding=16 gap=8
      text row.name role="heading" aria-level=2
      for card in row.items key=card.id
        TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Home
  props
    model: HomeModel
    active: bool
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
    heroIndex: number
    pickHero: action
  slot
  view
    column padding=16 gap=16
      text t("example.heading") role="heading" aria-level=1
      children
      if query == ""
        for row in model.rows key=row.id
          Row(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component SearchField
  props
    query: string
    edit: action
  view
    input value=query input=edit aria-label=t("ui.searchYourLibrary") placeholder=t("ui.titlePersonOrDescription") testId="search"

component SearchSurface
  props
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column padding=16 gap=12
      text t("ui.resultsForQuery", query=query) role="heading" aria-level=1
      if error
        text t("ui.searchIsUnavailableTryAnotherQuery") role="status"
      else
        if loading
          text t("ui.findingTitles") role="status"
        else
          Row(row=FeedRow(id="fast", name=t("ui.titleMatches"), receipt="", items=model.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if descriptive.query == query and descriptive.generation == generation
        Row(row=FeedRow(id="vibe", name=t("ui.theFeelingYouReLookingFor"), receipt="", items=descriptive.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if aiAvailable and ai.query == query and ai.generation == generation
        if ai.aiStatus == "running" or ai.aiStatus == "queued"
          text t("ui.exploringYourDescription") role="status"
        if ai.items.length > 0
          Row(row=FeedRow(id="ai", name=t("ui.discoveredForYou"), receipt="", items=ai.items), small=small, still=still, selectTitle=selectTitle, observe=observe)

component Detail
  props
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  view
    column padding=24 gap=16
      for title in model.title key=title.id
        text title.name role="heading" aria-level=1
        text title.facts
        text title.summary
        if model.canPlay
          button press=play(title.id)
            text (model.resumeSeconds > 0 ? t("ui.resumeWatching") : t("ui.play"))
      if model.seasons.length > 0
        Row(row=FeedRow(id="seasons", name=t("ui.seasons"), receipt="", items=model.seasons), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if model.episodes.length > 0
        Row(row=FeedRow(id="episodes", name=t("ui.episodes"), receipt="", items=model.episodes), small=small, still=still, selectTitle=selectTitle, observe=observe)
      for extra in model.extras key=extra.id
        button press=playExtra(extra.id) disabled=(not extra.ready)
          text extra.name
      for row in model.related key=row.id
        Row(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component PlayerChrome
  props
    model: PlayerView
    title: string
    visible: bool
    small: bool
    still: bool
    busy: bool
    serverError: string
    command: action
    seek: action
    editing: action
    close: action
  view
    BasePlayer(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close)

component Guide
  props
    model: GuideModel
    small: bool
    watch: action
    previous: action
    next: action
  view
    BaseGuide(model=model, small=small, watch=watch, previous=previous, next=next)

component LiveControls
  props
    lowDelay: bool
    reconnecting: bool
    delivery: string
    drift: number
    driftLabel: string
    canCatchUp: bool
    toggleLowDelay: action
    catchUp: action
  view
    BaseLive(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp)
