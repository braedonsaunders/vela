use QuickModel from "../../foundation/models.contract"
use Display, Eyebrow, Glass, PrimaryPill, GhostPill, Field, enter, base, glide, breathe, auroraA, auroraB, auroraC, vanish from "./look.contract"
use AuthNoticeProps, AuthStageProps, QuickConnectProps, SignInProps from "../../foundation/slot-api.contract"

// The Vela lockup: the searchlight V beside the monoline name, one image asset
// (brand/build.mjs draws it). `size` is its height.
component Wordmark
  props
    size: number
  view
    image "assets/brand/vela-lockup.svg" alt="" width=(size * 2.629) height=size aria-hidden=true

// The stage every signed-out state stands on: drifting light, a vignette and
// grain behind a centred glass card that resizes as its content changes.
component AuthStage
  props
    p: AuthStageProps
  slot
  view
    column position="relative" min-height="100dvh" width="100%" box-sizing="border-box" overflow="hidden" align-items="center" justify-content="center" padding="max(28px, 7vh) 16px" background-color="surface.page" -exact-exit-animation=(p.still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      column position="absolute" inset=0 aria-hidden=true pointer-events="none"
        if p.backdrop != ""
          image p.backdrop alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="cover"
        column position="absolute" width="72vmax" height="72vmax" left="-22vmax" top="-30vmax" border-radius="50%" opacity=0.5 background-image="radial-gradient(circle, var(--cinematic.ember) 0%, var(--cinematic.scrim-clear) 68%)" animation=(p.still ? "none" : "auroraA 34s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
        column position="absolute" width="80vmax" height="80vmax" right="-30vmax" bottom="-42vmax" border-radius="50%" opacity=0.55 background-image="radial-gradient(circle, var(--cinematic.tide) 0%, var(--cinematic.scrim-clear) 66%)" animation=(p.still ? "none" : "auroraB 41s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
        column position="absolute" width="54vmax" height="54vmax" left="34%" top="18%" border-radius="50%" opacity=0.35 background-image="radial-gradient(circle, var(--cinematic.dusk) 0%, var(--cinematic.scrim-clear) 70%)" animation=(p.still ? "none" : "auroraC 47s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
        column position="absolute" inset=0 background-image="radial-gradient(ellipse 110% 85% at 50% 42%, var(--cinematic.scrim-clear) 35%, var(--cinematic.vignette) 100%)"
        image "assets/grain.svg" alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="fill" opacity=0.06
      column position="relative" width="100%" max-width=448 gap=32 align-items="center" animation=enter(p.still, 0)
        if p.wordmark != ""
          image p.wordmark alt="" height=56 width="auto" max-width="100%" aria-hidden=true
        else
          image "assets/brand/vela-stacked.svg" alt="" width=60 height=104 aria-hidden=true
        column class=Glass width="100%" box-sizing="border-box" padding="clamp(28px, 5vw, 44px) clamp(22px, 4.5vw, 40px)" border-radius="cinematic.radius-panel" box-shadow="0px 40px 120px var(--cinematic.card-shadow), inset 0px 1px 0px var(--cinematic.ring)" -exact-layout-transition=(p.still ? "none" : "560ms ease-out")
          children

// A signed-out moment with nothing to fill in: connecting, redeeming a web code, offline.
component AuthNotice
  props
    p: AuthNoticeProps
  view
    column gap=18 align-items="center" text-align="center" padding="12px 0px" role=(p.kind == "offline" ? "alert" : "status") animation=enter(p.still, 0) -exact-exit-animation=(p.still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      if p.kind == "offline"
        image "symbol:alert" width=28 height=28 color="brand.warm" aria-hidden=true
        text t("ui.serverUnreachable") role="heading" aria-level=1 class=Display font-size=34
        text t("ui.yourServerCouldNotBeReachedReopenVelaWhenTheConnectionIsRestored") color="ink.secondary" font-size=15 line-height=1.55
      else
        Pulse(still=p.still)
        text (p.kind == "redeeming" ? t("ui.signingYouIn") : t("ui.connectingToYourLibrary")) color="ink.secondary" font-size=15

// Three soft lights that breathe in turn: the skin's indeterminate progress.
component Pulse
  props
    still: bool
  view
    row gap=8 aria-hidden=true
      for i in [0, 1, 2] key=`${i}`
        column width=7 height=7 border-radius=4 background-color="brand.warm" opacity=(still ? 0.8 : 1) animation=(still ? "none" : `breathe 1.4s cubic-bezier(0.45, 0, 0.55, 1) ${i * 180}ms infinite`)

component SignIn
  props
    p: SignInProps
  inject
    editUsername: action
    editPassword: action
    submit: action
    quick: action
    goSecure: action
  view
    column gap=26 animation=enter(p.still, 60) -exact-exit-animation=(p.still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      column gap=10
        text t("ui.welcomeToYourEvening") role="heading" aria-level=1 class=Display font-size=42
        text t("ui.signInToYourLibrary") color="ink.secondary" font-size=15 line-height=1.5
      // The server also answers at an HTTPS address: offer it before a password is typed here.
      if p.secureOrigin != ""
        column gap=12 padding=16 border-radius=16 background-color="cinematic.secure" border="1px solid var(--cinematic.secure-edge)" animation=enter(p.still, 120)
          row gap=10 align-items="center"
            image "symbol:lock" width=16 height=16 color="brand.warm" aria-hidden=true
            text t("secure.title") font-size=14 font-weight=650
          text t("secure.body", origin=p.secureOrigin) font-size=13 line-height=1.5 color="ink.secondary"
          button press=goSecure disabled=p.secureBusy testId="secure-switch" class=GhostPill height=42 padding-left=18 padding-right=18 align-self="flex-start"
            row gap=10 align-items="center"
              if p.secureBusy
                Pulse(still=p.still)
              text t("secure.action") font-size=14
          if p.secureError != ""
            text p.secureError role="alert" font-size=12 color="brand.warm"
      if p.error != ""
        row role="alert" gap=10 align-items="flex-start" padding="12px 14px" border-radius=14 background-color="cinematic.alert" border="1px solid var(--cinematic.alert-edge)" animation=enter(p.still, 0)
          image "symbol:alert" width=18 height=18 color="brand.warm" flex-shrink=0 aria-hidden=true
          text p.error color="ink.primary" font-size=14 line-height=1.45
      if p.passwordAvailable
        column gap=16
          column gap=8
            text t("ui.username") class=Eyebrow font-size=10 color="ink.quiet"
            input value=p.username input=editUsername autocomplete="username" autocapitalize="none" spellcheck=false aria-label=t("ui.username") testId="username" class=Field transition=`border-color 180ms linear, box-shadow ${base()}ms ${glide()}`
          column gap=8
            text t("ui.password") class=Eyebrow font-size=10 color="ink.quiet"
            input type="password" value=p.password input=editPassword submit=submit autocomplete="current-password" aria-label=t("ui.password") testId="password" class=Field transition=`border-color 180ms linear, box-shadow ${base()}ms ${glide()}`
          button press=submit disabled=(p.busy or p.username.trim() == "" or p.password == "") class=PrimaryPill height=52 margin-top=6 testId="sign-in" transition=`background-color 180ms linear, opacity 180ms linear, scale ${base()}ms ${glide()}`
            row gap=10 align-items="center" justify-content="center"
              if p.busy
                Pulse(still=p.still)
              text (p.busy ? t("ui.signingIn") : t("ui.signIn")) font-size=15 font-weight=650
      if p.passwordAvailable and p.quickAvailable
        row gap=14 align-items="center" aria-hidden=true
          column flex=1 height=1 background-color="cinematic.glass-edge"
          text t("ui.or") font-size=12 color="ink.quiet"
          column flex=1 height=1 background-color="cinematic.glass-edge"
      if p.quickAvailable
        button press=quick disabled=p.busy class=GhostPill height=52 testId="quick-connect" transition=`background-color 180ms linear, border-color 180ms linear, scale ${base()}ms ${glide()}`
          row gap=10 align-items="center" justify-content="center"
            image "symbol:smartphone" width=18 height=18 aria-hidden=true
            text t("ui.connectWithACode") font-size=15
      if not p.passwordAvailable and not p.quickAvailable
        text t("ui.noSignInMethodsOffered") role="status" color="ink.secondary" font-size=14 line-height=1.55

component QuickConnect
  props
    p: QuickConnectProps
  inject
    cancel: action
  view
    column gap=26 align-items="center" text-align="center" animation=enter(p.still, 60) -exact-exit-animation=(p.still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      column gap=10 align-items="center"
        text t("ui.anEasierWayIn") role="heading" aria-level=1 class=Display font-size=42
        text t("ui.approveThisCodeFromASignedInEtherDevice") color="ink.secondary" font-size=15 line-height=1.5 max-width=300
      row width="100%" gap=6 justify-content="center" testId="connect-code" aria-label=p.model.code role="text"
        for ch, i in p.model.code.split("") key=`${i}`
          text ch aria-hidden=true flex=1 max-width=44 height=54 display="flex" align-items="center" justify-content="center" border-radius=12 background-color="cinematic.glass-deep" border="1px solid var(--cinematic.glass-edge)" box-shadow="inset 0px 1px 0px var(--cinematic.ring)" font-family="ui-monospace, \"SF Mono\", Menlo, monospace" font-size=24 font-weight=600 color="brand.warm" animation=enter(p.still, 120 + i * 45)
      column gap=10 align-items="center"
        row gap=10 align-items="center" role="status"
          if p.error == ""
            Pulse(still=p.still)
          text (p.error == "" ? t("ui.waitingForApproval") : p.error) color=(p.error == "" ? "ink.secondary" : "brand.warm") font-size=14
        text t("ui.codeExpires", expiry=p.model.expiresLabel) color="ink.quiet" font-size=12
      button press=cancel class=GhostPill height=46 padding="0px 28px" transition=`background-color 180ms linear, scale ${base()}ms ${glide()}`
        text t("ui.cancel") font-size=14
