use QuickModel from "../../foundation/models.contract"
use Display, DisplayItalic, Eyebrow, Glass, PrimaryPill, GhostPill, Field, enter, base, glide, breathe, auroraA, auroraB, auroraC, vanish from "./look.contract"

// The Vela mark: a four-pointed star (the Sails) beside the italic wordmark.
component Wordmark
  props
    size: number
    still: bool
  view
    row align-items="center" gap=(size * 0.18) aria-hidden=true
      svg width=(size * 0.42) height=(size * 0.42) viewBox="0 0 24 24" animation=(still ? "none" : "breathe 5s cubic-bezier(0.45, 0, 0.55, 1) infinite")
        path d="M12 0C12.9 7.6 16.4 11.1 24 12C16.4 12.9 12.9 16.4 12 24C11.1 16.4 7.6 12.9 0 12C7.6 11.1 11.1 7.6 12 0Z" fill="var(--brand.warm)"
      text t("ui.vela") class=DisplayItalic font-size=size letter-spacing="-0.02em" line-height=1 color="ink.primary"

// The stage every signed-out state stands on: drifting light, a vignette and
// grain behind a centred glass card that resizes as its content changes.
component AuthStage
  props
    still: bool
  slot
  view
    column position="relative" min-height="100dvh" width="100%" box-sizing="border-box" overflow="hidden" align-items="center" justify-content="center" padding="max(28px, 7vh) 16px" background-color="surface.page" -exact-exit-animation=(still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      column position="absolute" inset=0 aria-hidden=true pointer-events="none"
        column position="absolute" width="72vmax" height="72vmax" left="-22vmax" top="-30vmax" border-radius="50%" opacity=0.5 background-image="radial-gradient(circle, var(--cinematic.ember) 0%, var(--cinematic.scrim-clear) 68%)" animation=(still ? "none" : "auroraA 34s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
        column position="absolute" width="80vmax" height="80vmax" right="-30vmax" bottom="-42vmax" border-radius="50%" opacity=0.55 background-image="radial-gradient(circle, var(--cinematic.tide) 0%, var(--cinematic.scrim-clear) 66%)" animation=(still ? "none" : "auroraB 41s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
        column position="absolute" width="54vmax" height="54vmax" left="34%" top="18%" border-radius="50%" opacity=0.35 background-image="radial-gradient(circle, var(--cinematic.dusk) 0%, var(--cinematic.scrim-clear) 70%)" animation=(still ? "none" : "auroraC 47s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
        column position="absolute" inset=0 background-image="radial-gradient(ellipse 110% 85% at 50% 42%, var(--cinematic.scrim-clear) 35%, var(--cinematic.vignette) 100%)"
        image "assets/grain.svg" alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="fill" opacity=0.06
      column position="relative" width="100%" max-width=448 gap=32 align-items="center" animation=enter(still, 0)
        Wordmark(size=46, still=still)
        column class=Glass width="100%" box-sizing="border-box" padding="clamp(28px, 5vw, 44px) clamp(22px, 4.5vw, 40px)" border-radius=28 box-shadow="0px 40px 120px var(--cinematic.card-shadow), inset 0px 1px 0px var(--cinematic.ring)" -exact-layout-transition=(still ? "none" : "560ms ease-out")
          children
        text t("ui.yourEveningReimagined") class=Eyebrow font-size=10 color="ink.quiet" text-align="center"

// A signed-out moment with nothing to fill in: connecting, redeeming a web code, offline.
component AuthNotice
  props
    kind: string
    still: bool
  view
    column gap=18 align-items="center" text-align="center" padding="12px 0px" role=(kind == "offline" ? "alert" : "status") animation=enter(still, 0) -exact-exit-animation=(still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      if kind == "offline"
        image "symbol:alert" width=28 height=28 color="brand.warm" aria-hidden=true
        text t("ui.serverUnreachable") role="heading" aria-level=1 class=Display font-size=34
        text t("ui.yourServerCouldNotBeReachedReopenVelaWhenTheConnectionIsRestored") color="ink.secondary" font-size=15 line-height=1.55
      else
        Pulse(still=still)
        text (kind == "redeeming" ? t("ui.signingYouIn") : t("ui.connectingToYourLibrary")) color="ink.secondary" font-size=15

// Three soft lights that breathe in turn: the skin's indeterminate progress.
component Pulse
  props
    still: bool
  view
    row gap=8 aria-hidden=true
      for i in [0, 1, 2] key=`${i}`
        column width=7 height=7 border-radius=4 background-color="brand.warm" opacity=(still ? 0.8 : 1) animation=(still ? "none" : `breathe 1.4s cubic-bezier(0.45, 0, 0.55, 1) ${i * 180}ms infinite`)

component SignIn
  props
    username: string
    password: string
    passwordAvailable: bool
    quickAvailable: bool
    error: string
    busy: bool
    still: bool
    editUsername: action
    editPassword: action
    submit: action
    quick: action
  view
    column gap=26 animation=enter(still, 60) -exact-exit-animation=(still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      column gap=10
        text t("ui.welcomeToYourEvening") role="heading" aria-level=1 class=Display font-size=42
        text t("ui.signInToYourLibrary") color="ink.secondary" font-size=15 line-height=1.5
      if error != ""
        row role="alert" gap=10 align-items="flex-start" padding="12px 14px" border-radius=14 background-color="cinematic.alert" border="1px solid var(--cinematic.alert-edge)" animation=enter(still, 0)
          image "symbol:alert" width=18 height=18 color="brand.warm" flex-shrink=0 aria-hidden=true
          text error color="ink.primary" font-size=14 line-height=1.45
      if passwordAvailable
        column gap=16
          column gap=8
            text t("ui.username") class=Eyebrow font-size=10 color="ink.quiet"
            input value=username input=editUsername autocomplete="username" autocapitalize="none" spellcheck=false aria-label=t("ui.username") testId="username" class=Field transition=`border-color 180ms linear, box-shadow ${base()}ms ${glide()}`
          column gap=8
            text t("ui.password") class=Eyebrow font-size=10 color="ink.quiet"
            input type="password" value=password input=editPassword submit=submit autocomplete="current-password" aria-label=t("ui.password") testId="password" class=Field transition=`border-color 180ms linear, box-shadow ${base()}ms ${glide()}`
          button press=submit disabled=(busy or username.trim() == "" or password == "") class=PrimaryPill height=52 margin-top=6 testId="sign-in" transition=`background-color 180ms linear, opacity 180ms linear, scale ${base()}ms ${glide()}`
            row gap=10 align-items="center" justify-content="center"
              if busy
                Pulse(still=still)
              text (busy ? t("ui.signingIn") : t("ui.signIn")) font-size=15 font-weight=650
      if passwordAvailable and quickAvailable
        row gap=14 align-items="center" aria-hidden=true
          column flex=1 height=1 background-color="cinematic.glass-edge"
          text t("ui.or") font-size=12 color="ink.quiet"
          column flex=1 height=1 background-color="cinematic.glass-edge"
      if quickAvailable
        button press=quick disabled=busy class=GhostPill height=52 testId="quick-connect" transition=`background-color 180ms linear, border-color 180ms linear, scale ${base()}ms ${glide()}`
          row gap=10 align-items="center" justify-content="center"
            image "symbol:smartphone" width=18 height=18 aria-hidden=true
            text t("ui.connectWithACode") font-size=15
      if not passwordAvailable and not quickAvailable
        text t("ui.noSignInMethodsOffered") role="status" color="ink.secondary" font-size=14 line-height=1.55

component QuickConnect
  props
    model: QuickModel
    error: string
    still: bool
    cancel: action
  view
    column gap=26 align-items="center" text-align="center" animation=enter(still, 60) -exact-exit-animation=(still ? "vanish 160ms linear both" : "vanish 320ms ease-in both")
      column gap=10 align-items="center"
        text t("ui.anEasierWayIn") role="heading" aria-level=1 class=Display font-size=42
        text t("ui.approveThisCodeFromASignedInEtherDevice") color="ink.secondary" font-size=15 line-height=1.5 max-width=300
      row width="100%" gap=6 justify-content="center" testId="connect-code" aria-label=model.code role="text"
        for ch, i in model.code.split("") key=`${i}`
          text ch aria-hidden=true flex=1 max-width=44 height=54 display="flex" align-items="center" justify-content="center" border-radius=12 background-color="cinematic.glass-deep" border="1px solid var(--cinematic.glass-edge)" box-shadow="inset 0px 1px 0px var(--cinematic.ring)" font-family="ui-monospace, \"SF Mono\", Menlo, monospace" font-size=24 font-weight=600 color="brand.warm" animation=enter(still, 120 + i * 45)
      column gap=10 align-items="center"
        row gap=10 align-items="center" role="status"
          if error == ""
            Pulse(still=still)
          text (error == "" ? t("ui.waitingForApproval") : error) color=(error == "" ? "ink.secondary" : "brand.warm") font-size=14
        text t("ui.codeExpires", expiry=model.expiresLabel) color="ink.quiet" font-size=12
      button press=cancel class=GhostPill height=46 padding="0px 28px" transition=`background-color 180ms linear, scale ${base()}ms ${glide()}`
        text t("ui.cancel") font-size=14
