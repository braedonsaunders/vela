use Card, FeedRow, DetailModel, ExtraModel, cardName from "../../foundation/models.contract"
use Row from "./slots.contract"
use Display, Eyebrow, PrimaryPill, GhostPill, IconButton, enter, expose, drift, base, glide, quick, FadeImage, dissolve, seasonFromRight, seasonFromLeft, vanish from "./look.contract"
use DetailProps from "../../foundation/slot-api.contract"

fn kindLabel(kind: string): string = (kind == "movie" ? t("ui.film") : kind == "show" ? t("ui.series") : kind == "season" ? t("ui.season") : t("ui.episode"))
fn side(small: bool): string = (small ? "20px" : "max(32px, 5.5vw)")

// A title opened over the page: an artwork band, then episodes, extras, people and related rows.
component Detail
  props
    p: DetailProps
  inject
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  state seasonDirection = 1
  derive episodesSeason = match first(p.model.episodes) { case some(e) => e.seasonId, case none => "" }
  // The foundation owns the selection (the visit's ?season=); without one the page shows
  // the season its episodes belong to.
  derive selectedSeason = (p.season != "" ? p.season : episodesSeason != "" ? episodesSeason : match first(p.model.title) { case some(t) => (t.kind == "season" ? t.id : match first(p.model.seasons) { case some(s) => s.id, case none => "" }), case none => "" })
  derive seasonLoading = p.season != "" and episodesSeason != "" and episodesSeason != p.season
  derive upNext = match first(p.model.episodes.filter(e => not e.played)) { case some(e) => [e], case none => [] }
  // A season swaps only the episode list, sliding in tab order; the page and its scroll stay.
  action pickSeason(id: string)
    if id != selectedSeason
      seasonDirection = (p.model.seasons.map(x => x.id).indexOf(id) >= p.model.seasons.map(x => x.id).indexOf(selectedSeason) ? 1 : -1)
      selectTitle(id, "season", "")
  action castBack
    scrollBy("detail-cast", -640, 0)
  action castOn
    scrollBy("detail-cast", 640, 0)
  view
    column gap=(p.small ? 36 : 52) padding-bottom=72
      for title in p.model.title key=title.id
        column position="relative" min-height=(p.small ? 600 : "min(80vh, 780px)") justify-content="flex-end" overflow="hidden"
          column position="absolute" inset=0 overflow="hidden" aria-hidden=true mask-image="linear-gradient(180deg, black 0%, black 78%, transparent 100%)" animation=expose(p.still)
            if title.backdrop != ""
              column position="absolute" inset=0 transform-origin="58% 40%" animation=drift(p.still)
                FadeImage(src=title.backdrop)
            column position="absolute" left="-12%" bottom="0%" width="70%" height="80%" background-color=(title.accent == "" ? "brand.warm" : title.accent) opacity=0.18 mask-image="radial-gradient(closest-side, black 0%, transparent 100%)"
            column position="absolute" inset=0 background-image="linear-gradient(90deg, var(--cinematic.scrim-deep) 0%, var(--cinematic.scrim-mid) 38%, var(--cinematic.scrim-clear) 72%), linear-gradient(0deg, var(--surface.page) 0%, var(--cinematic.scrim-strong) 20%, var(--cinematic.scrim-clear) 60%), linear-gradient(180deg, var(--cinematic.nav-scrim) 0%, var(--cinematic.scrim-clear) 22%)"
            image "assets/grain.svg" alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="fill" opacity=0.05
          column position="relative" padding-top=(p.small ? 96 : 120) padding-bottom=(p.small ? 8 : 12) padding-left=side(p.small) padding-right=side(p.small) max-width="58rem" gap=(p.small ? 14 : 18)
            row gap=10 align-items="center" animation=enter(p.still, 140)
              column width=24 height=2 border-radius=1 background-color=(title.accent == "" ? "brand.warm" : title.accent)
              text kindLabel(title.kind) class=Eyebrow font-size=10 color="brand.warm"
            if title.logo != ""
              image title.logo alt=title.name role="heading" aria-level=1 height=(p.small ? 92 : 150) width="auto" max-width=(p.small ? "80%" : "min(560px, 80%)") object-fit="contain" align-self="flex-start" animation=enter(p.still, 200)
            else
              text title.name role="heading" aria-level=1 class=Display font-size=(p.small ? 46 : 84) text-shadow="0px 4px 40px var(--cinematic.shadow)" animation=enter(p.still, 200)
            text ([title.facts].concat(title.genres.slice(0, 3)).filter(f => f != "").join(" · ")) font-size=14 color="ink.secondary" font-variant-numeric="tabular-nums" animation=enter(p.still, 260)
            if p.model.mediaFacts.length > 0
              row gap=8 flex-wrap="wrap" animation=enter(p.still, 300)
                for fact in p.model.mediaFacts key=fact
                  text fact font-size=11 font-weight=650 letter-spacing="0.06em" color="ink.primary" padding="5px 9px" border-radius=6 border="1px solid var(--cinematic.glass-edge-strong)" background-color="cinematic.control" backdrop-filter="blur(12px)"
            if title.summary != ""
              text title.summary color="ink.primary" opacity=0.88 font-size=(p.small ? 15 : 17) line-height=1.6 max-width="42rem" animation=enter(p.still, 340)
            row gap=12 align-items="center" flex-wrap="wrap" margin-top=(p.small ? 6 : 10) animation=enter(p.still, 400)
              if p.model.canPlay
                button press=play(title.id) class=PrimaryPill height=(p.small ? 50 : 56) padding-left=(p.small ? 22 : 30) padding-right=(p.small ? 26 : 34) testId="detail-play" transition=`background-color 180ms linear`
                  row gap=10 align-items="center"
                    image "symbol:play-fill" width=18 height=18 aria-hidden=true
                    text (p.model.resumeSeconds > 0 ? t("ui.resumePositionIn", position=p.model.resumePosition) : t("ui.play")) font-size=16
              for trailer in p.model.extras.filter(e => e.kind == "trailer" and e.ready) key=trailer.id
                button press=playExtra(trailer.id) class=GhostPill height=(p.small ? 50 : 56) padding-left=22 padding-right=26 transition=`background-color 180ms linear`
                  row gap=10 align-items="center"
                    image "symbol:play" width=16 height=16 aria-hidden=true
                    text t("ui.watchTrailer") font-size=15
            if p.model.canPlay and p.model.resumeSeconds > 0 and title.durationSeconds > 0
              column width=(p.small ? "60%" : 260) height=3 border-radius=2 background-color="cinematic.track-strong" overflow="hidden" role="progressbar" aria-label=t("ui.watchProgress") aria-valuemin=0 aria-valuemax=title.durationSeconds aria-valuenow=min(title.durationSeconds, max(0, p.model.resumeSeconds)) animation=enter(p.still, 440)
                column height=3 width=`${min(100, p.model.resumeSeconds / title.durationSeconds * 100)}%` background-color="brand.warm"
      if p.model.seasons.length > 0 or p.model.episodes.length > 0
        column padding-left=side(p.small) padding-right=side(p.small) gap=(p.small ? 18 : 24) animation=enter(p.still, 480)
          row align-items="flex-end" justify-content="space-between" flex-wrap="wrap" gap=16
            text t("ui.episodes") role="heading" aria-level=2 class=Display font-size=(p.small ? 30 : 38)
          if p.model.seasons.length > 1
            scroll position="sticky" top=0 z-index=4 overflow-x="auto" overflow-y="hidden" scrollbar-width="none" margin-left=(p.small ? "-20px" : "-12px") margin-right=(p.small ? "-20px" : "-12px") padding-left=(p.small ? 0 : 12) padding-right=(p.small ? 0 : 12) padding-top=8 padding-bottom=8 border-radius=(p.small ? 0 : 16) background-color="cinematic.toolbar" backdrop-filter="blur(20px) saturate(1.3)"
              row gap=8 role="group" aria-label=t("ui.season") testId="season-picker" padding-left=(p.small ? 20 : 0) padding-right=(p.small ? 20 : 0) padding-top=2 padding-bottom=2
                for season in p.model.seasons key=season.id
                  button press=pickSeason(season.id) aria-pressed=(season.id == selectedSeason) class=SeasonPill background-color=(season.id == selectedSeason ? "ink.primary" : "cinematic.control") color=(season.id == selectedSeason ? "ink.inverse" : "ink.primary") transition=`background-color ${quick()}ms linear, color ${quick()}ms linear`
                    text season.name font-size=14
          for shown in [episodesSeason] key=`season-${shown}`
            column gap=(p.small ? 18 : 24) opacity=(seasonLoading ? 0.45 : 1) transition="opacity 200ms linear" aria-busy=seasonLoading animation=(p.still ? "dissolve 240ms linear both" : seasonDirection > 0 ? "seasonFromRight 520ms cubic-bezier(0.16, 1, 0.3, 1) both" : "seasonFromLeft 520ms cubic-bezier(0.16, 1, 0.3, 1) both") -exact-exit-animation=(p.still ? "vanish 120ms linear both" : "vanish 200ms ease-in both")
              for episode in upNext key=episode.id
                row flex-direction=(p.small ? "column" : "row") align-items=(p.small ? "stretch" : "center") gap=(p.small ? 16 : 24) padding=(p.small ? 16 : 20) border-radius=20 background-color="cinematic.glass" border="1px solid var(--cinematic.glass-edge)" box-shadow="inset 0px 1px 0px var(--cinematic.ring), 0px 24px 60px -20px var(--cinematic.card-shadow)"
                  if episode.backdrop != ""
                    image episode.backdrop alt="" width=(p.small ? "100%" : 220) aspect-ratio="16 / 9" object-fit="cover" border-radius=12 flex-shrink=0
                  column gap=8 flex=1 min-width=0
                    text (episode.progressSeconds > 0 ? t("ui.continueWatching") : t("ui.upNext")) class=Eyebrow font-size=10 color="brand.warm"
                    text (episode.episodeNumber > 0 ? t("ui.numberTitle", number=episode.episodeNumberLabel, title=episode.name) : episode.name) role="heading" aria-level=3 class=Display font-size=(p.small ? 24 : 30)
                    if episode.facts != ""
                      text episode.facts font-size=13 color="ink.secondary"
                  button align-self=(p.small ? "stretch" : "center") press=play(episode.id) aria-label=(episode.progressSeconds > 0 ? t("ui.resumeTitle", title=episode.name) : t("ui.playTitle", title=episode.name)) class=PrimaryPill height=50 padding-left=22 padding-right=26 flex-shrink=0 transition=`background-color 180ms linear`
                    row gap=10 align-items="center" justify-content="center"
                      image "symbol:play-fill" width=16 height=16 aria-hidden=true
                      text (episode.progressSeconds > 0 ? t("ui.resumeEpisode") : t("ui.playEpisode")) font-size=15
              column
                for episode, i in p.model.episodes key=episode.id
                  EpisodeRow(episode=episode, small=p.small, still=p.still, play=play, selectTitle=selectTitle, delay=min(i, 8) * 40)
      if p.model.extras.length > 0
        column gap=16 animation=enter(p.still, 520)
          text t("ui.extras") role="heading" aria-level=2 class=Display font-size=(p.small ? 28 : 34) padding-left=side(p.small) padding-right=side(p.small)
          scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
            row gap=14 padding-left=side(p.small) padding-right=side(p.small) padding-top=4 padding-bottom=8
              for extra in p.model.extras key=extra.id
                ExtraTile(extra=extra, small=p.small, still=p.still, playExtra=playExtra)
      if p.model.castPeople.length > 0
        column gap=16 animation=enter(p.still, 560)
          row align-items="center" justify-content="space-between" padding-left=side(p.small) padding-right=side(p.small)
            text t("ui.featuring") role="heading" aria-level=2 class=Display font-size=(p.small ? 28 : 34)
            if not p.small and p.model.castPeople.length > 6
              row gap=8
                button press=castBack aria-label=t("ui.scrollBack") class=IconButton width=38 height=38 padding=11
                  image "symbol:back" width=16 height=16
                button press=castOn aria-label=t("ui.scrollOn") class=IconButton width=38 height=38 padding=11
                  image "symbol:forward-chevron" width=16 height=16
          scroll id="detail-cast" overflow-x="auto" overflow-y="hidden" scrollbar-width="none" scroll-behavior="smooth" mask-image="linear-gradient(90deg, black 0%, black 94%, transparent 100%)"
            row gap=(p.small ? 14 : 20) padding-left=side(p.small) padding-right=side(p.small) padding-top=4 padding-bottom=8
              for person, i in p.model.castPeople key=`${i}-${person.name}`
                column width=(p.small ? 84 : 112) flex-shrink=0 gap=8 align-items="center" text-align="center"
                  column position="relative" width=(p.small ? 76 : 100) height=(p.small ? 76 : 100) border-radius=999 overflow="hidden" background-image="linear-gradient(135deg, var(--cinematic.placeholder-top) 0%, var(--cinematic.placeholder-bottom) 100%)" box-shadow="0px 0px 0px 1px var(--cinematic.ring), 0px 12px 28px -14px var(--cinematic.card-shadow)" align-items="center" justify-content="center"
                    if person.portrait != ""
                      FadeImage(src=person.portrait)
                    else
                      text person.name.split(" ").filter(w => w != "").slice(0, 2).map(w => w.slice(0, 1).toUpperCase()).join("") class=Display font-size=(p.small ? 28 : 36) color="ink.secondary" aria-hidden=true
                  text person.name font-size=13 font-weight=600 line-clamp=2 color="ink.primary"
                  if person.role != ""
                    text person.role font-size=12 color="ink.quiet" line-clamp=2
      if p.model.crew.length > 0
        column gap=12 padding-left=side(p.small) padding-right=side(p.small) animation=enter(p.still, 580)
          text t("ui.behindTheStory") role="heading" aria-level=2 class=Display font-size=(p.small ? 28 : 34)
          text p.model.crew.join(" · ") font-size=15 color="ink.secondary" line-height=1.7 max-width="48rem"
      if p.model.related.length > 0
        column animation=enter(p.still, 600)
          for related in p.model.related key=related.id
            Row(row=related, small=p.small, still=p.still, selectTitle=selectTitle, observe=observe)

style SeasonPill
  height = 40
  padding = "0px 18px"
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  font-weight = 600
  flex-shrink = 0
  :hover
    border-color = "cinematic.glass-edge-strong"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"

// One episode: a still that lifts and shows a play mark on hover, then its text.
component EpisodeRow
  props
    episode: Card
    small: bool
    still: bool
    play: action
    selectTitle: action
    delay: number
  state lifted = false
  action hoverRow(over: bool)
    lifted = over
  view
    row gap=(small ? 14 : 24) align-items=(small ? "flex-start" : "center") padding="18px 0px" border-bottom="1px solid var(--cinematic.hairline)" hover=hoverRow animation=enter(still, delay)
      button press=selectTitle(episode.id, episode.kind, episode.receipt) aria-label=cardName(episode) testId=`episode-${episode.id}` focus=hoverRow(true) blur=hoverRow(false) position="relative" width=(small ? 128 : 220) aspect-ratio="16 / 9" padding=0 border="none" border-radius=10 overflow="hidden" background-color="surface.raised" color="ink.primary" flex-shrink=0 cursor="pointer" scale=(lifted and not still ? 1.03 : 1) box-shadow=(lifted ? "0px 20px 40px -14px var(--cinematic.card-shadow), 0px 0px 0px 1px var(--cinematic.ring)" : "0px 0px 0px 1px var(--cinematic.hairline)") transition=`scale ${base()}ms ${glide()}, box-shadow ${base()}ms ${glide()}`
        :focus-visible
          box-shadow="0px 0px 0px 3px var(--ink.primary)"
        if episode.backdrop != ""
          FadeImage(src=episode.backdrop)
        else
          column position="absolute" inset=0 align-items="center" justify-content="center" background-image="linear-gradient(160deg, var(--cinematic.placeholder-top) 0%, var(--cinematic.placeholder-bottom) 100%)"
            text (episode.episodeNumber > 0 ? episode.episodeNumberLabel : t("ui.episode")) class=Display font-size=(small ? 26 : 34) color="ink.secondary"
        column position="absolute" inset=0 align-items="center" justify-content="center" background-color="cinematic.scrim-soft" opacity=(lifted ? 1 : 0) transition=`opacity ${base()}ms ${glide()}` aria-hidden=true
          column width=44 height=44 border-radius=22 align-items="center" justify-content="center" background-color="cinematic.glass" backdrop-filter="blur(10px)" border="1px solid var(--cinematic.glass-edge-strong)"
            image "symbol:play-fill" width=16 height=16 color="ink.primary"
        if episode.progressSeconds > 0 and episode.durationSeconds > 0
          column position="absolute" left=8 right=8 bottom=8 height=3 border-radius=2 background-color="cinematic.track-strong" overflow="hidden" role="progressbar" aria-label=t("ui.titleWatchProgress", title=episode.name) aria-valuemin=0 aria-valuemax=episode.durationSeconds aria-valuenow=min(episode.durationSeconds, max(0, episode.progressSeconds))
            column height=3 width=`${min(100, episode.progressSeconds / episode.durationSeconds * 100)}%` background-color="brand.warm"
      column flex=1 min-width=0 gap=6
        text (episode.episodeNumber > 0 ? t("ui.numberTitle", number=episode.episodeNumberLabel, title=episode.name) : episode.name) role="heading" aria-level=3 font-size=(small ? 15 : 18) font-weight=600 line-clamp=2
        text (episode.played ? t("ui.factsWatched", facts=episode.facts) : episode.facts) color="ink.quiet" font-size=12 font-variant-numeric="tabular-nums"
        if not small and episode.summary != ""
          text episode.summary color="ink.secondary" font-size=14 line-clamp=2 line-height=1.55 max-width="46rem"
      if not small
        button press=play(episode.id) aria-label=t("ui.playTitle", title=episode.name) class=IconButton width=44 height=44 padding=13 flex-shrink=0
          image "symbol:play-fill" width=16 height=16

// An extra (trailer, featurette): a glass tile that plays, or says it is unavailable.
component ExtraTile
  props
    extra: ExtraModel
    small: bool
    still: bool
    playExtra: action
  view
    button press=playExtra(extra.id) disabled=(not extra.ready) aria-label=(extra.ready ? t("ui.playTitle", title=extra.name) : t("ui.titleNotAvailable", title=extra.name)) class=GhostPill border-radius=16 width=(small ? 220 : 280) height=(small ? 96 : 110) padding=18 flex-shrink=0 transition=`background-color 180ms linear`
      row gap=14 align-items="center" height="100%"
        column width=40 height=40 border-radius=20 align-items="center" justify-content="center" background-color=(extra.ready ? "ink.primary" : "cinematic.control") flex-shrink=0
          image (extra.ready ? "symbol:play-fill" : "symbol:lock") width=14 height=14 color=(extra.ready ? "ink.inverse" : "ink.quiet") aria-hidden=true
        column gap=4 flex=1 min-width=0 text-align="left"
          text extra.name font-size=15 font-weight=600 line-clamp=2
          if not extra.ready
            text t("ui.notAvailableYet") font-size=12 color="ink.quiet"
