// Cinematic design tokens: the display face, the type scale, motion curves and
// durations, and every keyframe the skin plays. Components read these instead
// of writing their own literals, so the skin moves and reads as one system.

font "Instrument Serif"
  400 = "assets/fonts/InstrumentSerif-Regular.ttf"
  400 italic = "assets/fonts/InstrumentSerif-Italic.ttf"

// Motion curves. Glide: a quick start and a long settle, for things arriving or
// lifting. Sweep: symmetric, for drifts and moves between two resting places.
// Release: accelerates away, for things leaving.
fn glide(): string = "cubic-bezier(0.16, 1, 0.3, 1)"
fn sweep(): string = "cubic-bezier(0.65, 0, 0.35, 1)"
fn release(): string = "cubic-bezier(0.4, 0, 1, 1)"

// Durations, in milliseconds.
fn quick(): number = 180
fn base(): number = 360
fn slow(): number = 640
fn reveal(): number = 1100

// An entrance: rise into place, staggered by delay. Reduced motion dissolves in place.
fn enter(still: bool, delay: number): string = (still ? "dissolve 240ms linear both" : `rise ${slow()}ms ${glide()} ${delay}ms both`)
// A larger entrance for a surface opening over the page.
fn open(still: bool): string = (still ? "dissolve 240ms linear both" : `open ${slow()}ms ${glide()} both`)
// Artwork appearing: a slow exposure from black, settling from slightly large.
fn expose(still: bool): string = (still ? "dissolve 400ms linear both" : `expose ${reveal()}ms ${glide()} both`)
// Ken Burns drift for hero artwork. Reduced motion holds the frame still.
fn drift(still: bool): string = (still ? "none" : "drift 32s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate")
// Exits and layout moves are written as literals where they are used (the JS
// target binds only literal values): exits are `vanish 320ms ease-in both`
// (`vanish 160ms linear both` when still); layout moves `560ms ease-out`.
// Hover/focus lift on cards and controls: transforms on a spring-like glide.
fn lift(still: bool): string = (still ? "box-shadow 180ms linear, opacity 180ms linear" : `scale ${base()}ms ${glide()}, translate ${base()}ms ${glide()}, box-shadow ${base()}ms ${glide()}, opacity ${quick()}ms linear`)
fn tint(still: bool): string = `background-color ${quick()}ms linear, border-color ${quick()}ms linear, color ${quick()}ms linear, box-shadow ${base()}ms ${glide()}`
// Chrome that shows and hides: fade, with a short slide when motion is allowed.
fn chrome(still: bool): string = (still ? `opacity ${base()}ms linear` : `opacity ${base()}ms ${glide()}, translate ${base()}ms ${glide()}`)
// Stagger for repeated items: a short step that stops growing after a handful.
fn stagger(i: number, step: number, cap: number): number = min(i, cap) * step

keyframes rise
  from opacity=0 translate="0px 22px"

keyframes dissolve
  from opacity=0

keyframes vanish
  to opacity=0

keyframes pop
  from opacity=0 scale=0.94 translate="0px -6px"

keyframes open
  from opacity=0 scale=0.94 translate="0px 28px"

keyframes expose
  from opacity=0 scale=1.08

keyframes drift
  from scale=1.04 translate="0px 0px"
  to scale=1.14 translate="-2.4% -1.6%"

keyframes shimmer
  from translate="-100% 0px"
  to translate="100% 0px"

keyframes spin
  from rotate=0
  to rotate=360

keyframes breathe
  50% opacity=0.45

keyframes glow
  50% opacity=0.75 scale=1.06

keyframes auroraA
  from translate="-8% -6%" scale=1
  to translate="10% 8%" scale=1.25

keyframes auroraB
  from translate="12% 6%" scale=1.2
  to translate="-10% -8%" scale=0.95

keyframes auroraC
  from translate="0% 10%" scale=0.9
  to translate="-6% -12%" scale=1.2

// Type. One display face for titles; the platform's UI face for everything read.
style Display
  font-family = "\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif"
  font-weight = 400
  letter-spacing = "-0.01em"
  line-height = 0.98

style DisplayItalic
  font-family = "\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif"
  font-style = "italic"
  font-weight = 400
  letter-spacing = "-0.01em"
  line-height = 1

style Eyebrow
  font-size = 11
  font-weight = 600
  letter-spacing = "0.24em"
  text-transform = "uppercase"

style Meta
  font-size = 13
  font-variant-numeric = "tabular-nums"
  color = "ink.secondary"

// Surfaces.
style Glass
  background-color = "cinematic.glass"
  backdrop-filter = "blur(28px) saturate(1.4)"
  border = "1px solid var(--cinematic.glass-edge)"

style PrimaryPill
  border = "none"
  border-radius = 999
  background-color = "ink.primary"
  color = "ink.inverse"
  font-weight = 650
  :hover
    background-color = "cinematic.primary-hover"
  :active
    -exact-press-scale = 0.97
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--surface.page), 0px 0px 0px 4px var(--brand.warm)"
  :disabled
    background-color = "cinematic.control-hover"
    color = "ink.quiet"

style GhostPill
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  background-color = "cinematic.control"
  backdrop-filter = "blur(20px) saturate(1.3)"
  color = "ink.primary"
  font-weight = 600
  :hover
    background-color = "cinematic.control-hover"
    border-color = "cinematic.glass-edge-strong"
  :active
    -exact-press-scale = 0.97
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--surface.page), 0px 0px 0px 4px var(--brand.warm)"
  :disabled
    opacity = 0.42

style IconButton
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  background-color = "cinematic.control"
  backdrop-filter = "blur(20px) saturate(1.3)"
  color = "ink.primary"
  box-sizing = "border-box"
  :hover
    background-color = "cinematic.control-hover"
  :active
    -exact-press-scale = 0.94
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--surface.page), 0px 0px 0px 4px var(--brand.warm)"
  :disabled
    opacity = 0.42

style Field
  box-sizing = "border-box"
  height = 52
  padding = "0px 18px"
  border-radius = 14
  border = "1px solid var(--cinematic.glass-edge)"
  background-color = "cinematic.field"
  color = "ink.primary"
  font-size = 16
  outline = "none"
  :hover
    border-color = "cinematic.glass-edge-strong"
  :focus-visible
    border-color = "brand.warm"
    box-shadow = "0px 0px 0px 4px var(--cinematic.focus-halo)"

// A loading placeholder: a quiet block swept by a soft highlight.
component Skeleton
  props
    width: string
    height: string
    radius: number
    still: bool
  view
    column width=width height=height flex-shrink=0 border-radius=radius overflow="hidden" background-color="cinematic.skeleton" aria-hidden=true
      if not still
        column width="100%" height="100%" background-image="linear-gradient(90deg, var(--cinematic.scrim-clear) 0%, var(--cinematic.skeleton-light) 50%, var(--cinematic.scrim-clear) 100%)" animation="shimmer 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite"
