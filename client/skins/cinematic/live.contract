use GuideModel, GuideChannel from "../../live/models.contract"
use Eyebrow, glide, quick from "./look.contract"
use LiveControlsProps, MiniGuideProps from "../../foundation/slot-api.contract"

keyframes zapIn
  from opacity=0 translate="-18px 0px"

keyframes zapOut
  to opacity=0 translate="-12px 0px"

// Live state over the player: the delivery mode, honest delivery states, low
// delay and catch-up, and channel up/down for pointers and touch.
component LiveControls
  props
    p: LiveControlsProps
  inject
    catchUp: action
    zap: action
  view
    column gap=10 padding="14px 16px" border-radius=18 background-color="cinematic.glass-deep" backdrop-filter="blur(28px) saturate(1.4)" border="1px solid var(--cinematic.glass-edge)" box-shadow="0px 24px 70px var(--cinematic.shadow)" min-width=240
      row gap=10 align-items="center"
        row gap=6 align-items="center" padding="3px 8px" border-radius=6 background-color="cinematic.guide-now"
          column width=6 height=6 border-radius=3 background-color="ink.primary" aria-hidden=true
          text t("live.liveBadge") font-size=10 font-weight=750 letter-spacing="0.14em"
        column flex=1
        row gap=4
          button press=zap(-1) aria-label=t("live.channelUp") class=ZapButton
            image "symbol:back" width=13 height=13 rotate="90deg" aria-hidden=true
          button press=zap(1) aria-label=t("live.channelDown") class=ZapButton
            image "symbol:back" width=13 height=13 rotate="-90deg" aria-hidden=true
      if p.reconnecting
        text t("live.reconnecting") role="status" font-size=13 color="ink.secondary"
      if p.delivery == "upstream-gap"
        text t("live.gap") role="status" font-size=13 color="ink.secondary"
      if p.delivery == "segment-delayed"
        text t("live.delayed") role="status" font-size=13 color="ink.secondary"
      if p.delivery == "waiting-for-publication"
        text t("live.publication") role="status" font-size=13 color="ink.secondary"
      if p.drift > 0
        text t("live.behind", seconds=p.driftLabel) role="status" font-size=13 color="ink.secondary" font-variant-numeric="tabular-nums"
      row gap=8
        if p.canCatchUp and p.drift > 0
          button press=catchUp class=LivePill background-color="cinematic.control" color="ink.primary"
            text t("live.catchUp") font-size=13 font-weight=600

// The in-player mini guide: the channel being tuned to, between its neighbours,
// with what is on now and next. It appears while the viewer flicks channels.
component MiniGuide
  props
    p: MiniGuideProps
  inject
    tune: action
  derive ids = p.model.channels.map(c => c.id)
  derive at = max(0, ids.indexOf(p.target != "" ? p.target : p.playing))
  derive n = p.model.channels.length
  derive around = (n < 3 ? p.model.channels : p.model.channels.slice((at - 1 + n) % n, (at - 1 + n) % n + 1).concat(p.model.channels.slice(at, at + 1)).concat(p.model.channels.slice((at + 1) % n, (at + 1) % n + 1)))
  view
    column gap=8 width=(p.small ? "calc(100% - 32px)" : 400) role="region" aria-label=t("live.channels") aria-live="polite" animation=(p.still ? "none" : `zapIn 260ms ${glide()} both`) -exact-exit-animation="zapOut 160ms ease-in both"
      for c, i in around key=c.id
        if (n < 3 ? c.id == (p.target != "" ? p.target : p.playing) : i == 1)
          MiniGuideCard(channel=c, playing=(c.id == p.playing), still=p.still, tune=tune)
        else
          row gap=12 align-items="center" padding="9px 14px" border-radius=14 background-color="cinematic.glass-deep" backdrop-filter="blur(24px) saturate(1.3)" border="1px solid var(--cinematic.hairline)" opacity=0.9 aria-hidden=true
            text c.number font-size=12 color="ink.quiet" font-variant-numeric="tabular-nums" width=40
            text c.name font-size=13 font-weight=600 color="ink.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex=1 min-width=0
            text (c.now != "" ? c.now : t("live.noListings")) font-size=12 color="ink.quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="50%"

component MiniGuideCard
  props
    channel: GuideChannel
    playing: bool
    still: bool
    tune: action
  view
    button press=tune aria-label=t("ui.watchChannel", channel=channel.name) class=ZapCard
      row gap=14 align-items="center" width="100%"
        column position="relative" width=88 height=54 flex-shrink=0 border-radius=10 overflow="hidden" padding=6 box-sizing="border-box" align-items="center" justify-content="center" background-color="cinematic.guide-logo" border="1px solid var(--cinematic.hairline)"
          if channel.logo != ""
            image channel.logo alt="" width="100%" height="100%" object-fit="contain"
          else
            text channel.name.slice(0, 2).toUpperCase() font-size=16 font-weight=750 color="ink.secondary"
        column flex=1 min-width=0 gap=5
          row gap=8 align-items="center"
            text channel.number font-size=12 font-weight=650 color="brand.warm" font-variant-numeric="tabular-nums"
            text channel.name font-size=13 font-weight=600 color="ink.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
            if playing
              text t("live.watching") class=Eyebrow font-size=9 color="ink.quiet" flex-shrink=0
          text (channel.now != "" ? channel.now : (channel.listed ? t("live.nothingNow") : t("live.noListings"))) font-size=17 font-weight=650 color="ink.primary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if channel.nowId != ""
            row gap=8 align-items="center"
              column flex=1 height=3 border-radius=2 background-color="cinematic.track" overflow="hidden" aria-hidden=true
                column height=3 width=`${channel.nowProgress}%` background-color="brand.warm"
              text channel.nowRemaining font-size=11 color="ink.quiet" font-variant-numeric="tabular-nums" flex-shrink=0
          if channel.nextLabel != ""
            text channel.nextLabel font-size=12 color="ink.quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

style ZapButton
  box-sizing = "border-box"
  width = 30
  height = 30
  padding = 8
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  background-color = "cinematic.control"
  color = "ink.primary"
  :hover
    background-color = "cinematic.control-hover"
  :active
    -exact-press-scale = 0.94
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"

style LivePill
  box-sizing = "border-box"
  height = 34
  padding = "0px 14px"
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  :active
    -exact-press-scale = 0.97
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"

style ZapCard
  box-sizing = "border-box"
  width = "100%"
  padding = "14px 16px"
  border = "1px solid var(--cinematic.guide-live-edge)"
  border-radius = 18
  background-color = "cinematic.glass-deep"
  backdrop-filter = "blur(28px) saturate(1.4)"
  box-shadow = "0px 24px 70px var(--cinematic.shadow)"
  color = "ink.primary"
  text-align = "left"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm), 0px 24px 70px var(--cinematic.shadow)"
