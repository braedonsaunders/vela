component LiveControls
  props
    lowDelay: bool
    reconnecting: bool
    delivery: string
    drift: number
    driftLabel: string
    canCatchUp: bool
    toggleLowDelay: action
    catchUp: action
  view
    column gap=10 padding="12px 20px" border-radius=12 background-color="surface.raised"
      text (lowDelay ? t("ui.liveLowDelay") : t("ui.liveAdaptive")) color="brand.warm" font-size=11 letter-spacing="2px"
      if reconnecting
        text t("live.reconnecting") role="status" color="ink.secondary"
      if delivery == "upstream-gap"
        text t("live.gap") role="status" color="ink.secondary"
      if delivery == "segment-delayed"
        text t("live.delayed") role="status" color="ink.secondary"
      if delivery == "waiting-for-publication"
        text t("live.publication") role="status" color="ink.secondary"
      if drift > 0
        text t("live.behind", seconds=driftLabel) role="status" color="ink.secondary"
      row gap=12
        button press=toggleLowDelay buttonStyle="bordered" aria-label=t("ui.toggleLowDelay") aria-pressed=lowDelay
          text (lowDelay ? t("ui.lowDelayOn") : t("ui.useLowDelay"))
        if canCatchUp and drift > 0
          button press=catchUp buttonStyle="bordered"
            text t("live.catchUp")
