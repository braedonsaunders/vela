use PlayerView from "../../foundation/player-models.contract"
use Display, Eyebrow, PrimaryPill, GhostPill, IconButton, chrome, enter, base, glide, spin, breathe, dissolve from "./look.contract"
use PlayerProps from "../../foundation/slot-api.contract"

// A screening's controls: a top bar with the title, a centred spinner while the
// engine waits, a failure card, and a bottom bar with the timeline and icon
// transport. Chrome fades and slides with the foundation's visibility.
// A track or rendition label from the engine reads "English · 5.1 · TrueHD": the first
// part is the item's name, the rest its muted detail.
fn itemName(label: string): string = match label.split(" · ").at(0) { case some(head) => head, case none => label }
fn itemDetail(label: string): string = label.split(" · ").slice(1).join(" · ")
// Seconds as a clock: 4:05, 1:02:09.
fn clock(total: number): string = `${floor(total / 3600) > 0 ? `${floor(total / 3600)}:${floor(total / 60) % 60 < 10 ? "0" : ""}` : ""}${floor(total / 60) % 60}:${floor(total) % 60 < 10 ? "0" : ""}${floor(total) % 60}`

component PlayerChrome
  props
    p: PlayerProps
  inject
    command: action
    seek: action
    editing: action
    close: action
  state scrubbing = false
  // Opening a menu holds the controls up and puts focus on its active item.
  action opened(menu: string, e: ToggleEvent)
    editing(e.newState == "open")
    if e.newState == "open"
      focus(`${menu}-${(menu == "player-cc" ? (p.model.subtitleId == "" ? 0 : 1 + p.model.subtitles.map(x => x.id).indexOf(p.model.subtitleId)) : menu == "player-audio" ? max(0, p.model.audio.map(x => x.id).indexOf(p.model.audioId)) : menu == "player-quality" ? (p.model.qualityAuto ? (p.model.lockedQuality == "" ? 0 : 1 + p.model.qualities.map(x => x.id).indexOf(p.model.lockedQuality)) : max(0, p.model.qualities.map(x => x.id).indexOf(p.model.lockedQuality))) : menu == "player-speed" ? max(0, speeds.indexOf(p.model.speeds.length > 0 ? p.model.speed : 1)) : chapterIndex)}`)
  action scrubFocus(on: bool)
    scrubbing = on
    editing(on)
  derive blocked = p.busy or p.model.state == "ended"
  // The standard rates are always listed; they are live only when the engine can change speed.
  derive speeds = (p.model.speeds.length > 0 ? p.model.speeds : [0.5, 0.75, 1, 1.25, 1.5, 2])
  derive chapterIndex = max(0, p.model.chapters.filter(c => c.seconds <= p.model.position).length - 1)
  derive failure = (p.serverError != "" ? p.serverError : p.model.reason)
  derive failed = p.model.state == "failed" or p.serverError != ""
  derive waiting = not failed and (p.model.waiting or p.model.state == "loading" or p.model.state == "buffering" or p.model.state == "recovering")
  derive shown = (p.visible or p.model.state != "playing")
  derive level = (p.model.muted ? 0 : max(0, min(1, p.model.volume)))
  derive gutter = (p.small ? 16 : 40)
  action scrub(v: number)
    seek(v)
  action setVolume(v: number)
    command("volume", `${v}`)
  action audio(v: string)
    command("audio", v)
  action subtitles(v: string)
    command("subtitle", v)
  action quality(v: string)
    command("quality", v)
  action speed(rate: number)
    command("speed", `${rate}`)
  view
    column position="absolute" inset=0 justify-content="space-between" pointer-events="none" testId="player-chrome" color="ink.primary"
      // Top: close, and the title being screened.
      row position="relative" padding=(p.small ? "18px 16px 72px" : "30px 40px 140px") gap=(p.small ? 14 : 20) align-items="center" background-image="linear-gradient(180deg, var(--cinematic.player-top) 0%, var(--cinematic.player-upper) 38%, var(--cinematic.player-mid) 68%, var(--cinematic.scrim-clear) 100%)" opacity=(shown ? 1 : 0) translate=(shown or p.still ? "0px 0px" : "0px -14px") transition=chrome(p.still)
        button press=close pointer-events=(shown ? "auto" : "none") aria-label=t("ui.closePlayer") class=IconButton width=46 height=46 padding=13 flex-shrink=0 transition=`background-color 180ms linear`
          image "symbol:back" width=20 height=20
        column gap=4 flex=1 min-width=0
          text t("ui.nowPlaying") class=Eyebrow font-size=10 color="ink.quiet"
          text p.title class=Display font-size=(p.small ? 24 : 34) line-clamp=1 text-shadow="0px 2px 18px var(--cinematic.shadow)"
      // Centre: the engine is waiting, or playback has failed.
      if failed
        column pointer-events="auto" align-self="center" align-items="center" text-align="center" gap=14 padding=(p.small ? "26px 22px" : "34px 40px") margin="0px 16px" max-width=440 box-sizing="border-box" border-radius=24 background-color="cinematic.glass" backdrop-filter="blur(28px) saturate(1.3)" border="1px solid var(--cinematic.glass-edge)" box-shadow="0px 30px 90px var(--cinematic.shadow)" role="alert" testId="player-status" animation=enter(p.still, 0)
          image "symbol:alert" width=26 height=26 color="brand.warm" aria-hidden=true
          text t("ui.playbackInterrupted") class=Display font-size=30
          if failure != ""
            text failure color="ink.secondary" font-size=14 line-height=1.55
          row gap=10 margin-top=6 flex-wrap="wrap" justify-content="center"
            button press=command("retry", "") class=PrimaryPill height=44 padding="0px 24px"
              text t("ui.tryAgain") font-size=14
            button press=close class=GhostPill height=44 padding="0px 22px"
              text t("ui.closePlayer") font-size=14
      else
        if waiting
          column align-self="center" align-items="center" gap=18 role="status" aria-label=(p.model.state == "recovering" ? t("ui.findingAWayForward") : p.model.state == "loading" ? t("ui.preparingYourScreening") : t("ui.buildingALittleBreathingRoom")) testId="player-status" animation=(p.still ? "dissolve 240ms linear both" : "dissolve 400ms ease-out 120ms both")
            Spinner(size=(p.small ? 52 : 64), still=p.still)
            if p.model.state == "loading" or p.model.state == "recovering"
              text (p.model.state == "recovering" ? t("ui.findingAWayForward") : t("ui.preparingYourScreening")) class=Display font-size=(p.small ? 22 : 26) color="ink.primary" text-shadow="0px 2px 24px var(--cinematic.shadow)"
      // Bottom: the timeline, then icon transport and screening controls.
      column position="relative" padding=(p.small ? "80px 16px 18px" : "150px 40px 30px") gap=(p.small ? 10 : 14) background-image="linear-gradient(0deg, var(--cinematic.player-bottom) 0%, var(--cinematic.player-upper) 42%, var(--cinematic.player-mid) 72%, var(--cinematic.scrim-clear) 100%)" opacity=(shown ? 1 : 0) translate=(shown or p.still ? "0px 0px" : "0px 18px") transition=chrome(p.still) pointer-events=(shown ? "auto" : "none")
        if p.model.actionError != "" and failure == ""
          text p.model.actionError color="brand.warm" font-size=13 role="status"
        // Timeline: buffered ranges, played fill and a thumb over a transparent native range.
        column position="relative" height=22 justify-content="center"
          column position="absolute" left=0 right=0 height=(scrubbing ? 6 : 4) border-radius=3 background-color="cinematic.track-strong" overflow="hidden" transition=(p.still ? "none" : `height ${base()}ms ${glide()}`)
            for range in p.model.buffered key=range.id
              column position="absolute" top=0 bottom=0 left=`${range.left}%` width=`${range.width}%` background-color="cinematic.buffer"
            column position="absolute" left=0 top=0 bottom=0 width=`${p.model.progress}%` border-radius=3 background-color="ink.primary"
          for chapter in p.model.chapters key=chapter.id
            column position="absolute" left=`${chapter.percent}%` height=(scrubbing ? 6 : 4) width=2 background-color="cinematic.marker" aria-hidden=true
          column position="absolute" left=`calc(${p.model.progress}% - 7px)` width=14 height=14 border-radius=7 background-color="ink.primary" box-shadow=(scrubbing ? "0px 0px 0px 6px var(--cinematic.focus-halo), 0px 2px 10px var(--cinematic.shadow)" : "0px 2px 10px var(--cinematic.shadow)") scale=(scrubbing or p.still ? 1 : 0.85) transition=(p.still ? "none" : `scale ${base()}ms ${glide()}, box-shadow ${base()}ms ${glide()}`) aria-hidden=true
          input focus=scrubFocus(true) blur=scrubFocus(false) type="range" min=0 max=max(1, p.model.duration) step=0.1 value=p.model.position change=scrub aria-label=t("ui.playbackPosition") testId="player-scrub" disabled=(p.model.duration <= 0 or blocked) position="absolute" left=0 right=0 width="100%" height=22 margin=0 opacity=0 cursor="pointer"
        row align-items="center" justify-content="space-between"
          text p.model.elapsed font-size=12 font-variant-numeric="tabular-nums" color="ink.secondary"
          text p.model.remaining font-size=12 font-variant-numeric="tabular-nums" color="ink.secondary"
        row gap=(p.small ? 4 : 8) align-items="center" margin-top=(p.small ? 0 : 2)
          button disabled=(p.model.state == "ended") press=command(p.model.playing ? "pause" : "play", "") aria-label=(p.model.state == "ended" ? t("ui.finished") : p.model.playing ? t("ui.pause") : t("ui.play")) testId="player-toggle" class=PrimaryPill width=(p.small ? 48 : 52) height=(p.small ? 48 : 52) padding=(p.small ? 14 : 15) box-sizing="border-box" flex-shrink=0 transition=`background-color 180ms linear`
            image (p.model.playing ? "symbol:pause-fill" : "symbol:play-fill") width=22 height=22
          button disabled=blocked press=command("seekBy", "-10") aria-label=t("ui.back10Seconds") class=Bare width=44 height=44 padding=8 flex-shrink=0
            SkipIcon(forward=false)
          button press=command("seekBy", "10") disabled=(p.model.duration <= 0 or blocked) aria-label=t("ui.forward10Seconds") class=Bare width=44 height=44 padding=8 flex-shrink=0
            SkipIcon(forward=true)
          button press=command("mute", "") aria-label=(p.model.muted ? t("ui.unmute") : t("ui.mute")) aria-pressed=p.model.muted testId="player-mute" class=Bare width=44 height=44 padding=11 flex-shrink=0
            image (p.model.muted or p.model.volume <= 0 ? "symbol:speaker-mute" : "symbol:speaker") width=22 height=22
          if not p.small
            column position="relative" width=104 height=22 justify-content="center" flex-shrink=0 margin-right=8
              column position="absolute" left=0 right=0 height=4 border-radius=2 background-color="cinematic.track-strong" overflow="hidden"
                column height=4 width=`${level * 100}%` background-color="ink.primary"
              column position="absolute" left=`calc(${level * 100}% - 6px)` width=12 height=12 border-radius=6 background-color="ink.primary" box-shadow="0px 1px 6px var(--cinematic.shadow)" aria-hidden=true
              input type="range" min=0 max=1 step=0.01 value=level change=setVolume focus=editing(true) blur=editing(false) aria-label=t("ui.volume") testId="player-volume" position="absolute" left=0 width="100%" height=22 margin=0 opacity=0 cursor="pointer"
          row flex=1 min-width=0 justify-content="flex-end"
            if not p.small
              text (p.model.quality != "" ? p.model.quality : p.model.path) testId="player-quality" font-size=11 font-weight=600 color="ink.secondary" letter-spacing="0.04em" line-clamp=1 padding="4px 10px" border="1px solid var(--cinematic.glass-edge)" border-radius=6 margin-right=6
          button popovertarget="player-cc" aria-label=t("ui.subtitles") testId="player-cc-button" class=Bare width=44 height=44 padding=10 flex-shrink=0
            CaptionsIcon(on=(p.model.subtitleId != ""))
          button popovertarget="player-audio" aria-label=t("ui.audio") testId="player-audio-button" class=Bare width=44 height=44 padding=10 flex-shrink=0
            image "symbol:waveform" width=22 height=22
          button popovertarget="player-quality" aria-label=t("ui.quality") testId="player-quality-button" class=Bare width=44 height=44 padding=10 flex-shrink=0
            image "symbol:settings" width=22 height=22
          button popovertarget="player-speed" aria-label=t("player.speed") testId="player-speed-button" class=Bare width=44 height=44 padding=10 flex-shrink=0
            SpeedIcon()
          button popovertarget="player-chapters" aria-label=t("ui.chapters") testId="player-chapters-button" disabled=(p.model.chapters.length == 0) class=Bare width=44 height=44 padding=10 flex-shrink=0
            image "symbol:list" width=22 height=22
          if p.model.pip
            button press=command("pip", "") aria-label=t("ui.pictureInPicture") class=Bare width=44 height=44 padding=10 flex-shrink=0
              PipIcon()
          if p.model.fullscreen
            button press=command("fullscreen", "") aria-label=t("ui.fullscreen") class=Bare width=44 height=44 padding=10 flex-shrink=0
              FullscreenIcon()
      // One compact menu per control: the menu's name, then a radio list (arrow keys move, Escape closes).
      MenuPanel(menu="player-cc", name=t("ui.subtitles"), small=p.small, opened=opened)
        ChoiceRow(menu="player-cc", index=0, count=p.model.subtitles.length + 1, label=t("ui.off"), detail="", selected=(p.model.subtitleId == "" and p.model.pendingSubtitleId == ""), pending=false, enabled=not blocked, still=p.still, choose=subtitles(""))
        for track, i in p.model.subtitles key=track.id
          ChoiceRow(menu="player-cc", index=i + 1, count=p.model.subtitles.length + 1, label=itemName(track.label), detail=itemDetail(track.label), selected=(p.model.subtitleId == track.id), pending=(p.model.pendingSubtitleId == track.id), enabled=not blocked, still=p.still, choose=subtitles(track.id))
      MenuPanel(menu="player-audio", name=t("ui.audio"), small=p.small, opened=opened)
        if p.model.audio.length > 0
          for track, i in p.model.audio key=track.id
            ChoiceRow(menu="player-audio", index=i, count=p.model.audio.length, label=itemName(track.label), detail=itemDetail(track.label), selected=(p.model.audioId == track.id), pending=(p.model.pendingAudioId == track.id), enabled=not blocked, still=p.still, choose=audio(track.id))
        else
          ChoiceRow(menu="player-audio", index=0, count=1, label=itemName(p.model.audioLabel != "" ? p.model.audioLabel : t("player.audioDefault")), detail=itemDetail(p.model.audioLabel), selected=true, pending=false, enabled=false, still=p.still, choose=audio(""))
      MenuPanel(menu="player-quality", name=t("ui.quality"), small=p.small, opened=opened)
        if p.model.qualityAuto
          ChoiceRow(menu="player-quality", index=0, count=p.model.qualities.length + 1, label=t("player.auto"), detail=(p.model.lockedQuality == "" ? p.model.quality : ""), selected=(p.model.lockedQuality == ""), pending=false, enabled=not blocked, still=p.still, choose=quality(""))
        for option, i in p.model.qualities key=option.id
          ChoiceRow(menu="player-quality", index=(p.model.qualityAuto ? i + 1 : i), count=(p.model.qualityAuto ? p.model.qualities.length + 1 : p.model.qualities.length), label=itemName(option.label), detail=itemDetail(option.label), selected=(p.model.lockedQuality == option.id or (p.model.lockedQuality == "" and not p.model.qualityAuto and option.label == p.model.quality)), pending=false, enabled=not blocked, still=p.still, choose=quality(option.id))
        if p.model.qualities.length == 0 and not p.model.qualityAuto
          ChoiceRow(menu="player-quality", index=0, count=1, label=itemName(p.model.quality != "" ? p.model.quality : p.model.path), detail=itemDetail(p.model.quality != "" ? p.model.quality : p.model.path), selected=true, pending=false, enabled=false, still=p.still, choose=quality(""))
      MenuPanel(menu="player-speed", name=t("player.speed"), small=p.small, opened=opened)
        for rate, i in speeds key=`${rate}`
          ChoiceRow(menu="player-speed", index=i, count=speeds.length, label=`${formatNumber(rate, "decimal")}×`, detail=(rate == 1 ? t("player.normal") : ""), selected=(p.model.speeds.length == 0 ? rate == 1 : p.model.speed == rate), pending=false, enabled=(p.model.speeds.length > 0 and not blocked), still=p.still, choose=speed(rate))
      if p.model.chapters.length > 0
        MenuPanel(menu="player-chapters", name=t("ui.chapters"), small=p.small, opened=opened)
          for chapter, i in p.model.chapters key=chapter.id
            ChoiceRow(menu="player-chapters", index=i, count=p.model.chapters.length, label=chapter.label, detail=clock(chapter.seconds), selected=(i == chapterIndex), pending=false, enabled=not blocked, still=p.still, choose=seek(chapter.seconds))

// A control's menu: a compact glass popover over its button, the menu's name above a radio list.
component MenuPanel
  props
    menu: string
    name: string
    small: bool
    opened: action
  slot
  view
    column id=menu popover="auto" position="absolute" position-area="top span-left" margin-bottom=12 toggle=opened(menu) pointer-events="auto" role="dialog" aria-label=name width=(small ? "calc(100vw - 32px)" : 300) max-height="min(60vh, 520px)" overflow-y="auto" box-sizing="border-box" padding="14px 8px 8px" gap=2 border="1px solid var(--cinematic.glass-edge)" border-radius=18 background-color="cinematic.popover" backdrop-filter="blur(30px) saturate(1.4)" color="ink.primary" box-shadow="0px 30px 90px var(--cinematic.shadow), inset 0px 1px 0px var(--cinematic.ring)"
      text name font-size=11 font-weight=650 letter-spacing="0.1em" text-transform="uppercase" color="ink.quiet" padding="0px 12px 8px"
      column role="radiogroup" aria-label=name gap=2
        children

// One choice in a player menu: the check on the active item (a spinner while the engine
// switches to it), the item's name and one muted detail. Unavailable items stay, dimmed.
component ChoiceRow
  props
    menu: string
    index: number
    count: number
    label: string
    detail: string
    selected: bool
    pending: bool
    enabled: bool
    still: bool
    choose: action
  action pick
    if enabled
      choose()
  action keys(k: string)
    if k == "ArrowDown"
      preventDefault()
      focus(`${menu}-${(index + 1) % count}`)
    if k == "ArrowUp"
      preventDefault()
      focus(`${menu}-${(index + count - 1) % count}`)
    if k == "Home"
      preventDefault()
      focus(`${menu}-0`)
    if k == "End"
      preventDefault()
      focus(`${menu}-${count - 1}`)
  view
    button id=`${menu}-${index}` role="radio" aria-checked=selected aria-disabled=(not enabled) press=pick key=keys display="flex" align-items="center" gap=12 box-sizing="border-box" min-height=44 padding="8px 12px" border="none" border-radius=12 background-color=(selected ? "cinematic.control" : "cinematic.scrim-clear") color="ink.primary" text-align="left" opacity=(enabled or selected ? 1 : 0.4) cursor=(enabled ? "pointer" : "default") transition="background-color 180ms linear"
      :hover
        background-color = "cinematic.control-hover"
      :focus-visible
        box-shadow = "0px 0px 0px 2px var(--brand.warm)"
      column width=16 height=16 flex-shrink=0 align-items="center" justify-content="center"
        if pending
          Spinner(size=14, still=still)
        else if selected
          image "symbol:checkmark" width=14 height=14 color="brand.warm"
      text label flex=1 min-width=0 font-size=14 font-weight=(selected ? 650 : 500) line-clamp=1
      if detail != ""
        text detail flex-shrink=0 max-width="55%" font-size=12 color="ink.quiet" line-clamp=1 font-variant-numeric="tabular-nums"

// Closed captions: a rounded frame with two caption lines, tinted while subtitles are on.
component CaptionsIcon
  props
    on: bool
  view
    svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
      if on
        rect x=2.5 y=4.5 width=19 height=15 rx=3 fill="currentcolor" opacity=0.3
      rect x=2.5 y=4.5 width=19 height=15 rx=3 fill="none" stroke="currentcolor" stroke-width=1.7
      path d="M6.5 12.5h4M13 12.5h4.5M6.5 15.5h7M15.5 15.5h2" fill="none" stroke="currentcolor" stroke-width=1.7 stroke-linecap="round"

style Bare
  border = "none"
  border-radius = 999
  background-color = "cinematic.scrim-clear"
  color = "ink.primary"
  box-sizing = "border-box"
  flex-shrink = 0
  :hover
    background-color = "cinematic.control-hover"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"
  :disabled
    opacity = 0.35

// A ring with a travelling arc: the engine is preparing, buffering or seeking.
component Spinner
  props
    size: number
    still: bool
  view
    column width=size height=size position="relative" aria-hidden=true
      svg width=size height=size viewBox="0 0 48 48" position="absolute" inset=0
        circle cx=24 cy=24 r=21 fill="none" stroke="var(--cinematic.track)" stroke-width=2.5
      svg width=size height=size viewBox="0 0 48 48" position="absolute" inset=0 animation=(still ? "none" : "spin 1.1s cubic-bezier(0.5, 0.15, 0.5, 0.85) infinite")
        circle cx=24 cy=24 r=21 fill="none" stroke="var(--ink.primary)" stroke-width=2.5 stroke-linecap="round" stroke-dasharray="34 98"
      column position="absolute" left="50%" top="50%" width=8 height=8 margin-left=-4 margin-top=-4 border-radius=4 background-color="brand.warm" animation=(still ? "none" : "breathe 1.6s cubic-bezier(0.45, 0, 0.55, 1) infinite")

// Circular arrow with "10": back (counter-clockwise) or forward.
component SkipIcon
  props
    forward: bool
  view
    svg width=28 height=28 viewBox="0 0 24 24" aria-hidden=true
      path d=(forward ? "M12 5.5a7.5 7.5 0 1 0 7.5 7.5" : "M12 5.5a7.5 7.5 0 1 1-7.5 7.5") fill="none" stroke="currentcolor" stroke-width=1.7 stroke-linecap="round"
      path d=(forward ? "M11 2.6 14.2 5.5 11 8.4" : "M13 2.6 9.8 5.5 13 8.4") fill="none" stroke="currentcolor" stroke-width=1.7 stroke-linecap="round" stroke-linejoin="round"
      text "10" x=12 y=16 font-size=7 font-weight=700 text-anchor="middle" fill="currentcolor"

component PipIcon
  view
    svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
      rect x=2.5 y=4.5 width=19 height=15 rx=3 fill="none" stroke="currentcolor" stroke-width=1.7
      rect x=12 y=11.5 width=7 height=5.5 rx=1.5 fill="currentcolor"

component FullscreenIcon
  view
    svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
      path d="M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15" fill="none" stroke="currentcolor" stroke-width=1.8 stroke-linecap="round"

// Playback speed: a dial with its needle leaning forward.
component SpeedIcon
  view
    svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
      path d="M4.5 17.5a8.5 8.5 0 1 1 15 0" fill="none" stroke="currentcolor" stroke-width=1.7 stroke-linecap="round"
      path d="M12 14.5l4-5" fill="none" stroke="currentcolor" stroke-width=1.9 stroke-linecap="round"
      circle cx=12 cy=14.5 r=1.6 fill="currentcolor"
