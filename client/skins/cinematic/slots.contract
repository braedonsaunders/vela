use Card, FeedRow, HomeModel, SearchModel, DetailModel, Viewport, cardName, skinLabel from "../../foundation/models.contract"

keyframes arrive
  from opacity=0 translate="0px 10px"

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
    viewport: Viewport
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
  slot
  state menuOpen = false
  action toggleMenu
    menuOpen = not menuOpen
  action changeAppearance(value: string)
    menuOpen = false
    chooseSkin(value)
  action leaveSession
    menuOpen = false
    signOut()
  action menuKey(k: string)
    if k == "Escape" and menuOpen
      preventDefault()
      menuOpen = false
      focus("profile-menu-trigger")
  view
    column position="relative" key=menuKey height="100%" min-height=0 background-color="surface.page" color="ink.primary" color-scheme="dark" font-family="system-ui, sans-serif"
      if viewer != ""
        row role="navigation" aria-label=t("ui.mainNavigation") padding="20px 5%" align-items="center" gap=24
          link href="/" color="ink.primary" text-decoration="none" aria-label=t("ui.velaHome")
            text t("ui.vela") font-size=30 font-weight=600 letter-spacing="-1.5px"
          if viewport.width >= 640
            text t("ui.yourEveningReimagined") font-size=10 letter-spacing="2px" color="ink.quiet" flex=1
          row flex=1 gap=16 justify-content="end"
            if canLive
              button press=live border="none" background-color="transparent" color="ink.secondary"
                text t("ui.live")
          if viewer != ""
            button id="profile-menu-trigger" press=toggleMenu aria-expanded=menuOpen aria-controls="viewer-settings" aria-label=t("ui.profileAndAppearance") testId="profile-menu" background-color="surface.raised" border="1px solid var(--surface.line)" border-radius=24 padding=(viewport.width < 640 ? "10px 14px" : "10px 18px") color="ink.primary"
              text (viewport.width < 640 ? viewer.slice(0, 1) : viewer) font-size=13
      if viewer != "" and menuOpen
        column id="viewer-settings" position="absolute" top=72 right="5%" z-index=30 margin=0 padding=22 gap=16 border="1px solid var(--surface.line)" border-radius=20 background-color="surface.raised" color="ink.primary" min-width=210
          text viewer font-weight=600
          if skins.length > 1
            text t("ui.appearance") font-size=12 color="ink.secondary"
            select value=skin change=changeAppearance aria-label=t("ui.appearance") testId="skin-picker" background-color="surface.page" color="ink.primary" border="1px solid var(--surface.line)" padding=10 border-radius=10
              for name in skins key=name
                option value=name
                  text skinLabel(name)
          vela-install pwaAction="install" buttonLabel=t("pwa.install")
          vela-install pwaAction="update" buttonLabel=t("pwa.update")
          button press=leaveSession background-color="transparent" border="none" color="ink.secondary" text-align="left" padding=0
            text t("ui.signOut")
      children

component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
  state lifted = false
  action hoverCard(over: bool)
    lifted = over
  action focusCard
    lifted = true
  action restCard
    lifted = false
  view
    column width=(small ? 142 : 190) flex-shrink=0 gap=10 intersect=observe(card.receipt)
      button press=selectTitle(card.id, card.kind, card.receipt) aria-label=cardName(card) testId=`title-${card.id}` hover=hoverCard focus=focusCard blur=restCard position="relative" scale=(lifted and not still ? 1.035 : 1) translate=(lifted and not still ? "0px -5px" : "0px 0px") box-shadow=(lifted ? "0px 18px 38px var(--cinematic.card-shadow)" : "none") padding=0 border="none" background-color="surface.raised" color="ink.primary" border-radius=12 overflow="hidden" text-align="left" transition=(still ? "none" : "scale 180ms ease, translate 180ms ease, box-shadow 180ms ease")
        if card.poster != ""
          image card.poster alt="" width="100%" height=(small ? 206 : 274) object-fit="cover"
        else
          column height=(small ? 206 : 274) padding=16 justify-content="end"
            text card.name font-size=22 font-weight=600
        if card.progressSeconds > 0 and card.durationSeconds > 0
          column position="absolute" left=10 right=10 bottom=10 height=3 border-radius=2 background-color="surface.line"
            column height=3 width=`${min(100, card.progressSeconds / card.durationSeconds * 100)}%` border-radius=2 background-color="brand.warm"
      text card.name font-size=14 font-weight=600 line-clamp=2
      text card.facts font-size=11 color="ink.quiet" line-clamp=1

component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column gap=18 padding="0px 5% 34px"
      text row.name role="heading" aria-level=2 font-size=(small ? 20 : 23) font-weight=550 letter-spacing="-0.5px"
      scroll overflow-x="auto" overflow-y="hidden"
        row gap=(small ? 14 : 20) align-items="flex-start"
          for card in row.items key=card.id
            TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Home
  props
    model: HomeModel
    active: bool
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
  slot
  view
    column
      column position="relative" min-height=(query != "" ? 160 : model.hero.length == 0 ? 0 : small ? 360 : 432) justify-content="end" overflow="hidden"
        if query == ""
          for hero in model.hero key=hero.id
            column position="absolute" inset=0
              if hero.backdrop != ""
                image hero.backdrop alt="" width="100%" height="100%" object-fit="cover" opacity=0.92
              if model.trailerReady and model.trailerUrl != "" and model.trailerExpiresAt > 0 and not still
                vela-preview url=model.trailerUrl active=(active and query == "" ? "true" : "false") still=(still ? "true" : "false") expiresAt=model.trailerExpiresAt.toString() position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
              column position="absolute" inset=0 background-image="linear-gradient(0deg, var(--surface.page) 0%, var(--cinematic.scrim-clear) 65%), linear-gradient(90deg, var(--cinematic.scrim-deep) 0%, var(--cinematic.scrim-mid) 45%, var(--cinematic.scrim-faint) 100%)"
            column position="relative" padding="20px 7%" gap=12 max-width=700 intersect=observe(hero.receipt) animation=(still ? "none" : "arrive 500ms ease both")
              row gap=10 align-items="center"
                column width=22 height=3 border-radius=2 background-color=(hero.accent == "" ? "brand.warm" : hero.accent)
                text t("ui.selectedForYou") font-size=10 letter-spacing="3px" color="brand.warm"
              text hero.name role="heading" aria-level=1 font-size=(small ? 36 : 62) font-weight=550 letter-spacing="-2px" line-height=1.05
              text hero.facts font-size=12 color="ink.secondary"
              if not small
                text hero.summary font-size=15 color="ink.secondary" line-clamp=2 line-height=1.6
              button press=selectTitle(hero.id, hero.kind, hero.receipt) aria-label=cardName(hero) background-color="ink.primary" color="ink.inverse" padding="12px 22px" border="none" border-radius=24 align-self="start"
                text t("ui.exploreTitle") font-size=13 font-weight=600
        column padding=(small ? "20px 5% 28px" : "26px 18% 38px")
          children
      if query == ""
        for row in model.rows key=row.id
          Row(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component SearchSurface
  props
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column gap=22 padding="0px 0px 40px" animation=(still ? "none" : "arrive 200ms ease both")
      text t("ui.resultsForQuery", query=query) role="heading" aria-level=1 font-size=24 padding="0px 5%"
      if error
        text t("ui.searchIsUnavailableTryAnotherQuery") role="status" color="ink.secondary" padding="0px 5%"
      else
        if loading
          text t("ui.findingTitles") role="status" color="ink.secondary" padding="0px 5%"
        else
          if model.items.length == 0
            text t("ui.noTitleMatchesTryANameAMoodOrADifferentDescription") role="status" color="ink.secondary" padding="0px 5%"
          else
            Row(row=FeedRow(id="fast", name=t("ui.titleMatches"), receipt="", items=model.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if descriptive.query == query and descriptive.generation == generation and descriptive.items.length > 0
          Row(row=FeedRow(id="vibe", name=t("ui.theFeelingYouReLookingFor"), receipt="", items=descriptive.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if ai.query == query and ai.generation == generation and aiAvailable and ai.aiStatus != ""
          column gap=12
            text t("ui.aLittleFurtherAfield") role="heading" aria-level=2 font-size=22 padding="0px 5%"
            if ai.aiStatus == "queued" or ai.aiStatus == "running"
              text t("ui.exploringYourDescription") role="status" color="ink.secondary" padding="0px 5%"
            if ai.items.length > 0
              Row(row=FeedRow(id="ai", name=t("ui.discoveredForYou"), receipt="", items=ai.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
            if ai.aiStatus == "failed"
              text t("ui.discoveryCouldnTFinishYourTitleMatchesAreReadyAbove") color="ink.secondary" padding="0px 5%"

component Detail
  props
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  derive selectedSeason = match first(model.title) { case some(t) => (t.kind == "season" ? t.id : match first(model.seasons) { case some(s) => s.id, case none => "" }), case none => "" }
  derive upNext = match first(model.episodes.filter(e => not e.played)) { case some(e) => [e], case none => [] }
  action pickSeason(id: string)
    selectTitle(id, "season", "")
  view
    column gap=28 padding-bottom=48 animation=(still ? "none" : "arrive 250ms ease both")
      for title in model.title key=title.id
        column position="relative" min-height=(small ? 520 : 600) justify-content="end" overflow="hidden"
          if title.backdrop != ""
            image title.backdrop alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="cover" opacity=0.9
          column position="absolute" inset=0 background-image="linear-gradient(0deg, var(--surface.page) 0%, var(--cinematic.scrim-soft) 90%), linear-gradient(90deg, var(--cinematic.scrim-strong), var(--cinematic.scrim-faint))"
          column position="relative" padding=(small ? "80px 7% 32px" : "110px 7% 42px") max-width="52rem" gap=18
            text (title.kind == "movie" ? t("ui.film") : title.kind == "show" ? t("ui.series") : title.kind == "season" ? t("ui.season") : t("ui.episode")) color="brand.warm" text-transform="uppercase" letter-spacing="3px" font-size=11
            if title.logo != ""
              image title.logo alt=title.name width=260 height=100 object-fit="contain"
            else
              text title.name role="heading" aria-level=1 font-size=(small ? 42 : 76) line-height=1.05 font-weight=550 letter-spacing="-1.5px"
            text title.facts color="ink.secondary" font-size=13
            text title.genres.join(" · ") color="ink.secondary" font-size=13
            if model.mediaFacts.length > 0
              row gap=12 flex-wrap="wrap"
                for fact in model.mediaFacts key=fact
                  text fact font-size=12 color="brand.warm" border="1px solid var(--surface.line)" padding="4px 8px" border-radius=5
            text title.summary color="ink.primary" font-size=16 line-height=1.6
            if model.canPlay
              button press=play(title.id) background-color="ink.primary" color="ink.inverse" border="none" border-radius=28 padding="15px 28px" align-self="start" testId="detail-play"
                text (model.resumeSeconds > 0 ? t("ui.resumePositionIn", position=model.resumePosition) : t("ui.play")) font-weight=650
              if model.resumeSeconds > 0 and title.durationSeconds > 0
                column width=230 height=3 border-radius=2 background-color="surface.line" role="progressbar" aria-label=t("ui.watchProgress") aria-valuemin=0 aria-valuemax=title.durationSeconds aria-valuenow=min(title.durationSeconds, max(0, model.resumeSeconds))
                  column height=3 width=`${min(100, model.resumeSeconds / title.durationSeconds * 100)}%` background-color="brand.warm"
            for trailer in model.extras.filter(e => e.kind == "trailer" and e.ready) key=trailer.id
              button press=playExtra(trailer.id) align-self="start" border="1px solid var(--surface.line)" border-radius=28 background-color="surface.glass" color="ink.primary" padding="13px 24px"
                text t("ui.watchTrailer")
      if model.seasons.length > 0 or model.episodes.length > 0
        column padding="0px 7%" gap=22
          row align-items="center" justify-content="space-between" flex-wrap="wrap" gap=16 padding-right=(small ? 52 : 0)
            text t("ui.episodes") role="heading" aria-level=2 font-size=28 font-weight=550
            if model.seasons.length > 0
              select value=selectedSeason change=pickSeason aria-label=t("ui.season") testId="season-picker" padding="12px 18px" border="1px solid var(--surface.line)" border-radius=12 background-color="surface.raised" color="ink.primary"
                for season in model.seasons key=season.id
                  option value=season.id
                    text season.name
          for episode in upNext key=episode.id
            row flex-direction=(small ? "column" : "row") align-items=(small ? "stretch" : "center") justify-content="space-between" gap=18 padding=24 border-radius=18 background-color="surface.raised"
              column gap=6 flex=1
                text (episode.progressSeconds > 0 ? t("ui.continueWatching") : t("ui.upNext")) color="brand.warm" font-size=10 letter-spacing="2px"
                text episode.name role="heading" aria-level=3 font-size=24
              button align-self=(small ? "stretch" : "center") press=play(episode.id) aria-label=(episode.progressSeconds > 0 ? t("ui.resumeTitle", title=episode.name) : t("ui.playTitle", title=episode.name)) padding="13px 24px" border-radius=26 background-color="ink.primary" color="ink.inverse" border="none"
                text (episode.progressSeconds > 0 ? t("ui.resumeEpisode") : t("ui.playEpisode")) font-weight=600
          for episode in model.episodes key=episode.id
            row gap=(small ? 14 : 24) align-items="center" padding="18px 0px" border-bottom="1px solid var(--surface.line)"
              button press=selectTitle(episode.id, episode.kind, episode.receipt) aria-label=cardName(episode) testId=`episode-${episode.id}` padding=0 border="none" border-radius=10 overflow="hidden" background-color="surface.raised" color="ink.primary" flex-shrink=0
                if episode.backdrop != ""
                  image episode.backdrop alt="" width=(small ? 100 : 180) height=(small ? 66 : 102) object-fit="cover"
                else
                  text (episode.episodeNumber > 0 ? episode.episodeNumberLabel : t("ui.episode")) width=(small ? 100 : 180) padding="22px 0px"
              column flex=1 min-width=0 gap=8
                text (episode.episodeNumber > 0 ? t("ui.numberTitle", number=episode.episodeNumberLabel, title=episode.name) : episode.name) role="heading" aria-level=3 font-size=(small ? 16 : 20) font-weight=550
                text (episode.played ? t("ui.factsWatched", facts=episode.facts) : episode.facts) color="ink.secondary" font-size=12
                if not small
                  text episode.summary color="ink.secondary" font-size=14 line-clamp=2 line-height=1.5
                if episode.progressSeconds > 0 and episode.durationSeconds > 0
                  column height=3 border-radius=2 background-color="surface.line" role="progressbar" aria-label=t("ui.titleWatchProgress", title=episode.name) aria-valuemin=0 aria-valuemax=episode.durationSeconds aria-valuenow=min(episode.durationSeconds, max(0, episode.progressSeconds))
                    column height=3 width=`${min(100, episode.progressSeconds / episode.durationSeconds * 100)}%` border-radius=2 background-color="brand.warm"
              button press=play(episode.id) aria-label=t("ui.playTitle", title=episode.name) border="1px solid var(--surface.line)" border-radius=24 width=44 height=44 padding=10 box-sizing="border-box" background-color="surface.glass" color="ink.primary"
                image "symbol:play-fill"
      if model.extras.length > 0
        column padding="0px 7%" gap=14
          text t("ui.extras") role="heading" aria-level=2 font-size=24
          for extra in model.extras key=extra.id
            button press=playExtra(extra.id) disabled=(not extra.ready) background-color="surface.raised" color="ink.primary" border="none" padding=16 border-radius=12 text-align="left"
              text (extra.ready ? extra.name : t("ui.titleNotAvailable", title=extra.name))
      if model.cast.length > 0
        column padding="0px 7%" gap=12
          text t("ui.featuring") role="heading" aria-level=2 font-size=24
          scroll overflow-x="auto" height=88
            row gap=12
              for person in model.cast key=person
                text person padding="20px 24px" border-radius=12 background-color="surface.raised" color="ink.secondary" flex-shrink=0
      if model.crew.length > 0
        column padding="0px 7%" gap=12
          text t("ui.behindTheStory") role="heading" aria-level=2 font-size=24
          text model.crew.join(" · ") line-height=1.6
      if model.related.length > 0
        for related in model.related key=related.id
          Row(row=related, small=small, still=still, selectTitle=selectTitle, observe=observe)

fn detailPresentation(width: number): string = "fullscreen"
fn detailSplit(width: number): string = "none"

component SearchField
  props
    query: string
    edit: action
  state focused = false
  action focusField
    focused = true
  action blurField
    focused = false
  view
    row align-items="center" gap=12 padding="8px 18px" border-radius=32 background-color="surface.glass" border=(focused ? "1px solid var(--brand.warm)" : "1px solid var(--surface.line)") box-shadow="0px 16px 50px var(--cinematic.search-shadow)"
      image "symbol:search" color="ink.secondary" width=20 height=20
      input value=query input=edit focus=focusField blur=blurField outline="none" placeholder=t("ui.aTitleAFeelingAWorldToGetLostIn") aria-label=t("ui.searchYourLibrary") testId="search" border-radius=14 flex=1 min-width=0 padding="12px 0px" border="none" background-color="transparent" color="ink.primary" font-size=15
        ::placeholder
          color="ink.secondary"
      if query != ""
        button press=edit("") aria-label=t("ui.clearSearch") border="none" background-color="transparent" color="ink.secondary" padding=8
          image "symbol:close"
