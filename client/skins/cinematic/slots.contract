use Card, FeedRow, HomeModel, SearchModel, DetailModel, QuickModel, Viewport from "../../foundation/models.contract"

keyframes arrive
  from opacity=0 translate="0px 10px"

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
    viewport: Viewport
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
  slot
  view
    column height="100%" min-height=0 background-color="surface.page" color="ink.primary" color-scheme="dark" font-family="system-ui, sans-serif"
      row padding="20px 5%" align-items="center" gap=24
        link href="/" color="ink.primary" text-decoration="none" aria-label="Vela home"
          text "vela" font-size=30 font-weight=600 letter-spacing="-1.5px"
        if viewport.width >= 640
          text "YOUR EVENING, REIMAGINED" font-size=10 letter-spacing="2px" color="ink.quiet" flex=1
        row flex=1 gap=16 justify-content="end"
          if canLive
            button press=live border="none" background-color="transparent" color="ink.secondary"
              text "Live"
        if viewer != ""
          button popovertarget="viewer-settings" aria-label="Profile and appearance" testId="profile-menu" background-color="surface.raised" border="1px solid var(--surface.line)" border-radius=24 padding=(viewport.width < 640 ? "10px 14px" : "10px 18px") color="ink.primary"
            text (viewport.width < 640 ? viewer.slice(0, 1) : viewer) font-size=13
      column id="viewer-settings" popover="auto" position="absolute" top=72 right="5%" left="auto" bottom="auto" margin=0 padding=22 gap=16 border="1px solid var(--surface.line)" border-radius=20 background-color="surface.raised" color="ink.primary" min-width=210
        text viewer font-weight=600
        if skins.length > 1
          text "Appearance" font-size=12 color="ink.secondary"
          select value=skin change=chooseSkin aria-label="Appearance" testId="skin-picker" background-color="surface.page" color="ink.primary" border="1px solid var(--surface.line)" padding=10 border-radius=10
            for name in skins key=name
              option value=name
                text (name == "editorial" or name == "index" ? "Index" : "Cinematic")
        button press=signOut background-color="transparent" border="none" color="ink.secondary" text-align="left" padding=0
          text "Sign out"
      children

component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
  state lifted = false
  action hoverCard(over: bool)
    lifted = over
  action focusCard
    lifted = true
  action restCard
    lifted = false
  view
    column width=(small ? 142 : 190) flex-shrink=0 gap=10 intersect=observe(card.receipt)
      button press=selectTitle(card.id, card.kind, card.receipt) aria-label=`Details for ${card.name}` testId=`title-${card.id}` hover=hoverCard focus=focusCard blur=restCard position="relative" scale=(lifted and not still ? 1.035 : 1) translate=(lifted and not still ? "0px -5px" : "0px 0px") box-shadow=(lifted ? "0px 18px 38px #00000088" : "none") padding=0 border="none" background-color="surface.raised" color="ink.primary" border-radius=12 overflow="hidden" text-align="left" transition=(still ? "none" : "scale 180ms ease, translate 180ms ease, box-shadow 180ms ease")
        if card.poster != ""
          image card.poster alt="" width="100%" height=(small ? 206 : 274) object-fit="cover"
        else
          column height=(small ? 206 : 274) padding=16 justify-content="end"
            text card.name font-size=22 font-weight=600
        if card.progressSeconds > 0 and card.durationSeconds > 0
          column position="absolute" left=10 right=10 bottom=10 height=3 border-radius=2 background-color="surface.line"
            column height=3 width=`${min(100, card.progressSeconds / card.durationSeconds * 100)}%` border-radius=2 background-color="brand.warm"
      text card.name font-size=14 font-weight=600 line-clamp=2
      text card.facts font-size=11 color="ink.quiet" line-clamp=1

component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column gap=18 padding="0px 5% 34px"
      text row.name role="heading" aria-level=2 font-size=(small ? 20 : 23) font-weight=550 letter-spacing="-0.5px"
      scroll overflow-x="auto" overflow-y="hidden"
        row gap=(small ? 14 : 20) align-items="flex-start"
          for card in row.items key=card.id
            TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Home
  props
    model: HomeModel
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
  slot
  view
    column
      column position="relative" min-height=(query != "" ? 160 : small ? 360 : 432) justify-content="end" overflow="hidden"
        if query == ""
          for hero in model.hero key=hero.id
            column position="absolute" inset=0
              if hero.backdrop != ""
                image hero.backdrop alt="" width="100%" height="100%" object-fit="cover" opacity=0.92
              column position="absolute" inset=0 background-image="linear-gradient(0deg, #090b0e 0%, #090b0e00 65%), linear-gradient(90deg, #090b0ef0 0%, #090b0e70 45%, #090b0e10 100%)"
            column position="relative" padding="20px 7%" gap=12 max-width=700 intersect=observe(hero.receipt) animation=(still ? "none" : "arrive 500ms ease both")
              row gap=10 align-items="center"
                column width=22 height=3 border-radius=2 background-color=(hero.accent == "" ? "brand.warm" : hero.accent)
                text "SELECTED FOR YOU" font-size=10 letter-spacing="3px" color="brand.warm"
              text hero.name role="heading" aria-level=1 font-size=(small ? 36 : 62) font-weight=550 letter-spacing="-2px" line-height=1.05
              text hero.facts font-size=12 color="ink.secondary"
              if not small
                text hero.summary font-size=15 color="ink.secondary" line-clamp=2 line-height=1.6
              button press=selectTitle(hero.id, hero.kind, hero.receipt) background-color="ink.primary" color="ink.inverse" padding="12px 22px" border="none" border-radius=24 align-self="start"
                text "Explore title" font-size=13 font-weight=600
        column padding=(small ? "20px 5% 28px" : "26px 18% 38px")
          children
      if query == ""
        for row in model.rows key=row.id
          Row(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component SearchSurface
  props
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column gap=22 padding="0px 0px 40px" animation=(still ? "none" : "arrive 200ms ease both")
      if error
        text "Search is unavailable. Try another query." role="status" color="ink.secondary"
      else
        if loading
          text "Finding titles…" role="status" color="ink.secondary"
        else
          if model.items.length == 0
            text "No title matches. Try a name, a mood or a different description." role="status" color="ink.secondary"
          else
            Row(row=FeedRow(id="fast", name="Title matches", receipt="", items=model.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if descriptive.query == query and descriptive.generation == generation and descriptive.items.length > 0
          Row(row=FeedRow(id="vibe", name="The feeling you're looking for", receipt="", items=descriptive.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if ai.query == query and ai.generation == generation and aiAvailable and ai.aiStatus != ""
          column gap=12
            text "A little further afield" role="heading" aria-level=2 font-size=22
            if ai.aiStatus == "queued" or ai.aiStatus == "running"
              text "Exploring your description…" role="status" color="ink.secondary"
            if ai.items.length > 0
              Row(row=FeedRow(id="ai", name="Discovered for you", receipt="", items=ai.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
            if ai.aiStatus == "failed"
              text "Discovery couldn't finish. Your title matches are ready above." color="ink.secondary"

component Detail
  props
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  view
    column gap=28 padding-bottom=48 animation=(still ? "none" : "arrive 250ms ease both")
      for title in model.title key=title.id
        column position="relative" min-height=(small ? 520 : 600) justify-content="end" overflow="hidden"
          if title.backdrop != ""
            image title.backdrop alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="cover" opacity=0.9
          column position="absolute" inset=0 background-image="linear-gradient(0deg, #090b0e 0%, #090b0e30 90%), linear-gradient(90deg, #090b0ed9, #090b0e10)"
          column position="relative" padding=(small ? "80px 7% 32px" : "110px 7% 42px") max-width="52rem" gap=18
            text (title.kind == "movie" ? "Film" : title.kind == "show" ? "Series" : title.kind == "season" ? "Season" : "Episode") color="brand.warm" text-transform="uppercase" letter-spacing="3px" font-size=11
            if title.logo != ""
              image title.logo alt=title.name width=260 height=100 object-fit="contain"
            else
              text title.name role="heading" aria-level=1 font-size=(small ? 42 : 76) line-height=1.05 font-weight=550 letter-spacing="-1.5px"
            text title.facts color="ink.secondary" font-size=13
            text title.genres.join(" · ") color="ink.secondary" font-size=13
            if model.mediaFacts.length > 0
              row gap=12 flex-wrap="wrap"
                for fact in model.mediaFacts key=fact
                  text fact font-size=12 color="brand.warm" border="1px solid var(--surface.line)" padding="4px 8px" border-radius=5
            text title.summary color="ink.primary" font-size=16 line-height=1.6
            if model.canPlay
              button press=play(title.id) background-color="ink.primary" color="ink.inverse" border="none" border-radius=28 padding="15px 28px" align-self="start" testId="detail-play"
                text (model.resumeSeconds > 0 ? `Resume · ${floor(model.resumeSeconds / 60)} min in` : "Play") font-weight=650
              if model.resumeSeconds > 0 and title.durationSeconds > 0
                column width=230 height=3 border-radius=2 background-color="surface.line" role="progressbar" aria-label="Watch progress" aria-valuemin=0 aria-valuemax=title.durationSeconds aria-valuenow=model.resumeSeconds
                  column height=3 width=`${min(100, model.resumeSeconds / title.durationSeconds * 100)}%` background-color="brand.warm"
            for trailer in model.extras.filter(e => e.kind == "trailer" and e.ready) key=trailer.id
              button press=playExtra(trailer.id) align-self="start" border="1px solid var(--surface.line)" border-radius=28 background-color="surface.glass" color="ink.primary" padding="13px 24px"
                text "Watch trailer"
      if model.seasons.length > 0
        Row(row=FeedRow(id="seasons", name="Seasons", receipt="", items=model.seasons), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if model.episodes.length > 0
        Row(row=FeedRow(id="episodes", name="Episodes", receipt="", items=model.episodes), small=small, still=still, selectTitle=selectTitle, observe=observe)
      if model.extras.length > 0
        column padding="0px 7%" gap=14
          text "Extras" role="heading" aria-level=2 font-size=24
          for extra in model.extras key=extra.id
            button press=playExtra(extra.id) disabled=(not extra.ready) background-color="surface.raised" color="ink.primary" border="none" padding=16 border-radius=12 text-align="left"
              text `${extra.name}${extra.ready ? "" : " · Not available"}`
      if model.cast.length > 0
        column padding="0px 7%" gap=12
          text "Featuring" role="heading" aria-level=2 font-size=24
          scroll overflow-x="auto" height=88
            row gap=12
              for person in model.cast key=person
                text person padding="20px 24px" border-radius=12 background-color="surface.raised" color="ink.secondary" flex-shrink=0
      if model.related.length > 0
        for related in model.related key=related.id
          Row(row=related, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Guide
  view
    column padding=24
      text "Live guide is not available." role="status" color="ink.secondary"

component SignIn
  props
    username: string
    password: string
    passwordAvailable: bool
    quickAvailable: bool
    error: string
    busy: bool
    editUsername: action
    editPassword: action
    submit: action
    quick: action
  view
    column max-width=380 width="85%" align-self="center" gap=20 padding="48px 0px"
      text "Welcome to your evening." role="heading" aria-level=1 font-size=40 line-height=1.1 letter-spacing="-1px"
      text "Sign in to your library." color="ink.secondary" font-size=15
      if error != ""
        text error role="alert" color="brand.warm"
      if passwordAvailable
        column gap=8
          text "Username" font-size=12 color="ink.secondary"
          input value=username input=editUsername autocomplete="username" aria-label="Username" testId="username" padding=14 border-radius=12 border="1px solid var(--surface.line)" background-color="surface.raised" color="ink.primary"
        column gap=8
          text "Password" font-size=12 color="ink.secondary"
          input type="password" value=password input=editPassword submit=submit autocomplete="current-password" aria-label="Password" testId="password" padding=14 border-radius=12 border="1px solid var(--surface.line)" background-color="surface.raised" color="ink.primary"
        button press=submit disabled=(busy or username.trim() == "" or password == "") padding=15 border-radius=24 border="none" background-color="ink.primary" color="ink.inverse" testId="sign-in"
          text (busy ? "Signing in…" : "Sign in") font-weight=600
      if quickAvailable
        button press=quick disabled=busy padding=15 border-radius=24 border="1px solid var(--surface.line)" background-color="surface.raised" color="ink.primary" testId="quick-connect"
          text "Connect with a code"

component QuickConnect
  props
    model: QuickModel
    error: string
    cancel: action
  view
    column max-width=420 width="85%" align-self="center" gap=24 padding="48px 0px" align-items="center"
      text "An easier way in." role="heading" aria-level=1 font-size=38 letter-spacing="-1px"
      text "Approve this code from a signed-in Ether device." color="ink.secondary" text-align="center" line-height=1.6
      text model.code font-size=44 font-weight=600 letter-spacing="8px" color="brand.warm" testId="connect-code"
      text `Expires ${model.expiresAt}` color="ink.secondary" font-size=12
      text (error == "" ? "Waiting for approval…" : error) role="status" color="ink.secondary"
      button press=cancel border="1px solid var(--surface.line)" border-radius=24 padding="12px 28px" background-color="surface.raised" color="ink.primary"
        text "Cancel"

fn detailPresentation(width: number): string = "fullscreen"
fn detailSplit(width: number): string = "none"

component SearchField
  props
    query: string
    edit: action
  view
    row align-items="center" gap=12 padding="8px 18px" border-radius=32 background-color="surface.glass" border="1px solid var(--surface.line)" box-shadow="0px 16px 50px #00000040"
      image "symbol:search" color="ink.secondary" width=20 height=20
      input value=query input=edit placeholder="A title, a feeling, a world to get lost in…" aria-label="Search your library" testId="search" border-radius=14 flex=1 min-width=0 padding="12px 0px" border="none" background-color="transparent" color="ink.primary" font-size=15
        ::placeholder
          color="ink.secondary"
      if query != ""
        button press=edit("") aria-label="Clear search" border="none" background-color="transparent" color="ink.secondary" padding=8
          image "symbol:close"
