use Card, FeedRow, HomeModel, SearchModel, Viewport, LibraryNav, cardName, skinLabel from "../../foundation/models.contract"
use Display, Eyebrow, PrimaryPill, IconButton, Skeleton, enter, expose, drift, stagger, base, slow, glide, quick, dissolve, pop, vanish, rise, fill, FadeImage from "./look.contract"
use Wordmark, Pulse from "./auth.contract"

// The page gutter: content aligns to it everywhere in the skin.
fn gutter(small: bool): string = (small ? "18px" : "max(28px, 4vw)")

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
    viewport: Viewport
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
    libraries: LibraryNav[]
    section: string
    openLibrary: action
  slot
  state menuOpen = false
  derive compact = viewport.width < 640
  derive still = viewport.prefersReducedMotion
  action toggleMenu
    menuOpen = not menuOpen
  action changeAppearance(value: string)
    menuOpen = false
    chooseSkin(value)
  action leaveSession
    menuOpen = false
    signOut()
  action findSomething
    menuOpen = false
    search()
    focus("vela-search")
  action menuKey(k: string)
    if k == "Escape" and menuOpen
      preventDefault()
      menuOpen = false
      focus("profile-menu-trigger")
  view
    column position="relative" key=menuKey height="100%" min-height=0 background-color="surface.page" color="ink.primary" color-scheme="dark" font-family="system-ui, -apple-system, \"Segoe UI Variable\", \"Segoe UI\", Roboto, sans-serif"
      if viewer != ""
        column role="navigation" aria-label=t("ui.mainNavigation") position="absolute" top=0 left=0 right=0 z-index=20 animation=(still ? "dissolve 240ms linear both" : "dissolve 900ms ease-out both")
          column position="absolute" top=0 left=0 right=0 bottom=(compact ? -18 : 0) pointer-events="none" aria-hidden=true background-image="linear-gradient(180deg, var(--cinematic.nav-scrim) 0%, var(--cinematic.scrim-clear) 100%)" backdrop-filter="blur(16px) saturate(1.2)" mask-image="linear-gradient(180deg, black 0%, black 45%, transparent 100%)"
          row position="relative" height=(compact ? 56 : 84) box-sizing="border-box" padding-left=gutter(compact) padding-right=gutter(compact) align-items="center" gap=(compact ? 8 : 10)
            link href="/" aria-label=t("ui.velaHome") text-decoration="none" color="ink.primary" margin-right=(compact ? 0 : 22)
              Wordmark(size=(compact ? 26 : 30), still=still)
            if compact
              column flex=1
            else
              scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none" flex=1 min-width=0 mask-image="linear-gradient(90deg, black 0%, black 90%, transparent 100%)"
                Destinations(libraries=libraries, section=section, canLive=canLive, still=still, chips=false, home=home, live=live, openLibrary=openLibrary)
            button press=findSomething aria-label=t("ui.search") class=IconButton width=40 height=40 padding=10 flex-shrink=0
              image "symbol:search" width=18 height=18
            button id="profile-menu-trigger" press=toggleMenu aria-expanded=menuOpen aria-controls="viewer-settings" aria-label=t("ui.profileAndAppearance") testId="profile-menu" class=NavLink flex-shrink=0 padding-top=4 padding-bottom=4 padding-left=4 padding-right=(compact ? 4 : 14)
              row gap=10 align-items="center"
                text viewer.slice(0, 1).toUpperCase() width=32 height=32 border-radius=16 display="flex" align-items="center" justify-content="center" font-size=14 font-weight=650 color="ink.primary" background-image="linear-gradient(135deg, var(--cinematic.ember) 0%, var(--cinematic.dusk) 100%)" box-shadow="inset 0px 0px 0px 1px var(--cinematic.ring)" aria-hidden=true
                if not compact
                  text viewer font-size=14 font-weight=550
          if compact
            scroll position="relative" overflow-x="auto" overflow-y="hidden" scrollbar-width="none" mask-image="linear-gradient(90deg, transparent 0%, black 5%, black 88%, transparent 100%)"
              row padding-left=18 padding-right=18 padding-bottom=8
                Destinations(libraries=libraries, section=section, canLive=canLive, still=still, chips=true, home=home, live=live, openLibrary=openLibrary)
      if viewer != "" and menuOpen
        column id="viewer-settings" position="absolute" top=(compact ? 104 : 78) right=(compact ? 12 : "max(28px, 4vw)") z-index=30 width=260 box-sizing="border-box" padding=20 gap=16 border="1px solid var(--cinematic.glass-edge)" border-radius=20 background-color="cinematic.popover" backdrop-filter="blur(30px) saturate(1.4)" color="ink.primary" box-shadow="0px 30px 80px var(--cinematic.shadow), inset 0px 1px 0px var(--cinematic.ring)" transform-origin="top right" animation=(still ? "dissolve 200ms linear both" : "pop 320ms cubic-bezier(0.16, 1, 0.3, 1) both") -exact-exit-animation=(still ? "vanish 120ms linear both" : "vanish 180ms ease-in both")
          row gap=12 align-items="center"
            text viewer.slice(0, 1).toUpperCase() width=40 height=40 border-radius=20 display="flex" align-items="center" justify-content="center" font-size=17 font-weight=650 background-image="linear-gradient(135deg, var(--cinematic.ember) 0%, var(--cinematic.dusk) 100%)" aria-hidden=true
            text viewer font-size=16 font-weight=600 flex=1 min-width=0 line-clamp=1
          column height=1 background-color="cinematic.glass-edge"
          if skins.length > 1
            column gap=8
              text t("ui.appearance") class=Eyebrow font-size=10 color="ink.quiet"
              select value=skin change=changeAppearance aria-label=t("ui.appearance") testId="skin-picker" box-sizing="border-box" width="100%" height=42 padding="0px 12px" border="1px solid var(--cinematic.glass-edge)" border-radius=12 background-color="cinematic.field" color="ink.primary" font-size=14
                for name in skins key=name
                  option value=name
                    text skinLabel(name)
          vela-install pwaAction="install" buttonLabel=t("pwa.install")
          vela-install pwaAction="update" buttonLabel=t("pwa.update")
          button press=leaveSession class=NavLink justify-content="flex-start" padding="8px 10px" margin="0px -10px"
            row gap=10 align-items="center"
              image "symbol:sign-out" width=16 height=16 aria-hidden=true
              text t("ui.signOut") font-size=14
      children

// Home, the server's libraries in order (a live library opens the guide), and Live
// when the server offers it without a live library.
component Destinations
  props
    libraries: LibraryNav[]
    section: string
    canLive: bool
    still: bool
    chips: bool
    home: action
    live: action
    openLibrary: action
  derive hasLiveLibrary = libraries.filter(l => l.kind == "live").length > 0
  view
    row gap=(chips ? 6 : 2) align-items="center"
      NavItem(label=t("ui.home"), on=(section == "home"), chip=chips, still=still, press=home)
      for lib in libraries key=lib.id
        if lib.kind == "live"
          if canLive
            NavItem(label=lib.name, on=(section == "live"), chip=chips, still=still, press=live)
        else
          NavItem(label=lib.name, on=(section == lib.id), chip=chips, still=still, press=openLibrary(lib.id))
      if canLive and not hasLiveLibrary
        NavItem(label=t("ui.live"), on=(section == "live"), chip=chips, still=still, press=live)

// A primary destination in the top bar; the current one carries a soft underline glow.
component NavItem
  props
    label: string
    on: bool
    chip: bool
    still: bool
    press: action
  view
    if chip
      button press=press() testId=`nav-${label}` aria-current=(on ? "page" : "false") position="relative" flex-shrink=0 height=34 padding="0px 14px" border="1px solid var(--cinematic.glass-edge)" border-radius=999 background-color="cinematic.control" color=(on ? "ink.inverse" : "ink.primary") backdrop-filter="blur(16px)" transition="color 240ms linear"
        :focus-visible
          box-shadow="0px 0px 0px 2px var(--brand.warm)"
        if on
          column sharedElement="nav-chip" -exact-layout-transition=(still ? "none" : "460ms ease-out") position="absolute" inset=-1 border-radius=999 background-color="ink.primary" aria-hidden=true
        text label position="relative" font-size=13 font-weight=600 white-space="nowrap"
    else
      button press=press() testId=`nav-${label}` aria-current=(on ? "page" : "false") class=NavLink position="relative" flex-shrink=0 color=(on ? "ink.primary" : "ink.secondary")
        text label font-size=14 font-weight=(on ? 650 : 550) white-space="nowrap"
        if on
          column sharedElement="nav-underline" -exact-layout-transition=(still ? "none" : "460ms ease-out") position="absolute" left=14 right=14 bottom=4 height=2 border-radius=1 background-color="brand.warm" aria-hidden=true

style NavLink
  display = "flex"
  align-items = "center"
  height = 40
  padding = "0px 14px"
  border = "none"
  border-radius = 999
  background-color = "cinematic.scrim-clear"
  color = "ink.secondary"
  font-weight = 550
  :hover
    background-color = "cinematic.control"
    color = "ink.primary"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"
    color = "ink.primary"

// A poster that lifts toward the viewer on hover or focus.
component TitleCard
  props
    card: Card
    small: bool
    still: bool
    selectTitle: action
    observe: action
    fill: bool
  state lifted = false
  action hoverCard(over: bool)
    lifted = over
  action focusCard
    lifted = true
  action restCard
    lifted = false
  view
    column width=(fill ? "100%" : small ? 132 : "clamp(150px, 12.4vw, 232px)") flex-shrink=0 gap=12 intersect=observe(card.receipt)
      button press=selectTitle(card.id, card.kind, card.receipt) aria-label=cardName(card) testId=`title-${card.id}` hover=hoverCard focus=focusCard blur=restCard position="relative" width="100%" aspect-ratio="2 / 3" padding=0 border="none" background-color="surface.raised" color="ink.primary" border-radius=(small ? 10 : 12) overflow="hidden" text-align="left" cursor="pointer" scale=(lifted and not still ? 1.045 : 1) translate=(lifted and not still ? "0px -6px" : "0px 0px") box-shadow=(lifted ? "0px 28px 50px -14px var(--cinematic.card-shadow), 0px 0px 0px 1px var(--cinematic.ring)" : "0px 10px 24px -12px var(--cinematic.card-shadow), 0px 0px 0px 1px var(--cinematic.hairline)") transition=`scale ${base()}ms ${glide()}, translate ${base()}ms ${glide()}, box-shadow ${base()}ms ${glide()}`
        :focus-visible
          box-shadow="0px 0px 0px 3px var(--ink.primary), 0px 28px 50px -14px var(--cinematic.card-shadow)"
        if card.poster != ""
          FadeImage(src=card.poster)
        else
          column position="absolute" inset=0 padding=16 justify-content="flex-end" background-image="linear-gradient(160deg, var(--cinematic.placeholder-top) 0%, var(--cinematic.placeholder-bottom) 100%)"
            text card.name class=Display font-size=(small ? 20 : 24) line-clamp=4
        column position="absolute" inset=0 pointer-events="none" background-image="linear-gradient(145deg, var(--cinematic.sheen) 0%, var(--cinematic.scrim-clear) 42%)" opacity=(lifted ? 1 : 0) transition=`opacity ${base()}ms ${glide()}` aria-hidden=true
        if card.played
          column position="absolute" top=8 right=8 width=24 height=24 border-radius=12 align-items="center" justify-content="center" background-color="cinematic.glass" backdrop-filter="blur(12px)" aria-hidden=true
            image "symbol:checkmark" width=12 height=12 color="ink.primary"
        if card.progressSeconds > 0 and card.durationSeconds > 0 and not card.played
          column position="absolute" left=0 right=0 bottom=0 height=36 background-image="linear-gradient(0deg, var(--cinematic.scrim-strong) 0%, var(--cinematic.scrim-clear) 100%)" aria-hidden=true
          column position="absolute" left=10 right=10 bottom=10 height=3 border-radius=2 background-color="cinematic.track-strong" overflow="hidden" aria-hidden=true
            column height=3 width=`${min(100, card.progressSeconds / card.durationSeconds * 100)}%` background-color="brand.warm"
      column gap=4 padding="0px 2px" opacity=(lifted ? 1 : 0.86) transition=`opacity ${quick()}ms linear`
        text card.name font-size=(small ? 13 : 14) font-weight=600 line-clamp=1 color="ink.primary"
        text card.facts font-size=12 color="ink.quiet" line-clamp=1 font-variant-numeric="tabular-nums"

// A named shelf of cards, in server order, that slides horizontally.
component Row
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    Shelf(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

// The shelf itself; a caller may add trailing content after the last card
// (home rows add their end-of-row sentinel and a quiet loading mark there).
component Shelf
  props
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  slot
  view
    column position="relative" gap=(small ? 2 : 4) padding-bottom=(small ? 18 : 28)
      text row.name role="heading" aria-level=2 font-size=(small ? 18 : 21) font-weight=650 letter-spacing="-0.012em" padding-left=gutter(small) padding-right=gutter(small)
      scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none" mask-image="linear-gradient(90deg, black 0%, black 94%, transparent 100%)"
        row gap=(small ? 12 : 18) align-items="flex-start" padding-top=(small ? 14 : 16) padding-bottom=(small ? 18 : 22) padding-left=gutter(small) padding-right=gutter(small)
          for card, i in row.items key=card.id
            column animation=enter(still, stagger(i, 45, 8))
              TitleCard(card=card, small=small, still=still, selectTitle=selectTitle, observe=observe, fill=false)
          children

// A row-shaped placeholder while titles load.
component RowSkeleton
  props
    small: bool
    still: bool
  view
    column gap=18 padding-bottom=28 aria-hidden=true
      column padding-left=gutter(small) padding-right=gutter(small)
        Skeleton(width="180px", height="20px", radius=6, still=still)
      row gap=(small ? 12 : 18) padding-left=gutter(small) padding-right=gutter(small) overflow="hidden"
        for i in [0, 1, 2, 3, 4, 5, 6, 7] key=`${i}`
          column gap=10 flex-shrink=0
            Skeleton(width=(small ? "132px" : "clamp(150px, 12.4vw, 232px)"), height=(small ? "198px" : "clamp(225px, 18.6vw, 348px)"), radius=12, still=still)
            Skeleton(width="70%", height="12px", radius=4, still=still)

component Home
  props
    model: HomeModel
    active: bool
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
    heroIndex: number
    pickHero: action
    reachEnd: action
    reachRowEnd: action
    homeMoreLoading: bool
    rowMoreLoading: string[]
  slot
  derive searching = query != ""
  derive shown = model.hero.slice(heroIndex, heroIndex + 1)
  derive previewing = not still and not searching and model.previews.filter(p => shown.map(h => h.id).includes(p.id)).length > 0
  derive rotating = model.hero.length > 1 and active and not searching and not still and model.previews.filter(p => shown.map(h => h.id).includes(p.id)).length == 0
  view
    column position="relative"
      // The artwork stage: behind the hero and the start of the rows, blurred into an aura while searching.
      for hero in shown key=hero.id
        column position="absolute" top=0 left=0 right=0 height=(small ? "640px" : "max(680px, 92vh)") overflow="hidden" pointer-events="none" aria-hidden=true mask-image="linear-gradient(180deg, black 0%, black 70%, transparent 100%)" animation=expose(still) -exact-exit-animation=(still ? "vanish 160ms linear both" : "vanish 900ms ease-in-out both")
          if hero.backdrop != ""
            image hero.backdrop alt="" position="absolute" top="-12%" left="-12%" width="124%" height="124%" object-fit="cover" filter="blur(70px) saturate(1.5)" opacity=(searching ? 0.5 : 0) transition=`opacity ${slow()}ms ${glide()}`
          column position="absolute" inset=0 opacity=(searching ? 0 : 1) transition=`opacity ${slow()}ms ${glide()}`
            if hero.backdrop != ""
              column position="absolute" inset=0 transform-origin="62% 38%" animation=drift(still)
                FadeImage(src=hero.backdrop)
            else
              if hero.poster != ""
                image hero.poster alt="" position="absolute" top="-20%" left="-20%" width="140%" height="140%" object-fit="cover" filter="blur(90px) saturate(1.6)" opacity=0.7 animation=drift(still)
            if not still and not searching
              for preview in model.previews.filter(p => p.id == hero.id) key=preview.id
                vela-preview url=preview.url active=(active and not searching ? "true" : "false") still=(still ? "true" : "false") expiresAt=preview.expiresAt.toString() position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
          column position="absolute" left="-10%" bottom="8%" width="75%" height="70%" background-color=(hero.accent == "" ? "brand.warm" : hero.accent) opacity=0.2 mask-image="radial-gradient(closest-side, black 0%, transparent 100%)"
          column position="absolute" inset=0 background-image="linear-gradient(90deg, var(--cinematic.scrim-deep) 0%, var(--cinematic.scrim-strong) 34%, var(--cinematic.scrim-mid) 52%, var(--cinematic.scrim-clear) 78%)" opacity=(previewing ? 1 : 0) transition=`opacity ${slow()}ms ${glide()}`
          column position="absolute" inset=0 background-image="linear-gradient(90deg, var(--cinematic.scrim-deep) 0%, var(--cinematic.scrim-mid) 32%, var(--cinematic.scrim-clear) 68%), linear-gradient(0deg, var(--surface.page) 0%, var(--cinematic.scrim-strong) 22%, var(--cinematic.scrim-clear) 58%), linear-gradient(180deg, var(--cinematic.nav-scrim) 0%, var(--cinematic.scrim-clear) 20%), radial-gradient(ellipse 120% 100% at 60% 35%, var(--cinematic.scrim-clear) 50%, var(--cinematic.vignette) 100%)"
          image "assets/grain.svg" alt="" position="absolute" inset=0 width="100%" height="100%" object-fit="fill" opacity=0.05
          if hero.backdrop == "" and hero.poster != "" and not small
            image hero.poster alt="" position="absolute" right="max(28px, 6vw)" top="max(110px, 14vh)" height="min(56vh, 520px)" aspect-ratio="2 / 3" object-fit="cover" border-radius=16 box-shadow="0px 50px 120px var(--cinematic.card-shadow), 0px 0px 0px 1px var(--cinematic.ring)" opacity=(searching ? 0 : 1) transition=`opacity ${slow()}ms ${glide()}` animation=enter(still, 300)
      // The hero copy, then the search box it settles onto.
      column position="relative" height=(searching ? (small ? "176px" : "190px") : model.hero.length == 0 ? (small ? "176px" : "190px") : small ? "520px" : "clamp(500px, 62vh, 700px)") justify-content="flex-end" box-sizing="border-box" -exact-layout-transition=(still ? "none" : "640ms ease-out")
        if not searching
          for hero in shown key=hero.id
            column padding-left=gutter(small) padding-right=gutter(small) gap=(small ? 12 : 16) max-width=(small ? "none" : "46rem") intersect=observe(hero.receipt) -exact-exit-animation=(still ? "vanish 120ms linear both" : "vanish 240ms ease-in both")
              row gap=10 align-items="center" animation=enter(still, 220)
                column width=24 height=2 border-radius=1 background-color=(hero.accent == "" ? "brand.warm" : hero.accent)
                text t("ui.selectedForYou") class=Eyebrow font-size=10 color="brand.warm"
              if hero.logo != ""
                image hero.logo alt=hero.name role="heading" aria-level=1 height=(small ? 96 : 150) width="auto" max-width=(small ? "78%" : "min(520px, 70%)") object-fit="contain" align-self="flex-start" animation=enter(still, 300)
              else
                text hero.name role="heading" aria-level=1 class=Display font-size=(small ? 48 : 84) text-shadow="0px 4px 40px var(--cinematic.shadow)" animation=enter(still, 300)
              text ([hero.facts].concat(hero.genres.slice(0, 3)).filter(f => f != "").join(" · ")) font-size=(small ? 13 : 14) color="ink.secondary" text-shadow="0px 1px 12px var(--cinematic.shadow)" font-variant-numeric="tabular-nums" animation=enter(still, 380)
              if hero.summary != ""
                text hero.summary font-size=(small ? 14 : 16) color=(previewing ? "ink.primary" : "ink.secondary") text-shadow="0px 1px 14px var(--cinematic.shadow)" line-clamp=(small ? 2 : 3) line-height=1.55 max-width="36rem" animation=enter(still, 440)
              row margin-top=(small ? 4 : 8) animation=enter(still, 500)
                button press=selectTitle(hero.id, hero.kind, hero.receipt) aria-label=cardName(hero) class=PrimaryPill height=(small ? 46 : 52) padding-left=(small ? 22 : 28) padding-right=(small ? 22 : 28) transition=`background-color 180ms linear, scale ${base()}ms ${glide()}`
                  row gap=10 align-items="center"
                    text t("ui.exploreTitle") font-size=15
                    image "symbol:forward-chevron" width=14 height=14 aria-hidden=true
        if not searching and model.hero.length > 1
          row gap=8 align-items="center" padding-left=gutter(small) padding-right=gutter(small) padding-top=(small ? 16 : 22) role="group" aria-label=t("ui.featuredTitles") animation=enter(still, 560)
            for hero, i in model.hero key=hero.id
              button press=pickHero(i) aria-label=t("ui.featuredTitleOf", position=formatNumber(i + 1, "decimal"), total=formatNumber(model.hero.length, "decimal"), title=hero.name) aria-current=(i == heroIndex ? "true" : "false") position="relative" width=(i == heroIndex ? 34 : 8) height=8 padding=0 border="none" border-radius=4 overflow="hidden" background-color=(i == heroIndex ? "cinematic.track-strong" : "cinematic.glass-edge-strong") cursor="pointer" -exact-layout-transition=(still ? "none" : "420ms ease-out")
                :hover
                  background-color="cinematic.control-hover"
                :focus-visible
                  box-shadow="0px 0px 0px 2px var(--brand.warm)"
                if i == heroIndex
                  for n in [heroIndex] key=`fill-${n}`
                    column position="absolute" inset=0 border-radius=4 background-color="ink.primary" animation=(rotating ? "fill 9000ms linear both" : "none")
        column padding-top=(small ? 26 : 34) padding-bottom=(small ? 10 : 14) padding-left=(small ? "16px" : "max(28px, 4vw)") padding-right=(small ? "16px" : "max(28px, 4vw)") align-items="center" -exact-layout-transition=(still ? "none" : "640ms ease-out")
          column width="100%" max-width=720 animation=enter(still, 420)
            children
      if not searching
        column position="relative" padding-top=(small ? 14 : 22)
          for row, i in model.rows key=row.id
            column animation=enter(still, 520 + stagger(i, 90, 4)) -exact-exit-animation=(still ? "vanish 120ms linear both" : "vanish 220ms ease-in both")
              Shelf(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
                if row.nextCursor != ""
                  column width=(small ? 60 : 96) align-self="stretch" flex-shrink=0 align-items="center" justify-content="center" intersect=reachRowEnd(row.id) aria-hidden=(not rowMoreLoading.includes(row.id))
                    if rowMoreLoading.includes(row.id)
                      Pulse(still=still)
          if model.nextCursor != ""
            column height=120 align-items="center" justify-content="center" intersect=reachEnd
              if homeMoreLoading
                RowSkeleton(small=small, still=still)
          if model.rows.length == 0
            EmptyState(icon="symbol:sparkles", title=t("ui.nothingHereYet"), message=t("ui.yourLibraryHasNoRowsYet"), still=still)

// A centred, designed moment for empty results and unavailable lanes.
component EmptyState
  props
    icon: string
    title: string
    message: string
    still: bool
  view
    column align-items="center" text-align="center" gap=14 padding="56px 24px 72px" role="status" animation=enter(still, 80)
      column width=64 height=64 border-radius=32 align-items="center" justify-content="center" background-color="cinematic.glass" border="1px solid var(--cinematic.glass-edge)" box-shadow="inset 0px 1px 0px var(--cinematic.ring)" margin-bottom=6
        image icon width=24 height=24 color="brand.warm" aria-hidden=true
      text title class=Display font-size=32
      if message != ""
        text message font-size=15 color="ink.secondary" line-height=1.55 max-width="28rem"

component SearchSurface
  props
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    column position="relative" gap=(small ? 18 : 26) padding-bottom=72 animation=(still ? "dissolve 240ms linear both" : "rise 640ms cubic-bezier(0.16, 1, 0.3, 1) 160ms both")
      column padding-left=gutter(small) padding-right=gutter(small) gap=6
        text t("ui.resultsForQuery", query=query) role="heading" aria-level=1 class=Display font-size=(small ? 32 : 46) line-clamp=2
      if error
        EmptyState(icon="symbol:alert", title=t("ui.searchUnavailable"), message=t("ui.searchIsUnavailableTryAnotherQuery"), still=still)
      else
        if loading
          column
            text t("ui.findingTitles") role="status" position="absolute" width=1 height=1 overflow="hidden" opacity=0
            RowSkeleton(small=small, still=still)
        else
          if model.items.length == 0
            EmptyState(icon="symbol:search", title=t("ui.noMatches"), message=t("ui.noTitleMatchesTryANameAMoodOrADifferentDescription"), still=still)
          else
            Row(row=FeedRow(id="fast", name=t("ui.titleMatches"), receipt="", items=model.items, nextCursor="", continuation="exhausted"), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if descriptive.query == query and descriptive.generation == generation and descriptive.items.length > 0
          column animation=enter(still, 120)
            Row(row=FeedRow(id="vibe", name=t("ui.theFeelingYouReLookingFor"), receipt="", items=descriptive.items, nextCursor="", continuation="exhausted"), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if ai.query == query and ai.generation == generation and aiAvailable and ai.aiStatus != ""
          column gap=10 animation=enter(still, 160)
            row gap=10 align-items="center" padding-left=gutter(small) padding-right=gutter(small)
              image "symbol:sparkles" width=18 height=18 color="brand.warm" aria-hidden=true
              text t("ui.aLittleFurtherAfield") role="heading" aria-level=2 class=Display font-size=(small ? 26 : 30)
            if ai.aiStatus == "queued" or ai.aiStatus == "running"
              row gap=12 align-items="center" padding-left=gutter(small) padding-right=gutter(small) role="status"
                Pulse(still=still)
                text t("ui.exploringYourDescription") color="ink.secondary" font-size=14
            if ai.items.length > 0
              Row(row=FeedRow(id="ai", name=t("ui.discoveredForYou"), receipt="", items=ai.items, nextCursor="", continuation="exhausted"), small=small, still=still, selectTitle=selectTitle, observe=observe)
            if ai.aiStatus == "failed"
              text t("ui.discoveryCouldnTFinishYourTitleMatchesAreReadyAbove") color="ink.secondary" font-size=14 padding-left=gutter(small) padding-right=gutter(small)

fn detailPresentation(width: number): string = "fullscreen"
fn detailSplit(width: number): string = "none"

// The rounded search box at the centre of the home composition.
component SearchField
  props
    query: string
    edit: action
  state focused = false
  action focusField
    focused = true
  action blurField
    focused = false
  view
    row align-items="center" gap=14 height=60 box-sizing="border-box" padding="0px 8px 0px 22px" border-radius=999 background-color=(focused ? "cinematic.search-focus" : "cinematic.search") backdrop-filter="blur(26px) saturate(1.5)" border=(focused ? "1px solid var(--cinematic.glass-edge-strong)" : "1px solid var(--cinematic.glass-edge)") box-shadow=(focused ? "0px 26px 70px var(--cinematic.search-shadow), 0px 0px 0px 3px var(--cinematic.focus-halo), inset 0px 1px 0px var(--cinematic.ring)" : "0px 18px 50px var(--cinematic.search-shadow), inset 0px 1px 0px var(--cinematic.ring)") transition=`background-color 180ms linear, border-color 180ms linear, box-shadow ${base()}ms ${glide()}`
      image "symbol:search" color=(focused ? "ink.primary" : "ink.secondary") width=20 height=20 flex-shrink=0 aria-hidden=true
      input id="vela-search" value=query input=edit focus=focusField blur=blurField outline="none" placeholder=t("ui.aTitleAFeelingAWorldToGetLostIn") aria-label=t("ui.searchYourLibrary") testId="search" flex=1 min-width=0 height="100%" padding=0 border="none" background-color="transparent" color="ink.primary" font-size=17
        ::placeholder
          color="ink.quiet"
      if query != ""
        button press=edit("") aria-label=t("ui.clearSearch") class=IconButton width=40 height=40 padding=11 flex-shrink=0
          image "symbol:close" width=16 height=16

// Waiting and failure moments the foundation reports: shaped like what is coming, never blank.
component Status
  props
    kind: string
    message: string
    small: bool
    still: bool
  view
    if kind == "home"
      column role="status" aria-label=message animation=(still ? "dissolve 240ms linear both" : "dissolve 500ms ease-out both")
        column height=(small ? "520px" : "clamp(500px, 62vh, 700px)") justify-content="flex-end" gap=16 padding-left=gutter(small) padding-right=gutter(small) box-sizing="border-box" background-image="radial-gradient(ellipse 80% 70% at 20% 40%, var(--cinematic.skeleton) 0%, var(--cinematic.scrim-clear) 70%)"
          Skeleton(width="120px", height="10px", radius=4, still=still)
          Skeleton(width=(small ? "80%" : "min(560px, 50%)"), height=(small ? "48px" : "76px"), radius=10, still=still)
          Skeleton(width=(small ? "60%" : "300px"), height="14px", radius=4, still=still)
          Skeleton(width="150px", height="52px", radius=26, still=still)
          column align-items="center" padding-top=34
            Skeleton(width="min(720px, 100%)", height="60px", radius=30, still=still)
        column padding-top=36
          RowSkeleton(small=small, still=still)
    else
      if kind == "library"
        column role="status" aria-label=message gap=28 padding-top=(small ? 120 : 128) animation=(still ? "dissolve 240ms linear both" : "dissolve 400ms ease-out both")
          column gap=16 padding-left=gutter(small) padding-right=gutter(small)
            Skeleton(width="90px", height="10px", radius=4, still=still)
            Skeleton(width=(small ? "70%" : "380px"), height=(small ? "44px" : "68px"), radius=10, still=still)
            row gap=10
              Skeleton(width="220px", height="42px", radius=21, still=still)
              Skeleton(width="160px", height="42px", radius=21, still=still)
          RowSkeleton(small=small, still=still)
          RowSkeleton(small=small, still=still)
      else
        if kind == "detail"
          column role="status" aria-label=message gap=18 padding-left=(small ? "20px" : "max(32px, 5.5vw)") padding-right=(small ? "20px" : "max(32px, 5.5vw)") padding-top=(small ? 260 : 300) padding-bottom=48 background-image="radial-gradient(ellipse 90% 60% at 30% 20%, var(--cinematic.skeleton) 0%, var(--cinematic.scrim-clear) 70%)" animation=(still ? "dissolve 240ms linear both" : "dissolve 400ms ease-out both")
            Skeleton(width="90px", height="10px", radius=4, still=still)
            Skeleton(width=(small ? "85%" : "min(620px, 60%)"), height=(small ? "44px" : "72px"), radius=10, still=still)
            Skeleton(width="260px", height="14px", radius=4, still=still)
            Skeleton(width=(small ? "100%" : "min(560px, 55%)"), height="52px", radius=8, still=still)
            Skeleton(width="170px", height="56px", radius=28, still=still)
        else
          if kind == "loading"
            column role="status" padding="96px 24px" align-items="center" gap=16
              Pulse(still=still)
              text message color="ink.secondary" font-size=15
          else
            EmptyState(icon="symbol:alert", title=t("ui.somethingWentQuiet"), message=message, still=still)
