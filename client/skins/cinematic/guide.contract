use GuideModel, GuideChannel, GuideProgramme, LiveTile from "../../live/models.contract"
use Display, Eyebrow, PrimaryPill, GhostPill, IconButton, glide, quick, base, spin from "./look.contract"

// The channel guide as an app: a preview of the focused programme, a toolbar of
// days and filters, then one grid that scrolls on both axes inside its panel with
// a sticky time ruler and channel rail. Rows and programmes are windowed around
// the visible port, so a lineup of hundreds scrolls as smoothly as a dozen.

keyframes guideSwap
  from opacity=0 translate="10px 0px"

keyframes guidePulse
  0% opacity=1 scale=1
  70% opacity=0 scale=2.6
  100% opacity=0 scale=2.6

// Grid geometry, in CSS pixels. Minutes become pixels at `ppm` per minute.
// Zoom 0, 1, 2 shows about 4.5, 3 and 2 hours across a laptop panel; phones keep one scale.
fn ppm(small: bool, zoom: number): number = (small ? 4 : zoom == 0 ? 4 : zoom == 2 ? 9 : 6)
fn rowH(small: bool): number = (small ? 68 : 72)
fn railW(small: bool): number = (small ? 84 : 264)
fn rulerH(): number = 44
fn side(small: bool): string = (small ? "16px" : "max(28px, 4vw)")

// Server genres map to palette slots in the data module; -1 has no colour cue.
fn toneColor(n: number): string = (n == 0 ? "cinematic.tone-news" : n == 1 ? "cinematic.tone-sport" : n == 2 ? "cinematic.tone-film" : n == 3 ? "cinematic.tone-kids" : n == 4 ? "cinematic.tone-factual" : n == 5 ? "cinematic.tone-drama" : n == 6 ? "cinematic.tone-comedy" : n == 7 ? "cinematic.tone-music" : n == 8 ? "cinematic.tone-life" : "cinematic.tone-other")

fn keep(c: GuideChannel, filter: string): bool = (filter == "all" ? true : filter == "favourites" ? c.favorite : filter == "listed" ? c.listed : c.group == filter)

// The programme under `t` minutes in a row, else the next one, else the last; a row without listings focuses its rail cell.
fn cellAt(c: GuideChannel, t: number): string = match first(c.programmes.filter(p => p.at + p.span > t)) { case some(p) => `guide-${p.id}`, case none => match first(c.programmes.slice(-1)) { case some(p) => `guide-${p.id}`, case none => `guide-rail-${c.id}` } }

fn metaLine(p: GuideProgramme): string = ([p.airing ? p.remainingLabel : t("ui.startEnd", start=p.startLabel, end=p.endLabel), p.episode].filter(s => s != "").join(" · "))

component Guide
  props
    model: GuideModel
    small: bool
    still: bool
    zoom: number
    tile: LiveTile
    watch: action
    chooseDay: action
    setZoom: action
    tileMessage: action
    tileUnmute: action
    tileTuneIn: action
    retune: action
  state selChannel = ""
  state expanded = false
  state selProgramme = ""
  state filter = "all"
  state mode = "now"
  state rowBase = 0
  state colBase = -1
  state portW = 1200
  state portH = 640
  state focusMin = -1
  state landed = -1
  derive rows = model.channels.filter(c => keep(c, filter))
  derive grid = not small or mode == "guide"
  derive scale = ppm(small, zoom)
  derive row = rowH(small)
  derive rail = railW(small)
  derive width = model.minutes * scale
  // Open with the landing time a third of the way across the panel, so the past reads to its left.
  derive landingMin = max(0, min(model.minutes - (portW - rail) / scale, model.landing - (portW - rail) / scale / 3))
  derive col = (colBase < 0 ? floor(landingMin / 30) : colBase)
  derive firstRow = max(0, rowBase - 6)
  derive lastRow = min(rows.length, rowBase + ceil(portH / row) + 8)
  derive winFrom = col * 30 - 150
  derive winTo = col * 30 + portW / scale + 150
  // The preview follows selection; with none it shows the first channel airing something.
  derive heroChannels = (selChannel != "" ? model.channels.filter(c => c.id == selChannel) : model.channels.filter(c => c.nowId != "").slice(0, 1))
  derive heroFallback = (heroChannels.length == 0 ? model.channels.slice(0, 1) : heroChannels)

  action scrolled(x: number, y: number)
    if landed < 0
      landed = landingMin
    let r = floor(y / row / 4) * 4
    if r != rowBase
      rowBase = r
    let c = floor(x / scale / 30)
    if c != colBase
      colBase = c
  action measured(w: number, h: number)
    portW = w
    portH = h
  action pickDay(offset: number)
    rowBase = 0
    colBase = -1
    landed = -1
    focusMin = -1
    selChannel = ""
    selProgramme = ""
    chooseDay(offset)
  action pickFilter(value: string)
    filter = value
    rowBase = 0
  // Zooming keeps the time at the panel's left edge where it was.
  action pickZoom(z: number)
    landed = col * 30
    colBase = col
    setZoom(z)
  action toggleExpanded
    let next = not expanded
    expanded = next
    if next
      requestFullscreen("guide-page")
    else
      exitFullscreen()
  action pageKey(k: string)
    if k == "Escape" and expanded
      preventDefault()
      expanded = false
      exitFullscreen()
  action pickMode(value: string)
    mode = value
    landed = -1
    colBase = -1
  action jumpNow
    if model.day != 0
      pickDay(0)
    else
      selChannel = ""
      selProgramme = ""
      if still
        scrollIntoView("guide-now-anchor", block="nearest", inline="start")
      else
        scrollIntoView("guide-now-anchor", block="nearest", inline="start", behavior="smooth")
  action shift(hours: number)
    let target = col * 30 + hours * 60
    if target < 0 and model.day > 0
      pickDay(model.day - 1)
    else
      if target > model.minutes - 60 and model.day < model.days.length - 1
        pickDay(model.day + 1)
      else
        let id = `guide-tick-${max(0, min(model.minutes - 30, target))}`
        if still
          scrollIntoView(id, block="nearest", inline="start")
        else
          scrollIntoView(id, block="nearest", inline="start", behavior="smooth")
  action select(channel: string, programme: string)
    selChannel = channel
    selProgramme = programme
  action press(channel: string, programme: string, airing: bool)
    selChannel = channel
    selProgramme = programme
    focusMin = -1
    if airing
      retune(channel)
  action move(index: number, at: number, airing: bool, channel: string, leftId: string, rightId: string, k: string, event: KeyboardEvent)
    if k == "Enter" and airing
      preventDefault()
      watch(channel)
    if not event.metaKey and not event.ctrlKey and not event.altKey
      if k == "ArrowLeft" and leftId != ""
        preventDefault()
        focusMin = -1
        focus(leftId)
      if k == "ArrowRight" and rightId != ""
        preventDefault()
        focusMin = -1
        focus(rightId)
      if k == "ArrowUp" or k == "ArrowDown" or k == "PageUp" or k == "PageDown"
        preventDefault()
        let step = (k == "ArrowUp" ? -1 : k == "ArrowDown" ? 1 : k == "PageUp" ? -6 : 6)
        let target = max(0, min(rows.length - 1, index + step))
        let t = (focusMin >= 0 ? focusMin : max(at, col * 30))
        focusMin = t
        focus(match first(rows.slice(target, target + 1)) { case some(c) => cellAt(c, t), case none => "" })
  action railKey(index: number, k: string)
    if k == "ArrowUp" or k == "ArrowDown"
      preventDefault()
      let target = max(0, min(rows.length - 1, index + (k == "ArrowUp" ? -1 : 1)))
      focus(match first(rows.slice(target, target + 1)) { case some(c) => `guide-rail-${c.id}`, case none => "" })
    if k == "ArrowRight"
      preventDefault()
      focus(match first(rows.slice(index, index + 1)) { case some(c) => cellAt(c, max(col * 30, model.nowMinute)), case none => "" })

  view
    // Expanded hides the preview so the grid takes the page, and asks the browser for full screen.
    column id="guide-page" key=pageKey height="100%" min-height=0 box-sizing="border-box" background-color="surface.page" padding-top=(expanded ? 96 : grid ? 0 : (small ? 116 : 112)) background-image="radial-gradient(ellipse 70% 60% at 82% 0%, var(--cinematic.guide-aura), transparent 70%)"
      text t("ui.channelGuide") role="heading" aria-level=1 position="absolute" width=1 height=1 overflow="hidden" opacity=0
      if grid and not expanded
        column position="relative" flex-shrink=0 height=(small ? 196 : "calc(84px + clamp(128px, 16vh, 168px))") overflow="hidden"
          for c in heroFallback key=`hero-${c.id}`
            GuideHero(channel=c, programmeId=(selChannel == c.id and selProgramme != "" ? selProgramme : c.nowId), small=small, still=still, watch=watch)
          if tile.state != "off"
            column position="absolute" right=side(small) bottom=(small ? 12 : 14) z-index=2
              GuideTile(tile=tile, small=small, still=still, watch=watch, message=tileMessage, unmute=tileUnmute, tuneIn=tileTuneIn)
      // Toolbar: days, the time stepper and filters. Phones put the view switch first and the days beneath.
      if small
        row flex-shrink=0 align-items="center" gap=10 padding-left=side(small) padding-right=side(small) padding-top=10 padding-bottom=(grid ? 8 : 12) role="toolbar" aria-label=t("live.guideControls")
          row gap=4 padding=4 border-radius=999 background-color="cinematic.control" border="1px solid var(--cinematic.glass-edge)" role="tablist" aria-label=t("live.view")
            button press=pickMode("now") role="tab" aria-selected=(mode == "now") class=GuideTab background-color=(mode == "now" ? "ink.primary" : "transparent") color=(mode == "now" ? "ink.inverse" : "ink.secondary")
              text t("live.onNow") font-size=13 font-weight=650 white-space="nowrap"
            button press=pickMode("guide") role="tab" aria-selected=(mode == "guide") class=GuideTab background-color=(mode == "guide" ? "ink.primary" : "transparent") color=(mode == "guide" ? "ink.inverse" : "ink.secondary")
              text t("live.guide") font-size=13 font-weight=650 white-space="nowrap"
          column flex=1
          button press=pickFilter(filter == "favourites" ? "all" : "favourites") aria-pressed=(filter == "favourites") aria-label=t("live.favourites") class=IconButton width=38 height=38 padding=10 color=(filter == "favourites" ? "brand.warm" : "ink.primary")
            image (filter == "favourites" ? "symbol:star-fill" : "symbol:star") width=17 height=17 aria-hidden=true
          if grid
            button press=jumpNow aria-label=t("live.jumpToNow") class=GuideChip height=38 padding-left=12 padding-right=14
              row gap=7 align-items="center"
                column width=7 height=7 border-radius=4 background-color="cinematic.guide-now" aria-hidden=true
                text t("live.now") font-size=13 font-weight=650
        if grid
          row flex-shrink=0 gap=6 align-items="center" overflow-x="auto" scrollbar-width="none" padding-left=side(small) padding-right=side(small) padding-bottom=12 role="group" aria-label=t("live.day")
            for d in model.days key=d.offset
              GuideDayChip(label=d.label, date=d.date, offset=d.offset, on=(d.offset == model.day), small=small, pick=pickDay)
      else
        row flex-shrink=0 align-items="center" gap=14 padding-left=side(small) padding-right=side(small) padding-top=6 padding-bottom=16 role="toolbar" aria-label=t("live.guideControls")
          row gap=6 align-items="center" flex-shrink=1 min-width=0 overflow-x="auto" scrollbar-width="none" role="group" aria-label=t("live.day")
            for d in model.days key=d.offset
              GuideDayChip(label=d.label, date=d.date, offset=d.offset, on=(d.offset == model.day), small=small, pick=pickDay)
          row gap=6 align-items="center" flex-shrink=0
            button press=shift(-2) aria-label=t("ui.earlierProgrammes") class=IconButton width=38 height=38 padding=11
              image "symbol:back" width=16 height=16 aria-hidden=true
            button press=jumpNow aria-label=t("live.jumpToNow") class=GuideChip height=38 padding-left=14 padding-right=16
              row gap=9 align-items="center"
                column position="relative" width=8 height=8 aria-hidden=true
                  column position="absolute" inset=0 border-radius=4 background-color="cinematic.guide-now" animation=(still ? "none" : "guidePulse 2.2s ease-out infinite")
                  column position="absolute" inset=0 border-radius=4 background-color="cinematic.guide-now"
                text t("live.now") font-size=13 font-weight=650
            button press=shift(2) aria-label=t("ui.laterProgrammes") class=IconButton width=38 height=38 padding=11
              image "symbol:forward-chevron" width=16 height=16 aria-hidden=true
          column flex=1 min-width=0
          row gap=2 padding=3 border-radius=999 flex-shrink=0 background-color="cinematic.control" border="1px solid var(--cinematic.glass-edge)" role="group" aria-label=t("live.zoom")
            for z in [0, 1, 2] key=z
              button press=pickZoom(z) aria-pressed=(z == zoom) aria-label=t("live.hoursAcross", hours=(z == 0 ? "4½" : z == 1 ? "3" : "2")) class=GuideTab height=30 padding-left=10 padding-right=10 background-color=(z == zoom ? "ink.primary" : "transparent") color=(z == zoom ? "ink.inverse" : "ink.secondary")
                text t("live.hours", hours=(z == 0 ? "4½" : z == 1 ? "3" : "2")) font-size=12 font-weight=650 white-space="nowrap" font-variant-numeric="tabular-nums"
          row gap=8 align-items="center" flex-shrink=0
            button press=toggleExpanded aria-pressed=expanded aria-label=(expanded ? t("live.exitFullGuide") : t("live.fullGuide")) class=IconButton width=38 height=38 padding=11
              image (expanded ? "symbol:close" : "symbol:layers") width=16 height=16 aria-hidden=true
            button press=pickFilter(filter == "favourites" ? "all" : "favourites") aria-pressed=(filter == "favourites") aria-label=t("live.favourites") class=IconButton width=38 height=38 padding=10 color=(filter == "favourites" ? "brand.warm" : "ink.primary")
              image (filter == "favourites" ? "symbol:star-fill" : "symbol:star") width=17 height=17 aria-hidden=true
            select value=filter change=pickFilter aria-label=t("live.filter") class=GuideSelect
              option value="all"
                text t("live.allChannels")
              option value="favourites"
                text t("live.favourites")
              option value="listed"
                text t("live.withListings")
              for g in model.groups key=g
                option value=g
                  text g
      if model.channels.length == 0
        column flex=1 align-items="center" justify-content="center" gap=10 padding=32
          text t("live.noChannels") role="status" font-size=17 color="ink.secondary"
      else
        if rows.length == 0
          column flex=1 align-items="center" justify-content="center" gap=14 padding=32
            text t("live.noMatches") role="status" font-size=17 color="ink.secondary"
            button press=pickFilter("all") class=GhostPill height=42 padding-left=20 padding-right=20
              text t("live.allChannels") font-size=14
        else
          if grid
            column flex=1 min-height=0 margin-left=(small ? 0 : side(small)) margin-right=(small ? 0 : side(small)) margin-bottom=(small ? 0 : 24) border-radius=(small ? 0 : 20) overflow="hidden" border=(small ? "none" : "1px solid var(--cinematic.glass-edge)") border-top="1px solid var(--cinematic.glass-edge)" background-color="cinematic.guide-panel" box-shadow=(small ? "none" : "0px 40px 120px var(--cinematic.shadow)")
              for day in [model.day] key=day
                scroll id="guide-grid" testId="guide-grid" scroll=scrolled resize=measured scrollLeft=((landed < 0 ? landingMin : landed) * scale) flex=1 min-height=0 overflow="auto" overscroll-behavior="contain" scroll-padding-left=rail scroll-padding-top=rulerH() role="grid" aria-label=t("ui.programmeGuideUseArrowKeysToMoveAndEnterToWatch")
                  column position="relative" width=(rail + width) height=(rulerH() + rows.length * row) flex-shrink=0
                    // Half-hour and hour lines under every row, drawn once.
                    column position="absolute" left=rail top=rulerH() width=width height=(rows.length * row) aria-hidden=true background-image=`repeating-linear-gradient(90deg, var(--cinematic.guide-hour) 0px 1px, transparent 1px ${30 * scale}px, var(--cinematic.guide-half) ${30 * scale}px ${30 * scale + 1}px, transparent ${30 * scale + 1}px ${60 * scale}px)`
                    if model.nowMinute >= 0
                      column position="absolute" left=rail top=rulerH() width=(model.nowMinute * scale) height=(rows.length * row) background-color="cinematic.guide-past" aria-hidden=true pointer-events="none"
                    // The time ruler: sticky on top, its corner sticky on the left too.
                    row position="sticky" top=0 z-index=6 height=rulerH() width=(rail + width) background-color="cinematic.guide-ruler" backdrop-filter="blur(18px) saturate(1.3)" border-bottom="1px solid var(--cinematic.glass-edge)"
                      row position="sticky" left=0 z-index=7 width=rail height=rulerH() flex-shrink=0 box-sizing="border-box" padding-left=(small ? 12 : 20) align-items="center" background-color="cinematic.guide-rail" border-right="1px solid var(--cinematic.glass-edge)"
                        text (small ? model.days.filter(d => d.offset == model.day).map(d => d.label).join("") : model.dayLabel) class=Eyebrow font-size=10 letter-spacing="0.16em" color="ink.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                      column position="relative" width=width height=rulerH() flex-shrink=0
                        // A label the now pill would cover fades out rather than colliding with it.
                        for tick in model.ticks key=tick.id
                          column id=`guide-tick-${tick.minute}` position="absolute" left=(tick.minute * scale) top=0 bottom=0 width=(30 * scale) justify-content="center" aria-hidden=true
                            column position="absolute" left=0 bottom=0 width=1 height=(tick.hour ? 10 : 6) background-color=(tick.hour ? "cinematic.glass-edge-strong" : "cinematic.glass-edge")
                            text tick.label opacity=(model.nowMinute >= 0 and tick.minute * scale > model.nowMinute * scale - 112 and tick.minute * scale < model.nowMinute * scale + 30 ? 0 : 1) transition=(still ? "none" : "opacity 200ms linear") padding-left=10 font-size=12 font-weight=(tick.hour ? 650 : 500) color=(tick.hour ? "ink.primary" : "ink.quiet") font-variant-numeric="tabular-nums" white-space="nowrap"
                        if model.nowMinute >= 0
                          column id="guide-now-anchor" position="absolute" left=(max(0, model.nowMinute - (portW - rail) / scale / 3) * scale) top=0 width=1 height=1 aria-hidden=true
                          row position="absolute" left=(model.nowMinute * scale) bottom=7 translate="-50% 0px" z-index=2 gap=5 align-items="center" padding="3px 8px" border-radius=999 background-color="cinematic.guide-now" box-shadow="0px 4px 18px var(--cinematic.guide-now-glow)" aria-hidden=true
                            text model.nowLabel font-size=11 font-weight=700 color="ink.primary" font-variant-numeric="tabular-nums" white-space="nowrap"
                    // Channel rows, windowed around the port.
                    for c, i in rows.slice(firstRow, lastRow) key=c.id
                      row position="absolute" left=0 top=(rulerH() + (firstRow + i) * row) width=(rail + width) height=row role="row" border-bottom="1px solid var(--cinematic.hairline)" box-sizing="border-box"
                        GuideRail(channel=c, index=(firstRow + i), small=small, rail=rail, row=row, selected=(c.id == selChannel), watch=watch, select=select, railKey=railKey)
                        if not c.listed
                          button id=`guide-empty-${c.id}` press=watch(c.id) aria-label=t("ui.watchChannel", channel=c.name) position="sticky" left=(rail + 6) margin-left=6 margin-top=6 height=(row - 13) width=max(120, min(width, portW - rail - 12)) box-sizing="border-box" class=GuideEmpty
                            row gap=10 align-items="center" padding-left=16
                              text t("live.noListings") font-size=13 color="ink.quiet"
                              text "·" font-size=13 color="ink.quiet" aria-hidden=true
                              text t("live.watch") font-size=13 font-weight=600 color="ink.secondary"
                        for p in c.programmes.filter(p => p.at + p.span > winFrom and p.at < winTo) key=p.id
                          GuideCell(programme=p, channel=c, index=(firstRow + i), scale=scale, rail=rail, row=row, small=small, nowMinute=model.nowMinute, selected=(c.id == selChannel and p.id == selProgramme), focusMin=focusMin, select=select, press=press, move=move)
                    if model.nowMinute >= 0
                      column position="absolute" left=(rail + model.nowMinute * scale - 1) top=rulerH() width=2 height=(rows.length * row) z-index=2 background-color="cinematic.guide-now" box-shadow="0px 0px 14px var(--cinematic.guide-now-glow)" pointer-events="none" aria-hidden=true
          else
            GuideNowList(rows=rows, still=still, watch=watch)

// The preview: the selected programme over its artwork, compact beside the live tile.
component GuideHero
  props
    channel: GuideChannel
    programmeId: string
    small: bool
    still: bool
    watch: action
  derive picked = channel.programmes.filter(p => p.id == programmeId)
  view
    column position="absolute" inset=0
      for p in picked key=`art-${p.id}`
        column position="absolute" inset=0 aria-hidden=true animation=(still ? "none" : `guideSwap 520ms ${glide()} both`)
          if p.art != ""
            image p.art alt="" position="absolute" top=0 right=0 width=(small ? "100%" : "70%") height="100%" object-fit="cover" mask-image="linear-gradient(90deg, transparent 0%, black 50%)" opacity=(small ? 0.32 : 0.55)
          if p.tone >= 0
            column position="absolute" left="-8%" top="-60%" width="60%" height="200%" background-color=toneColor(p.tone) opacity=0.14 mask-image="radial-gradient(closest-side, black 0%, transparent 100%)"
      column position="absolute" inset=0 pointer-events="none" aria-hidden=true background-image="linear-gradient(0deg, var(--surface.page) 0%, var(--cinematic.scrim-mid) 45%, var(--cinematic.scrim-clear) 100%), linear-gradient(90deg, var(--cinematic.scrim-deep) 0%, var(--cinematic.scrim-mid) 40%, var(--cinematic.scrim-soft) 100%)"
      column position="relative" height="100%" justify-content="flex-end" box-sizing="border-box" padding-left=side(small) padding-right=(small ? "calc(16px + 132px)" : "calc(max(28px, 4vw) + clamp(214px, 28vh, 300px) + 28px)") padding-bottom=(small ? 12 : 16)
        for p in picked key=`copy-${p.id}`
          column gap=(small ? 4 : 7) min-width=0 animation=(still ? "none" : `guideSwap 420ms ${glide()} both`) role="region" aria-label=t("live.selectedProgramme") aria-live="polite"
            row gap=10 align-items="center" min-width=0
              if p.airing
                row gap=6 align-items="center" padding="2px 7px" border-radius=6 background-color="cinematic.guide-now" flex-shrink=0
                  column width=6 height=6 border-radius=3 background-color="ink.primary" aria-hidden=true
                  text t("live.liveBadge") font-size=10 font-weight=750 letter-spacing="0.14em"
              text `${channel.number} · ${channel.name}` class=Eyebrow font-size=10 letter-spacing="0.18em" color="ink.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              if p.genre != "" and not small
                row gap=6 align-items="center" flex-shrink=0
                  column width=6 height=6 border-radius=3 background-color=toneColor(p.tone) aria-hidden=true
                  text p.genre font-size=12 color="ink.secondary"
            text p.name class=Display font-size=(small ? 24 : 38) white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-shadow="0px 4px 40px var(--cinematic.shadow)"
            row gap=12 align-items="center" min-width=0
              if not small
                button press=watch(channel.id) class=PrimaryPill height=34 padding-left=14 padding-right=16 flex-shrink=0 testId="guide-watch"
                  row gap=8 align-items="center"
                    image "symbol:play-fill" width=13 height=13 aria-hidden=true
                    text (p.airing ? t("live.watch") : t("ui.watchChannel", channel=channel.name)) font-size=13 white-space="nowrap"
              text t("ui.startEnd", start=p.startLabel, end=p.endLabel) font-size=13 font-weight=600 font-variant-numeric="tabular-nums" white-space="nowrap"
              if p.airing
                column width=(small ? 48 : 120) height=3 flex-shrink=0 border-radius=2 background-color="cinematic.track-strong" overflow="hidden" role="progressbar" aria-label=t("live.progress") aria-valuemin=0 aria-valuemax=100 aria-valuenow=p.progress
                  column height=3 width=`${p.progress}%` background-color="brand.warm" transition=(still ? "none" : `width ${base()}ms ${glide()}`)
                text p.remainingLabel font-size=12 color="brand.warm" font-variant-numeric="tabular-nums" white-space="nowrap"
              else
                text (p.ended ? t("live.ended") : t("live.startsIn", minutes=p.startsInLabel)) font-size=12 color="ink.secondary" white-space="nowrap"
              if p.episode != "" and not small
                text p.episode font-size=12 color="ink.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              if p.rating != "" and not small
                text p.rating font-size=10 font-weight=700 letter-spacing="0.06em" padding="2px 6px" border-radius=4 border="1px solid var(--cinematic.glass-edge-strong)" color="ink.secondary" flex-shrink=0
        if picked.length == 0
          column gap=(small ? 4 : 7) min-width=0 animation=(still ? "none" : `guideSwap 420ms ${glide()} both`)
            text `${channel.number}` class=Eyebrow font-size=10 color="ink.secondary"
            text channel.name class=Display font-size=(small ? 24 : 38) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
            row gap=12 align-items="center"
              if not small
                button press=watch(channel.id) class=PrimaryPill height=34 padding-left=14 padding-right=16
                  row gap=8 align-items="center"
                    image "symbol:play-fill" width=13 height=13 aria-hidden=true
                    text t("live.watch") font-size=13
              text (channel.listed ? t("live.nothingNow") : t("live.noListings")) font-size=13 color="ink.secondary"

// The live preview tile: one muted ambient stream with its channel and an honest state.
// Clicking it opens full watch; the speaker unmutes in place.
component GuideTile
  props
    tile: LiveTile
    small: bool
    still: bool
    watch: action
    message: action
    unmute: action
    tuneIn: action
  view
    column position="relative" height=(small ? 72 : "clamp(120px, calc(16vh - 14px), 168px)") aspect-ratio="16 / 9" border-radius=(small ? 10 : 14) overflow="hidden" background-color="media.ground" border="1px solid var(--cinematic.glass-edge-strong)" box-shadow="0px 18px 50px var(--cinematic.shadow)"
      if tile.planJson != "" and (tile.state == "connecting" or tile.state == "playing")
        vela-player plan=tile.planJson playerCommand=tile.commandJson message=message ambient="true" position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
      if tile.state == "connecting"
        column position="absolute" inset=0 align-items="center" justify-content="center" role="status" aria-label=t("live.tuning", channel=tile.channelName)
          column width=18 height=18 border-radius=9 border="2px solid var(--cinematic.track-strong)" border-top-color="brand.warm" animation=(still ? "none" : "spin 900ms linear infinite") aria-hidden=true
      if tile.state == "unavailable"
        column position="absolute" inset=0 align-items="center" justify-content="center" padding=10 role="status"
          text t("live.previewUnavailable") font-size=12 color="ink.secondary" text-align="center"
      if tile.state == "tune-in"
        button press=tuneIn aria-label=t("live.tuneInTo", channel=tile.channelName) position="absolute" inset=0 class=TileTuneIn
          row gap=8 align-items="center" justify-content="center"
            image "symbol:play-fill" width=12 height=12 aria-hidden=true
            text t("live.tuneIn") font-size=13 font-weight=650
      else
        button press=watch(tile.channelId) aria-label=t("ui.watchChannel", channel=tile.channelName) position="absolute" inset=0 class=TileOpen testId="guide-tile"
      row position="absolute" left=0 right=0 top=0 gap=6 align-items="center" padding=(small ? "5px 6px" : "8px 10px") background-image="linear-gradient(180deg, var(--cinematic.player-top) 0%, var(--cinematic.scrim-clear) 100%)" pointer-events="none"
        row gap=4 align-items="center" padding="1px 5px" border-radius=4 background-color="cinematic.guide-now" flex-shrink=0
          column width=5 height=5 border-radius=3 background-color="ink.primary" aria-hidden=true
          text t("live.liveBadge") font-size=9 font-weight=750 letter-spacing="0.12em"
        if not small
          text tile.channelName font-size=11 font-weight=650 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 text-shadow="0px 1px 4px var(--cinematic.shadow)"
      if tile.state == "playing"
        button press=unmute aria-label=(tile.muted ? t("live.unmutePreview") : t("live.mutePreview")) aria-pressed=(not tile.muted) position="absolute" right=(small ? 4 : 8) bottom=(small ? 4 : 8) class=TileSpeaker width=(small ? 26 : 30) height=(small ? 26 : 30) padding=(small ? 6 : 7)
          image (tile.muted ? "symbol:speaker-mute" : "symbol:speaker") width="100%" height="100%" aria-hidden=true

// A channel's cell in the sticky rail: number, logo or monogram, name and what is on now.
component GuideRail
  props
    channel: GuideChannel
    index: number
    small: bool
    rail: number
    row: number
    selected: bool
    watch: action
    select: action
    railKey: action
  view
    button id=`guide-rail-${channel.id}` press=watch(channel.id) focus=select(channel.id, "") key=railKey(index) role="rowheader" aria-label=t("ui.watchChannel", channel=channel.name) position="sticky" left=0 z-index=3 flex-shrink=0 width=rail height=(row - 1) box-sizing="border-box" padding-left=(small ? 8 : 16) padding-right=(small ? 8 : 14) class=GuideRailCell background-color=(selected ? "cinematic.guide-rail-on" : "cinematic.guide-rail")
      row gap=(small ? 0 : 12) align-items="center" width="100%" justify-content=(small ? "center" : "flex-start")
        if not small
          text channel.number width=34 flex-shrink=0 text-align="right" font-size=12 color="ink.quiet" font-variant-numeric="tabular-nums"
        column position="relative" width=(small ? 64 : 58) height=(small ? 40 : 36) flex-shrink=0 border-radius=8 overflow="hidden" align-items="center" justify-content="center" background-color="cinematic.guide-logo" border="1px solid var(--cinematic.hairline)"
          if channel.logo != ""
            image channel.logo alt="" width="100%" height="100%" object-fit="cover"
          else
            text channel.name.slice(0, 2).toUpperCase() font-size=13 font-weight=750 letter-spacing="0.04em" color="ink.secondary"
          if small
            text channel.number position="absolute" right=3 bottom=2 font-size=9 font-weight=700 color="ink.primary" text-shadow="0px 1px 3px var(--cinematic.shadow)" font-variant-numeric="tabular-nums"
        if not small
          column gap=4 flex=1 min-width=0
            row gap=5 align-items="center"
              text channel.name font-size=14 font-weight=620 color="ink.primary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              if channel.favorite
                image "symbol:star-fill" width=10 height=10 color="brand.warm" flex-shrink=0 aria-label=t("live.favourite")
            if channel.nowId != ""
              column height=2 border-radius=1 background-color="cinematic.track" overflow="hidden" margin-top=3 aria-hidden=true
                column height=2 width=`${channel.nowProgress}%` background-color="brand.warm"
              text channel.nowRemaining font-size=11 color="ink.quiet" font-variant-numeric="tabular-nums"
            else
              text (channel.listed ? channel.group : t("live.noListings")) font-size=11 color="ink.quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// One programme block on the timeline; its label stays readable beside the rail when it began earlier.
component GuideCell
  props
    programme: GuideProgramme
    channel: GuideChannel
    index: number
    scale: number
    rail: number
    row: number
    small: bool
    nowMinute: number
    selected: bool
    focusMin: number
    select: action
    press: action
    move: action
  derive w = programme.span * scale
  derive elapsed = (programme.airing ? max(0, min(w, (nowMinute - programme.at) * scale)) : 0)
  view
    button id=`guide-${programme.id}` press=press(channel.id, programme.id, programme.airing) focus=select(channel.id, programme.id) key=move(index, programme.at, programme.airing, channel.id, programme.leftId, programme.rightId) role="gridcell" aria-selected=selected aria-label=t("ui.programmeStartToEndChannelProgrammeDetails", programme=programme.name, start=programme.startLabel, end=programme.endLabel, channel=channel.name) position="absolute" left=(rail + programme.at * scale + 2) top=5 width=max(2, w - 4) height=(row - 11) box-sizing="border-box" padding=0 display="flex" flex-direction="row" align-items="stretch" overflow="clip" text-align="left" class=GuideCell background-color=(programme.airing ? "cinematic.guide-live" : "cinematic.guide-cell") border=(programme.airing ? "1px solid var(--cinematic.guide-live-edge)" : "1px solid var(--cinematic.hairline)") opacity=(programme.ended ? 0.46 : 1) box-shadow=(selected ? "inset 0px 0px 0px 2px var(--brand.warm)" : "none") background-image=(programme.airing ? `linear-gradient(90deg, var(--cinematic.guide-live-fill) 0px, var(--cinematic.guide-live-fill) ${elapsed}px, transparent ${elapsed}px)` : "none")
      if programme.tone >= 0 and w > 24
        column position="absolute" left=0 top=10 bottom=10 width=3 border-radius=2 background-color=toneColor(programme.tone) opacity=(programme.ended ? 0.5 : 0.9) aria-hidden=true
      if programme.airing
        column position="absolute" left=0 bottom=0 height=2 width=elapsed background-color="brand.warm" aria-hidden=true
      if w >= 10 * scale
        column position="sticky" left=(rail + 12) height="100%" justify-content="center" gap=(small ? 3 : 4) padding-left=12 padding-right=10 box-sizing="border-box" max-width=max(0, w - 4) min-width=0 flex-shrink=1
          text programme.name font-size=(small ? 13 : 14) font-weight=(programme.airing ? 680 : 600) color="ink.primary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if w > 110
            text metaLine(programme) font-size=12 color=(programme.airing ? "brand.warm" : "ink.secondary") font-variant-numeric="tabular-nums" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

component GuideDayChip
  props
    label: string
    date: string
    offset: number
    on: bool
    small: bool
    pick: action
  view
    button press=pick(offset) aria-pressed=on class=GuideChip flex-shrink=0 background-color=(on ? "ink.primary" : "cinematic.control") color=(on ? "ink.inverse" : "ink.primary") border-color=(on ? "ink.primary" : "cinematic.glass-edge")
      row gap=6 align-items="baseline"
        text label font-size=13 font-weight=650 white-space="nowrap"
        if offset > 1
          text date font-size=12 opacity=0.62 white-space="nowrap"

// Phones: every channel with what is on now and next, one tap from watching.
component GuideNowList
  props
    rows: GuideChannel[]
    still: bool
    watch: action
  view
    list id="guide-now-list" virtualized=true appearance="none" flex=1 min-height=0 estimated-item-height=98 padding-bottom=24 aria-label=t("live.onNow")
      for c in rows key=c.id
        button press=watch(c.id) aria-label=t("ui.watchChannel", channel=c.name) class=GuideNowRow
          row gap=14 align-items="center" width="100%"
            column position="relative" width=76 height=48 flex-shrink=0 border-radius=10 overflow="hidden" align-items="center" justify-content="center" background-color="cinematic.guide-logo" border="1px solid var(--cinematic.hairline)"
              if c.logo != ""
                image c.logo alt="" width="100%" height="100%" object-fit="cover"
              else
                text c.name.slice(0, 2).toUpperCase() font-size=15 font-weight=750 color="ink.secondary"
            column flex=1 min-width=0 gap=4
              row gap=6 align-items="center"
                text c.number font-size=11 color="ink.quiet" font-variant-numeric="tabular-nums"
                text c.name font-size=12 font-weight=600 color="ink.secondary" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
                if c.favorite
                  image "symbol:star-fill" width=9 height=9 color="brand.warm" flex-shrink=0 aria-label=t("live.favourite")
              text (c.now != "" ? c.now : (c.listed ? t("live.nothingNow") : t("live.noListings"))) font-size=16 font-weight=(c.now != "" ? 640 : 500) color=(c.now != "" ? "ink.primary" : "ink.quiet") white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              if c.nowId != ""
                row gap=8 align-items="center"
                  column flex=1 height=2 border-radius=1 background-color="cinematic.track" overflow="hidden" aria-hidden=true
                    column height=2 width=`${c.nowProgress}%` background-color="brand.warm"
                  text c.nowRemaining font-size=11 color="ink.quiet" font-variant-numeric="tabular-nums" flex-shrink=0
              if c.nextLabel != ""
                text c.nextLabel font-size=12 color="ink.quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

style GuideChip
  box-sizing = "border-box"
  height = 36
  padding = "0px 14px"
  border-radius = 999
  border = "1px solid var(--cinematic.glass-edge)"
  background-color = "cinematic.control"
  color = "ink.primary"
  transition = "background-color 180ms linear, color 180ms linear, border-color 180ms linear"
  :hover
    border-color = "cinematic.glass-edge-strong"
  :active
    -exact-press-scale = 0.97
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--surface.page), 0px 0px 0px 4px var(--brand.warm)"

style TileOpen
  border = "none"
  background-color = "transparent"
  border-radius = 14
  :hover
    background-color = "cinematic.scrim-faint"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--brand.warm)"

style TileTuneIn
  border = "none"
  background-color = "cinematic.scrim-mid"
  color = "ink.primary"
  :hover
    background-color = "cinematic.scrim-soft"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--brand.warm)"

style TileSpeaker
  box-sizing = "border-box"
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  background-color = "cinematic.glass-deep"
  color = "ink.primary"
  :hover
    background-color = "cinematic.control-hover"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"

style GuideSelect
  box-sizing = "border-box"
  height = 38
  padding = "0px 14px"
  border = "1px solid var(--cinematic.glass-edge)"
  border-radius = 999
  background-color = "cinematic.control"
  color = "ink.primary"
  font-size = 13
  font-weight = 600

style GuideTab
  height = 30
  padding = "0px 14px"
  border = "none"
  border-radius = 999
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--brand.warm)"

style GuideRailCell
  border = "none"
  border-right = "1px solid var(--cinematic.glass-edge)"
  color = "ink.primary"
  text-align = "left"
  transition = "background-color 160ms linear"
  :hover
    background-color = "cinematic.guide-rail-on"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--brand.warm)"

style GuideCell
  border-radius = 10
  color = "ink.primary"
  transition = "border-color 160ms linear, box-shadow 200ms ease"
  :hover
    border-color = "cinematic.glass-edge-strong"
  :focus-visible
    border-color = "brand.warm"
    box-shadow = "inset 0px 0px 0px 1px var(--brand.warm), 0px 10px 34px var(--cinematic.shadow)"

style GuideEmpty
  border = "1px dashed var(--cinematic.glass-edge)"
  border-radius = 10
  background-color = "transparent"
  text-align = "left"
  :hover
    background-color = "cinematic.guide-cell"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--brand.warm)"

style GuideIdent
  background-image = "radial-gradient(ellipse at 50% 40%, var(--cinematic.guide-ident) 0%, transparent 75%)"
  border = "1px solid var(--cinematic.hairline)"

style GuideNowRow
  box-sizing = "border-box"
  width = "100%"
  padding = "12px 16px"
  border = "none"
  border-bottom = "1px solid var(--cinematic.hairline)"
  background-color = "transparent"
  color = "ink.primary"
  text-align = "left"
  :active
    background-color = "cinematic.guide-cell"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--brand.warm)"
