use GuideModel from "../../live/models.contract"

component Guide
  props
    model: GuideModel
    small: bool
    watch: action
    previous: action
    next: action
  state selectedChannel = ""
  state selectedProgramme = ""
  action selectProgramme(channel: string, programme: string)
    selectedChannel = channel
    selectedProgramme = programme
    focus("programme-sheet")
  action dismissProgramme
    let id = selectedProgramme
    selectedProgramme = ""
    focus(`guide-${id}`)
  action sheetKey(k: string)
    if k == "Escape"
      preventDefault()
      dismissProgramme()
  action move(channel: string, airing: bool, leftId: string, rightId: string, upId: string, downId: string, k: string, event: KeyboardEvent)
    if k == "Enter" and airing
      preventDefault()
      watch(channel)
    if not event.metaKey and not event.ctrlKey and not event.altKey
      if k == "ArrowLeft" or k == "ArrowRight" or k == "ArrowUp" or k == "ArrowDown"
        preventDefault()
        let target = (k == "ArrowLeft" ? leftId : (k == "ArrowRight" ? rightId : (k == "ArrowUp" ? upId : downId)))
        if target != ""
          focus(target)
  view
    column gap=20 padding="36px 5% 64px" background-image="radial-gradient(ellipse at 85% 0%, var(--cinematic.guide-aura), transparent 65%)"
      text t("ui.liveTelevision") color="brand.warm" font-size=11 letter-spacing="3px"
      text t("ui.channelGuide") role="heading" aria-level=1 font-size=(small ? 36 : 52) font-weight=550 letter-spacing="-1px"
      row gap=12 align-items="center"
        button press=previous aria-label=t("ui.earlierProgrammes") buttonStyle="bordered"
          text t("live.previous")
        button press=next aria-label=t("ui.laterProgrammes") buttonStyle="bordered"
          text t("live.next")
      text t("ui.startEnd", start=model.fromLabel, end=model.untilLabel) color="ink.secondary" font-size=13
      for channel in model.channels.filter(c => c.id == selectedChannel) key=`sheet-${channel.id}`
        for programme in channel.programmes.filter(p => p.id == selectedProgramme) key=programme.id
          column id="programme-sheet" tabindex=-1 key=sheetKey role="region" aria-label=programme.name gap=12 padding=24 border="1px solid var(--surface.line)" border-radius=16 background-color="surface.raised" max-width="35rem"
            row gap=12 align-items="center"
              column gap=6 flex=1
                text channel.name font-size=12 color="brand.warm"
                text programme.name font-size=24 font-weight=550
              button press=dismissProgramme aria-label=t("live.close") buttonStyle="bordered"
                text t("ui.close")
            text t("ui.startEnd", start=programme.startLabel, end=programme.endLabel) color="ink.secondary" font-size=13
            if programme.summary != ""
              text programme.summary color="ink.secondary" line-height=1.6
            if programme.airing
              button press=watch(channel.id) buttonStyle="bordered"
                text t("live.watch")
            else
              text (programme.ended ? t("ui.thisProgrammeHasEnded") : t("live.startsIn", minutes=programme.startsInLabel)) color="ink.secondary"
      if model.channels.length == 0
        text t("live.noChannels") role="status" color="ink.secondary"
      if small
        for channel in model.channels key=channel.id
          button press=watch(channel.id) aria-label=t("ui.watchChannel", channel=channel.name) padding=16 border="none" border-radius=12 background-color="surface.raised" color="ink.primary" text-align="left"
            column gap=6
              row gap=12 align-items="center"
                if channel.logo != ""
                  image channel.logo alt="" width=48 height=30 object-fit="contain" border-radius=4
                column gap=4
                  text (channel.favorite ? t("ui.channel", channel=channel.name) : channel.name) font-weight=600
                  text channel.number color="ink.quiet" font-size=11
              text (channel.now == "" ? t("ui.noCurrentProgrammeInformation") : t("ui.nowProgramme", programme=channel.now)) color="ink.secondary"
              if channel.next != ""
                text t("ui.nextProgramme", programme=channel.next) color="ink.quiet"
      else
        column width="100%" gap=3 role="grid" aria-label=t("ui.programmeGuideUseArrowKeysToMoveAndEnterToWatch")
          row height=54 gap=4
            column width=200 flex-shrink=0
            column flex=1 min-width=0 position="relative"
              for tick in model.ticks key=tick.id
                column position="absolute" left=`${tick.offset}%` top=0 bottom=0 width=1 background-color="surface.line"
                  text tick.label position="absolute" top=0 right=(tick.offset == 100 ? 0 : -60) width=60 font-size=11 color="ink.secondary" text-align=(tick.offset == 100 ? "right" : "left")
              if model.showNow
                column position="absolute" left=`${model.nowOffset}%` bottom=0 pointer-events="none"
                  text t("live.now") color="ink.inverse" background-color="brand.warm" border-radius=12 padding="4px 8px" font-size=10 font-weight=650
          for channel in model.channels key=channel.id
            row height=88 gap=4 role="row"
              button press=watch(channel.id) aria-label=t("ui.watchChannel", channel=channel.name) box-sizing="border-box" width=200 flex-shrink=0 padding=12 border="none" background-color="surface.raised" color="ink.primary" text-align="left"
                row gap=10 align-items="center"
                  if channel.logo != ""
                    image channel.logo alt="" width=44 height=28 object-fit="contain" border-radius=4
                  column gap=5
                    text (channel.favorite ? t("ui.channel", channel=channel.name) : channel.name) font-size=13 font-weight=600 line-clamp=1
                    text channel.number color="ink.quiet" font-size=11
              column flex=1 min-width=0 position="relative" background-color="surface.raised"
                for programme in channel.programmes key=programme.id
                  button id=`guide-${programme.id}` key=move(channel.id, programme.airing, programme.leftId, programme.rightId, programme.upId, programme.downId) press=selectProgramme(channel.id, programme.id) aria-label=t("ui.programmeStartToEndChannelProgrammeDetails", programme=programme.name, start=programme.startLabel, end=programme.endLabel, channel=channel.name) position="absolute" left=`${programme.offset}%` width=`${programme.width}%` height="100%" box-sizing="border-box" padding=14 border="1px solid var(--surface.line)" background-color=(programme.airing ? "cinematic.guide-airing" : "surface.raised") opacity=(programme.ended ? 0.45 : 1) color="ink.primary" text-align="left" overflow="hidden" border-radius=6
                    column gap=4
                      text programme.name font-weight=600 line-clamp=1
                      text t("ui.startEnd", start=programme.startLabel, end=programme.endLabel) font-size=11 color="ink.secondary"
                if model.showNow
                  column position="absolute" left=`${model.nowOffset}%` top=0 bottom=0 width=2 background-color="brand.warm" pointer-events="none"
