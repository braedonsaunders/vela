use GuideModel, GuideChannel from "../../live/models.contract"
use Glyph, Round, mqFade, mqRise, mqGone from "./look.contract"
use LiveControlsProps, MiniGuideProps from "../../foundation/slot-api.contract"

// Live state over the player: a red LIVE badge with the delivery mode, honest delivery
// states, low delay and catch-up, and channel up and down for pointers and touch.
component LiveControls
  props
    p: LiveControlsProps
  inject
    toggleLowDelay: action
    catchUp: action
    zap: action
  view
    column gap=10 padding="12px 14px" min-width=240 max-width=320 box-sizing="border-box" border-radius=8 background-color="marquee.menu" box-shadow="0px 12px 40px var(--marquee.shadow)" color="marquee.ink" font-family="\"Open Sans\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, Roboto, \"Helvetica Neue\", sans-serif"
      row gap=10 align-items="center"
        text t("live.liveBadge") font-size=11 font-weight=800 letter-spacing="0.1em" padding="3px 7px" border-radius=3 background-color="marquee.live" color="marquee.ink"
        text (p.lowDelay ? t("live.lowDelay") : t("live.adaptive")) font-size=14 font-weight=600 color="marquee.ink-dim" flex=1
        button press=zap(-1) aria-label=t("live.channelUp") class=Round width=32 height=32
          Glyph(name="up", size=18)
        button press=zap(1) aria-label=t("live.channelDown") class=Round width=32 height=32
          Glyph(name="down", size=18)
      if p.reconnecting
        text t("live.reconnecting") role="status" font-size=13 color="marquee.ink-dim"
      if p.delivery == "upstream-gap"
        text t("live.gap") role="status" font-size=13 color="marquee.ink-dim"
      if p.delivery == "segment-delayed"
        text t("live.delayed") role="status" font-size=13 color="marquee.ink-dim"
      if p.delivery == "waiting-for-publication"
        text t("live.publication") role="status" font-size=13 color="marquee.ink-dim"
      if p.drift > 0
        text t("live.behind", seconds=p.driftLabel) role="status" font-size=13 color="marquee.ink-dim" font-variant-numeric="tabular-nums"
      row gap=8 flex-wrap="wrap"
        button press=toggleLowDelay aria-label=t("ui.toggleLowDelay") aria-pressed=p.lowDelay class=LiveToggle background-color=(p.lowDelay ? "marquee.amber" : "marquee.control") color=(p.lowDelay ? "marquee.on-amber" : "marquee.ink")
          text (p.lowDelay ? t("ui.lowDelayOn") : t("ui.useLowDelay")) font-size=13 font-weight=700
        if p.canCatchUp and p.drift > 0
          button press=catchUp class=LiveToggle background-color="marquee.control" color="marquee.ink"
            text t("live.catchUp") font-size=13 font-weight=700

style LiveToggle
  box-sizing = "border-box"
  height = 32
  padding = "0px 12px"
  border = "none"
  border-radius = 4
  cursor = "pointer"
  :hover
    opacity = 0.9
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.ink)"

// The in-player mini guide while flicking channels: the channel being tuned to between
// its neighbours, with what is on now, its progress and what is next.
component MiniGuide
  props
    p: MiniGuideProps
  inject
    tune: action
  derive ids = p.model.channels.map(c => c.id)
  derive at = max(0, ids.indexOf(p.target != "" ? p.target : p.playing))
  derive n = p.model.channels.length
  derive around = (n < 3 ? p.model.channels : p.model.channels.slice((at - 1 + n) % n, (at - 1 + n) % n + 1).concat(p.model.channels.slice(at, at + 1)).concat(p.model.channels.slice((at + 1) % n, (at + 1) % n + 1)))
  view
    column width=(p.small ? "calc(100vw - 32px)" : 380) border-radius=6 overflow="hidden" background-color="marquee.menu" box-shadow="0px 16px 50px var(--marquee.shadow)" color="marquee.ink" font-family="\"Open Sans\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, Roboto, \"Helvetica Neue\", sans-serif" role="region" aria-label=t("live.channels") aria-live="polite" animation=(p.still ? "mqFade 120ms linear both" : "mqRise 220ms cubic-bezier(0.2, 0, 0, 1) both") -exact-exit-animation="mqGone 140ms linear both"
      for c, i in around key=c.id
        if (n < 3 ? c.id == (p.target != "" ? p.target : p.playing) : i == 1)
          button press=tune aria-label=t("ui.watchChannel", channel=c.name) class=ZapTarget
            row gap=12 align-items="center" width="100%"
              ChannelMark(channel=c, size=46)
              column flex=1 min-width=0 gap=4
                row gap=8 align-items="center"
                  text c.number font-size=13 font-weight=800 color="marquee.amber" font-variant-numeric="tabular-nums"
                  text c.name font-size=13 font-weight=600 color="marquee.ink-dim" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
                  if c.id == p.playing
                    text t("live.watching") font-size=11 font-weight=700 color="marquee.ink-faint" flex-shrink=0
                text (c.now != "" ? c.now : (c.listed ? t("live.nothingNow") : t("live.noListings"))) font-size=16 font-weight=700 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                if c.nowId != ""
                  row gap=8 align-items="center"
                    column flex=1 height=3 border-radius=2 background-color="marquee.track" overflow="hidden" aria-hidden=true
                      column height=3 width=`${c.nowProgress}%` background-color="marquee.amber"
                    text c.nowRemaining font-size=12 color="marquee.ink-faint" font-variant-numeric="tabular-nums" flex-shrink=0
                if c.nextLabel != ""
                  text c.nextLabel font-size=12 color="marquee.ink-faint" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        else
          row gap=12 align-items="center" padding="8px 14px" opacity=0.75 aria-hidden=true
            text c.number width=40 font-size=12 font-weight=700 color="marquee.ink-faint" font-variant-numeric="tabular-nums"
            text c.name font-size=13 font-weight=600 color="marquee.ink-dim" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex=1 min-width=0
            text (c.now != "" ? c.now : t("live.noListings")) font-size=12 color="marquee.ink-faint" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="50%"

// A channel's logo on a quiet tile, or its initials when it has none.
component ChannelMark
  props
    channel: GuideChannel
    size: number
  view
    column width=(size * 1.6) height=size flex-shrink=0 border-radius=3 overflow="hidden" align-items="center" justify-content="center" background-color="marquee.raised"
      if channel.logo != ""
        image channel.logo alt="" width="100%" height="100%" object-fit="contain"
      else
        text channel.name.slice(0, 3).toUpperCase() font-size=13 font-weight=800 color="marquee.ink-dim"

style ZapTarget
  box-sizing = "border-box"
  width = "100%"
  padding = "12px 14px"
  border = "none"
  border-top = "1px solid var(--marquee.line)"
  border-bottom = "1px solid var(--marquee.line)"
  background-color = "marquee.raised"
  color = "marquee.ink"
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "marquee.control-hover"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--marquee.amber)"
