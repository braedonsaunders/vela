use GuideModel, GuideChannel, GuideProgramme, LiveTile from "../../live/models.contract"
use LibraryOption from "../../foundation/models.contract"
use Glyph, Solid, Spinner, Art, Pick, Primary, Secondary, Round, barH, gutter from "./look.contract"
use GuideProps from "../../foundation/slot-api.contract"

// The live guide as a grid: the focused programme's details and the live preview
// tile on top, a toolbar of days and filters, then channels down the left against
// a sticky half-hour ruler. Rows and programmes are windowed around the visible port.

fn ppm(small: bool): number = (small ? 3.6 : 5)
fn rowH(small: bool): number = (small ? 60 : 64)
fn railW(small: bool): number = (small ? 92 : 220)
fn rulerH(): number = 36

fn keep(c: GuideChannel, filter: string): bool = (filter == "all" ? true : filter == "favourites" ? c.favorite : filter == "listed" ? c.listed : c.group == filter)

// The programme under `at` minutes in a row, else the next one, else the last; a row without
// listings focuses its channel. Cell ids match the data module's left/right neighbour ids.
fn cellAt(c: GuideChannel, at: number): string = match first(c.programmes.filter(entry => entry.at + entry.span > at)) { case some(entry) => `guide-${entry.id}`, case none => match first(c.programmes.slice(-1)) { case some(entry) => `guide-${entry.id}`, case none => `mq-rail-${c.id}` } }

component Guide
  props
    p: GuideProps
  inject
    watch: action
    chooseDay: action
    tileMessage: action
    tileUnmute: action
    tileTuneIn: action
    retune: action
  state selChannel = ""
  state selProgramme = ""
  state filter = "all"
  state rowBase = 0
  state colBase = -1
  state portW = 1200
  state portH = 600
  state focusMin = -1
  state landed = -1
  derive rows = p.model.channels.filter(c => keep(c, filter))
  derive scale = ppm(p.small)
  derive row = rowH(p.small)
  derive rail = railW(p.small)
  derive width = p.model.minutes * scale
  // Open with the landing time (now, on today) a quarter of the way across, so a little of the past shows.
  derive anchorMin = (p.model.nowMinute >= 0 ? p.model.nowMinute : p.model.landing)
  derive landingMin = max(0, min(p.model.minutes - (portW - rail) / scale, anchorMin - (portW - rail) / scale / 4))
  derive col = (colBase < 0 ? floor(landingMin / 30) : colBase)
  derive firstRow = max(0, rowBase - 6)
  derive lastRow = min(rows.length, rowBase + ceil(portH / row) + 8)
  derive winFrom = col * 30 - 120
  derive winTo = col * 30 + portW / scale + 120
  derive focusChannels = (selChannel != "" ? p.model.channels.filter(c => c.id == selChannel) : p.model.channels.filter(c => c.nowId != "").slice(0, 1))
  derive filterChoices = [LibraryOption(id="all", label=t("live.allChannels")), LibraryOption(id="favourites", label=t("live.favourites")), LibraryOption(id="listed", label=t("live.withListings"))].concat(p.model.groups.map(g => LibraryOption(id=g, label=g)))
  action scrolled(x: number, y: number)
    if landed < 0
      landed = landingMin
    let r = floor(y / row / 4) * 4
    if r != rowBase
      rowBase = r
    let c = floor(x / scale / 30)
    if c != colBase
      colBase = c
  action measured(w: number, h: number)
    portW = w
    portH = h
  action pickDay(offset: number)
    rowBase = 0
    colBase = -1
    landed = -1
    focusMin = -1
    selChannel = ""
    selProgramme = ""
    chooseDay(offset)
  action pickFilter(value: string)
    filter = value
    rowBase = 0
  action jumpNow
    if p.model.day != 0
      pickDay(0)
    else
      selChannel = ""
      selProgramme = ""
      if p.still
        scrollIntoView("mq-guide-now", block="nearest", inline="start")
      else
        scrollIntoView("mq-guide-now", block="nearest", inline="start", behavior="smooth")
  action shift(hours: number)
    let target = col * 30 + hours * 60
    if target < 0 and p.model.day > 0
      pickDay(p.model.day - 1)
    else
      if target > p.model.minutes - 60 and p.model.day < p.model.days.length - 1
        pickDay(p.model.day + 1)
      else
        let id = `mq-tick-${max(0, min(p.model.minutes - 30, target))}`
        if p.still
          scrollIntoView(id, block="nearest", inline="start")
        else
          scrollIntoView(id, block="nearest", inline="start", behavior="smooth")
  action select(channel: string, programme: string)
    selChannel = channel
    selProgramme = programme
  action press(channel: string, programme: string, airing: bool)
    selChannel = channel
    selProgramme = programme
    focusMin = -1
    if airing
      retune(channel)
  action move(index: number, at: number, airing: bool, channel: string, leftId: string, rightId: string, k: string, event: KeyboardEvent)
    if k == "Enter" and airing
      preventDefault()
      watch(channel)
    if not event.metaKey and not event.ctrlKey and not event.altKey
      if k == "ArrowLeft" and leftId != ""
        preventDefault()
        focusMin = -1
        focus(leftId)
      if k == "ArrowRight" and rightId != ""
        preventDefault()
        focusMin = -1
        focus(rightId)
      if k == "ArrowUp" or k == "ArrowDown" or k == "PageUp" or k == "PageDown"
        preventDefault()
        let step = (k == "ArrowUp" ? -1 : k == "ArrowDown" ? 1 : k == "PageUp" ? -6 : 6)
        let target = max(0, min(rows.length - 1, index + step))
        let at2 = (focusMin >= 0 ? focusMin : max(at, col * 30))
        focusMin = at2
        focus(match first(rows.slice(target, target + 1)) { case some(c) => cellAt(c, at2), case none => "" })
  action railKey(index: number, k: string)
    if k == "ArrowUp" or k == "ArrowDown"
      preventDefault()
      let target = max(0, min(rows.length - 1, index + (k == "ArrowUp" ? -1 : 1)))
      focus(match first(rows.slice(target, target + 1)) { case some(c) => `mq-rail-${c.id}`, case none => "" })
    if k == "ArrowRight"
      preventDefault()
      focus(match first(rows.slice(index, index + 1)) { case some(c) => cellAt(c, max(col * 30, p.model.nowMinute)), case none => "" })
  view
    column height="100%" min-height=0 box-sizing="border-box" padding-top=barH(p.small) background-color="marquee.page" color="marquee.ink" font-family="\"Open Sans\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, Roboto, \"Helvetica Neue\", sans-serif"
      text t("ui.channelGuide") role="heading" aria-level=1 position="absolute" width=1 height=1 overflow="hidden" opacity=0
      row flex-shrink=0 gap=(p.small ? 12 : 24) align-items="stretch" padding=(p.small ? "12px 14px 8px" : "20px 40px 14px")
        column flex=1 min-width=0
          for c in focusChannels key=`focus-${c.id}`
            Focus(channel=c, programmeId=(selChannel == c.id and selProgramme != "" ? selProgramme : c.nowId), small=p.small, still=p.still, watch=watch)
        if p.tile.state != "off"
          GuideTile(tile=p.tile, small=p.small, still=p.still, watch=watch, message=tileMessage, unmute=tileUnmute, tuneIn=tileTuneIn)
      row flex-shrink=0 align-items="center" gap=(p.small ? 4 : 8) padding-left=(p.small ? "8px" : "34px") padding-right=gutter(p.small) padding-bottom=8 border-bottom="1px solid var(--marquee.line)" role="toolbar" aria-label=t("live.guideControls")
        scroll flex=1 min-width=0 overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
          row gap=2 align-items="center" role="group" aria-label=t("live.day")
            for d in p.model.days key=d.offset
              button press=pickDay(d.offset) aria-pressed=(d.offset == p.model.day) class=DayTab color=(d.offset == p.model.day ? "marquee.ink" : "marquee.ink-dim") border-bottom=(d.offset == p.model.day ? "2px solid var(--marquee.amber)" : "2px solid transparent")
                text (d.offset > 1 and not p.small ? `${d.label} ${d.date}` : d.label) font-size=14 font-weight=(d.offset == p.model.day ? 700 : 600) white-space="nowrap"
        button press=shift(-2) aria-label=t("ui.earlierProgrammes") class=Round width=34 height=34
          Glyph(name="left", size=18)
        button press=jumpNow aria-label=t("live.jumpToNow") class=NowButton
          text t("live.now") font-size=13 font-weight=700
        button press=shift(2) aria-label=t("ui.laterProgrammes") class=Round width=34 height=34
          Glyph(name="right", size=18)
        if not p.small
          Pick(label=t("live.filter"), value=filter, choices=filterChoices, change=pickFilter)
        else
          button press=pickFilter(filter == "favourites" ? "all" : "favourites") aria-pressed=(filter == "favourites") aria-label=t("live.favourites") class=Round width=34 height=34 color=(filter == "favourites" ? "marquee.amber" : "marquee.ink-dim")
            if filter == "favourites"
              Solid(name="star", size=18)
            else
              Glyph(name="star", size=18)
      if p.model.channels.length == 0
        column flex=1 align-items="center" justify-content="center" padding=32
          text t("live.noChannels") role="status" font-size=16 color="marquee.ink-dim"
      else
        if rows.length == 0
          column flex=1 align-items="center" justify-content="center" gap=14 padding=32
            text t("live.noMatches") role="status" font-size=16 color="marquee.ink-dim"
            button press=pickFilter("all") class=Secondary height=38 padding="0px 18px"
              text t("live.allChannels") font-size=14
        else
          for day in [p.model.day] key=day
            scroll id="mq-guide-grid" testId="guide-grid" scroll=scrolled resize=measured scrollLeft=((landed < 0 ? landingMin : landed) * scale) flex=1 min-height=0 overflow="auto" overscroll-behavior="contain" scroll-padding-left=rail scroll-padding-top=rulerH() role="grid" aria-label=t("ui.programmeGuideUseArrowKeysToMoveAndEnterToWatch")
              column position="relative" width=(rail + width) height=(rulerH() + rows.length * row) flex-shrink=0
                if p.model.nowMinute >= 0
                  column position="absolute" left=rail top=rulerH() width=(p.model.nowMinute * scale) height=(rows.length * row) background-color="marquee.guide-past" aria-hidden=true pointer-events="none"
                row position="sticky" top=0 z-index=6 height=rulerH() width=(rail + width) background-color="marquee.chrome" border-bottom="1px solid var(--marquee.line)"
                  row position="sticky" left=0 z-index=7 width=rail height=rulerH() flex-shrink=0 box-sizing="border-box" padding-left=(p.small ? 10 : 16) align-items="center" background-color="marquee.chrome"
                    text (p.small ? p.model.days.filter(d => d.offset == p.model.day).map(d => d.label).join("") : p.model.dayLabel) font-size=12 font-weight=700 color="marquee.ink-dim" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  column position="relative" width=width height=rulerH() flex-shrink=0
                    for tick in p.model.ticks key=tick.id
                      column id=`mq-tick-${tick.minute}` position="absolute" left=(tick.minute * scale) top=0 bottom=0 width=(30 * scale) justify-content="center" border-left="1px solid var(--marquee.line)" box-sizing="border-box" aria-hidden=true
                        text tick.label padding-left=8 font-size=12 font-weight=(tick.hour ? 700 : 500) color=(tick.hour ? "marquee.ink" : "marquee.ink-faint") font-variant-numeric="tabular-nums" white-space="nowrap" opacity=(p.model.nowMinute >= 0 and tick.minute * scale > p.model.nowMinute * scale - 90 and tick.minute * scale < p.model.nowMinute * scale + 24 ? 0 : 1)
                    if p.model.nowMinute >= 0
                      column id="mq-guide-now" position="absolute" left=(max(0, p.model.nowMinute - (portW - rail) / scale / 4) * scale) top=0 width=1 height=1 aria-hidden=true
                      text p.model.nowLabel position="absolute" left=(p.model.nowMinute * scale) top=8 translate="-50% 0px" z-index=2 padding="2px 7px" border-radius=3 background-color="marquee.amber" color="marquee.on-amber" font-size=11 font-weight=800 font-variant-numeric="tabular-nums" white-space="nowrap" aria-hidden=true
                for c, i in rows.slice(firstRow, lastRow) key=c.id
                  row position="absolute" left=0 top=(rulerH() + (firstRow + i) * row) width=(rail + width) height=row role="row"
                    RailCell(channel=c, index=(firstRow + i), small=p.small, rail=rail, row=row, selected=(c.id == selChannel), watch=watch, select=select, railKey=railKey)
                    if not c.listed
                      button press=watch(c.id) aria-label=t("ui.watchChannel", channel=c.name) position="sticky" left=(rail + 1) margin-left=1 margin-top=1 height=(row - 2) width=max(120, min(width, portW - rail - 4)) box-sizing="border-box" class=EmptyCell
                        row gap=8 align-items="center" padding-left=14
                          text t("live.noListings") font-size=13 color="marquee.ink-faint"
                          text t("live.watch") font-size=13 font-weight=700 color="marquee.amber"
                    for entry in c.programmes.filter(entry => entry.at + entry.span > winFrom and entry.at < winTo) key=entry.id
                      Cell(programme=entry, channel=c, index=(firstRow + i), scale=scale, rail=rail, row=row, small=p.small, nowMinute=p.model.nowMinute, selected=(c.id == selChannel and entry.id == selProgramme), select=select, press=press, move=move)
                if p.model.nowMinute >= 0
                  column position="absolute" left=(rail + p.model.nowMinute * scale - 1) top=rulerH() width=2 height=(rows.length * row) z-index=2 background-color="marquee.amber" pointer-events="none" aria-hidden=true

style DayTab
  box-sizing = "border-box"
  height = 38
  padding = "0px 12px"
  border = "none"
  border-radius = 0
  background-color = "transparent"
  cursor = "pointer"
  :hover
    color = "marquee.ink"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--marquee.amber)"

style NowButton
  box-sizing = "border-box"
  height = 30
  padding = "0px 12px"
  border = "1px solid var(--marquee.line-strong)"
  border-radius = 4
  background-color = "transparent"
  color = "marquee.ink"
  cursor = "pointer"
  :hover
    background-color = "marquee.hover"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.amber)"

// The focused programme: its still, channel, name, time and progress, and a way to watch.
component Focus
  props
    channel: GuideChannel
    programmeId: string
    small: bool
    still: bool
    watch: action
  derive picked = channel.programmes.filter(entry => entry.id == programmeId)
  view
    row gap=(small ? 12 : 20) align-items="center" min-width=0 height=(small ? 84 : 132) role="region" aria-label=t("live.selectedProgramme") aria-live="polite"
      for entry in picked key=entry.id
        if entry.art != "" and not small
          column position="relative" height="100%" aspect-ratio="16 / 9" flex-shrink=0 border-radius=4 overflow="hidden" background-color="marquee.raised"
            Art(src=entry.art, still=still)
        column flex=1 min-width=0 gap=(small ? 3 : 6)
          row gap=8 align-items="center" min-width=0
            if entry.airing
              text t("live.liveBadge") font-size=10 font-weight=800 letter-spacing="0.1em" padding="2px 6px" border-radius=3 background-color="marquee.live" color="marquee.ink" flex-shrink=0
            text `${channel.number} · ${channel.name}` font-size=13 font-weight=600 color="marquee.ink-dim" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
          text entry.name font-size=(small ? 17 : 22) font-weight=700 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          row gap=10 align-items="center" min-width=0
            text t("ui.startEnd", start=entry.startLabel, end=entry.endLabel) font-size=13 color="marquee.ink-dim" font-variant-numeric="tabular-nums" white-space="nowrap"
            if entry.airing
              column width=(small ? 50 : 100) height=4 flex-shrink=0 border-radius=2 background-color="marquee.track" overflow="hidden" role="progressbar" aria-label=t("live.progress") aria-valuemin=0 aria-valuemax=100 aria-valuenow=entry.progress
                column height=4 width=`${entry.progress}%` background-color="marquee.amber"
              text entry.remainingLabel font-size=13 color="marquee.amber" font-variant-numeric="tabular-nums" white-space="nowrap"
            else
              text (entry.ended ? t("live.ended") : t("live.startsIn", minutes=entry.startsInLabel)) font-size=13 color="marquee.ink-faint" white-space="nowrap"
            if entry.episode != "" and not small
              text entry.episode font-size=13 color="marquee.ink-faint" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
          if entry.summary != "" and not small
            text entry.summary font-size=13 color="marquee.ink-dim" line-height=1.45 line-clamp=1
        if not small
          button press=watch(channel.id) class=Primary height=40 padding="0px 20px" flex-shrink=0 testId="guide-watch"
            row gap=8 align-items="center"
              Solid(name="play", size=16)
              text (entry.airing ? t("live.watch") : t("ui.watchChannel", channel=channel.name)) font-size=14 white-space="nowrap"
      if picked.length == 0
        column flex=1 min-width=0 gap=4
          text `${channel.number} · ${channel.name}` font-size=13 font-weight=600 color="marquee.ink-dim"
          text (channel.listed ? t("live.nothingNow") : t("live.noListings")) font-size=(small ? 17 : 22) font-weight=700
        if not small
          button press=watch(channel.id) class=Primary height=40 padding="0px 20px" flex-shrink=0
            row gap=8 align-items="center"
              Solid(name="play", size=16)
              text t("live.watch") font-size=14

// The live preview tile: one muted ambient stream with its channel and an honest state.
component GuideTile
  props
    tile: LiveTile
    small: bool
    still: bool
    watch: action
    message: action
    unmute: action
    tuneIn: action
  view
    column position="relative" height=(small ? 84 : 132) aspect-ratio="16 / 9" flex-shrink=0 border-radius=4 overflow="hidden" background-color="media.ground" box-shadow="0px 8px 24px var(--marquee.shadow), 0px 0px 0px 1px var(--marquee.line)"
      if tile.planJson != "" and (tile.state == "connecting" or tile.state == "playing")
        vela-player plan=tile.planJson playerCommand=tile.commandJson message=message ambient="true" position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
      if tile.state == "connecting"
        column position="absolute" inset=0 align-items="center" justify-content="center" role="status" aria-label=t("live.tuning", channel=tile.channelName)
          Spinner(size=22, still=still)
      if tile.state == "unavailable"
        column position="absolute" inset=0 align-items="center" justify-content="center" padding=10 role="status"
          text t("live.previewUnavailable") font-size=12 color="marquee.ink-dim" text-align="center"
      if tile.state == "tune-in"
        button press=tuneIn aria-label=t("live.tuneInTo", channel=tile.channelName) position="absolute" inset=0 class=TileButton background-color="marquee.scrim-soft"
          row gap=8 align-items="center" justify-content="center"
            Solid(name="play", size=14)
            text t("live.tuneIn") font-size=13 font-weight=700
      else
        button press=watch(tile.channelId) aria-label=t("ui.watchChannel", channel=tile.channelName) position="absolute" inset=0 class=TileButton background-color="transparent" testId="guide-tile"
      row position="absolute" left=0 right=0 top=0 gap=6 align-items="center" padding=(small ? "5px 6px" : "7px 9px") background-image="linear-gradient(180deg, var(--marquee.scrim) 0%, var(--marquee.scrim-clear) 100%)" pointer-events="none"
        text t("live.liveBadge") font-size=9 font-weight=800 letter-spacing="0.1em" padding="1px 5px" border-radius=3 background-color="marquee.live" color="marquee.ink" flex-shrink=0
        if not small
          text tile.channelName font-size=11 font-weight=700 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
      if tile.state == "playing"
        button press=unmute aria-label=(tile.muted ? t("live.unmutePreview") : t("live.mutePreview")) aria-pressed=(not tile.muted) position="absolute" right=6 bottom=6 class=Round width=30 height=30 background-color="marquee.scrim" color="marquee.ink"
          Glyph(name=(tile.muted ? "mute" : "volume"), size=16)

style TileButton
  border = "none"
  color = "marquee.ink"
  cursor = "pointer"
  :hover
    background-color = "marquee.scrim-faint"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--marquee.amber)"

// A channel in the sticky rail: logo, number and name.
component RailCell
  props
    channel: GuideChannel
    index: number
    small: bool
    rail: number
    row: number
    selected: bool
    watch: action
    select: action
    railKey: action
  view
    button id=`mq-rail-${channel.id}` press=watch(channel.id) focus=select(channel.id, "") key=railKey(index) role="rowheader" aria-label=t("ui.watchChannel", channel=channel.name) position="sticky" left=0 z-index=3 flex-shrink=0 width=rail height=row box-sizing="border-box" padding-left=(small ? 6 : 12) padding-right=(small ? 6 : 10) class=RailButton background-color=(selected ? "marquee.raised" : "marquee.guide-rail")
      row gap=(small ? 0 : 12) align-items="center" width="100%" justify-content=(small ? "center" : "flex-start")
        column position="relative" width=(small ? 76 : 64) height=(small ? 42 : 38) flex-shrink=0 border-radius=3 overflow="hidden" align-items="center" justify-content="center" background-color="marquee.raised"
          if channel.logo != ""
            image channel.logo alt="" width="100%" height="100%" object-fit="contain"
          else
            text channel.name.slice(0, 3).toUpperCase() font-size=12 font-weight=800 color="marquee.ink-dim"
          if small
            text channel.number position="absolute" right=3 bottom=1 font-size=9 font-weight=800 color="marquee.ink" text-shadow="0px 1px 3px var(--marquee.shadow)" font-variant-numeric="tabular-nums"
        if not small
          column gap=2 flex=1 min-width=0
            row gap=5 align-items="center"
              text channel.number font-size=12 font-weight=700 color="marquee.ink-faint" font-variant-numeric="tabular-nums"
              if channel.favorite
                column color="marquee.amber" aria-label=t("live.favourite")
                  Solid(name="star", size=11)
            text channel.name font-size=13 font-weight=600 color="marquee.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

style RailButton
  border = "none"
  border-bottom = "1px solid var(--marquee.page)"
  border-right = "1px solid var(--marquee.line)"
  color = "marquee.ink"
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "marquee.raised"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--marquee.amber)"

// One programme block; its label stays beside the rail when it began earlier.
component Cell
  props
    programme: GuideProgramme
    channel: GuideChannel
    index: number
    scale: number
    rail: number
    row: number
    small: bool
    nowMinute: number
    selected: bool
    select: action
    press: action
    move: action
  derive w = programme.span * scale
  derive elapsed = (programme.airing ? max(0, min(w, (nowMinute - programme.at) * scale)) : 0)
  view
    button id=`guide-${programme.id}` press=press(channel.id, programme.id, programme.airing) focus=select(channel.id, programme.id) key=move(index, programme.at, programme.airing, channel.id, programme.leftId, programme.rightId) role="gridcell" aria-selected=selected aria-label=t("ui.programmeStartToEndChannelProgrammeDetails", programme=programme.name, start=programme.startLabel, end=programme.endLabel, channel=channel.name) position="absolute" left=(rail + programme.at * scale + 1) top=1 width=max(2, w - 2) height=(row - 2) box-sizing="border-box" padding=0 display="flex" flex-direction="row" align-items="stretch" overflow="clip" text-align="left" class=GuideCell background-color=(programme.airing ? "marquee.guide-air" : "marquee.guide-cell") opacity=(programme.ended ? 0.55 : 1) border-color=(selected ? "marquee.amber" : "transparent")
      if programme.airing
        column position="absolute" left=0 bottom=0 height=3 width=elapsed background-color="marquee.amber" aria-hidden=true
      if w >= 8 * scale
        column position="sticky" left=(rail + 1) height="100%" justify-content="center" gap=3 padding-left=12 padding-right=8 box-sizing="border-box" max-width=max(0, w - 2) min-width=0 flex-shrink=1
          text programme.name font-size=(small ? 13 : 14) font-weight=(programme.airing ? 700 : 600) color="marquee.ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if w > 100
            text (programme.airing ? programme.remainingLabel : t("ui.startEnd", start=programme.startLabel, end=programme.endLabel)) font-size=12 color=(programme.airing ? "marquee.amber" : "marquee.ink-faint") font-variant-numeric="tabular-nums" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// Hover tints whatever the cell's fill is; focus draws the amber edge.
style GuideCell
  border = "2px solid transparent"
  border-radius = 2
  color = "marquee.ink"
  cursor = "pointer"
  :hover
    box-shadow = "inset 0px 0px 0px 200px var(--marquee.hover)"
  :focus-visible
    border-color = "marquee.amber"

style EmptyCell
  border = "1px dashed var(--marquee.line-strong)"
  border-radius = 2
  background-color = "transparent"
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "marquee.guide-cell"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 2px var(--marquee.amber)"
