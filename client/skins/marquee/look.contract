use LibraryOption from "../../foundation/models.contract"

// Marquee design tokens: a charcoal media-server look with an amber accent. Type is
// the platform's sans in confident weights; icons are the skin's own line glyphs.
// Every colour is a marquee.* token in app.tamber.

// The top bar's height; pages under the overlaid bar start below it.
fn barH(small: bool): number = (small ? 52 : 56)
// Page gutters: content aligns to them everywhere.
fn gutter(small: bool): string = (small ? "14px" : "40px")
fn gutterPx(small: bool): number = (small ? 14 : 40)

// Hover and press feedback is quick and flat; reduced motion keeps colour changes only.
fn ease(): string = "cubic-bezier(0.2, 0, 0, 1)"
fn quick(still: bool): string = (still ? "none" : `background-color 120ms linear, color 120ms linear, border-color 120ms linear, box-shadow 160ms ${ease()}, opacity 160ms linear`)
fn arrive(still: bool, delay: number): string = (still ? "mqFade 160ms linear both" : `mqRise 420ms ${ease()} ${delay}ms both`)

fn kindLabel(kind: string): string = (kind == "movie" ? t("ui.film") : kind == "show" ? t("ui.series") : kind == "season" ? t("ui.season") : kind == "episode" ? t("ui.episode") : t("ui.collection"))

keyframes mqFade
  from opacity=0

keyframes mqGone
  to opacity=0

keyframes mqRise
  from opacity=0 translate="0px 10px"

keyframes mqDrop
  from opacity=0 translate="0px -6px"

keyframes mqSlide
  from translate="-100% 0px"

keyframes mqSpin
  from rotate=0
  to rotate=360

keyframes mqPulse
  50% opacity=0.4

keyframes mqSheen
  from translate="-100% 0px"
  to translate="100% 0px"

// One line glyph per name, drawn on a 24-unit grid with a round 1.8 stroke.
fn glyphPath(name: string): string = (
  name == "home" ? "M3.5 11 12 4l8.5 7M6 9.2V20h4.5v-5.5h3V20H18V9.2" :
  name == "film" ? "M4 4.5h16v15H4zM8 4.5v15M16 4.5v15M4 8.5h4M4 12h4M4 15.5h4M16 8.5h4M16 12h4M16 15.5h4" :
  name == "tv" ? "M3 7.5h18v11.5H3zM8.5 3.5 12 7l3.5-3.5M8 21h8" :
  name == "live" ? "M12 10.6a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8zM8.2 8.2a5.4 5.4 0 0 0 0 7.6M15.8 8.2a5.4 5.4 0 0 1 0 7.6M5.4 5.4a9.3 9.3 0 0 0 0 13.2M18.6 5.4a9.3 9.3 0 0 1 0 13.2" :
  name == "stack" ? "M4 9h16v11H4zM6.5 6h11M9 3h6" :
  name == "menu" ? "M4 6.5h16M4 12h16M4 17.5h16" :
  name == "search" ? "M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.3 15.3 20.5 20.5" :
  name == "grid" ? "M4 4h6.5v6.5H4zM13.5 4H20v6.5h-6.5zM4 13.5h6.5V20H4zM13.5 13.5H20V20h-6.5z" :
  name == "rows" ? "M4 6h3M10 6h10M4 12h3M10 12h10M4 18h3M10 18h10" :
  name == "left" ? "M14.5 5.5 8 12l6.5 6.5" :
  name == "right" ? "M9.5 5.5 16 12l-6.5 6.5" :
  name == "down" ? "M6.5 9.5 12 15l5.5-5.5" :
  name == "up" ? "M6.5 14.5 12 9l5.5 5.5" :
  name == "back" ? "M19.5 12h-14M11 6l-6 6 6 6" :
  name == "close" ? "M6.5 6.5l11 11M17.5 6.5l-11 11" :
  name == "check" ? "M5 12.5l4.5 4.5L19 7.5" :
  name == "heart" ? "M12 19.5s-7-4.3-7-9.6a3.9 3.9 0 0 1 7-2.4 3.9 3.9 0 0 1 7 2.4c0 5.3-7 9.6-7 9.6z" :
  name == "sort" ? "M8 4.5v15M4.5 16 8 19.5 11.5 16M16 19.5v-15M12.5 8 16 4.5 19.5 8" :
  name == "filter" ? "M4 5.5h16l-6.2 7.2v5.6l-3.6 1.6v-7.2z" :
  name == "sliders" ? "M4 7h9M17 7h3M15 5v4M4 17h3M11 17h9M9 15v4" :
  name == "volume" ? "M4 9.5h3.5L12 5.5v13l-4.5-4H4zM15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11" :
  name == "volume-low" ? "M4 9.5h3.5L12 5.5v13l-4.5-4H4zM15.5 9a4.2 4.2 0 0 1 0 6" :
  name == "mute" ? "M4 9.5h3.5L12 5.5v13l-4.5-4H4zM16 9.5l5 5M21 9.5l-5 5" :
  name == "expand" ? "M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" :
  name == "pip" ? "M3 5h18v14H3zM12 11.5h6.5v5H12z" :
  name == "captions" ? "M3 5h18v14H3zM7 12.5h3.5M13 12.5h4M7 15.5h7" :
  name == "person" ? "M12 4.5a3.8 3.8 0 1 1 0 7.6 3.8 3.8 0 0 1 0-7.6zM4.5 20a7.5 7.5 0 0 1 15 0" :
  name == "signout" ? "M14 4.5h5v15h-5M10 8l-4 4 4 4M6 12h10" :
  name == "phone" ? "M8 2.5h8a1 1 0 0 1 1 1v17a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1v-17a1 1 0 0 1 1-1zM11 18.5h2" :
  name == "alert" ? "M12 3.5 21.5 20h-19zM12 10v4.5M12 17.3v.2" :
  name == "star" ? "M12 3.8l2.5 5.2 5.7.7-4.2 3.9 1.1 5.6L12 16.4l-5.1 2.8 1.1-5.6-4.2-3.9 5.7-.7z" :
  name == "info" ? "M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17zM12 11v5.5M12 7.8v.2" :
  name == "ellipsis" ? "M5.5 12h.1M12 12h.1M18.5 12h.1" :
  name == "chapters" ? "M4 6h16M4 12h10M4 18h13" :
  name == "install" ? "M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19.5h14" :
  "M4 4h16v16H4z")

// A filled mark, for transport and badges.
fn solidPath(name: string): string = (
  name == "play" ? "M7.5 4.6v14.8c0 .8.9 1.3 1.6.9l11.6-7.4c.6-.4.6-1.4 0-1.8L9.1 3.7c-.7-.4-1.6.1-1.6.9z" :
  name == "pause" ? "M6.5 4h3.6v16H6.5zM13.9 4h3.6v16h-3.6z" :
  name == "heart" ? "M12 19.5s-7-4.3-7-9.6a3.9 3.9 0 0 1 7-2.4 3.9 3.9 0 0 1 7 2.4c0 5.3-7 9.6-7 9.6z" :
  name == "star" ? "M12 3.8l2.5 5.2 5.7.7-4.2 3.9 1.1 5.6L12 16.4l-5.1 2.8 1.1-5.6-4.2-3.9 5.7-.7z" :
  "M5 5h14v14H5z")

component Glyph
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" flex-shrink=0 aria-hidden=true
      path d=glyphPath(name) fill="none" stroke="currentcolor" stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"

component Solid
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" flex-shrink=0 aria-hidden=true
      path d=solidPath(name) fill="currentcolor"

// A circular arrow with the step in seconds: back turns anticlockwise.
component SkipGlyph
  props
    forward: bool
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" flex-shrink=0 aria-hidden=true
      path d=(forward ? "M19.5 12.5a7.5 7.5 0 1 1-2.6-5.7" : "M4.5 12.5a7.5 7.5 0 1 0 2.6-5.7") fill="none" stroke="currentcolor" stroke-width=1.8 stroke-linecap="round"
      path d=(forward ? "M17.6 3.2v4.1h-4.1" : "M6.4 3.2v4.1h4.1") fill="none" stroke="currentcolor" stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"
      text "10" x=12 y=15.6 font-size=7.4 font-weight=700 text-anchor="middle" fill="currentcolor"

// The Vela wordmark, set for this skin: an amber sail beside a heavy lowercase name.
component Wordmark
  props
    size: number
  view
    row align-items="center" gap=(size * 0.3) aria-hidden=true
      svg width=(size * 0.9) height=size viewBox="0 0 20 22"
        path d="M3 2.2c0-.9 1-1.4 1.7-.9l13.6 8.8c.7.4.7 1.4 0 1.8L4.7 20.7c-.7.5-1.7 0-1.7-.9z" fill="var(--marquee.amber)"
        path d="M3 2.2v17.6c0 .9 1 1.4 1.7.9L11 16.6V5.4L4.7 1.3c-.7-.5-1.7 0-1.7.9z" fill="var(--marquee.amber-deep)"
      text t("ui.vela") font-size=(size * 0.92) font-weight=800 letter-spacing="-0.03em" line-height=1 color="marquee.ink" text-transform="lowercase"

// The amber ring the skin waits with.
component Spinner
  props
    size: number
    still: bool
  view
    svg width=size height=size viewBox="0 0 48 48" flex-shrink=0 aria-hidden=true animation=(still ? "none" : "mqSpin 900ms linear infinite")
      circle cx=24 cy=24 r=20 fill="none" stroke="var(--marquee.track)" stroke-width=4
      circle cx=24 cy=24 r=20 fill="none" stroke="var(--marquee.amber)" stroke-width=4 stroke-linecap="round" stroke-dasharray=(still ? "126 0" : "38 90")

// A loading block in the shape of what is coming.
component Block
  props
    width: string
    height: string
    radius: number
    still: bool
  view
    column width=width height=height flex-shrink=0 border-radius=radius overflow="hidden" background-color="marquee.skeleton" aria-hidden=true
      if not still
        column width="100%" height="100%" background-image="linear-gradient(90deg, transparent 0%, var(--marquee.skeleton-sheen) 50%, transparent 100%)" animation="mqSheen 1.5s ease-in-out infinite"

// Artwork that fades in once loaded, holding its box until then.
component Art
  props
    src: string
    still: bool
  state loaded = false
  action reveal
    loaded = true
  view
    image src alt="" load=reveal position="absolute" inset=0 width="100%" height="100%" object-fit="cover" opacity=(loaded ? 1 : 0) transition=(still ? "none" : "opacity 260ms linear")

// The amber call to action.
style Primary
  box-sizing = "border-box"
  border = "none"
  border-radius = 6
  background-color = "marquee.amber"
  color = "marquee.on-amber"
  font-weight = 700
  cursor = "pointer"
  :hover
    background-color = "marquee.amber-hover"
  :active
    -exact-press-scale = 0.98
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.page), 0px 0px 0px 4px var(--marquee.ink)"
  :disabled
    background-color = "marquee.raised"
    color = "marquee.ink-faint"

// A quiet filled button beside the amber one.
style Secondary
  box-sizing = "border-box"
  border = "none"
  border-radius = 6
  background-color = "marquee.control"
  color = "marquee.ink"
  font-weight = 600
  cursor = "pointer"
  :hover
    background-color = "marquee.control-hover"
  :active
    -exact-press-scale = 0.98
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.amber)"
  :disabled
    opacity = 0.45

// A round icon button that lights on hover.
style Round
  box-sizing = "border-box"
  display = "flex"
  align-items = "center"
  justify-content = "center"
  border = "none"
  border-radius = 999
  padding = 0
  background-color = "transparent"
  color = "marquee.ink-dim"
  cursor = "pointer"
  flex-shrink = 0
  :hover
    background-color = "marquee.hover"
    color = "marquee.ink"
  :active
    -exact-press-scale = 0.94
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.amber)"
    color = "marquee.ink"
  :disabled
    opacity = 0.35

// A native select drawn as a flat dropdown label; a chevron sits over its right edge.
style Dropdown
  box-sizing = "border-box"
  height = 34
  padding = "0px 30px 0px 12px"
  border = "none"
  border-radius = 4
  appearance = "none"
  background-color = "transparent"
  color = "marquee.ink"
  font-size = 14
  font-weight = 600
  cursor = "pointer"

style TextField
  box-sizing = "border-box"
  width = "100%"
  height = 44
  padding = "0px 14px"
  border = "1px solid var(--marquee.line-strong)"
  border-radius = 4
  background-color = "marquee.field"
  color = "marquee.ink"
  font-size = 15
  outline = "none"
  :hover
    border-color = "marquee.ink-faint"
  :focus-visible
    border-color = "marquee.amber"
    box-shadow = "0px 0px 0px 1px var(--marquee.amber)"

style Label
  font-size = 12
  font-weight = 700
  letter-spacing = "0.06em"
  text-transform = "uppercase"
  color = "marquee.ink-faint"

// A dropdown: a native select with the skin's chevron, for type, sort and filter choices.
component Pick
  props
    label: string
    value: string
    choices: LibraryOption[]
    change: action
  view
    row position="relative" align-items="center" flex-shrink=0
      select value=value change=change aria-label=label class=Dropdown
        for c in choices key=c.id
          option value=c.id
            text c.label
      column position="absolute" right=8 top=0 bottom=0 justify-content="center" pointer-events="none" color="marquee.ink-dim"
        Glyph(name="down", size=14)
