use LibraryOption from "../../foundation/models.contract"

// Marquee design tokens: a charcoal media-server look with an amber accent. Type is
// the platform's sans in confident weights; icons are the skin's own line glyphs.
// Every colour is a marquee.* token in app.tamber.

// The top bar's height; pages under the overlaid bar start below it.
fn barH(small: bool): number = (small ? 52 : 56)
// Page gutters: content aligns to them everywhere.
fn gutter(small: bool): string = (small ? "14px" : "40px")
fn gutterPx(small: bool): number = (small ? 14 : 40)

// Hover and press feedback is quick and flat; reduced motion keeps colour changes only.
fn ease(): string = "cubic-bezier(0.2, 0, 0, 1)"
fn quick(still: bool): string = (still ? "none" : `background-color 120ms linear, color 120ms linear, border-color 120ms linear, box-shadow 160ms ${ease()}, opacity 160ms linear`)
fn arrive(still: bool, delay: number): string = (still ? "mqFade 160ms linear both" : `mqRise 420ms ${ease()} ${delay}ms both`)

fn kindLabel(kind: string): string = (kind == "movie" ? t("ui.film") : kind == "show" ? t("ui.series") : kind == "season" ? t("ui.season") : kind == "episode" ? t("ui.episode") : t("ui.collection"))

keyframes mqFade
  from opacity=0

keyframes mqGone
  to opacity=0

keyframes mqRise
  from opacity=0 translate="0px 10px"

keyframes mqDrop
  from opacity=0 translate="0px -6px"

keyframes mqSlide
  from translate="-100% 0px"

keyframes mqSpin
  from rotate=0
  to rotate=360

keyframes mqPulse
  50% opacity=0.4

keyframes mqSheen
  from translate="-100% 0px"
  to translate="100% 0px"

// Icons are assets: a built-in role where one fits, else the skin's own one-colour line
// glyph (assets/icons/marquee-*.svg, declared in app.tamber). One image node per use.
fn glyphSrc(name: string): string = (name == "home" ? "symbol:home" : name == "search" ? "symbol:search" : name == "menu" ? "symbol:menu" : name == "close" ? "symbol:close" : name == "back" ? "symbol:back" : name == "check" ? "symbol:checkmark" : name == "heart" ? "symbol:heart" : name == "sort" ? "symbol:sort" : name == "filter" ? "symbol:filter" : name == "sliders" ? "symbol:adjust" : name == "volume" or name == "volume-low" ? "symbol:speaker" : name == "mute" ? "symbol:speaker-mute" : name == "signout" ? "symbol:sign-out" : name == "phone" ? "symbol:smartphone" : name == "alert" ? "symbol:alert" : name == "star" ? "symbol:star" : name == "info" ? "symbol:info" : name == "rows" ? "symbol:list" : name == "person" ? "symbol:person" : name == "live" ? "symbol:radio" : `symbol:icon.marquee-${name}`)

// Filled marks for transport and badges.
fn solidSrc(name: string): string = (name == "play" ? "symbol:play-fill" : name == "pause" ? "symbol:pause-fill" : name == "heart" ? "symbol:heart-fill" : name == "star" ? "symbol:star-fill" : "symbol:circle")

component Glyph
  props
    name: string
    size: number
  view
    image glyphSrc(name) width=size height=size flex-shrink=0 aria-hidden=true

component Solid
  props
    name: string
    size: number
  view
    image solidSrc(name) width=size height=size flex-shrink=0 aria-hidden=true

// A circular arrow with the ten-second step: back turns anticlockwise.
component SkipGlyph
  props
    forward: bool
    size: number
  view
    image (forward ? "symbol:icon.marquee-skip-forward" : "symbol:icon.marquee-skip-back") width=size height=size flex-shrink=0 aria-hidden=true

// The Vela lockup for dark grounds: the two-tone searchlight V and the monoline name.
// It keeps its 2.629:1 aspect; below 72 px wide the brand rules call for the symbol alone.
component Wordmark
  props
    size: number
  view
    if size * 2.629 >= 72
      image "assets/brand/vela-lockup.svg" alt="" width=(size * 2.629) height=size flex-shrink=0 aria-hidden=true
    else
      image "assets/brand/vela-symbol.svg" alt="" width=(size * 46 / 49.6) height=size flex-shrink=0 aria-hidden=true

// The amber ring the skin waits with: one bordered box turning.
component Spinner
  props
    size: number
    still: bool
  view
    column width=size height=size flex-shrink=0 box-sizing="border-box" border-radius=999 border=(size > 30 ? "3px solid var(--marquee.track)" : "2px solid var(--marquee.track)") border-top-color="marquee.amber" animation=(still ? "none" : "mqSpin 900ms linear infinite") aria-hidden=true

// A loading block in the shape of what is coming.
component Block
  props
    width: string
    height: string
    radius: number
    still: bool
  view
    column width=width height=height flex-shrink=0 border-radius=radius overflow="hidden" background-color="marquee.skeleton" aria-hidden=true
      if not still
        column width="100%" height="100%" background-image="linear-gradient(90deg, transparent 0%, var(--marquee.skeleton-sheen) 50%, transparent 100%)" animation="mqSheen 1.5s ease-in-out infinite"

// Artwork that fades in once loaded, holding its box until then.
component Art
  props
    src: string
    still: bool
  state loaded = false
  action reveal
    loaded = true
  view
    image src alt="" load=reveal position="absolute" inset=0 width="100%" height="100%" object-fit="cover" opacity=(loaded ? 1 : 0) transition=(still ? "none" : "opacity 260ms linear")

// The amber call to action.
style Primary
  box-sizing = "border-box"
  border = "none"
  border-radius = 6
  background-color = "marquee.amber"
  color = "marquee.on-amber"
  font-weight = 700
  cursor = "pointer"
  :hover
    background-color = "marquee.amber-hover"
  :active
    -exact-press-scale = 0.98
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.page), 0px 0px 0px 4px var(--marquee.ink)"
  :disabled
    background-color = "marquee.raised"
    color = "marquee.ink-faint"

// A quiet filled button beside the amber one.
style Secondary
  box-sizing = "border-box"
  border = "none"
  border-radius = 6
  background-color = "marquee.control"
  color = "marquee.ink"
  font-weight = 600
  cursor = "pointer"
  :hover
    background-color = "marquee.control-hover"
  :active
    -exact-press-scale = 0.98
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.amber)"
  :disabled
    opacity = 0.45

// A round icon button that lights on hover.
style Round
  box-sizing = "border-box"
  display = "flex"
  align-items = "center"
  justify-content = "center"
  border = "none"
  border-radius = 999
  padding = 0
  background-color = "transparent"
  color = "marquee.ink-dim"
  cursor = "pointer"
  flex-shrink = 0
  :hover
    background-color = "marquee.hover"
    color = "marquee.ink"
  :active
    -exact-press-scale = 0.94
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--marquee.amber)"
    color = "marquee.ink"
  :disabled
    opacity = 0.35

// A native select drawn as a flat dropdown label; a chevron sits over its right edge.
style Dropdown
  box-sizing = "border-box"
  height = 34
  padding = "0px 30px 0px 12px"
  border = "none"
  border-radius = 4
  appearance = "none"
  background-color = "transparent"
  color = "marquee.ink"
  font-size = 14
  font-weight = 600
  cursor = "pointer"

style TextField
  box-sizing = "border-box"
  width = "100%"
  height = 44
  padding = "0px 14px"
  border = "1px solid var(--marquee.line-strong)"
  border-radius = 4
  background-color = "marquee.field"
  color = "marquee.ink"
  font-size = 15
  outline = "none"
  :hover
    border-color = "marquee.ink-faint"
  :focus-visible
    border-color = "marquee.amber"
    box-shadow = "0px 0px 0px 1px var(--marquee.amber)"

style Label
  font-size = 12
  font-weight = 700
  letter-spacing = "0.06em"
  text-transform = "uppercase"
  color = "marquee.ink-faint"

// A dropdown: a native select with the skin's chevron, for type, sort and filter choices.
component Pick
  props
    label: string
    value: string
    choices: LibraryOption[]
    change: action
  view
    row position="relative" align-items="center" flex-shrink=0
      select value=value change=change aria-label=label class=Dropdown
        for c in choices key=c.id
          option value=c.id
            text c.label
      column position="absolute" right=8 top=0 bottom=0 justify-content="center" pointer-events="none" color="marquee.ink-dim"
        Glyph(name="down", size=14)
