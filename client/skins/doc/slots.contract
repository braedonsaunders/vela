// The "doc" engine: its slots draw the active skin document (docs/skin-schema.md)
// through the generated renderer. Slots a document leaves out use cinematic's.
use Style, Env, Ctx, DocSlot, ShellSlot, SkinDoc, RouteProps, noStyle from "../../renderer/shapes.contract"
use V1, V5, BoxEl, ctxs1, ctxs5, ctxKey, binds, heroActFor, num, styleAt, rootCtx, selectedSeason from "../../renderer/levels.contract"
use SkinPicker from "../../foundation/skin-picker.contract"
use HomeProps, ShellProps from "../../foundation/slot-api.contract"
use GuideModel, GuideChannel, LiveTile from "../../live/models.contract"

fn part(s: string, i: number): string = match s.split("|").at(i) { case some(x) => x, case none => "" }
fn toggled(flags: string[], f: string): string[] = (flags.includes(f) ? flags.filter(x => x != f) : flags.concat([f]))
fn detailPresentation(doc: SkinDoc, width: number): string = (width < 640 ? doc.detailSmall : doc.detailWide)

// The root container a slot's tree hangs from.
component Root
  props
    s: Style
    pos: string
    e: Env
  state quiet = 0
  action idle(v: bool)
    quiet = quiet
  action still
    quiet = quiet
  action unkeyed(k: string)
    quiet = quiet
  slot
  view
    // The tree's root takes every style row, as a document node does.
    BoxEl(s=s, pos=pos, anim=(e.still ? "none" : s.animation), fade=false, dw="", dbg="", dbi=s.backgroundImage, dc="", dop="", dtr="", test="", domId="", role="", label="", lt="", se="", exitAnim="", hovering=idle, pointing=still, keying=unkeyed)
      children

// Where the foundation's content sits among a slot's nodes: its flex order, an outer
// box and an inner one (a centred, width-capped search field, a filling route).
component SlotBox
  props
    order: string
    pos: string
    s: Style
    inner: Style
    e: Env
  state quiet = 0
  action idle(v: bool)
    quiet = quiet
  action still
    quiet = quiet
  action unkeyed(k: string)
    quiet = quiet
  slot
  view
    // The outer box takes every style row (sticky strips, z-index, glass), as a document node does.
    BoxEl(s=s, pos=pos, anim=(e.still ? "none" : s.animation), fade=false, dw="", dbg="", dbi=s.backgroundImage, dc="", dop="", dtr="", test="", domId="", role="", label="", lt="", se="", exitAnim="", hovering=idle, pointing=still, keying=unkeyed)
      column position="relative" width=inner.width max-width=inner.maxWidth height=inner.height min-height=inner.minHeight flex-grow=inner.flexGrow flex-shrink=inner.flexShrink display=inner.display flex-direction=inner.flexDirection animation=(e.still ? "none" : inner.animation)
        children

component Shell
  props
    p: ShellProps
  inject
    doc: SkinDoc
    chooseSkin: action
    signOut: action
    home: action
    search: action
    live: action
    openLibrary: action
    homeGuide: GuideModel[]
  slot
  state flags: string[] = []
  state pickerOpen = false
  action act(name: string, arg: string)
    if name == "home"
      flags = flags.filter(f => f.startsWith("keep-"))
      home()
    if name == "search"
      flags = flags.filter(f => f.startsWith("keep-"))
      search()
    if name == "live"
      flags = flags.filter(f => f.startsWith("keep-"))
      live()
    // A live library is the Live TV section, not a browse library: its id is no section id.
    if name == "library"
      flags = flags.filter(f => f.startsWith("keep-"))
      if p.libraries.filter(l => l.id == arg and l.kind == "live").length > 0
        live()
      else
        openLibrary(arg)
    if name == "toggle"
      flags = toggled(flags, arg)
    if name == "reset"
      flags = flags.filter(f => f.startsWith("keep-"))
    if name == "open"
      flags = (flags.includes(arg) ? flags : flags.concat([arg]))
    if name == "close"
      flags = flags.filter(x => x != arg)
    if name == "openPicker"
      flags = flags.filter(f => f.startsWith("keep-"))
      pickerOpen = true
    if name == "signOut"
      flags = flags.filter(f => f.startsWith("keep-"))
      signOut()
  action seen(token: string)
    flags = flags
  action pick(value: string)
    pickerOpen = false
    chooseSkin(value)
  action dismiss
    pickerOpen = false
  view
    // One Env, bound once (Exact expands a derive at every use).
    for env in [Env(styles=doc.styles, dflt=noStyle(), route="shell", entry="", load="ready", detail=[], season="", home=[], libraries=p.libraries, viewer=p.viewer, section=p.section, query="", heroIndex=0, small=p.viewport.width < 640, tv=p.viewport.width >= 1600, width=p.viewport.width, skinCount=p.skins.length, rowLoading=[], homeLoading=false, still=p.viewport.prefersReducedMotion, canLive=p.canLive, flags=flags, guide=homeGuide, tile=[], tuned=[], tunedId="", zapping="", favoriteCount=0)] key="env"
      Root(s=styleAt(env, doc.shell.root), pos=(doc.shell.rootPos == 1 ? "absolute" : doc.shell.rootPos == 2 ? "sticky" : "relative"), e=env)
        SlotBox(order=doc.shell.slotOrder, pos=(doc.shell.slotPos == 1 ? "absolute" : doc.shell.slotPos == 2 ? "sticky" : "relative"), s=styleAt(env, doc.shell.slotStyle), inner=styleAt(env, doc.shell.slotInner), e=env)
          children
        for n, i in doc.shell.nodes key=`${i}`
          for cc, j in ctxs5(n, rootCtx(), env) key=ctxKey(cc, j)
            V5(n=n, c=Ctx(cc, index=(n.rep == "" ? cc.index : j)), e=env, act=act, obs=seen)
        if pickerOpen
          SkinPicker(skins=p.skins, current=p.skin, small=env.small, still=env.still, choose=pick, dismiss=dismiss)

component Home
  props
    p: HomeProps
  inject
    homeWidth: number
    doc: SkinDoc
    selectTitle: action
    observe: action
    pickHero: action
    playHero: action
    openLive: action
    watchChannel: action
    previewChannel: action
    zapTile: action
    tileTuneIn: action
    tileUnmute: action
    homeGuide: GuideModel[]
    homeTile: LiveTile[]
    homeTuned: GuideChannel[]
    homeZapping: string
  slot
  state flags: string[] = []
  action act(name: string, arg: string)
    if name == "select"
      selectTitle(part(arg, 0), part(arg, 1), part(arg, 2))
    if name == "watch" and arg != ""
      watchChannel(arg)
    if name == "preview" and arg != ""
      previewChannel(arg)
    if name == "zap"
      zapTile(num(arg) < 0 ? -1 : 1)
    if name == "tuneIn"
      tileTuneIn()
    if name == "unmute"
      tileUnmute()
    if name == "guide"
      openLive()
    if name == "play"
      playHero(heroActFor(p.model, arg).map(a => a.targetId).join(""), num(heroActFor(p.model, arg).map(a => a.positionSeconds.toString()).join("")), heroActFor(p.model, arg).map(a => a.hasPosition).includes(true))
    if name == "pickHero"
      pickHero(match parseNumber(arg) { case some(x) => x, case none => 0 })
    if name == "toggle"
      flags = toggled(flags, arg)
  view
    // One Env, bound once (Exact expands a derive at every use).
    for env in [Env(styles=doc.styles, dflt=noStyle(), route="home", entry="", load="ready", detail=[], season="", home=[p.model], libraries=[], viewer=p.model.viewer, section="home", query=p.query, heroIndex=p.heroIndex, small=p.small, tv=homeWidth >= 1600, width=homeWidth, skinCount=0, rowLoading=p.rowMoreLoading, homeLoading=p.homeMoreLoading, still=p.still, canLive=p.model.liveAvailable, flags=flags, guide=homeGuide, tile=homeTile, tuned=homeTuned, tunedId=homeTuned.map(c => c.id).join(""), zapping=homeZapping, favoriteCount=match first(homeGuide) { case some(g) => g.channels.filter(c => c.favorite).length, case none => 0 })] key="env"
      Root(s=styleAt(env, doc.home.root), pos=(doc.home.rootPos == 1 ? "absolute" : doc.home.rootPos == 2 ? "sticky" : "relative"), e=env)
        SlotBox(order=doc.home.slotOrder, pos=(doc.home.slotPos == 1 ? "absolute" : doc.home.slotPos == 2 ? "sticky" : "relative"), s=styleAt(env, doc.home.slotStyle), inner=styleAt(env, doc.home.slotInner), e=env)
          children
        for n, i in doc.home.nodes key=`${i}`
          for cc, j in ctxs1(n, rootCtx(), env) key=ctxKey(cc, j)
            V1(n=n, c=Ctx(cc, index=(n.rep == "" ? cc.index : j)), e=env, act=act, obs=observe)

// The route view: the one place the renderer draws a whole route (docs/skin-distribution.md,
// "End state"). It draws the document's tree named after the stack entry's route, with
// that route's models; routes move here from the compiled slots one by one.
component Route
  props
    p: RouteProps
  inject
    doc: SkinDoc
    selectTitle: action
    observeDetail: action
    play: action
    playExtra: action
    leave: action
  state flags: string[] = []
  action act(name: string, arg: string)
    if name == "select"
      selectTitle(part(arg, 0), part(arg, 1), part(arg, 2))
    if name == "play"
      play(arg)
    if name == "playExtra"
      playExtra(arg)
    if name == "back"
      leave()
    if name == "toggle"
      flags = toggled(flags, arg)
  view
    for env in [Env(styles=doc.styles, dflt=noStyle(), route=p.route, entry=p.entry, load=p.load, detail=p.detail, season=selectedSeason(p.detail, p.season), home=[], libraries=[], viewer="", section=p.route, query="", heroIndex=0, small=p.small, tv=p.tv, width=p.width, skinCount=0, rowLoading=[], homeLoading=false, still=p.still, canLive=false, flags=flags, guide=[], tile=[], tuned=[], tunedId="", zapping="", favoriteCount=0)] key="env"
      for tree in doc.routes.filter(t => t.name == p.route) key=tree.name
        Root(s=styleAt(env, tree.root), pos=(tree.rootPos == 1 ? "absolute" : tree.rootPos == 2 ? "sticky" : "relative"), e=env)
          for n, i in tree.nodes key=`${i}`
            for cc, j in ctxs1(n, rootCtx(), env) key=ctxKey(cc, j)
              V1(n=n, c=Ctx(cc, index=(n.rep == "" ? cc.index : j)), e=env, act=act, obs=observeDetail)
