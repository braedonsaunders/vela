// The "doc" engine: its slots draw the active skin document (docs/skin-schema.md)
// through the generated renderer. Slots a document leaves out use cinematic's.
use Style, Env, Ctx, ShellSlot, SkinDoc, RouteProps, noStyle, holderNode5 from "../../renderer/shapes.contract"
use V1, V5, RootEl, KeyRootEl, kids1, kids5, binds, envBinds, styleAt, stateOf, rootCtx, selectedSeason from "../../renderer/levels.contract"
use SkinPicker from "../../foundation/skin-picker.contract"
use HomeProps, ShellProps from "../../foundation/slot-api.contract"
use GuideModel, GuideChannel, LiveTile from "../../live/models.contract"

fn part(s: string, i: number): string = match s.split("|").at(i) { case some(x) => x, case none => "" }
fn pagerUpdate(pagers: string[], arg: string): string = match first(pagers.filter(x => part(x, 0) == part(arg, 0))) { case some(x) => `${part(arg, 0)}|${part(arg, 1) == "s" ? part(arg, 2) : part(x, 1)}|${part(arg, 1) == "e" ? part(arg, 2) : part(x, 2)}|${part(arg, 3)}|${part(arg, 4)}`, case none => `${part(arg, 0)}|${part(arg, 1) == "s" ? part(arg, 2) : "1"}|${part(arg, 1) == "e" ? part(arg, 2) : "1"}|${part(arg, 3)}|${part(arg, 4)}` }
// A full-size flex column: the shell's boxes when it wraps a route page bare.
fn bareStyle(): Style = Style(noStyle(), display="flex", flexDirection="column", flexGrow=1, minHeight="0px", width="100%", height="100%")
fn toggled(flags: string[], f: string): string[] = (flags.includes(f) ? flags.filter(x => x != f) : flags.concat([f]))
fn detailPresentation(doc: SkinDoc, width: number): string = (width < doc.detailFrom ? doc.detailSmall : doc.detailWide)
fn detailSplit(doc: SkinDoc, width: number): string = (width < doc.detailFrom ? "none" : doc.detailSplit)

// The root container a route's tree hangs from (no handlers: a renderer component declares no
// action, members.contract says why).
component Root
  props
    s: Style
    pos: string
    e: Env
  slot
  view
    // The tree's root takes every style row, as a document node does, and alone takes color-scheme.
    RootEl(s=s, pos=pos, anim=(e.still ? "none" : s.animation), fade=false, ahid=false, dw="", dbg="", dbi=s.backgroundImage, dc="", dop="", dtr="", test="", domId="", role="", label="", lt="", exitAnim="")
      children

// The shell's root: Root plus the one key handler (Escape closes the innermost open menu).
component ShellRoot
  props
    s: Style
    pos: string
    e: Env
  inject
    docKey: action
  slot
  view
    KeyRootEl(s=s, pos=pos, anim=(e.still ? "none" : s.animation), fade=false, ahid=false, dw="", dbg="", dbi=s.backgroundImage, dc="", dop="", dtr="", test="", domId="", role="", label="", lt="", exitAnim="", keying=docKey)
      children

// Where the foundation's content sits among a slot's nodes: its flex order, an outer
// box and an inner one (a centred, width-capped search field, a filling route).
component SlotBox
  props
    order: string
    pos: string
    s: Style
    inner: Style
    e: Env
  slot
  view
    // The outer box takes every style row (sticky strips, z-index, glass), bound (its style may be the renderer's own).
    RootEl(s=s, pos=pos, anim=(e.still ? "none" : s.animation), fade=false, ahid=false, dw="", dbg="", dbi=s.backgroundImage, dc="", dop="", dtr="", test="", domId="", role="", label="", lt="", exitAnim="")
      column position="relative" width=inner.width max-width=inner.maxWidth height=inner.height min-height=inner.minHeight flex-grow=inner.flexGrow flex-shrink=inner.flexShrink display=inner.display flex-direction=inner.flexDirection animation=(e.still ? "none" : inner.animation)
        children

component Shell
  props
    p: ShellProps
  inject
    query: string
    doc: SkinDoc
    homeGuide: GuideModel[]
    docShellFlags: string[]
    docPickerOpen: bool
    docPickSkin: action
    docDismissPicker: action
  slot
  view
    // One Env, bound once (Exact expands a derive at every use).
    for env0 in [Env(styles=doc.styles, dflt=noStyle(), route="shell", entry="", load="ready", detail=[], season="", home=[], libraries=p.libraries, viewer=p.viewer, section=p.section, query=query, heroIndex=0, small=p.viewport.width < 640, tv=p.viewport.width >= 1600, width=p.viewport.width, skinCount=p.skins.length, rowLoading=[], homeLoading=false, still=p.viewport.prefersReducedMotion, canLive=p.canLive, flags=docShellFlags, guide=homeGuide, tile=[], tuned=[], tunedId="", zapping="", favoriteCount=0, library=[], libraryLoading=false, libraryMoreLoading=false, pagers=[], authState="", authError="", authBusy=false, canPassword=false, canQuick=false, quickCode="", quickExpires="", quickError="", authReady=false, secureOrigin="", secureBusy=false, secureError="", authBackdrop="", authWordmark="", collection=[], collectionMoreLoading=false, ev=[])] key="env0"
      for env in [Env(env0, ev=envBinds(env0))] key="env"
        for rv in [binds(rootCtx(), env)] key="rv"
          for rs in [stateOf(doc.shell.rootSts, doc.shell.rootBase, rv, env)] key="rs"
            for ss in [stateOf(doc.shell.slotSts, doc.shell.slotBase, rv, env)] key="ss"
              // Bare (a route page): a plain full-size box around the page, no shell nodes.
              ShellRoot(s=(p.bare ? bareStyle() : styleAt(env, rs.s)), pos=(not p.bare and rs.pos == 1 ? "absolute" : not p.bare and rs.pos == 2 ? "sticky" : "relative"), e=env)
                // The top-level nodes in document order, the route's slot box among them (Tab follows it).
                for n, i in (p.bare ? [holderNode5()] : doc.shell.nodes) key=`${i}`
                  if n.t == "holder"
                    SlotBox(order=(p.bare ? "0" : doc.shell.slotOrder), pos=(not p.bare and ss.pos == 1 ? "absolute" : not p.bare and ss.pos == 2 ? "sticky" : "relative"), s=(p.bare ? bareStyle() : styleAt(env, ss.s)), inner=(p.bare ? bareStyle() : styleAt(env, doc.shell.slotInner)), e=env)
                      children
                  else
                    for kid in kids5([n], rootCtx(), env, false) key=kid.key
                      V5(n=kid.n, c=kid.c, vals=kid.vals, sr=kid.sr, dis=kid.dis, e=env, scope="shell")
                if docPickerOpen and not p.bare
                  SkinPicker(skins=p.skins, current=p.skin, small=env.small, still=env.still, choose=docPickSkin, dismiss=docDismissPicker)

// Home's slot is empty for documents: home is drawn by the route view (Route below) with
// the other routes, so the renderer has one call site for all of them.
component Home
  props
    p: HomeProps
  slot
  view
    column display="none" aria-hidden=true

// The route view: the one place the renderer draws a page (docs/skin-distribution.md,
// "End state"): home or a route the document draws, by the stack entry's route, with that
// route's models. Its children are the foundation's content for the tree's holder (home's
// search field).
component Route
  props
    p: RouteProps
  inject
    homeWidth: number
    doc: SkinDoc
    homeGuide: GuideModel[]
    homeTile: LiveTile[]
    homeTuned: GuideChannel[]
    homeZapping: string
    docFlags: string[]
    docPagers: string[]
  slot
  derive onHome = p.route == "home"
  // Whose flags this view's nodes change (members.contract): a stack entry keeps its own.
  derive scope = `route:${p.route}:${p.entry}`
  view
    // One Env, bound once (Exact expands a derive at every use). Home reads the home pane's width.
    for env0 in [Env(styles=doc.styles, dflt=noStyle(), route=p.route, entry=p.entry, load=p.load, detail=p.detail, season=selectedSeason(p.detail, p.season), home=p.home, libraries=p.libraries, viewer=p.home.map(h => h.viewer).join(""), section=p.route, query=p.query, heroIndex=p.heroIndex, small=p.small, tv=(onHome ? homeWidth >= 1600 : p.tv), width=(onHome ? homeWidth : p.width), skinCount=0, rowLoading=p.rowMoreLoading, homeLoading=p.homeMoreLoading, still=p.still, canLive=p.home.map(h => h.liveAvailable).includes(true), flags=docFlags.filter(f => part(f, 0) == scope).map(f => part(f, 1)), guide=(onHome ? homeGuide : []), tile=(onHome ? homeTile : []), tuned=(onHome ? homeTuned : []), tunedId=(onHome ? homeTuned.map(c => c.id).join("") : ""), zapping=(onHome ? homeZapping : ""), favoriteCount=(onHome ? match first(homeGuide) { case some(g) => g.channels.filter(c => c.favorite).length, case none => 0 } : 0), library=p.library, libraryLoading=p.libraryLoading, libraryMoreLoading=p.libraryMoreLoading, pagers=docPagers, authState=p.authState, authError=p.authError, authBusy=p.authBusy, canPassword=p.canPassword, canQuick=p.canQuick, quickCode=p.quickCode, quickExpires=p.quickExpires, quickError=p.quickError, authReady=p.authReady, secureOrigin=p.secureOrigin, secureBusy=p.secureBusy, secureError=p.secureError, authBackdrop=p.authBackdrop, authWordmark=p.authWordmark, collection=p.collection, collectionMoreLoading=p.collectionMoreLoading, ev=[])] key="env0"
      for env in [Env(env0, ev=envBinds(env0))] key="env"
        for tree in doc.routes.filter(t => t.name == p.route) key=tree.name
          for rv in [binds(rootCtx(), env)] key="rv"
            for rs in [stateOf(tree.rootSts, tree.rootBase, rv, env)] key="rs"
              for ss in [stateOf(tree.slotSts, tree.slotBase, rv, env)] key="ss"
                Root(s=styleAt(env, rs.s), pos=(rs.pos == 1 ? "absolute" : rs.pos == 2 ? "sticky" : "relative"), e=env)
                  // The top-level nodes in document order, the holder's slot box (home's search field) among them.
                  for n, i in tree.nodes key=`${i}`
                    if n.t == "holder"
                      SlotBox(order=tree.slotOrder, pos=(ss.pos == 1 ? "absolute" : ss.pos == 2 ? "sticky" : "relative"), s=styleAt(env, ss.s), inner=styleAt(env, tree.slotInner), e=env)
                        children
                    else
                      for kid in kids1([n], rootCtx(), env, false) key=kid.key
                        V1(n=kid.n, c=kid.c, vals=kid.vals, sr=kid.sr, dis=kid.dis, e=env, scope=scope)
