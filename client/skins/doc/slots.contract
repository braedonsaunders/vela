// The "doc" engine: its slots draw the active skin document (docs/skin-schema.md)
// through the generated renderer. Slots a document leaves out use cinematic's.
use Style, Env, Ctx, DocSlot, ShellSlot, SkinDoc, noStyle from "../../renderer/shapes.contract"
use V1, V5, ctxs1, ctxs5, ctxKey, binds, heroActFor, num, styleAt, rootCtx from "../../renderer/levels.contract"
use SkinPicker from "../../foundation/skin-picker.contract"
use HomeProps, ShellProps from "../../foundation/slot-api.contract"

fn part(s: string, i: number): string = match s.split("|").at(i) { case some(x) => x, case none => "" }
fn toggled(flags: string[], f: string): string[] = (flags.includes(f) ? flags.filter(x => x != f) : flags.concat([f]))
fn detailPresentation(doc: SkinDoc, width: number): string = (width < 640 ? doc.detailSmall : doc.detailWide)

// The root container a slot's tree hangs from.
component Root
  props
    s: Style
  slot
  view
    box display=s.display position="relative" width=s.width height=s.height min-height=s.minHeight flex-direction=s.flexDirection gap=s.gap padding-top=s.paddingTop padding-right=s.paddingRight padding-bottom=s.paddingBottom padding-left=s.paddingLeft overflow-x=s.overflowX overflow-y=s.overflowY color=s.color background-color=s.backgroundColor background-image=s.backgroundImage font-family=s.fontFamily font-size=s.fontSize
      children

// Where the foundation's content sits among a slot's nodes: its flex order, an outer
// box and an inner one (a centred, width-capped search field, a filling route).
component SlotBox
  props
    order: string
    s: Style
    inner: Style
    e: Env
  slot
  view
    column order=num(order) position="relative" display=s.display flex-direction=s.flexDirection flex-grow=s.flexGrow flex-shrink=s.flexShrink flex-basis=s.flexBasis min-height=s.minHeight height=s.height width=s.width padding-top=s.paddingTop padding-right=s.paddingRight padding-bottom=s.paddingBottom padding-left=s.paddingLeft margin-top=s.marginTop margin-bottom=s.marginBottom align-items=s.alignItems justify-content=s.justifyContent box-sizing=s.boxSizing
      column position="relative" width=inner.width max-width=inner.maxWidth height=inner.height min-height=inner.minHeight flex-grow=inner.flexGrow flex-shrink=inner.flexShrink display=inner.display flex-direction=inner.flexDirection animation=(e.still ? "none" : inner.animation)
        children

component Shell
  props
    p: ShellProps
  inject
    doc: SkinDoc
    chooseSkin: action
    signOut: action
    home: action
    search: action
    live: action
    openLibrary: action
  slot
  state flags: string[] = []
  state pickerOpen = false
  action act(name: string, arg: string)
    if name == "home"
      flags = []
      home()
    if name == "search"
      flags = []
      search()
    if name == "live"
      flags = []
      live()
    if name == "library"
      flags = []
      openLibrary(arg)
    if name == "toggle"
      flags = toggled(flags, arg)
    if name == "open"
      flags = (flags.includes(arg) ? flags : flags.concat([arg]))
    if name == "close"
      flags = flags.filter(x => x != arg)
    if name == "openPicker"
      flags = []
      pickerOpen = true
    if name == "signOut"
      flags = []
      signOut()
  action seen(token: string)
    flags = flags
  action pick(value: string)
    pickerOpen = false
    chooseSkin(value)
  action dismiss
    pickerOpen = false
  view
    // One Env, bound once (Exact expands a derive at every use).
    for env in [Env(styles=doc.styles, dflt=noStyle(), home=[], libraries=p.libraries, viewer=p.viewer, section=p.section, query="", heroIndex=0, small=p.viewport.width < 640, still=p.viewport.prefersReducedMotion, canLive=p.canLive, flags=flags)] key="env"
      Root(s=styleAt(env, doc.shell.root))
        SlotBox(order=doc.shell.slotOrder, s=styleAt(env, doc.shell.slotStyle), inner=styleAt(env, doc.shell.slotInner), e=env)
          children
        for n, i in doc.shell.nodes key=`${i}`
          for cc, j in ctxs5(n, rootCtx(), env) key=ctxKey(cc, j)
            V5(n=n, c=Ctx(cc, index=(n.rep == "" ? cc.index : j)), e=env, act=act, obs=seen)
        if pickerOpen
          SkinPicker(skins=p.skins, current=p.skin, small=env.small, still=env.still, choose=pick, dismiss=dismiss)

component Home
  props
    p: HomeProps
  inject
    doc: SkinDoc
    selectTitle: action
    observe: action
    pickHero: action
    playHero: action
  slot
  state flags: string[] = []
  action act(name: string, arg: string)
    if name == "select"
      selectTitle(part(arg, 0), part(arg, 1), part(arg, 2))
    if name == "play"
      playHero(heroActFor(p.model, arg).map(a => a.targetId).join(""), num(heroActFor(p.model, arg).map(a => a.positionSeconds.toString()).join("")), heroActFor(p.model, arg).map(a => a.hasPosition).includes(true))
    if name == "pickHero"
      pickHero(match parseNumber(arg) { case some(x) => x, case none => 0 })
    if name == "toggle"
      flags = toggled(flags, arg)
  view
    // One Env, bound once (Exact expands a derive at every use).
    for env in [Env(styles=doc.styles, dflt=noStyle(), home=[p.model], libraries=[], viewer=p.model.viewer, section="home", query=p.query, heroIndex=p.heroIndex, small=p.small, still=p.still, canLive=p.model.liveAvailable, flags=flags)] key="env"
      Root(s=styleAt(env, doc.home.root))
        SlotBox(order=doc.home.slotOrder, s=styleAt(env, doc.home.slotStyle), inner=styleAt(env, doc.home.slotInner), e=env)
          children
        for n, i in doc.home.nodes key=`${i}`
          for cc, j in ctxs1(n, rootCtx(), env) key=ctxKey(cc, j)
            V1(n=n, c=Ctx(cc, index=(n.rep == "" ? cc.index : j)), e=env, act=act, obs=observe)

