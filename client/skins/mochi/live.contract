use GuideModel, GuideChannel from "../../live/models.contract"
use Pixel, Title, Label, Candy, NightBubble, PixelIcon, Mascot, Twinkle, settle from "./look.contract"
use LiveControlsProps, MiniGuideProps from "../../foundation/slot-api.contract"

keyframes mochiZapIn
  from opacity=0 translate="-18px 0px" scale=0.96

keyframes mochiZapOut
  to opacity=0 translate="-12px 0px"

// Live state over the player, as a little night-sky card: the delivery mode, honest
// delivery states, low delay and catch-up, and channel up/down for pointers and touch.
component LiveControls
  props
    p: LiveControlsProps
  inject
    catchUp: action
    zap: action
  view
    column gap=10 padding="14px 16px" border-radius=24 background-color="mochi.night-deep" backdrop-filter="blur(20px) saturate(1.3)" border="2px solid var(--mochi.night-edge-strong)" box-shadow="0px 6px 0px var(--mochi.night-deep)" min-width=250 color="mochi.night-ink" font-family="Fredoka, ui-rounded, system-ui, sans-serif"
      row gap=10 align-items="center"
        row gap=6 align-items="center" padding="3px 10px" border-radius=999 background-color="mochi.pink" color="mochi.ink" border="2px solid var(--mochi.ink)"
          PixelIcon(name="heart", size=9)
          text t("live.liveBadge") class=Pixel font-size=11
        column flex=1
        row gap=6
          button press=zap(-1) aria-label=t("live.channelUp") class=NightBubble width=34 height=34 padding=0 display="flex" align-items="center" justify-content="center"
            column rotate="90deg"
              PixelIcon(name="back", size=11)
          button press=zap(1) aria-label=t("live.channelDown") class=NightBubble width=34 height=34 padding=0 display="flex" align-items="center" justify-content="center"
            column rotate="-90deg"
              PixelIcon(name="back", size=11)
      if p.reconnecting
        text t("live.reconnecting") role="status" font-size=13 color="mochi.night-soft"
      if p.delivery == "upstream-gap"
        text t("live.gap") role="status" font-size=13 color="mochi.night-soft"
      if p.delivery == "segment-delayed"
        text t("live.delayed") role="status" font-size=13 color="mochi.night-soft"
      if p.delivery == "waiting-for-publication"
        text t("live.publication") role="status" font-size=13 color="mochi.night-soft"
      if p.drift > 0
        text t("live.behind", seconds=p.driftLabel) role="status" font-size=13 color="mochi.night-soft" font-variant-numeric="tabular-nums"
      row gap=8 flex-wrap="wrap"
        if p.canCatchUp and p.drift > 0
          button press=catchUp class=LivePill background-color="mochi.pink" color="mochi.ink" border-color="mochi.ink"
            text t("live.catchUp") font-size=14 font-weight=600

// The in-player mini guide: the channel being tuned to, between its neighbours,
// with what is on now and next. It appears while the viewer flicks channels.
component MiniGuide
  props
    p: MiniGuideProps
  inject
    tune: action
  derive ids = p.model.channels.map(c => c.id)
  derive at = max(0, ids.indexOf(p.target != "" ? p.target : p.playing))
  derive n = p.model.channels.length
  derive around = (n < 3 ? p.model.channels : p.model.channels.slice((at - 1 + n) % n, (at - 1 + n) % n + 1).concat(p.model.channels.slice(at, at + 1)).concat(p.model.channels.slice((at + 1) % n, (at + 1) % n + 1)))
  view
    column gap=8 width=(p.small ? "calc(100% - 32px)" : 400) role="region" aria-label=t("live.channels") aria-live="polite" color="mochi.night-ink" font-family="Fredoka, ui-rounded, system-ui, sans-serif" animation=(p.still ? "none" : `mochiZapIn 300ms ${settle()} both`) -exact-exit-animation="mochiZapOut 160ms ease-in both"
      for c, i in around key=c.id
        if (n < 3 ? c.id == (p.target != "" ? p.target : p.playing) : i == 1)
          MiniGuideCard(channel=c, playing=(c.id == p.playing), still=p.still, tune=tune)
        else
          row gap=12 align-items="center" padding="9px 14px" border-radius=18 background-color="mochi.night-deep" border="2px solid var(--mochi.night-edge)" opacity=0.9 aria-hidden=true
            text c.number class=Pixel font-size=13 color="mochi.night-quiet" font-variant-numeric="tabular-nums" width=40
            text c.name font-size=13 font-weight=600 color="mochi.night-soft" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex=1 min-width=0
            text (c.now != "" ? c.now : t("live.noListings")) font-size=12 color="mochi.night-quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="50%"

component MiniGuideCard
  props
    channel: GuideChannel
    playing: bool
    still: bool
    tune: action
  view
    button press=tune aria-label=t("ui.watchChannel", channel=channel.name) class=ZapCard
      row gap=14 align-items="center" width="100%"
        column position="relative" width=88 height=54 flex-shrink=0 border-radius=14 overflow="hidden" padding=6 box-sizing="border-box" align-items="center" justify-content="center" background-color="mochi.night-card" border="2px solid var(--mochi.card)"
          if channel.logo != ""
            image channel.logo alt="" width="100%" height="100%" object-fit="contain"
          else
            text channel.name.slice(0, 2).toUpperCase() class=Pixel font-size=18 color="mochi.night-soft"
        column flex=1 min-width=0 gap=5
          row gap=8 align-items="center"
            text channel.number class=Pixel font-size=13 color="mochi.sakura" font-variant-numeric="tabular-nums"
            text channel.name font-size=13 font-weight=600 color="mochi.night-soft" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
            if playing
              text t("live.watching") class=Label font-size=9 color="mochi.night-quiet" flex-shrink=0
          text (channel.now != "" ? channel.now : (channel.listed ? t("live.nothingNow") : t("live.noListings"))) font-size=17 font-weight=650 color="mochi.night-ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if channel.nowId != ""
            row gap=8 align-items="center"
              column flex=1 height=8 border-radius=4 background-color="mochi.night-track" overflow="hidden" aria-hidden=true
                column height="100%" width=`${channel.nowProgress}%` background-color="mochi.pink"
              text channel.nowRemaining font-size=11 color="mochi.night-quiet" font-variant-numeric="tabular-nums" flex-shrink=0
          if channel.nextLabel != ""
            text channel.nextLabel font-size=12 color="mochi.night-quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

style LivePill
  box-sizing = "border-box"
  height = 36
  padding = "0px 15px"
  border = "2px solid var(--mochi.night-edge-strong)"
  border-radius = 999
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  cursor = "pointer"
  :active
    -exact-press-scale = 0.95
  :focus-visible
    box-shadow = "0px 0px 0px 3px var(--mochi.night), 0px 0px 0px 6px var(--mochi.sakura)"

style ZapCard
  box-sizing = "border-box"
  width = "100%"
  padding = "14px 16px"
  border = "3px solid var(--mochi.sakura)"
  border-radius = 24
  background-color = "mochi.night-deep"
  backdrop-filter = "blur(20px) saturate(1.3)"
  box-shadow = "0px 6px 0px var(--mochi.pink-deep)"
  color = "mochi.night-ink"
  text-align = "left"
  cursor = "pointer"
  :focus-visible
    box-shadow = "0px 0px 0px 3px var(--mochi.night), 0px 0px 0px 6px var(--mochi.star)"
