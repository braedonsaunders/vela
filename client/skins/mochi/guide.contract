use GuideModel, GuideChannel, GuideProgramme, LiveTile from "../../live/models.contract"
use Pixel, Title, Label, Candy, NightBubble, PixelIcon, Mascot, NightSky, Twinkle, settle, boing, quick, base, mochiSpin, mochiFloat from "./look.contract"
use GuideProps from "../../foundation/slot-api.contract"

// The guide under a night sky: what is airing now beside the live tile (with Mochi
// perched on it), a toolbar of days and filters, then one grid that scrolls on both
// axes inside a rounded panel with a sticky pixel time ruler, a channel rail and a
// sakura now line. Rows and programmes are windowed around the visible port, so a
// lineup of hundreds scrolls as smoothly as a dozen. Petals stop under reduced motion.

keyframes guideSwap
  from opacity=0 translate="10px 0px"

keyframes guidePulse
  0% opacity=1 scale=1
  70% opacity=0 scale=2.6
  100% opacity=0 scale=2.6

// Grid geometry, in CSS pixels. Minutes become pixels at `ppm` per minute.
// Zoom 0, 1, 2 shows about 4.5, 3 and 2 hours across a laptop panel; phones keep one scale.
fn ppm(small: bool, zoom: number): number = (small ? 4 : zoom == 0 ? 4 : zoom == 2 ? 9 : 6)
fn rowH(small: bool): number = (small ? 68 : 72)
fn railW(small: bool): number = (small ? 84 : 264)
fn rulerH(): number = 44
fn side(small: bool): string = (small ? "16px" : "max(28px, 4vw)")

// Server genres map to palette slots in the data module; -1 has no colour cue.
fn toneColor(n: number): string = (n == 0 ? "mochi.tone-news" : n == 1 ? "mochi.tone-sport" : n == 2 ? "mochi.tone-film" : n == 3 ? "mochi.tone-kids" : n == 4 ? "mochi.tone-factual" : n == 5 ? "mochi.tone-drama" : n == 6 ? "mochi.tone-comedy" : n == 7 ? "mochi.tone-music" : n == 8 ? "mochi.tone-life" : "mochi.tone-other")

fn keep(c: GuideChannel, filter: string): bool = (filter == "all" ? true : filter == "favourites" ? c.favorite : filter == "listed" ? c.listed : c.group == filter)

// The programme under `t` minutes in a row, else the next one, else the last; a row without listings focuses its rail cell.
fn cellAt(c: GuideChannel, t: number): string = match first(c.programmes.filter(entry => entry.at + entry.span > t)) { case some(entry) => `guide-${entry.id}`, case none => match first(c.programmes.slice(-1)) { case some(entry) => `guide-${entry.id}`, case none => `guide-rail-${c.id}` } }

fn metaLine(entry: GuideProgramme): string = ([entry.airing ? entry.remainingLabel : t("ui.startEnd", start=entry.startLabel, end=entry.endLabel), entry.episode].filter(s => s != "").join(" · "))

component Guide
  props
    p: GuideProps
  inject
    watch: action
    chooseDay: action
    setZoom: action
    tileMessage: action
    tileUnmute: action
    tileTuneIn: action
    retune: action
  state selChannel = ""
  state expanded = false
  state selProgramme = ""
  state filter = "all"
  state mode = "now"
  state rowBase = 0
  state colBase = -1
  state portW = 1200
  state portH = 640
  state focusMin = -1
  state landed = -1
  derive rows = p.model.channels.filter(c => keep(c, filter))
  derive grid = not p.small or mode == "guide"
  derive scale = ppm(p.small, p.zoom)
  derive row = rowH(p.small)
  derive rail = railW(p.small)
  derive width = p.model.minutes * scale
  // Open with the landing time a third of the way across the panel, so the past reads to its left.
  derive landingMin = max(0, min(p.model.minutes - (portW - rail) / scale, p.model.landing - (portW - rail) / scale / 3))
  derive col = (colBase < 0 ? floor(landingMin / 30) : colBase)
  derive firstRow = max(0, rowBase - 6)
  derive lastRow = min(rows.length, rowBase + ceil(portH / row) + 8)
  derive winFrom = col * 30 - 150
  derive winTo = col * 30 + portW / scale + 150
  // The preview follows selection; with none it shows the first channel airing something.
  derive heroChannels = (selChannel != "" ? p.model.channels.filter(c => c.id == selChannel) : p.model.channels.filter(c => c.nowId != "").slice(0, 1))
  derive heroFallback = (heroChannels.length == 0 ? p.model.channels.slice(0, 1) : heroChannels)

  action scrolled(x: number, y: number)
    if landed < 0
      landed = landingMin
    let r = floor(y / row / 4) * 4
    if r != rowBase
      rowBase = r
    let c = floor(x / scale / 30)
    if c != colBase
      colBase = c
  action measured(w: number, h: number)
    portW = w
    portH = h
  action pickDay(offset: number)
    rowBase = 0
    colBase = -1
    landed = -1
    focusMin = -1
    selChannel = ""
    selProgramme = ""
    chooseDay(offset)
  action pickFilter(value: string)
    filter = value
    rowBase = 0
  // Zooming keeps the time at the panel's left edge where it was.
  action pickZoom(z: number)
    landed = col * 30
    colBase = col
    setZoom(z)
  action toggleExpanded
    let next = not expanded
    expanded = next
    if next
      requestFullscreen("guide-page")
    else
      exitFullscreen()
  action pageKey(k: string)
    if k == "Escape" and expanded
      preventDefault()
      expanded = false
      exitFullscreen()
  action pickMode(value: string)
    mode = value
    landed = -1
    colBase = -1
  action jumpNow
    if p.model.day != 0
      pickDay(0)
    else
      selChannel = ""
      selProgramme = ""
      if p.still
        scrollIntoView("guide-now-anchor", block="nearest", inline="start")
      else
        scrollIntoView("guide-now-anchor", block="nearest", inline="start", behavior="smooth")
  action shift(hours: number)
    let target = col * 30 + hours * 60
    if target < 0 and p.model.day > 0
      pickDay(p.model.day - 1)
    else
      if target > p.model.minutes - 60 and p.model.day < p.model.days.length - 1
        pickDay(p.model.day + 1)
      else
        let id = `guide-tick-${max(0, min(p.model.minutes - 30, target))}`
        if p.still
          scrollIntoView(id, block="nearest", inline="start")
        else
          scrollIntoView(id, block="nearest", inline="start", behavior="smooth")
  action select(channel: string, programme: string)
    selChannel = channel
    selProgramme = programme
  action press(channel: string, programme: string, airing: bool)
    selChannel = channel
    selProgramme = programme
    focusMin = -1
    if airing
      retune(channel)
  action move(index: number, at: number, airing: bool, channel: string, leftId: string, rightId: string, k: string, event: KeyboardEvent)
    if k == "Enter" and airing
      preventDefault()
      watch(channel)
    if not event.metaKey and not event.ctrlKey and not event.altKey
      if k == "ArrowLeft" and leftId != ""
        preventDefault()
        focusMin = -1
        focus(leftId)
      if k == "ArrowRight" and rightId != ""
        preventDefault()
        focusMin = -1
        focus(rightId)
      if k == "ArrowUp" or k == "ArrowDown" or k == "PageUp" or k == "PageDown"
        preventDefault()
        let step = (k == "ArrowUp" ? -1 : k == "ArrowDown" ? 1 : k == "PageUp" ? -6 : 6)
        let target = max(0, min(rows.length - 1, index + step))
        let t = (focusMin >= 0 ? focusMin : max(at, col * 30))
        focusMin = t
        focus(match first(rows.slice(target, target + 1)) { case some(c) => cellAt(c, t), case none => "" })
  action railKey(index: number, k: string)
    if k == "ArrowUp" or k == "ArrowDown"
      preventDefault()
      let target = max(0, min(rows.length - 1, index + (k == "ArrowUp" ? -1 : 1)))
      focus(match first(rows.slice(target, target + 1)) { case some(c) => `guide-rail-${c.id}`, case none => "" })
    if k == "ArrowRight"
      preventDefault()
      focus(match first(rows.slice(index, index + 1)) { case some(c) => cellAt(c, max(col * 30, p.model.nowMinute)), case none => "" })

  view
    // Expanded hides the preview so the grid takes the page, and asks the browser for full screen.
    column id="guide-page" key=pageKey position="relative" z-index=0 height="100%" min-height=0 box-sizing="border-box" background-color="mochi.night" color="mochi.night-ink" font-family="Fredoka, ui-rounded, system-ui, sans-serif" padding-top=(expanded ? 24 : grid ? 0 : 8)
      column position="absolute" inset=0 z-index=-1
        NightSky(still=p.still, petals=true)
      text t("ui.channelGuide") role="heading" aria-level=1 position="absolute" width=1 height=1 overflow="hidden" opacity=0
      if grid and not expanded
        column position="relative" flex-shrink=0 height=(p.small ? 196 : "calc(84px + clamp(128px, 16vh, 168px))") overflow="hidden"
          for c in heroFallback key=`hero-${c.id}`
            GuideHero(channel=c, programmeId=(selChannel == c.id and selProgramme != "" ? selProgramme : c.nowId), small=p.small, still=p.still, watch=watch)
          if p.tile.state != "off"
            column position="absolute" right=side(p.small) bottom=(p.small ? 12 : 14) z-index=2
              column position="absolute" right=(p.small ? 6 : 14) top=(p.small ? -24 : -34) z-index=3 pointer-events="none" animation=(p.still ? "none" : "mochiFloat 3.4s ease-in-out infinite")
                Mascot(mood="wow", size=(p.small ? 30 : 40))
              GuideTile(tile=p.tile, small=p.small, still=p.still, watch=watch, message=tileMessage, unmute=tileUnmute, tuneIn=tileTuneIn)
      // Toolbar: days, the time stepper and filters. Phones put the view switch first and the days beneath.
      if p.small
        row flex-shrink=0 align-items="center" gap=10 padding-left=side(p.small) padding-right=side(p.small) padding-top=10 padding-bottom=(grid ? 8 : 12) role="toolbar" aria-label=t("live.guideControls")
          row gap=4 padding=4 border-radius=999 background-color="mochi.night-card" border="1px solid var(--mochi.night-edge)" role="tablist" aria-label=t("live.view")
            button press=pickMode("now") role="tab" aria-selected=(mode == "now") class=GuideTab background-color=(mode == "now" ? "mochi.pink" : "transparent") color=(mode == "now" ? "mochi.ink" : "mochi.night-soft")
              text t("live.onNow") font-size=13 font-weight=650 white-space="nowrap"
            button press=pickMode("guide") role="tab" aria-selected=(mode == "guide") class=GuideTab background-color=(mode == "guide" ? "mochi.pink" : "transparent") color=(mode == "guide" ? "mochi.ink" : "mochi.night-soft")
              text t("live.guide") font-size=13 font-weight=650 white-space="nowrap"
          column flex=1
          button press=pickFilter(filter == "favourites" ? "all" : "favourites") aria-pressed=(filter == "favourites") aria-label=t("live.favourites") class=NightBubble width=38 height=38 padding=10 color=(filter == "favourites" ? "mochi.sakura" : "mochi.night-ink")
            PixelIcon(name=(filter == "favourites" ? "heart" : "star"), size=15)
          if grid
            button press=jumpNow aria-label=t("live.jumpToNow") class=GuideChip height=38 padding-left=12 padding-right=14
              row gap=7 align-items="center"
                column width=7 height=7 border-radius=4 background-color="mochi.pink" aria-hidden=true
                text t("live.now") class=Pixel font-size=14
        if grid
          row flex-shrink=0 gap=6 align-items="center" overflow-x="auto" scrollbar-width="none" padding-left=side(p.small) padding-right=side(p.small) padding-bottom=12 role="group" aria-label=t("live.day")
            for d in p.model.days key=d.offset
              GuideDayChip(label=d.label, date=d.date, offset=d.offset, on=(d.offset == p.model.day), small=p.small, pick=pickDay)
      else
        row flex-shrink=0 align-items="center" gap=14 padding-left=side(p.small) padding-right=side(p.small) padding-top=6 padding-bottom=16 role="toolbar" aria-label=t("live.guideControls")
          row gap=6 align-items="center" flex-shrink=1 min-width=0 overflow-x="auto" scrollbar-width="none" role="group" aria-label=t("live.day")
            for d in p.model.days key=d.offset
              GuideDayChip(label=d.label, date=d.date, offset=d.offset, on=(d.offset == p.model.day), small=p.small, pick=pickDay)
          row gap=6 align-items="center" flex-shrink=0
            button press=shift(-2) aria-label=t("ui.earlierProgrammes") class=NightBubble width=38 height=38 padding=11
              PixelIcon(name="back", size=13)
            button press=jumpNow aria-label=t("live.jumpToNow") class=GuideChip height=38 padding-left=14 padding-right=16
              row gap=9 align-items="center"
                column position="relative" width=8 height=8 aria-hidden=true
                  column position="absolute" inset=0 border-radius=4 background-color="mochi.pink" animation=(p.still ? "none" : "guidePulse 2.2s ease-out infinite")
                  column position="absolute" inset=0 border-radius=4 background-color="mochi.pink"
                text t("live.now") class=Pixel font-size=14
            button press=shift(2) aria-label=t("ui.laterProgrammes") class=NightBubble width=38 height=38 padding=11
              PixelIcon(name="forward", size=13)
          column flex=1 min-width=0
          row gap=2 padding=3 border-radius=999 flex-shrink=0 background-color="mochi.night-card" border="1px solid var(--mochi.night-edge)" role="group" aria-label=t("live.zoom")
            for z in [0, 1, 2] key=z
              button press=pickZoom(z) aria-pressed=(z == p.zoom) aria-label=t("live.hoursAcross", hours=(z == 0 ? "4½" : z == 1 ? "3" : "2")) class=GuideTab height=30 padding-left=10 padding-right=10 background-color=(z == p.zoom ? "mochi.pink" : "transparent") color=(z == p.zoom ? "mochi.ink" : "mochi.night-soft")
                text t("live.hours", hours=(z == 0 ? "4½" : z == 1 ? "3" : "2")) font-size=12 font-weight=650 white-space="nowrap" font-variant-numeric="tabular-nums"
          row gap=8 align-items="center" flex-shrink=0
            button press=toggleExpanded aria-pressed=expanded aria-label=(expanded ? t("live.exitFullGuide") : t("live.fullGuide")) class=NightBubble width=38 height=38 padding=11
              PixelIcon(name=(expanded ? "close" : "full"), size=14)
            button press=pickFilter(filter == "favourites" ? "all" : "favourites") aria-pressed=(filter == "favourites") aria-label=t("live.favourites") class=NightBubble width=38 height=38 padding=10 color=(filter == "favourites" ? "mochi.sakura" : "mochi.night-ink")
              PixelIcon(name=(filter == "favourites" ? "heart" : "star"), size=15)
            select value=filter change=pickFilter aria-label=t("live.filter") class=GuideSelect
              option value="all"
                text t("live.allChannels")
              option value="favourites"
                text t("live.favourites")
              option value="listed"
                text t("live.withListings")
              for g in p.model.groups key=g
                option value=g
                  text g
      if p.model.channels.length == 0
        column flex=1 align-items="center" justify-content="center" gap=14 padding=32
          Mascot(mood="sleepy", size=80)
          text t("live.noChannels") role="status" font-size=17 color="mochi.night-soft"
      else
        if rows.length == 0
          column flex=1 align-items="center" justify-content="center" gap=14 padding=32
            Mascot(mood="sleepy", size=72)
            text t("live.noMatches") role="status" font-size=17 color="mochi.night-soft"
            button press=pickFilter("all") class=NightPill height=42 padding-left=20 padding-right=20
              text t("live.allChannels") font-size=14
        else
          if grid
            column flex=1 min-height=0 margin-left=(p.small ? 0 : side(p.small)) margin-right=(p.small ? 0 : side(p.small)) margin-bottom=(p.small ? 0 : 24) border-radius=(p.small ? 0 : 26) overflow="hidden" border=(p.small ? "none" : "2px solid var(--mochi.night-edge-strong)") border-top="2px solid var(--mochi.night-edge-strong)" background-color="mochi.night-veil" backdrop-filter="blur(10px)" box-shadow=(p.small ? "none" : "0px 8px 0px var(--mochi.night-deep)")
              for day in [p.model.day] key=day
                scroll id="guide-grid" testId="guide-grid" scroll=scrolled resize=measured scrollLeft=((landed < 0 ? landingMin : landed) * scale) flex=1 min-height=0 overflow="auto" overscroll-behavior="contain" scroll-padding-left=rail scroll-padding-top=rulerH() role="grid" aria-label=t("ui.programmeGuideUseArrowKeysToMoveAndEnterToWatch")
                  column position="relative" width=(rail + width) height=(rulerH() + rows.length * row) flex-shrink=0
                    // Half-hour and hour lines under every row, drawn once.
                    column position="absolute" left=rail top=rulerH() width=width height=(rows.length * row) aria-hidden=true background-image=`repeating-linear-gradient(90deg, var(--mochi.night-edge) 0px 1px, transparent 1px ${30 * scale}px, var(--mochi.night-card) ${30 * scale}px ${30 * scale + 1}px, transparent ${30 * scale + 1}px ${60 * scale}px)`
                    if p.model.nowMinute >= 0
                      column position="absolute" left=rail top=rulerH() width=(p.model.nowMinute * scale) height=(rows.length * row) background-color="mochi.past" aria-hidden=true pointer-events="none"
                    // The time ruler: sticky on top, its corner sticky on the left too.
                    row position="sticky" top=0 z-index=6 height=rulerH() width=(rail + width) background-color="mochi.night" backdrop-filter="blur(18px) saturate(1.3)" border-bottom="1px solid var(--mochi.night-edge)"
                      row position="sticky" left=0 z-index=7 width=rail height=rulerH() flex-shrink=0 box-sizing="border-box" padding-left=(p.small ? 12 : 20) align-items="center" background-color="mochi.night" border-right="1px solid var(--mochi.night-edge)"
                        text (p.small ? p.model.days.filter(d => d.offset == p.model.day).map(d => d.label).join("") : p.model.dayLabel) class=Label font-size=10 letter-spacing="0.16em" color="mochi.night-soft" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                      column position="relative" width=width height=rulerH() flex-shrink=0
                        // A label the now pill would cover fades out rather than colliding with it.
                        for tick in p.model.ticks key=tick.id
                          column id=`guide-tick-${tick.minute}` position="absolute" left=(tick.minute * scale) top=0 bottom=0 width=(30 * scale) justify-content="center" aria-hidden=true
                            column position="absolute" left=0 bottom=0 width=1 height=(tick.hour ? 10 : 6) background-color=(tick.hour ? "mochi.night-edge-strong" : "mochi.night-edge")
                            text tick.label font-family="\"Pixelify Sans\", ui-monospace, monospace" opacity=(p.model.nowMinute >= 0 and tick.minute * scale > p.model.nowMinute * scale - 112 and tick.minute * scale < p.model.nowMinute * scale + 30 ? 0 : 1) transition=(p.still ? "none" : "opacity 200ms linear") padding-left=10 font-size=12 font-weight=(tick.hour ? 650 : 500) color=(tick.hour ? "mochi.night-ink" : "mochi.night-quiet") font-variant-numeric="tabular-nums" white-space="nowrap"
                        if p.model.nowMinute >= 0
                          column id="guide-now-anchor" position="absolute" left=(max(0, p.model.nowMinute - (portW - rail) / scale / 3) * scale) top=0 width=1 height=1 aria-hidden=true
                          row position="absolute" left=(p.model.nowMinute * scale) bottom=7 translate="-50% 0px" z-index=2 gap=5 align-items="center" padding="2px 9px" border-radius=999 background-color="mochi.pink" border="2px solid var(--mochi.ink)" box-shadow="0px 4px 18px var(--mochi.airing-fill)" aria-hidden=true
                            text p.model.nowLabel class=Pixel font-size=12 color="mochi.ink" font-variant-numeric="tabular-nums" white-space="nowrap"
                    // Channel rows, windowed around the port.
                    for c, i in rows.slice(firstRow, lastRow) key=c.id
                      row position="absolute" left=0 top=(rulerH() + (firstRow + i) * row) width=(rail + width) height=row role="row" border-bottom="1px solid var(--mochi.night-card)" box-sizing="border-box"
                        GuideRail(channel=c, index=(firstRow + i), small=p.small, rail=rail, row=row, selected=(c.id == selChannel), watch=watch, select=select, railKey=railKey)
                        if not c.listed
                          button id=`guide-empty-${c.id}` press=watch(c.id) aria-label=t("ui.watchChannel", channel=c.name) position="sticky" left=(rail + 6) margin-left=6 margin-top=6 height=(row - 13) width=max(120, min(width, portW - rail - 12)) box-sizing="border-box" class=GuideEmpty
                            row gap=10 align-items="center" padding-left=16
                              text t("live.noListings") font-size=13 color="mochi.night-quiet"
                              text "·" font-size=13 color="mochi.night-quiet" aria-hidden=true
                              text t("live.watch") font-size=13 font-weight=600 color="mochi.night-soft"
                        for entry in c.programmes.filter(entry => entry.at + entry.span > winFrom and entry.at < winTo) key=entry.id
                          GuideCell(programme=entry, channel=c, index=(firstRow + i), scale=scale, rail=rail, row=row, small=p.small, nowMinute=p.model.nowMinute, selected=(c.id == selChannel and entry.id == selProgramme), focusMin=focusMin, select=select, press=press, move=move)
                    if p.model.nowMinute >= 0
                      column position="absolute" left=(rail + p.model.nowMinute * scale - 1.5) top=rulerH() width=3 height=(rows.length * row) z-index=2 border-radius=2 background-color="mochi.pink" box-shadow="0px 0px 16px var(--mochi.pink)" pointer-events="none" aria-hidden=true
          else
            GuideNowList(rows=rows, still=p.still, watch=watch)

// The preview: the selected programme over its artwork, compact beside the live tile.
component GuideHero
  props
    channel: GuideChannel
    programmeId: string
    small: bool
    still: bool
    watch: action
  derive picked = channel.programmes.filter(entry => entry.id == programmeId)
  view
    column position="absolute" inset=0
      for entry in picked key=`art-${entry.id}`
        column position="absolute" inset=0 aria-hidden=true animation=(still ? "none" : `guideSwap 520ms ${settle()} both`)
          if entry.art != ""
            image entry.art alt="" position="absolute" top=0 right=0 width=(small ? "100%" : "70%") height="100%" object-fit="cover" mask-image="linear-gradient(90deg, transparent 0%, black 50%)" opacity=(small ? 0.32 : 0.55)
          if entry.tone >= 0
            column position="absolute" left="-8%" top="-60%" width="60%" height="200%" background-color=toneColor(entry.tone) opacity=0.14 mask-image="radial-gradient(closest-side, black 0%, transparent 100%)"
      column position="absolute" inset=0 pointer-events="none" aria-hidden=true background-image="linear-gradient(0deg, var(--mochi.night) 0%, var(--mochi.night-veil) 45%, var(--mochi.night-clear) 100%), linear-gradient(90deg, var(--mochi.night-deep) 0%, var(--mochi.night-veil) 40%, var(--mochi.night-veil) 100%)"
      column position="relative" height="100%" justify-content="flex-end" box-sizing="border-box" padding-left=side(small) padding-right=(small ? "calc(16px + 148px)" : "calc(max(28px, 4vw) + clamp(224px, 28vh, 310px) + 32px)") padding-bottom=(small ? 12 : 16)
        for entry in picked key=`copy-${entry.id}`
          column gap=(small ? 4 : 7) min-width=0 animation=(still ? "none" : `guideSwap 420ms ${settle()} both`) role="region" aria-label=t("live.selectedProgramme") aria-live="polite"
            row gap=10 align-items="center" min-width=0
              if entry.airing
                row gap=6 align-items="center" padding="3px 10px" border-radius=999 background-color="mochi.pink" border="2px solid var(--mochi.ink)" flex-shrink=0
                  column width=6 height=6 border-radius=3 background-color="mochi.ink" aria-hidden=true
                  text t("live.liveBadge") class=Pixel font-size=11 color="mochi.ink"
              text `${channel.number} · ${channel.name}` class=Label font-size=10 letter-spacing="0.18em" color="mochi.night-soft" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              if entry.genre != "" and not small
                row gap=6 align-items="center" flex-shrink=0
                  column width=6 height=6 border-radius=3 background-color=toneColor(entry.tone) aria-hidden=true
                  text entry.genre font-size=12 color="mochi.night-soft"
            text entry.name class=Title font-size=(small ? 24 : 40) white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-shadow="3px 3px 0px var(--mochi.ink)"
            row gap=12 align-items="center" min-width=0
              if not small
                button press=watch(channel.id) class=Candy height=38 padding-left=14 padding-right=18 flex-shrink=0 testId="guide-watch"
                  row gap=8 align-items="center"
                    PixelIcon(name="play", size=12)
                    text (entry.airing ? t("live.watch") : t("ui.watchChannel", channel=channel.name)) font-size=13 white-space="nowrap"
              text t("ui.startEnd", start=entry.startLabel, end=entry.endLabel) font-size=13 font-weight=600 font-variant-numeric="tabular-nums" white-space="nowrap"
              if entry.airing
                column width=(small ? 48 : 120) height=10 flex-shrink=0 border-radius=5 background-color="mochi.night-track" border="2px solid var(--mochi.night-edge-strong)" box-sizing="border-box" overflow="hidden" role="progressbar" aria-label=t("live.progress") aria-valuemin=0 aria-valuemax=100 aria-valuenow=entry.progress
                  column height="100%" width=`${entry.progress}%` background-image="repeating-linear-gradient(135deg, var(--mochi.pink) 0px, var(--mochi.pink) 4px, var(--mochi.pink-hover) 4px, var(--mochi.pink-hover) 8px)" transition=(still ? "none" : `width ${base()}ms ${settle()}`)
                text entry.remainingLabel font-size=12 color="mochi.sakura" font-variant-numeric="tabular-nums" white-space="nowrap"
              else
                text (entry.ended ? t("live.ended") : t("live.startsIn", minutes=entry.startsInLabel)) font-size=12 color="mochi.night-soft" white-space="nowrap"
              if entry.episode != "" and not small
                text entry.episode font-size=12 color="mochi.night-soft" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              if entry.rating != "" and not small
                text entry.rating font-size=10 font-weight=700 letter-spacing="0.06em" padding="2px 6px" border-radius=4 border="1px solid var(--mochi.night-edge-strong)" color="mochi.night-soft" flex-shrink=0
        if picked.length == 0
          column gap=(small ? 4 : 7) min-width=0 animation=(still ? "none" : `guideSwap 420ms ${settle()} both`)
            text `${channel.number}` class=Label font-size=10 color="mochi.night-soft"
            text channel.name class=Title font-size=(small ? 24 : 38) white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
            row gap=12 align-items="center"
              if not small
                button press=watch(channel.id) class=Candy height=38 padding-left=14 padding-right=18
                  row gap=8 align-items="center"
                    PixelIcon(name="play", size=12)
                    text t("live.watch") font-size=13
              text (channel.listed ? t("live.nothingNow") : t("live.noListings")) font-size=13 color="mochi.night-soft"

// The live preview tile: one muted ambient stream with its channel and an honest state.
// Clicking it opens full watch; the speaker unmutes in place.
component GuideTile
  props
    tile: LiveTile
    small: bool
    still: bool
    watch: action
    message: action
    unmute: action
    tuneIn: action
  inject
    mediaAuthJson: string
    tileNativeMedia: string
  view
    column position="relative" height=(small ? 72 : "clamp(120px, calc(16vh - 14px), 168px)") aspect-ratio="16 / 9" border-radius=(small ? 14 : 20) overflow="hidden" background-color="media.ground" border=(small ? "3px solid var(--mochi.card)" : "4px solid var(--mochi.card)") box-shadow="5px 6px 0px var(--mochi.pink)"
      if tile.planJson != "" and (tile.state == "connecting" or tile.state == "playing")
        vela-player plan=tile.planJson mediaAuth=mediaAuthJson nativeMedia=tileNativeMedia playerCommand=tile.commandJson message=message ambient="true" position="absolute" inset=0 width="100%" height="100%" aria-hidden=true
      if tile.state == "connecting"
        column position="absolute" inset=0 align-items="center" justify-content="center" role="status" aria-label=t("live.tuning", channel=tile.channelName)
          column color="mochi.star" animation=(still ? "none" : "mochiSpin 1.4s steps(8) infinite") aria-hidden=true
            PixelIcon(name="sparkle", size=18)
      if tile.state == "unavailable"
        column position="absolute" inset=0 align-items="center" justify-content="center" padding=10 role="status"
          text t("live.previewUnavailable") font-size=12 color="mochi.night-soft" text-align="center"
      if tile.state == "tune-in"
        button press=tuneIn aria-label=t("live.tuneInTo", channel=tile.channelName) position="absolute" inset=0 class=TileTuneIn
          row gap=8 align-items="center" justify-content="center"
            PixelIcon(name="play", size=12)
            text t("live.tuneIn") font-size=13 font-weight=650
      else
        button press=watch(tile.channelId) aria-label=t("ui.watchChannel", channel=tile.channelName) position="absolute" inset=0 class=TileOpen testId="guide-tile"
      row position="absolute" left=0 right=0 top=0 gap=6 align-items="center" padding=(small ? "5px 6px" : "8px 10px") background-image="linear-gradient(180deg, var(--mochi.night-deep) 0%, var(--mochi.night-clear) 100%)" pointer-events="none"
        row gap=4 align-items="center" padding="1px 5px" border-radius=4 background-color="mochi.pink" flex-shrink=0
          column width=5 height=5 border-radius=3 background-color="mochi.ink" aria-hidden=true
          text t("live.liveBadge") class=Pixel font-size=10 color="mochi.ink"
        if not small
          text tile.channelName font-size=11 font-weight=650 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 text-shadow="0px 1px 4px var(--mochi.night-deep)"
      if tile.state == "playing"
        button press=unmute aria-label=(tile.muted ? t("live.unmutePreview") : t("live.mutePreview")) aria-pressed=(not tile.muted) position="absolute" right=(small ? 4 : 8) bottom=(small ? 4 : 8) class=TileSpeaker width=(small ? 26 : 30) height=(small ? 26 : 30) padding=(small ? 6 : 7)
          PixelIcon(name=(tile.muted ? "mute" : "speaker"), size=(small ? 12 : 14))

// A channel's cell in the sticky rail: number, logo or monogram, name and what is on now.
component GuideRail
  props
    channel: GuideChannel
    index: number
    small: bool
    rail: number
    row: number
    selected: bool
    watch: action
    select: action
    railKey: action
  view
    button id=`guide-rail-${channel.id}` press=watch(channel.id) focus=select(channel.id, "") key=railKey(index) role="rowheader" aria-label=t("ui.watchChannel", channel=channel.name) position="sticky" left=0 z-index=3 flex-shrink=0 width=rail height=(row - 1) box-sizing="border-box" padding-left=(small ? 8 : 16) padding-right=(small ? 8 : 14) class=GuideRailCell background-color=(selected ? "mochi.night-3" : "mochi.night")
      row gap=(small ? 0 : 12) align-items="center" width="100%" justify-content=(small ? "center" : "flex-start")
        if not small
          text channel.number width=34 flex-shrink=0 text-align="right" class=Pixel font-size=13 color="mochi.night-quiet" font-variant-numeric="tabular-nums"
        column position="relative" width=(small ? 64 : 58) height=(small ? 40 : 36) flex-shrink=0 border-radius=12 overflow="hidden" padding=6 box-sizing="border-box" align-items="center" justify-content="center" background-color="mochi.night-card" border="1px solid var(--mochi.night-card)"
          if channel.logo != ""
            image channel.logo alt="" width="100%" height="100%" object-fit="contain"
          else
            text channel.name.slice(0, 2).toUpperCase() font-size=13 font-weight=750 letter-spacing="0.04em" color="mochi.night-soft"
          if small
            text channel.number position="absolute" right=3 bottom=2 font-size=9 font-weight=700 color="mochi.night-ink" text-shadow="0px 1px 3px var(--mochi.night-deep)" font-variant-numeric="tabular-nums"
        if not small
          column gap=4 flex=1 min-width=0
            row gap=5 align-items="center"
              text channel.name font-size=14 font-weight=620 color="mochi.night-ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              if channel.favorite
                column color="mochi.butter" flex-shrink=0 role="img" aria-label=t("live.favourite")
                  PixelIcon(name="heart", size=10)
            if channel.nowId != ""
              column height=2 border-radius=1 background-color="mochi.night-track" overflow="hidden" margin-top=3 aria-hidden=true
                column height=2 width=`${channel.nowProgress}%` background-color="mochi.sakura"
              text channel.nowRemaining font-size=11 color="mochi.night-quiet" font-variant-numeric="tabular-nums"
            else
              text (channel.listed ? channel.group : t("live.noListings")) font-size=11 color="mochi.night-quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// One programme block on the timeline; its label stays readable beside the rail when it began earlier.
component GuideCell
  props
    programme: GuideProgramme
    channel: GuideChannel
    index: number
    scale: number
    rail: number
    row: number
    small: bool
    nowMinute: number
    selected: bool
    focusMin: number
    select: action
    press: action
    move: action
  derive w = programme.span * scale
  derive elapsed = (programme.airing ? max(0, min(w, (nowMinute - programme.at) * scale)) : 0)
  view
    button id=`guide-${programme.id}` press=press(channel.id, programme.id, programme.airing) focus=select(channel.id, programme.id) key=move(index, programme.at, programme.airing, channel.id, programme.leftId, programme.rightId) role="gridcell" aria-selected=selected aria-label=t("ui.programmeStartToEndChannelProgrammeDetails", programme=programme.name, start=programme.startLabel, end=programme.endLabel, channel=channel.name) position="absolute" left=(rail + programme.at * scale + 2) top=5 width=max(2, w - 4) height=(row - 11) box-sizing="border-box" padding=0 display="flex" flex-direction="row" align-items="stretch" overflow="clip" text-align="left" class=GuideCell background-color=(programme.airing ? "mochi.airing" : "mochi.night-card") border=(programme.airing ? "1px solid var(--mochi.sakura)" : "1px solid var(--mochi.night-card)") opacity=(programme.ended ? 0.46 : 1) box-shadow=(selected ? "inset 0px 0px 0px 2px var(--mochi.sakura)" : "none") background-image=(programme.airing ? `linear-gradient(90deg, var(--mochi.airing-fill) 0px, var(--mochi.airing-fill) ${elapsed}px, transparent ${elapsed}px)` : "none")
      if programme.tone >= 0 and w > 24
        column position="absolute" left=7 top="50%" width=7 height=7 margin-top=-3.5 border-radius=4 background-color=toneColor(programme.tone) opacity=(programme.ended ? 0.5 : 1) aria-hidden=true
      if programme.airing
        column position="absolute" left=0 bottom=0 height=3 width=elapsed background-color="mochi.pink" aria-hidden=true
      if w >= 10 * scale
        column position="sticky" left=(rail + 12) height="100%" justify-content="center" gap=(small ? 3 : 4) padding-left=(programme.tone >= 0 and w > 24 ? 20 : 12) padding-right=10 box-sizing="border-box" max-width=max(0, w - 4) min-width=0 flex-shrink=1
          text programme.name font-size=(small ? 13 : 14) font-weight=(programme.airing ? 680 : 600) color="mochi.night-ink" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if w > 110
            text metaLine(programme) font-size=12 color=(programme.airing ? "mochi.sakura" : "mochi.night-soft") font-variant-numeric="tabular-nums" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

component GuideDayChip
  props
    label: string
    date: string
    offset: number
    on: bool
    small: bool
    pick: action
  view
    button press=pick(offset) aria-pressed=on class=GuideChip flex-shrink=0 background-color=(on ? "mochi.pink" : "mochi.night-card") color=(on ? "mochi.ink" : "mochi.night-ink") border-color=(on ? "mochi.ink" : "mochi.night-edge")
      row gap=6 align-items="baseline"
        text label font-size=13 font-weight=650 white-space="nowrap"
        if offset > 1
          text date font-size=12 opacity=0.62 white-space="nowrap"

// Phones: every channel with what is on now and next, one tap from watching.
component GuideNowList
  props
    rows: GuideChannel[]
    still: bool
    watch: action
  view
    list id="guide-now-list" virtualized=true appearance="none" flex=1 min-height=0 estimated-item-height=98 padding-bottom=24 aria-label=t("live.onNow")
      for c in rows key=c.id
        button press=watch(c.id) aria-label=t("ui.watchChannel", channel=c.name) class=GuideNowRow
          row gap=14 align-items="center" width="100%"
            column position="relative" width=76 height=48 flex-shrink=0 border-radius=14 overflow="hidden" padding=6 box-sizing="border-box" align-items="center" justify-content="center" background-color="mochi.night-card" border="1px solid var(--mochi.night-card)"
              if c.logo != ""
                image c.logo alt="" width="100%" height="100%" object-fit="contain"
              else
                text c.name.slice(0, 2).toUpperCase() font-size=15 font-weight=750 color="mochi.night-soft"
            column flex=1 min-width=0 gap=4
              row gap=6 align-items="center"
                text c.number font-size=11 color="mochi.night-quiet" font-variant-numeric="tabular-nums"
                text c.name font-size=12 font-weight=600 color="mochi.night-soft" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
                if c.favorite
                  column color="mochi.butter" flex-shrink=0 role="img" aria-label=t("live.favourite")
                    PixelIcon(name="heart", size=9)
              text (c.now != "" ? c.now : (c.listed ? t("live.nothingNow") : t("live.noListings"))) font-size=16 font-weight=(c.now != "" ? 640 : 500) color=(c.now != "" ? "mochi.night-ink" : "mochi.night-quiet") white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              if c.nowId != ""
                row gap=8 align-items="center"
                  column flex=1 height=2 border-radius=1 background-color="mochi.night-track" overflow="hidden" aria-hidden=true
                    column height=2 width=`${c.nowProgress}%` background-color="mochi.sakura"
                  text c.nowRemaining font-size=11 color="mochi.night-quiet" font-variant-numeric="tabular-nums" flex-shrink=0
              if c.nextLabel != ""
                text c.nextLabel font-size=12 color="mochi.night-quiet" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

style GuideChip
  box-sizing = "border-box"
  height = 38
  padding = "0px 15px"
  border-radius = 999
  border = "2px solid var(--mochi.night-edge-strong)"
  background-color = "mochi.night-card"
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  cursor = "pointer"
  transition = "background-color 160ms linear, color 160ms linear, border-color 160ms linear"
  :hover
    border-color = "mochi.sakura"
  :active
    -exact-press-scale = 0.94
  :focus-visible
    box-shadow = "0px 0px 0px 3px var(--mochi.night), 0px 0px 0px 6px var(--mochi.sakura)"

style NightPill
  box-sizing = "border-box"
  border = "2px solid var(--mochi.night-edge-strong)"
  border-radius = 999
  background-color = "mochi.night-card"
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  font-weight = 600
  cursor = "pointer"
  :hover
    background-color = "mochi.night-card-hover"
    border-color = "mochi.sakura"
  :active
    -exact-press-scale = 0.95
  :focus-visible
    box-shadow = "0px 0px 0px 3px var(--mochi.night), 0px 0px 0px 6px var(--mochi.sakura)"

style TileOpen
  border = "none"
  background-color = "transparent"
  border-radius = 16
  cursor = "pointer"
  :hover
    background-color = "mochi.night-card"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 3px var(--mochi.sakura)"

style TileTuneIn
  border = "none"
  background-color = "mochi.night-veil"
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  cursor = "pointer"
  :hover
    background-color = "mochi.night-deep"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 3px var(--mochi.sakura)"

style TileSpeaker
  box-sizing = "border-box"
  border = "2px solid var(--mochi.ink)"
  border-radius = 999
  background-color = "mochi.card"
  color = "mochi.ink"
  display = "flex"
  align-items = "center"
  justify-content = "center"
  cursor = "pointer"
  :hover
    background-color = "mochi.pink-soft"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--mochi.night), 0px 0px 0px 5px var(--mochi.sakura)"

style GuideSelect
  box-sizing = "border-box"
  height = 38
  padding = "0px 14px"
  border = "2px solid var(--mochi.night-edge-strong)"
  border-radius = 999
  background-color = "mochi.night-2"
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  font-size = 14
  font-weight = 600

style GuideTab
  height = 30
  padding = "0px 14px"
  border = "none"
  border-radius = 999
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  cursor = "pointer"
  :focus-visible
    box-shadow = "0px 0px 0px 2px var(--mochi.night), 0px 0px 0px 4px var(--mochi.sakura)"

style GuideRailCell
  border = "none"
  border-right = "2px solid var(--mochi.night-edge)"
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  text-align = "left"
  cursor = "pointer"
  transition = "background-color 160ms linear"
  :hover
    background-color = "mochi.night-3"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 3px var(--mochi.sakura)"

style GuideCell
  border-radius = 14
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  cursor = "pointer"
  transition = "border-color 160ms linear, box-shadow 200ms ease, background-color 160ms linear"
  :hover
    border-color = "mochi.sakura"
    background-color = "mochi.night-card-hover"
  :focus-visible
    border-color = "mochi.sakura"
    box-shadow = "inset 0px 0px 0px 2px var(--mochi.sakura), 0px 6px 0px var(--mochi.night-deep)"

style GuideEmpty
  border = "2px dashed var(--mochi.night-edge)"
  border-radius = 14
  background-color = "transparent"
  color = "mochi.night-ink"
  text-align = "left"
  cursor = "pointer"
  :hover
    background-color = "mochi.night-card"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 3px var(--mochi.sakura)"

style GuideNowRow
  box-sizing = "border-box"
  width = "100%"
  padding = "12px 16px"
  border = "none"
  border-bottom = "2px dashed var(--mochi.night-card)"
  background-color = "transparent"
  color = "mochi.night-ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  text-align = "left"
  :active
    background-color = "mochi.night-card"
  :focus-visible
    box-shadow = "inset 0px 0px 0px 3px var(--mochi.sakura)"
