use Card, FeedRow, DetailModel, ExtraModel, cardName from "../../foundation/models.contract"
use Row, gutter, accent from "./slots.contract"
use Pixel, Title, Label, Candy, Puffy, Bubble, PixelIcon, Mascot, Twinkle, Burst, FadeImage, hop, popIn, lift, boing, mochiFade, mochiHop, mochiPop, mochiFloat from "./look.contract"

fn kindLabel(kind: string): string = (kind == "movie" ? t("ui.film") : kind == "show" ? t("ui.series") : kind == "season" ? t("ui.season") : t("ui.episode"))

// A title opened as a sticker book page: artwork in a rounded frame, the poster
// stuck over its edge, then episodes, extras, people and related rows.
component Detail
  props
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  // The foundation's current season is the one its episodes belong to. A picked tab
  // lights at once and holds only until the foundation answers with any new season,
  // so Back and other navigation always show the foundation's choice.
  state pickedSeason = ""
  state pickedFrom = ""
  derive episodesSeason = match first(model.episodes) { case some(e) => e.seasonId, case none => "" }
  derive pending = pickedSeason != "" and pickedSeason != episodesSeason and episodesSeason == pickedFrom
  derive selectedSeason = (pending ? pickedSeason : episodesSeason != "" ? episodesSeason : match first(model.title) { case some(t) => (t.kind == "season" ? t.id : match first(model.seasons) { case some(s) => s.id, case none => "" }), case none => "" })
  derive upNext = match first(model.episodes.filter(e => not e.played)) { case some(e) => [e], case none => [] }
  action pickSeason(id: string)
    if id != selectedSeason
      pickedFrom = episodesSeason
      pickedSeason = id
      selectTitle(id, "season", "")
  view
    column gap=(small ? 34 : 46) padding-bottom=72 color="mochi.ink" font-family="Fredoka, ui-rounded, system-ui, sans-serif"
      for title in model.title key=title.id
        column position="relative"
          // The artwork frame.
          column position="relative" margin=(small ? "0px" : "22px 22px 0px") height=(small ? 260 : "clamp(300px, 46vh, 480px)") border=(small ? "none" : "3px solid var(--mochi.ink)") border-bottom="3px solid var(--mochi.ink)" border-radius=(small ? "0px 0px 28px 28px" : "30px") overflow="hidden" background-color=accent(title.name) box-shadow=(small ? "none" : "8px 9px 0px var(--mochi.lavender)") aria-hidden=true animation=popIn(still, 0)
            if title.backdrop != ""
              FadeImage(src=title.backdrop)
            else
              if title.poster != ""
                image title.poster alt="" position="absolute" top="-20%" left="-20%" width="140%" height="140%" object-fit="cover" filter="blur(50px) saturate(1.3)" opacity=0.85
            column position="absolute" inset=0 background-image="linear-gradient(0deg, var(--mochi.scrim-soft) 0%, var(--mochi.scrim-clear) 55%)"
            column position="absolute" top=18 left=22 color="mochi.butter" filter="drop-shadow(2px 2px 0px var(--mochi.ink))"
              Twinkle(size=22, color="mochi.butter", delay=0, still=still)
          // The poster sticker and the title copy.
          row position="relative" flex-direction=(small ? "column" : "row") gap=(small ? 16 : 36) padding-left=(small ? "20px" : "max(48px, 5vw)") padding-right=(small ? "20px" : "max(48px, 5vw)") margin-top=(small ? -96 : -130) align-items=(small ? "flex-start" : "flex-end")
            if title.poster != ""
              column flex-shrink=0 width=(small ? 128 : "clamp(170px, 15vw, 230px)") aspect-ratio="2 / 3" rotate="-3deg" aria-hidden=true animation=popIn(still, 120)
                column position="relative" width="100%" height="100%" box-sizing="border-box" padding=5 border="3px solid var(--mochi.ink)" border-radius=20 background-color="mochi.card" box-shadow="7px 8px 0px var(--mochi.shadow-pink)"
                  column position="relative" flex=1 border-radius=13 overflow="hidden"
                    FadeImage(src=title.poster)
                column position="absolute" top=-11 left="34%" width=56 height=20 rotate="6deg" background-color="mochi.butter" opacity=0.9 border="2px solid var(--mochi.ink)" box-sizing="border-box"
            column gap=(small ? 12 : 14) flex=1 min-width=0 animation=hop(still, 160) padding-bottom=(small ? 0 : 6)
              row gap=8 align-items="center" flex-wrap="wrap"
                text kindLabel(title.kind) class=Label font-size=11 padding="4px 10px" border-radius=999 background-color="mochi.mint" border="2px solid var(--mochi.ink)"
                for fact in model.mediaFacts key=fact
                  text fact class=Label font-size=11 padding="4px 10px" border-radius=8 background-color="mochi.card" border="2px solid var(--mochi.ink)"
              if title.logo != "" and small
                image title.logo alt=title.name role="heading" aria-level=1 height=80 width="auto" max-width="85%" object-fit="contain" align-self="flex-start"
              else
                text title.name role="heading" aria-level=1 class=Title font-size=(small ? 34 : 54)
              row gap=6 flex-wrap="wrap"
                for fact in [title.facts].concat(title.genres.slice(0, 4)).filter(f => f != "") key=fact
                  text fact font-size=13 font-weight=600 padding="4px 12px" border-radius=999 background-color="mochi.lavender-soft" font-variant-numeric="tabular-nums"
          column gap=(small ? 16 : 20) animation=hop(still, 260) padding-left=(small ? "20px" : "max(48px, 5vw)") padding-right=(small ? "20px" : "max(48px, 5vw)") padding-top=(small ? 16 : 24) max-width="56rem"
            if title.summary != ""
              text title.summary font-size=(small ? 15 : 17) line-height=1.6 color="mochi.ink-soft"
            row gap=14 align-items="center" flex-wrap="wrap"
              if model.canPlay
                PlayButton(label=(model.resumeSeconds > 0 ? t("ui.resumePositionIn", position=model.resumePosition) : t("ui.play")), accessible="", small=small, still=still, press=play(title.id))
              for trailer in model.extras.filter(e => e.kind == "trailer" and e.ready) key=trailer.id
                button press=playExtra(trailer.id) class=Puffy height=(small ? 50 : 56) padding-left=22 padding-right=26
                  row gap=10 align-items="center"
                    PixelIcon(name="star", size=14)
                    text t("ui.watchTrailer") font-size=16
            if model.canPlay and model.resumeSeconds > 0 and title.durationSeconds > 0
              CandyBar(value=min(title.durationSeconds, max(0, model.resumeSeconds)), total=title.durationSeconds, label=t("ui.watchProgress"), width=(small ? "70%" : "320px"))
      if model.seasons.length > 0 or model.episodes.length > 0
        column padding-left=(small ? "16px" : "max(48px, 5vw)") padding-right=(small ? "16px" : "max(48px, 5vw)") gap=(small ? 16 : 22) animation=hop(still, 380)
          SectionHeading(label=t("ui.episodes"), icon="layers", small=small)
          if model.seasons.length > 1
            scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none" margin-left=(small ? "-16px" : "0px") margin-right=(small ? "-16px" : "0px")
              row gap=10 role="group" aria-label=t("ui.season") testId="season-picker" padding="4px 16px 8px"
                for season in model.seasons key=season.id
                  button press=pickSeason(season.id) aria-pressed=(season.id == selectedSeason) class=SeasonPill background-color=(season.id == selectedSeason ? "mochi.pink" : "mochi.card") box-shadow=(season.id == selectedSeason ? "0px 4px 0px var(--mochi.ink)" : "0px 2px 0px var(--mochi.ink)")
                    text season.name font-size=15
          for episode in upNext key=episode.id
            row flex-direction=(small ? "column" : "row") align-items=(small ? "stretch" : "center") gap=(small ? 14 : 22) padding=(small ? 14 : 18) border-radius=26 background-color="mochi.butter-soft" border="3px solid var(--mochi.ink)" box-shadow="6px 7px 0px var(--mochi.butter)"
              if episode.backdrop != ""
                column position="relative" width=(small ? "100%" : 240) aspect-ratio="16 / 9" border-radius=16 overflow="hidden" border="3px solid var(--mochi.ink)" box-sizing="border-box" flex-shrink=0
                  FadeImage(src=episode.backdrop)
              column gap=6 flex=1 min-width=0
                text (episode.progressSeconds > 0 ? t("ui.continueWatching") : t("ui.upNext")) class=Label font-size=11 color="mochi.pink-deep"
                text (episode.episodeNumber > 0 ? t("ui.numberTitle", number=episode.episodeNumberLabel, title=episode.name) : episode.name) role="heading" aria-level=3 class=Title font-size=(small ? 22 : 28)
                if episode.facts != ""
                  text episode.facts font-size=13 color="mochi.ink-soft"
              PlayButton(label=(episode.progressSeconds > 0 ? t("ui.resumeEpisode") : t("ui.playEpisode")), accessible=(episode.progressSeconds > 0 ? t("ui.resumeTitle", title=episode.name) : t("ui.playTitle", title=episode.name)), small=true, still=still, press=play(episode.id))
          column gap=(small ? 12 : 14) aria-busy=pending opacity=(pending ? 0.5 : 1) transition="opacity 200ms linear"
            for episode, i in model.episodes key=episode.id
              EpisodeCard(episode=episode, small=small, still=still, play=play, selectTitle=selectTitle, delay=min(i, 8) * 40)
      if model.extras.length > 0
        column gap=14 animation=hop(still, 420)
          column padding-left=(small ? "16px" : "max(48px, 5vw)")
            SectionHeading(label=t("ui.extras"), icon="star", small=small)
          scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
            row gap=16 padding-left=(small ? "16px" : "max(48px, 5vw)") padding-right=(small ? "16px" : "max(48px, 5vw)") padding-top=6 padding-bottom=14
              for extra in model.extras key=extra.id
                ExtraTile(extra=extra, small=small, playExtra=playExtra)
      if model.cast.length > 0
        column gap=14 padding-left=(small ? "16px" : "max(48px, 5vw)") padding-right=(small ? "16px" : "max(48px, 5vw)") animation=hop(still, 460)
          SectionHeading(label=t("ui.featuring"), icon="heart", small=small)
          row gap=10 flex-wrap="wrap"
            for person in model.cast key=person
              row gap=10 align-items="center" padding="5px 16px 5px 5px" border-radius=999 background-color="mochi.card" border="2.5px solid var(--mochi.ink)" box-shadow="0px 3px 0px var(--mochi.ink)"
                text person.slice(0, 1).toUpperCase() width=30 height=30 border-radius=15 display="flex" align-items="center" justify-content="center" font-family="\"Pixelify Sans\", ui-monospace, monospace" font-size=14 font-weight=700 background-color=accent(person) aria-hidden=true
                text person font-size=15 font-weight=550
      if model.crew.length > 0
        column gap=12 padding-left=(small ? "16px" : "max(48px, 5vw)") padding-right=(small ? "16px" : "max(48px, 5vw)") animation=hop(still, 480)
          SectionHeading(label=t("ui.behindTheStory"), icon="sparkle", small=small)
          text model.crew.join(" · ") font-size=15 color="mochi.ink-soft" line-height=1.7 max-width="48rem"
      if model.related.length > 0
        column animation=hop(still, 500)
          for related in model.related key=related.id
            Row(row=related, small=small, still=still, selectTitle=selectTitle, observe=observe)

// A section title in pixel type beside a pixel icon in a candy badge.
component SectionHeading
  props
    label: string
    icon: string
    small: bool
  view
    row gap=10 align-items="center"
      row width=32 height=32 border-radius=10 align-items="center" justify-content="center" background-color=accent(label) border="2.5px solid var(--mochi.ink)" box-sizing="border-box" aria-hidden=true
        PixelIcon(name=icon, size=14)
      text label role="heading" aria-level=2 class=Pixel font-size=(small ? 22 : 26)

// The big candy play button; it throws sparkles as it starts playback.
component PlayButton
  props
    label: string
    accessible: string
    small: bool
    still: bool
    press: action
  state bursts = 0
  action go
    bursts = bursts + 1
    press()
  view
    column position="relative" flex-shrink=0
      button press=go aria-label=(accessible == "" ? label : accessible) class=Candy height=(small ? 50 : 58) padding-left=(small ? 22 : 30) padding-right=(small ? 26 : 34) testId="detail-play"
        row gap=10 align-items="center" justify-content="center"
          PixelIcon(name="play", size=(small ? 15 : 17))
          text label font-size=(small ? 16 : 18)
      for n in [bursts] key=`burst-${n}`
        if n > 0
          Burst(still=still)

// Watched progress as a striped candy bar.
component CandyBar
  props
    value: number
    total: number
    label: string
    width: string
  view
    column width=width height=14 border-radius=7 border="2.5px solid var(--mochi.ink)" box-sizing="border-box" background-color="mochi.card" overflow="hidden" role="progressbar" aria-label=label aria-valuemin=0 aria-valuemax=total aria-valuenow=value
      column height="100%" width=`${min(100, value / max(1, total) * 100)}%` background-image="repeating-linear-gradient(135deg, var(--mochi.pink) 0px, var(--mochi.pink) 5px, var(--mochi.pink-hover) 5px, var(--mochi.pink-hover) 10px)"

style SeasonPill
  height = 42
  padding = "0px 18px"
  border = "2.5px solid var(--mochi.ink)"
  border-radius = 999
  color = "mochi.ink"
  font-family = "Fredoka, ui-rounded, system-ui, sans-serif"
  font-weight = 600
  flex-shrink = 0
  cursor = "pointer"
  :hover
    scale = 1.05
  :active
    -exact-press-scale = 0.94
  :focus-visible
    box-shadow = "0px 0px 0px 3px var(--mochi.card), 0px 0px 0px 6px var(--mochi.focus)"

// One episode as a white card: a still that lifts and shows a play heart, then its text.
component EpisodeCard
  props
    episode: Card
    small: bool
    still: bool
    play: action
    selectTitle: action
    delay: number
  state lifted = false
  action hoverRow(over: bool)
    lifted = over
  view
    row gap=(small ? 12 : 20) align-items=(small ? "flex-start" : "center") padding=(small ? 10 : 14) border-radius=22 background-color="mochi.card" border="2.5px solid var(--mochi.ink)" box-shadow=(lifted ? "5px 6px 0px var(--mochi.shadow)" : "3px 3px 0px var(--mochi.shadow)") hover=hoverRow translate=(lifted and not still ? "0px -3px" : "0px 0px") transition=lift(still) animation=hop(still, delay)
      button press=selectTitle(episode.id, episode.kind, episode.receipt) aria-label=cardName(episode) testId=`episode-${episode.id}` focus=hoverRow(true) blur=hoverRow(false) position="relative" width=(small ? 124 : 200) aspect-ratio="16 / 9" padding=0 border="2.5px solid var(--mochi.ink)" border-radius=14 overflow="hidden" background-color=accent(episode.name) color="mochi.ink" flex-shrink=0 cursor="pointer" rotate=(lifted and not still ? "-1.5deg" : "0deg") transition=lift(still)
        :focus-visible
          box-shadow="0px 0px 0px 3px var(--mochi.card), 0px 0px 0px 6px var(--mochi.focus)"
        if episode.backdrop != ""
          FadeImage(src=episode.backdrop)
        else
          column position="absolute" inset=0 align-items="center" justify-content="center"
            text (episode.episodeNumber > 0 ? episode.episodeNumberLabel : t("ui.episode")) class=Pixel font-size=(small ? 24 : 30)
        column position="absolute" inset=0 align-items="center" justify-content="center" background-color="mochi.scrim-soft" opacity=(lifted ? 1 : 0) transition="opacity 200ms linear" aria-hidden=true
          row width=42 height=42 border-radius=21 align-items="center" justify-content="center" background-color="mochi.pink" border="2.5px solid var(--mochi.ink)" box-sizing="border-box" scale=(lifted and not still ? 1 : 0.7) transition=lift(still)
            PixelIcon(name="play", size=14)
        if episode.played
          row position="absolute" top=6 right=6 width=22 height=22 border-radius=11 align-items="center" justify-content="center" background-color="mochi.mint" border="2px solid var(--mochi.ink)" box-sizing="border-box" aria-hidden=true
            PixelIcon(name="check", size=10)
        if episode.progressSeconds > 0 and episode.durationSeconds > 0
          column position="absolute" left=8 right=8 bottom=8
            CandyBar(value=min(episode.durationSeconds, max(0, episode.progressSeconds)), total=episode.durationSeconds, label=t("ui.titleWatchProgress", title=episode.name), width="100%")
      column flex=1 min-width=0 gap=5
        row gap=8 align-items="center" min-width=0
          if episode.episodeNumber > 0
            text episode.episodeNumberLabel class=Pixel font-size=13 padding="1px 8px" border-radius=8 background-color="mochi.lavender-soft" flex-shrink=0
          text episode.name role="heading" aria-level=3 font-size=(small ? 15 : 18) font-weight=650 line-clamp=2
        text (episode.played ? t("ui.factsWatched", facts=episode.facts) : episode.facts) color="mochi.ink-soft" font-size=13 font-variant-numeric="tabular-nums"
        if not small and episode.summary != ""
          text episode.summary color="mochi.ink-soft" font-size=14 line-clamp=2 line-height=1.5 max-width="46rem"
      if not small
        button press=play(episode.id) aria-label=t("ui.playTitle", title=episode.name) class=Bubble width=46 height=46 padding=0 flex-shrink=0 display="flex" align-items="center" justify-content="center" background-color="mochi.pink-soft"
          PixelIcon(name="play", size=15)

// An extra (trailer, featurette): a puffy tile that plays, or says it is not ready.
component ExtraTile
  props
    extra: ExtraModel
    small: bool
    playExtra: action
  view
    button press=playExtra(extra.id) disabled=(not extra.ready) aria-label=(extra.ready ? t("ui.playTitle", title=extra.name) : t("ui.titleNotAvailable", title=extra.name)) class=Puffy border-radius=22 width=(small ? 220 : 270) height=(small ? 92 : 104) padding=16 flex-shrink=0
      row gap=14 align-items="center" height="100%"
        row width=42 height=42 border-radius=21 align-items="center" justify-content="center" background-color=(extra.ready ? "mochi.pink" : "mochi.lavender-soft") border="2.5px solid var(--mochi.ink)" box-sizing="border-box" flex-shrink=0 aria-hidden=true
          PixelIcon(name=(extra.ready ? "play" : "lock"), size=14)
        column gap=4 flex=1 min-width=0 text-align="left"
          text extra.name font-size=15 font-weight=600 line-clamp=2
          if not extra.ready
            text t("ui.notAvailableYet") font-size=12 color="mochi.ink-soft"
