use Card, FeedRow, HomeModel, SearchModel, DetailModel, ReceiptReply, Viewport, PlaybackModel from "./foundation/models.contract"
use GuideModel from "./live/models.contract"
use Guide from "./skins/cinematic/guide.contract"
use Shell, Home, SearchSurface, Detail, PlayerChrome from "./skins/cinematic/slots.contract"

routes nav
  home "/"
    live "/live"
    liveWatch "/live/:id"
    title "/title/:id"
    watch "/watch/:id"
    extra "/watch/extra/:id"

component Client
  members "./foundation/behavior.contract"

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color="surface.page" color="ink.primary" color-scheme="dark"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="home-scroll" position="absolute" inset=0
            Shell(viewer=home.viewer, skin=activeSkin, skins=home.skins, chooseSkin=chooseSkin)
              scroll id="home-scroll" flex=1 min-height=0
                if failed(home)
                  text "Your library couldn't be reached. Check your server connection." padding=32 role="status"
                else
                  if not current(home)
                    text "Finding your evening…" padding=32 role="status"
                  else
                    Home(model=home, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe)
                      row align-items="center" gap=12 padding="8px 18px" border-radius=32 background-color="surface.glass" border="1px solid var(--surface.line)" box-shadow="0px 16px 50px #00000040"
                        image "symbol:search" color="ink.secondary" width=20 height=20
                        input value=query input=edit placeholder="A title, a feeling, a world to get lost in…" aria-label="Search your library" testId="search" flex=1 min-width=0 padding="12px 0px" border="none" background-color="transparent" color="ink.primary" font-size=15
                        if query != ""
                          button press=edit("") aria-label="Clear search" border="none" background-color="transparent" color="ink.secondary" padding=8
                            image "symbol:close"
                    if query != ""
                      SearchSurface(query=query, model=results, descriptive=descriptive, ai=ai, generation=generation, loading=(not current(results) or results.query != query or results.generation != generation), error=failed(results), aiAvailable=home.aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
        if e.name == "live"
          column navigationKey=`${e.id}` position="absolute" inset=0
            Shell(viewer=home.viewer, skin=activeSkin, skins=home.skins, chooseSkin=chooseSkin)
              scroll flex=1 min-height=0
                if failed(guide)
                  text "The guide couldn't be loaded. Check your connection." role="status" padding=32
                else
                  if not current(guide)
                    text "Loading the guide…" role="status" padding=32
                  else
                    Guide(model=guide, small=small, watch=watchChannel, previous=earlierGuide, next=laterGuide)
        if e.name == "title"
          column navigationKey=`${e.id}` navigationPresentation=(small ? "fullscreen" : "modal") navigationScroll=`detail-scroll-${e.id}` position="absolute" inset=0 background-color="surface.page" color="ink.primary"
            row padding="16px 5%" align-items="center"
              button id="back" press=close aria-label="Back to browsing" border="none" border-radius=24 padding="10px 16px" background-color="surface.raised" color="ink.primary"
                text "Back"
              text "vela" flex=1 text-align="center" color="ink.secondary" font-size=22
            scroll id=`detail-scroll-${e.id}` flex=1 min-height=0
              if failed(detail)
                text "This title couldn't be opened. It may no longer be available." padding=32 role="status"
              else
                if not current(detail)
                  text "Opening title…" padding=32 role="status"
                else
                  Detail(model=detail, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
        if e.name == "watch" or e.name == "extra" or e.name == "liveWatch"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color="surface.page"
            button id="back" press=close aria-label="Close player" padding=16
              text "Back"
            if failed(playback)
              text "Playback couldn't be started." role="status" padding=24
            else
              if not current(playback)
                text "Preparing playback…" role="status" padding=24
              else
                column flex=1 min-height=0 position="relative"
                  vela-player plan=playback.planJson playerCommand=commandJson message=playerMessage flex=1 min-height=240
                  if e.name == "liveWatch"
                    button press=toggleLowDelay aria-label="Toggle low delay" buttonStyle="bordered"
                      text (lowDelay ? "Low delay on" : "Low delay off")
                  PlayerChrome(titleId=e.params.id, command=playerCommand)
