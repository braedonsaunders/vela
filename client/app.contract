use Guide, LiveControls, MiniGuide from "./foundation/skin.contract"
use PlayerChrome from "./foundation/skin.contract"
use Card, FeedRow, HomeModel, SearchModel, DetailModel, ReceiptReply, Viewport, PlaybackModel from "./foundation/models.contract"
use AuthStage, AuthNotice, SignIn, QuickConnect from "./foundation/skin.contract"
use Shell, Home, SearchSurface, Detail, SearchField, Row, Status, Collection, Library, skinDetailPresentation, skinDetailSplit from "./foundation/skin.contract"
use dissolve, open, vanish from "./skins/cinematic/look.contract"

routes nav
  home "/"
    title "/title/:id"
    watch "/watch/:id"
    extra "/watch/extra/:id"
    collection "/collection/:id"
    library "/library/:id"
    live "/live"
    liveWatch "/live/:id"

component Client
  members "./foundation/behavior.contract"
  members "./foundation/player.contract"
  members "./foundation/live.contract"
  members "./foundation/appearance.contract"

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color=pageColor color=inkColor color-scheme="dark" -exact-mode=(activePackJson != "" ? "pack=installed" : "pack=house")
      vela-theme pack=activePackJson width=0 height=0 aria-hidden=true
      vela-context message=receiveOrigin width=0 height=0 aria-hidden=true
      vela-context probe="media" message=receiveCapabilities width=0 height=0 aria-hidden=true
      vela-context probe="network" message=receiveNetwork width=0 height=0 aria-hidden=true
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationSplit=(top(nav).name == "title" ? skinDetailSplit(activeSkin, viewport.width) : "none") navigationScroll="home-scroll" position="absolute" inset=0
            Shell(viewer=(auth.authenticated and current(home) ? home.viewer : ""), skin=activeSkin, skins=(auth.authenticated and current(home) ? (home.skins.includes("example") ? ["cinematic", "index", "jellytwin", "mochi", "example"] : ["cinematic", "index", "jellytwin", "mochi"]) : []), chooseSkin=chooseSkin, signOut=logout, viewport=shellViewport, canLive=(auth.authenticated and current(home) and home.liveAvailable), canLibrary=false, home=goHome, search=openSearch, live=openLive, library=goHome, libraries=(auth.authenticated and current(home) and current(libraries) ? libraries : []), section=(libraryId == "" ? "home" : libraryId == "@live" ? "live" : libraryId), openLibrary=openLibrary)
              if failed(auth) or not current(auth) or not auth.authenticated
                scroll id="home-scroll" role="region" aria-label=t("ui.browseAndSearch") flex=1 min-height=0
                  AuthStage(skin=activeSkin, still=still, backdrop=packBackdrop, wordmark=packWordmark)
                    if failed(auth)
                      AuthNotice(skin=activeSkin, kind="offline", still=still)
                    else
                      if not current(auth)
                        AuthNotice(skin=activeSkin, kind=(webCode != "" ? "redeeming" : "connecting"), still=still)
                      else
                        if quickSecret != ""
                          QuickConnect(skin=activeSkin, model=quickModel, error=quickError, still=still, cancel=cancelCode)
                        else
                          SignIn(skin=activeSkin, username=username, password=password, passwordAvailable=auth.passwordAvailable, quickAvailable=auth.quickAvailable, error=authError, busy=(pending(signedIn) or pending(quickStarted)), still=still, editUsername=editUsername, editPassword=editPassword, submit=submitSignIn, quick=startCode)
              else
                // Home and the libraries side by side: the track pans to the active section.
                column flex=1 min-height=0 position="relative" overflow="hidden"
                  row height="100%" translate=`${sectionIndex * -100}% 0px` transition=(activeSkin == "index" or activeSkin == "editorial" or activeSkin == "example" or still ? "none" : "translate 640ms cubic-bezier(0.65, 0, 0.35, 1)")
                    scroll id="home-scroll" role="region" aria-label=t("ui.browseAndSearch") scroll=cancelPreviewOnScroll width="100%" height="100%" flex-shrink=0 inert=(sectionIndex != 0) aria-hidden=(sectionIndex != 0) opacity=(sectionIndex == 0 or not still ? 1 : 0) transition=(activeSkin == "index" or activeSkin == "editorial" or activeSkin == "example" ? "none" : still ? "opacity 260ms linear" : "opacity 640ms cubic-bezier(0.65, 0, 0.35, 1)")
                      if failed(home)
                        Status(skin=activeSkin, kind="failure", message=t("ui.yourLibraryCouldnTBeReachedCheckYourServerConnection"), small=homeSmall, still=still)
                      else
                        if not current(home)
                          Status(skin=activeSkin, kind="home", message=t("ui.findingYourEvening"), small=homeSmall, still=still)
                        else
                          Home(skin=activeSkin, model=homeSurface, active=(top(nav).name == "home" and sectionIndex == 0 and page.visibilityState == "visible"), query=query, small=homeSmall, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroAt, pickHero=pickHero, reachEnd=loadMoreHome, reachRowEnd=loadMoreRow, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading, cardPreview=cardPreview, previewIntent=previewIntent, playHero=playHero, libraries=(current(libraries) ? libraries : []), openLibrary=openLibrary, live=openLive, canLive=home.liveAvailable)
                            SearchField(skin=activeSkin, query=query, edit=edit)
                          if query != ""
                            SearchSurface(skin=activeSkin, query=query, model=results, descriptive=descriptive, ai=ai, generation=generation, loading=(pending(results) or (not failed(results) and (not current(results) or results.query != query or results.generation != generation))), error=(failed(results) and not pending(results)), aiAvailable=home.aiAvailable, small=homeSmall, still=still, selectTitle=selectTitle, observe=observe)
                    for sid in sectionIds.slice(1) key=sid
                      if sid == "@live"
                        // Live TV: the guide owns its scrolling; it mounts only while its panel is active.
                        column role="region" aria-label=t("ui.live") width="100%" height="100%" flex-shrink=0 min-height=0 inert=(libraryId != "@live") aria-hidden=(libraryId != "@live") opacity=(libraryId == "@live" or not still ? 1 : 0)
                          if libraryId == "@live"
                            if guideReady
                              Guide(skin=activeSkin, model=guide, small=small, still=still, zoom=guideZoom, tile=tile, watch=watchChannel, previous=earlierGuide, next=laterGuide, chooseDay=chooseGuideDay, setZoom=setGuideZoom, tileMessage=tileMessage, tileUnmute=tileUnmute, tileTuneIn=tileTuneIn, retune=retuneTile)
                            else
                              if failed(guide)
                                text t("ui.theGuideCouldnTBeLoadedCheckYourConnection") role="status" padding=32 padding-top=(small ? 120 : 112)
                              else
                                text t("ui.loadingTheGuide") role="status" padding=32 padding-top=(small ? 120 : 112)
                      else
                        for lib in libraries.filter(l => l.id == sid) key=lib.id
                          scroll id=`library-scroll-${lib.id}` role="region" aria-label=lib.name width="100%" height="100%" flex-shrink=0 inert=(lib.id != libraryId) aria-hidden=(lib.id != libraryId) opacity=(lib.id == libraryId or not still ? 1 : 0) transition=(activeSkin == "index" or activeSkin == "editorial" or activeSkin == "example" ? "none" : still ? "opacity 260ms linear" : "opacity 640ms cubic-bezier(0.65, 0, 0.35, 1)")
                            // One page per library: the live answer when it is this library's, else this
                            // session's last answer for it, so switching source never remounts the page.
                            for shown in [libraryModel].filter(m => m.id == lib.id).concat(librarySnapshots.filter(m => m.id == lib.id)).slice(0, 1) key=lib.id
                              Library(skin=activeSkin, model=shown, loading=(lib.id == libraryId and libraryLoading), moreLoading=(lib.id == libraryId and libraryMoreLoading), small=small, still=still, close=goHome, setSort=setLibrarySort, setFilter=setLibraryFilter, more=moreLibrary, selectTitle=selectTitle, observe=observe)
                            if lib.id == libraryId and libraryModel.id != lib.id and librarySnapshots.filter(m => m.id == lib.id).length == 0
                              if failed(libraryModel)
                                Status(skin=activeSkin, kind="failure", message=t("library.couldNotOpen"), small=small, still=still)
                              else
                                Status(skin=activeSkin, kind="library", message=t("ui.findingTitles"), small=small, still=still)
                            // Panels not yet visited show their shape (still) so a long pan passes over content.
                            if lib.id != libraryId and libraryModel.id != lib.id and librarySnapshots.filter(m => m.id == lib.id).length == 0
                              Status(skin=activeSkin, kind="library", message=t("ui.findingTitles"), small=small, still=true)
        if e.name == "live"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color=pageColor
        if e.name == "title"
          column navigationKey=`${e.id}` navigationBar="none" navigationPresentation=skinDetailPresentation(activeSkin, viewport.width) navigationScroll=`detail-scroll-${e.id}` position="absolute" inset=0 box-sizing="border-box" padding=(flatDetail or small ? "0px" : "4vh 4vw") background-color=(flatDetail ? pageColor : activeSkin == "mochi" ? "mochi.scrim" : "media.overlay") backdrop-filter=(flatDetail ? "none" : "blur(18px) saturate(1.1)") animation=(flatDetail ? "none" : still ? "dissolve 200ms linear both" : "dissolve 420ms ease-out both") color=inkColor
            column position="relative" flex=1 min-height=0 overflow="hidden" border-radius=(flatDetail or small ? 0 : 28) background-color=pageColor box-shadow=(flatDetail or small ? "none" : activeSkin == "mochi" ? "0px 0px 0px 3px var(--mochi.ink), 10px 12px 0px 3px var(--mochi.lavender)" : "0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)") animation=(flatDetail ? "none" : still ? "dissolve 240ms linear both" : "open 680ms cubic-bezier(0.16, 1, 0.3, 1) both")
              button id="back" press=close aria-label=t("ui.closeTitle") testId="detail-close" position="absolute" top=20 right=20 z-index=10 box-sizing="border-box" width=44 height=44 border=(activeSkin == "mochi" ? "3px solid var(--mochi.ink)" : "1px solid var(--surface.line)") border-radius=22 padding=13 background-color=(activeSkin == "mochi" ? "mochi.card" : "surface.glass") backdrop-filter="blur(20px) saturate(1.3)" color=(activeSkin == "mochi" ? "mochi.ink" : "ink.primary")
                image "symbol:close"
              scroll id=`detail-scroll-${e.id}` role="region" aria-label=t("ui.titleDetails") flex=1 min-height=0
                if failed(detail)
                  Status(skin=activeSkin, kind="failure", message=t("ui.thisTitleCouldnTBeOpenedItMayNoLongerBeAvailable"), small=small, still=still)
                else
                  if not current(detail)
                    Status(skin=activeSkin, kind="detail", message=t("ui.openingTitle"), small=small, still=still)
                  else
                    Detail(skin=activeSkin, model=detailSurface, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observeDetail)
        if e.name == "collection"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color=pageColor color=inkColor
            scroll flex=1 min-height=0
              if failed(collection)
                Status(skin=activeSkin, kind="failure", message=t("ui.thisCollectionCouldnTBeOpened"), small=small, still=still)
              else
                if not current(collection)
                  Status(skin=activeSkin, kind="loading", message=t("ui.openingCollection"), small=small, still=still)
                else
                  Collection(skin=activeSkin, id=e.params.id, name=collection.name, items=collection.items, small=small, still=still, close=close, selectTitle=selectTitle, observe=observe)
        if e.name == "library"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color=pageColor
        if e.name == "watch" or e.name == "extra" or e.name == "liveWatch"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" id="watch-stage" testId="watch-stage" key=stageKey pointermove=touchWatch pointerdown=touchWatch position="absolute" inset=0 background-color="media.ground" color="ink.primary" tabindex=0
            if failed(playback)
              column margin="auto" padding=32 gap=16
                text t("ui.playbackCouldnTBeStarted") role="alert"
                button press=close
                  text t("ui.backToTitle")
            else
              if not current(playback)
                text t("ui.requestingPlaybackSession") role="status" margin="auto"
              else
                vela-player plan=(watchModel.planJson != "" ? watchModel.planJson : currentPlan) playerCommand=watchCommandJson serverError=watchReply.error message=liveWatchMessage position="absolute" inset=0 width="100%" height="100%"
                PlayerChrome(skin=activeSkin, model=watchModel, title=(e.name == "liveWatch" ? (current(liveIdentity) ? liveIdentity.title : t("ui.liveTelevisionTitle")) : watchTitle), busy=pending(watchAuthorized), visible=watchChromeVisible, small=small, still=still, serverError=watchReply.error, command=watchControl, seek=watchSeek, editing=editWatch, close=closeWatch)
                if e.name == "liveWatch"
                  column position="absolute" top=88 right=(small ? 12 : 36) z-index=2 max-width=(small ? "calc(100% - 24px)" : "none") opacity=(liveControlsVisible ? 1 : 0) pointer-events=(liveControlsVisible ? "auto" : "none") inert=(not liveControlsVisible) transition=(still ? "none" : "opacity 180ms ease")
                    LiveControls(skin=activeSkin, lowDelay=lowDelay, reconnecting=(liveView.sessionId == playback.sessionId and liveView.reconnecting), delivery=(liveView.sessionId == playback.sessionId ? liveView.delivery : "unknown"), drift=(liveView.sessionId == playback.sessionId ? liveView.drift : -1), driftLabel=(liveView.sessionId == playback.sessionId ? liveView.driftLabel : ""), canCatchUp=(liveView.sessionId == playback.sessionId and liveView.canCatchUp), toggleLowDelay=toggleLowDelay, catchUp=catchUpLive, zap=zap)
                  if zapTarget != "" and guide.channels.length > 0
                    column position="absolute" left=(small ? 16 : 40) top="50%" translate="0px -50%" z-index=3
                      MiniGuide(skin=activeSkin, model=guide, playing=playingId, target=zapTarget, small=small, still=still, tune=tuneZap)
      // A new appearance dissolves in from its own ground instead of swapping hard.
      for n in [skinSwitches].filter(k => k > 0) key=`veil-${n}`
        column position="absolute" inset=0 z-index=500 pointer-events="none" aria-hidden=true background-color=pageColor animation=(still ? "vanish 260ms linear both" : "vanish 760ms cubic-bezier(0.65, 0, 0.35, 1) 60ms both")
