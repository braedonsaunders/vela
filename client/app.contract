use Shell, Home, SearchSurface, Detail, SearchField, Status, Collection, Library, Guide, LiveControls, MiniGuide, PlayerChrome, AuthStage, AuthNotice, SignIn, QuickConnect, Connect, skinDetailPresentation, skinDetailSplit, skinManifest, pickerSkins, resolveSkin from "./foundation/skins.generated.contract"
use ShellProps, ConnectProps, HomeProps, SearchProps, SearchFieldProps, DetailProps, StatusProps, CollectionProps, LibraryProps, GuideProps, LiveControlsProps, MiniGuideProps, PlayerProps, AuthStageProps, AuthNoticeProps, SignInProps, QuickConnectProps from "./foundation/slot-api.contract"
use Card, FeedRow, HomeModel, SearchModel, DetailModel, ReceiptReply, Viewport, PlaybackModel from "./foundation/models.contract"
use dissolve, open, vanish from "./foundation/motion.contract"
use buildEngine from "./foundation/engine.contract"
use VelaSplash from "./foundation/splash.contract"
use DocRoute from "./foundation/skins.generated.contract"
use RouteProps from "./renderer/shapes.contract"

routes nav
  home "/"
    title "/title/:id"
    watch "/watch/:id"
    extra "/watch/extra/:id"
    collection "/collection/:id"
    connect "/connect"
    connectServer "/connect/:id"
    library "/library/:id"
    live "/live"
    liveWatch "/live/:id"

component Client
  members "./foundation/behavior.contract"
  members "./foundation/player.contract"
  members "./foundation/live.contract"
  members "./foundation/appearance.contract"
  members "./foundation/launch.contract"
  members "./foundation/theme.contract"
  // What every skin slot reads besides its record: the active skin, the server's skin
  // document, and the app's actions by their own names. Each slot's generated dispatch
  // (foundation/skins.generated.contract) offers these to its skin under the slot ABI's names.
  // Each slot's record is built once per draw in a one-element loop (`for slotProps in
  // [Record(...)]`): Exact re-emits a prop's expression at every read, a loop binds a value.
  provide
    activeSkin
    doc = activeDoc
    // The home pane's own width (a split title page narrows it): document breakpoints follow it.
    homeWidth = shellViewport.width
    chooseSkin
    logout
    goHome
    openSearch
    openLive
    openLibrary
    goSecure
    selectTitle
    observe
    observeDetail
    pickHero
    loadMoreHome
    loadMoreRow
    previewIntent
    playHero
    openLiveProgramme
    retryDescriptive
    retryFailed
    edit
    // The search query, for a skin document's own search input (renderer widget searchInput).
    query
    play
    playExtra
    close
    setLibrarySort
    setLibraryFilter
    moreLibrary
    moreCollection
    watchChannel
    earlierGuide
    laterGuide
    chooseGuideDay
    setGuideZoom
    tileMessage
    // Foundation-private media authorization: injected only into vela-player and vela-preview.
    mediaAuthJson
    tileNativeMedia
    previewNativeMedia
    previewMessage
    tileUnmute
    tileTuneIn
    retuneTile
    previewChannel
    zapTile
    homeGuide
    homeTile
    homeTuned
    homeZapping
    retryTileStop
    probeServer
    addServer
    selectServer
    removeServer
    startPlexLink
    choosePlexServer
    cancelPlexLink
    signInJellyfin
    startJellyfinQuick
    cancelJellyfinQuick
    openConnect
    catchUpLive
    zap
    tuneZap
    watchControl
    watchSeek
    editWatch
    closeWatch
    toggleWatchInfo
    toggleThemeMusic
    editUsername
    editPassword
    // A document's sign-in fields (renderer widget textInput) show and edit them.
    username
    password
    submitSignIn
    startCode
    cancelCode

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color=pageColor color=inkColor color-scheme="dark" -exact-mode=(activePackJson != "" ? "pack=installed" : "pack=house")
      vela-theme pack=activePackJson width=0 height=0 aria-hidden=true
      vela-theme fonts=activeDoc.fontsJson width=0 height=0 aria-hidden=true
      vela-theme keyframes=activeDoc.keyframesCss width=0 height=0 aria-hidden=true
      vela-engine build=buildEngine() wanted=resolveSkin(wantedSkin) chosen=pickEngine fallback=serverEngine settled=engineSettled still=still width=0 height=0 aria-hidden=true
      vela-context message=receiveOrigin secureNavigate=secureNavigate secureOrigins=secureOriginsJSON width=0 height=0 aria-hidden=true
      vela-context probe="media" message=receiveCapabilities width=0 height=0 aria-hidden=true
      vela-context probe="network" message=receiveNetwork width=0 height=0 aria-hidden=true
      for e in stack(nav) key=e.id
        // Home, and each route the active skin document draws (title, …): one column, one shell
        // (bare on a route) and one route view, so the renderer has one page call site. A framed
        // title's scrim and blur (the document's detail frame) sit on the route column itself: a
        // route is its own backdrop root, so a blur inside it would not see home beneath.
        if e.name == "home" or docRoutes.includes(e.name)
          column navigationKey=`${e.id}` navigationBar=(e.name == "home" ? "auto" : "none") navigationSplit=(e.name == "home" and top(nav).name == "title" ? skinDetailSplit(activeSkin, viewport.width, activeDoc) : "none") navigationPresentation=(e.name == "title" ? skinDetailPresentation(activeSkin, viewport.width, activeDoc) : "") navigationScroll=(e.name == "home" ? "home-scroll" : `${e.name}-scroll-${e.id}`) key=homeKey tabindex=-1 position="absolute" inset=0 background-color=(e.name == "title" and not activeDoc.detailFlat ? activeDoc.detailScrim : "transparent") backdrop-filter=(e.name == "title" and not activeDoc.detailFlat ? activeDoc.detailBlur : "none") animation=(e.name != "title" or activeDoc.detailFlat ? "none" : still ? "dissolve 200ms linear both" : "dissolve 420ms ease-out both")
            for slotProps in [ShellProps(skin=activeSkin, current=(docReady ? match first(currentDocManifest) { case some(m) => m, case none => skinManifest(activeSkin) } : skinManifest(activeSkin)), skins=(auth.authenticated and current(home) ? pickerSkins(home.skins).concat(docManifests) : []), viewer=(auth.authenticated and current(home) ? home.viewer : ""), viewport=shellViewport, canLive=(auth.authenticated and current(home) and home.liveAvailable), canLibrary=false, libraries=(auth.authenticated and current(home) and current(libraries) ? libraries : []), section=(libraryId == "" ? "home" : libraryId == "@live" ? "live" : libraryId), secureOrigin=(auth.authenticated and current(home) ? auth.secureOrigin : ""), secureBusy=secureBusy, secureError=secureError, servers=(current(servers) ? servers.servers : []), bare=(e.name != "home"))] key="shell"
              Shell(p=slotProps)
                // Home and the libraries side by side: the track pans to the active section.
                // The section track clips (never scrolls): a focus or scrollIntoView inside a row would
                // otherwise scroll this sideways and slide the whole page off its section.
                column flex=1 min-height=0 position="relative" z-index=0 overflow="clip"
                  row height="100%" translate=`${e.name == "home" ? sectionIndex * -100 : 0}% 0px` transition=(not traits.panSections or still ? "none" : "translate 640ms cubic-bezier(0.65, 0, 0.35, 1)")
                    // Home (or a route page), then its libraries and Live TV, or the signed-out page: one loop,
                    // one scroll per page, one route view.
                    for sid in (e.name != "home" ? ["home"] : signedOutPage ? ["auth"] : sectionIds) key=sid
                      if sid == "@live"
                        // Live TV: the guide owns its scrolling; it mounts on first visit and stays (inert) so it keeps its place.
                        column role="region" aria-label=t("ui.live") width="100%" height="100%" flex-shrink=0 min-height=0 inert=(libraryId != "@live") aria-hidden=(libraryId != "@live") opacity=(libraryId == "@live" or not still ? 1 : 0) transition=(not traits.panSections ? "none" : still ? "opacity 260ms linear" : "opacity 640ms cubic-bezier(0.65, 0, 0.35, 1)")
                          if libraryId == "@live" or liveVisited
                            if guideReady
                              for slotProps in [GuideProps(model=guide, small=small, still=still, zoom=guideZoom, tile=tile, focus=guideFocus)] key="guide"
                                Guide(p=slotProps)
                            else
                              if failed(guide)
                                text t("ui.theGuideCouldnTBeLoadedCheckYourConnection") role="status" padding=32 padding-top=(small ? 120 : 112)
                              else
                                text t("ui.loadingTheGuide") role="status" padding=32 padding-top=(small ? 120 : 112)
                      else
                        scroll id=(sid == "home" or sid == "auth" ? (e.name == "home" ? "home-scroll" : `page-${e.id}`) : `library-scroll-${sid}`) role=(sid == "home" and e.name != "home" ? "" : "region") aria-label=(sid == "home" or sid == "auth" ? (e.name == "home" ? t("ui.browseAndSearch") : "") : libraries.filter(l => l.id == sid).map(l => l.name).join("")) scroll=cancelPreviewOnScroll mask-image=(sid == "home" and e.name == "home" and traits.barMask ? (small ? "linear-gradient(180deg, transparent 0px, rgba(0, 0, 0, 0.2) 64px, black 118px)" : "linear-gradient(180deg, transparent 0px, rgba(0, 0, 0, 0.2) 48px, black 96px)") : "none") width="100%" height="100%" flex-shrink=0 inert=(sid == "auth" ? false : sid == "home" ? e.name == "home" and sectionIndex != 0 : sid != libraryId) aria-hidden=(sid == "auth" ? false : sid == "home" ? e.name == "home" and sectionIndex != 0 : sid != libraryId) opacity=((sid == "auth" or (sid == "home" ? e.name != "home" or sectionIndex == 0 : sid == libraryId)) or not still ? 1 : 0) transition=(not traits.panSections ? "none" : still ? "opacity 260ms linear" : "opacity 640ms cubic-bezier(0.65, 0, 0.35, 1)")
                          if sid == "home" and e.name == "home" and homeKnown
                            for slotProps in [HomeProps(model=homeSurface, active=(top(nav).name == "home" and sectionIndex == 0 and page.visibilityState == "visible"), query=query, small=homeSmall, still=still, heroIndex=heroAt, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading, cardPreview=cardPreview, libraries=(current(libraries) ? libraries : []), canLive=home.liveAvailable)] key="home"
                              Home(p=slotProps)
                                for slotProps in [SearchFieldProps(query=query)] key="searchField"
                                  SearchField(p=slotProps)
                          // The route view (one call site): home's tree, a route's, or a library page's, when the document draws it.
                          for shown in [(sid == "home" or sid == "auth" ? [] : [libraryModel].filter(m => m.id == sid).concat(librarySnapshots.filter(m => m.id == sid)).slice(0, 1))] key="shown"
                            if (sid == "home" and (e.name != "home" or homeKnown or activeDoc.drawsStatus) and docRoutes.includes(e.name)) or (sid == "auth" and docDrawsAuth) or (sid != "home" and sid != "auth" and docRoutes.includes("library"))
                              for routeProps in [RouteProps(route=(sid == "home" ? e.name : sid == "auth" ? "auth" : "library"), entry=(sid == "home" ? `${e.id}` : sid), load=(sid == "home" or sid == "auth" ? (e.name == "title" ? (failed(detail) ? "failed" : current(detail) ? "ready" : "loading") : e.name == "home" and not homeKnown ? (failed(home) ? "failed" : "loading") : "ready") : shown.length > 0 ? "ready" : sid == libraryId and failed(libraryModel) ? "failed" : "loading"), detail=(e.name == "title" and current(detail) ? [detailSurface] : []), season=detailSeason, small=(e.name == "home" ? homeSmall : small), tv=(viewport.width >= 1600), width=viewport.width, still=still, home=(e.name == "home" and homeKnown ? [homeSurface] : []), query=query, heroIndex=heroAt, rowMoreLoading=rowMoreLoading, homeMoreLoading=homeMoreLoading, libraries=(current(libraries) ? libraries : []), library=(sid == "home" ? [] : shown), libraryLoading=(sid != "home" and sid == libraryId and libraryLoading), libraryMoreLoading=(sid != "home" and sid == libraryId and libraryMoreLoading), authState=authState, authError=authError, authBusy=(pending(signedIn) or pending(quickStarted)), canPassword=(current(auth) and auth.passwordAvailable), canQuick=(current(auth) and auth.quickAvailable), quickCode=quickModel.code, quickExpires=quickModel.expiresLabel, quickError=quickError)] key="route"
                                DocRoute(p=routeProps)
                                  if sid == "home" and e.name == "home"
                                    for slotProps in [SearchFieldProps(query=query)] key="searchField"
                                      SearchField(p=slotProps)
                          if sid == "home" and e.name == "home" and homeKnown and query != ""
                            for slotProps in [SearchProps(query=query, model=results, descriptive=descriptive, ai=ai, generation=generation, loading=(searchTimeQuery != query or searchTimeGeneration != generation or pending(results) or (not failed(results) and (not current(results) or results.query != query or results.generation != generation))), error=(failed(results) and not pending(results) and searchTimeQuery == query and searchTimeGeneration == generation), aiAvailable=home.aiAvailable, descriptiveState=descriptiveState, descriptiveCanRetry=descriptiveCanRetry, aiState=aiState, small=homeSmall, still=still)] key="searchSurface"
                              SearchSurface(p=slotProps)
                          if sid == "home" and e.name == "home" and not homeKnown and not (activeDoc.drawsStatus and docRoutes.includes("home"))
                            if failed(home)
                              for slotProps in [StatusProps(kind="failure", message=t("ui.yourLibraryCouldnTBeReachedCheckYourServerConnection"), canRetry=true, small=homeSmall, still=still)] key="status"
                                Status(p=slotProps)
                            else
                              for slotProps in [StatusProps(kind="home", canRetry=false, message=t("ui.findingYourEvening"), small=homeSmall, still=still)] key="status"
                                Status(p=slotProps)
                          if sid == "auth" and not docDrawsAuth
                            for slotProps in [AuthStageProps(still=still, backdrop=packBackdrop, wordmark=packWordmark)] key="authStage"
                              AuthStage(p=slotProps)
                                if failed(auth)
                                  for slotProps in [AuthNoticeProps(kind="offline", still=still)] key="authNotice"
                                    AuthNotice(p=slotProps)
                                else
                                  if not current(auth)
                                    for slotProps in [AuthNoticeProps(kind=(webCode != "" ? "redeeming" : "connecting"), still=still)] key="authNotice"
                                      AuthNotice(p=slotProps)
                                  else
                                    // A signed-out Plex server links with a code; others take the sign-in below.
                                    if auth.serverKind == "plex"
                                      for slotProps in [ConnectProps(serverId=auth.serverId, servers=(current(servers) ? servers.servers : []), probe=probe, addedServerId=addedServerId, addServerError=addServerError, serverError=serverError, plexLink=plexLink, plexServers=(current(plexServers) ? plexServers : []), plexError=plexError, jellyQuick=jellyQuickModel, jellyQuickError=jellyQuickError, jellySignInError=jellySignInError, busy=(pending(serverAdded) or pending(serverChange) or pending(plexStarted) or pending(plexChoice) or pending(jellySignIn) or pending(jellyQuick)), canClose=false, small=small, still=still)] key="connect"
                                        Connect(p=slotProps)
                                    else if quickSecret != ""
                                      for slotProps in [QuickConnectProps(model=quickModel, error=quickError, still=still)] key="quickConnect"
                                        QuickConnect(p=slotProps)
                                    else
                                      for slotProps in [SignInProps(username=username, password=password, passwordAvailable=auth.passwordAvailable, quickAvailable=auth.quickAvailable, error=authError, busy=(pending(signedIn) or pending(quickStarted)), still=still, secureOrigin=auth.secureOrigin, secureBusy=secureBusy, secureError=secureError)] key="signIn"
                                        SignIn(p=slotProps)
                          if sid != "home" and sid != "auth" and not docRoutes.includes("library")
                            // One page per library: the live answer when it is this library's, else this
                            // session's last answer for it, so switching source never remounts the page.
                            for shown in [libraryModel].filter(m => m.id == sid).concat(librarySnapshots.filter(m => m.id == sid)).slice(0, 1) key=sid
                              for slotProps in [LibraryProps(model=shown, loading=(sid == libraryId and libraryLoading), moreLoading=(sid == libraryId and libraryMoreLoading), small=small, still=still)] key="library"
                                Library(p=slotProps)
                            if sid == libraryId and libraryModel.id != sid and librarySnapshots.filter(m => m.id == sid).length == 0
                              if failed(libraryModel)
                                for slotProps in [StatusProps(kind="failure", message=t("library.couldNotOpen"), canRetry=true, small=small, still=still)] key="status"
                                  Status(p=slotProps)
                              else
                                for slotProps in [StatusProps(kind="library", canRetry=false, message=t("ui.findingTitles"), small=small, still=still)] key="status"
                                  Status(p=slotProps)
                            // Panels not yet visited show their shape (still) so a long pan passes over content.
                            if sid != libraryId and libraryModel.id != sid and librarySnapshots.filter(m => m.id == sid).length == 0
                              for slotProps in [StatusProps(kind="library", canRetry=false, message=t("ui.findingTitles"), small=small, still=true)] key="status"
                                Status(p=slotProps)
        if e.name == "live"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color=pageColor
        if e.name == "title" and not docRoutes.includes("title")
          column navigationKey=`${e.id}` navigationBar="none" navigationPresentation=skinDetailPresentation(activeSkin, viewport.width, activeDoc) navigationScroll=`detail-scroll-${e.id}` position="absolute" inset=0 box-sizing="border-box" padding=(flatDetail or small ? "0px" : "4vh 4vw") background-color=(flatDetail ? pageColor : traits.detailScrim) backdrop-filter=(flatDetail ? "none" : "blur(18px) saturate(1.1)") animation=(flatDetail ? "none" : still ? "dissolve 200ms linear both" : "dissolve 420ms ease-out both") color=inkColor
            column position="relative" flex=1 min-height=0 overflow="hidden" border-radius=(flatDetail or small ? 0 : 28) background-color=pageColor box-shadow=(flatDetail or small ? "none" : traits.detailShadow) animation=(flatDetail ? "none" : still ? "dissolve 240ms linear both" : "open 680ms cubic-bezier(0.16, 1, 0.3, 1) both")
              button id="back" press=close aria-label=t("ui.closeTitle") testId="detail-close" position="absolute" top=20 right=20 z-index=10 box-sizing="border-box" width=44 height=44 border-style="solid" border-width=traits.closeBorderWidth border-color=traits.closeBorderColor border-radius=22 padding=13 background-color=traits.closeBackground backdrop-filter="blur(20px) saturate(1.3)" color=traits.closeInk
                image "symbol:close"
              scroll id=`detail-scroll-${e.id}` role="region" aria-label=t("ui.titleDetails") flex=1 min-height=0
                if failed(detail)
                  for slotProps in [StatusProps(kind="failure", message=t("ui.thisTitleCouldnTBeOpenedItMayNoLongerBeAvailable"), canRetry=true, small=small, still=still)] key="status"
                    Status(p=slotProps)
                else
                  if not current(detail)
                    for slotProps in [StatusProps(kind="detail", canRetry=false, message=t("ui.openingTitle"), small=small, still=still)] key="status"
                      Status(p=slotProps)
                  else
                    for slotProps in [DetailProps(model=detailSurface, themeMusic=themeMusicOn, small=small, still=still, season=detailSeason)] key="detail"
                      Detail(p=slotProps)
        if e.name == "collection"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color=pageColor color=inkColor
            scroll flex=1 min-height=0
              if failed(collection)
                for slotProps in [StatusProps(kind="failure", message=t("ui.thisCollectionCouldnTBeOpened"), canRetry=true, small=small, still=still)] key="status"
                  Status(p=slotProps)
              else
                if not current(collection) and activeCollectionPages <= 1
                  for slotProps in [StatusProps(kind="loading", canRetry=false, message=t("ui.openingCollection"), small=small, still=still)] key="status"
                    Status(p=slotProps)
                else
                  for slotProps in [CollectionProps(id=e.params.id, name=collection.name, items=collection.items, more=(current(collection) and collection.more), moreLoading=collectionMoreLoading, complete=collection.complete, small=small, still=still)] key="collection"
                    Collection(p=slotProps)
        // Connecting a server: adding one, or signing in to one the viewer chose.
        if e.name == "connect" or e.name == "connectServer"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" position="absolute" inset=0 background-color=pageColor color=inkColor
            scroll id=`connect-scroll-${e.id}` flex=1 min-height=0
              for slotProps in [AuthStageProps(still=still, backdrop=packBackdrop, wordmark=packWordmark)] key="authStage"
                AuthStage(p=slotProps)
                  for slotProps in [ConnectProps(serverId=(e.name == "connectServer" ? e.params.id : ""), servers=(current(servers) ? servers.servers : []), probe=probe, addedServerId=addedServerId, addServerError=addServerError, serverError=serverError, plexLink=plexLink, plexServers=(current(plexServers) ? plexServers : []), plexError=plexError, jellyQuick=jellyQuickModel, jellyQuickError=jellyQuickError, jellySignInError=jellySignInError, busy=(pending(serverAdded) or pending(serverChange) or pending(plexStarted) or pending(plexChoice) or pending(jellySignIn) or pending(jellyQuick)), canClose=true, small=small, still=still)] key=`connect-${e.id}`
                    Connect(p=slotProps)
        if e.name == "library"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color=pageColor
        if e.name == "watch" or e.name == "extra" or e.name == "liveWatch"
          column navigationKey=`${e.id}` navigationPresentation="fullscreen" id="watch-stage" testId="watch-stage" key=stageKey pointermove=touchWatch pointerdown=touchWatch position="absolute" inset=0 background-color="media.ground" color="ink.primary" tabindex=0
            // The chrome stands from the moment Play is pressed (a loading view until the session
            // and its plan exist, however long the server prepares), so its spinner runs on
            // without a swap; the picture joins beneath it.
            if current(playback) and watchPlan != "" and mediaReady
              vela-player plan=(watchModel.planJson != "" ? watchModel.planJson : currentPlan) mediaAuth=mediaAuthJson nativeMedia=watchNativeMedia playerCommand=watchCommandJson serverError=watchReply.error message=liveWatchMessage position="absolute" inset=0 width="100%" height="100%" z-index=0
            // The chrome is its own layer above the picture: whatever the engine composites
            // (a video element or a GPU canvas) stays under it, and pointer events bubble to the stage.
            column position="absolute" inset=0 z-index=1
              for slotProps in [PlayerProps(model=watchView, title=(e.name == "liveWatch" ? (current(liveIdentity) ? liveIdentity.title : t("ui.liveTelevisionTitle")) : watchTitle), busy=(pending(watchAuthorized) or not current(playback) or watchPlan == ""), visible=watchChromeVisible, small=small, still=still, serverError=watchReply.error, info=watchInfo)] key="playerChrome"
                PlayerChrome(p=slotProps)
            if current(playback)
              if e.name == "liveWatch"
                column position="absolute" top=88 right=(small ? 12 : 36) z-index=2 max-width=(small ? "calc(100% - 24px)" : "none") opacity=(liveControlsVisible ? 1 : 0) pointer-events=(liveControlsVisible ? "auto" : "none") inert=(not liveControlsVisible) transition=(still ? "none" : "opacity 180ms ease")
                  for slotProps in [LiveControlsProps(reconnecting=(liveView.sessionId == playback.sessionId and liveView.reconnecting), delivery=(liveView.sessionId == playback.sessionId ? liveView.delivery : "unknown"), drift=(liveView.sessionId == playback.sessionId ? liveView.drift : -1), driftLabel=(liveView.sessionId == playback.sessionId ? liveView.driftLabel : ""), canCatchUp=(liveView.sessionId == playback.sessionId and liveView.canCatchUp))] key="liveControls"
                    LiveControls(p=slotProps)
                if zapTarget != "" and guide.channels.length > 0
                  column position="absolute" left=(small ? 16 : 40) top="50%" translate="0px -50%" z-index=3
                    for slotProps in [MiniGuideProps(model=guide, playing=playingId, target=zapTarget, small=small, still=still)] key="miniGuide"
                      MiniGuide(p=slotProps)
      // The show's theme, while its title page is the visible screen (foundation/theme.contract).
      if themePlaying
        audio themeUrl autoplay=true volume=themeVolume width=0 height=0 aria-hidden=true
      // The launch splash, over everything while boot and sign-in are pending; it leaves as the first screen is ready.
      if launching
        VelaSplash(still=still, ground=pageColor, paper=splashOnPaper, label=t("ui.connectingToYourLibrary"))
      // A new appearance dissolves in from its own ground instead of swapping hard.
      for n in [skinSwitches].filter(k => k > 0) key=`veil-${n}`
        column position="absolute" inset=0 z-index=500 pointer-events="none" aria-hidden=true background-color=pageColor animation=(still ? "vanish 260ms linear both" : "vanish 760ms cubic-bezier(0.65, 0, 0.35, 1) 60ms both")
