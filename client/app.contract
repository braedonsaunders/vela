use PlayerChrome from "./skins/cinematic/player.contract"
use Card, FeedRow, HomeModel, SearchModel, DetailModel, ReceiptReply, Viewport, PlaybackModel from "./foundation/models.contract"
use SignIn, QuickConnect from "./skins/cinematic/slots.contract"
use Shell, Home, SearchSurface, Detail, SearchField, Row, skinDetailPresentation, skinDetailSplit from "./foundation/skin.contract"

routes nav
  home "/"
    title "/title/:id"
    watch "/watch/:id"
    extra "/watch/extra/:id"
    collection "/collection/:id"
    live "/live"
    liveWatch "/live/:id"

component Client
  members "./foundation/behavior.contract"

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color="surface.page" color="ink.primary" color-scheme="dark"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationSplit=skinDetailSplit(activeSkin, viewport.width) navigationScroll="home-scroll" position="absolute" inset=0
            Shell(viewer=home.viewer, skin=activeSkin, skins=home.skins, chooseSkin=chooseSkin, signOut=logout, viewport=viewport, canLive=home.liveAvailable, canLibrary=false, home=goHome, search=openSearch, live=openLive, library=goHome)
              scroll id="home-scroll" flex=1 min-height=0
                if failed(auth)
                  text "Your server could not be reached. Reopen Vela when the connection is restored." padding=32 role="status"
                else
                  if not current(auth)
                    text "Connecting to your library…" padding=32 role="status"
                  else
                    if not auth.authenticated
                      if quickSecret != ""
                        QuickConnect(model=quickModel, error=quickError, cancel=cancelCode)
                      else
                        SignIn(username=username, password=password, passwordAvailable=auth.passwordAvailable, quickAvailable=auth.quickAvailable, error=authError, busy=(pending(signedIn) or pending(quickStarted)), editUsername=editUsername, editPassword=editPassword, submit=submitSignIn, quick=startCode)
                    else
                      if failed(home)
                        text "Your library couldn't be reached. Check your server connection." padding=32 role="status"
                      else
                        if not current(home)
                          text "Finding your evening…" padding=32 role="status"
                        else
                          Home(skin=activeSkin, model=home, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe)
                            SearchField(skin=activeSkin, query=query, edit=edit)
                          if query != ""
                                button press=edit("") aria-label="Clear search" border="none" background-color="transparent" color="ink.secondary" padding=8
                                  image "symbol:close"
                          if query != ""
                            SearchSurface(skin=activeSkin, query=query, model=results, descriptive=descriptive, ai=ai, generation=generation, loading=(not current(results) or results.query != query or results.generation != generation), error=failed(results), aiAvailable=home.aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
        if e.name == "title"
          column navigationKey=`${e.id}` navigationBar="none" navigationPresentation=skinDetailPresentation(activeSkin, viewport.width) navigationScroll=`detail-scroll-${e.id}` position="absolute" inset=0 background-color="surface.page" color="ink.primary"
            row padding="16px 5%" align-items="center"
              button id="back" press=close aria-label="Back to browsing" border="none" border-radius=24 padding="10px 16px" background-color="surface.raised" color="ink.primary"
                text "Back"
              text "vela" flex=1 text-align="center" color="ink.secondary" font-size=22
            scroll id=`detail-scroll-${e.id}` flex=1 min-height=0
              if failed(detail)
                text "This title couldn't be opened. It may no longer be available." padding=32 role="status"
              else
                if not current(detail)
                  text "Opening title…" padding=32 role="status"
                else
                  Detail(skin=activeSkin, model=detail, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
        if e.name == "collection"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color="surface.page" color="ink.primary"
            button press=close aria-label="Back" padding=16
              text "Back"
            scroll flex=1 min-height=0
              if failed(collection)
                text "This collection couldn't be opened." padding=24 role="status"
              else
                if not current(collection)
                  text "Opening collection…" padding=24 role="status"
                else
                  Row(skin=activeSkin, row=FeedRow(id=e.params.id, name=collection.name, receipt="", items=collection.items), small=small, still=still, selectTitle=selectTitle, observe=observe)
        if e.name == "watch" or e.name == "extra"
          column navigationKey=`${e.id}` position="absolute" inset=0 background-color="surface.page"
            button id="back" press=close aria-label="Close player" padding=16
              text "Back"
            if failed(playback)
              text "Playback couldn't be started." role="status" padding=24
            else
              if not current(playback)
                text "Preparing playback…" role="status" padding=24
              else
                column flex=1 min-height=0 position="relative"
                  vela-player plan=currentPlan playerCommand=commandJson message=playerMessage flex=1 min-height=240
                  PlayerChrome(titleId=e.params.id, command=playerCommand)
