component Client
  state query = ""
  action edit(v: string)
    query = v
  view
    main testId="root" width="100%" height="100%" background-color="#0a0a0c" display="flex" align-items="center" justify-content="center"
      column width=480 max-width="90%" gap=24 align-items="center"
        text "Vela" color="#ffffff" font-size=32
        input value=query input=edit placeholder="Search" aria-label="Search" width="100%" border-radius=24 padding=16 background-color="#222226" color="#ffffff"
