use Card, FeedRow, HomeModel, SearchModel, DetailModel, Viewport from "./models.contract"
use Shell as CineShell, Home as CineHome, SearchSurface as CineSearchSurface, Row as CineRow, Detail as CineDetail, SearchField as CineSearchField, detailPresentation as CinePresentation, detailSplit as CineSplit from "../skins/cinematic/slots.contract"
use Shell as IndexShell, Home as IndexHome, SearchSurface as IndexSearchSurface, Row as IndexRow, Detail as IndexDetail, SearchField as IndexSearchField, detailPresentation as IndexPresentation, detailSplit as IndexSplit from "../skins/index/slots.contract"

fn skinDetailPresentation(skin: string, width: number): string = (skin == "index" or skin == "editorial" ? IndexPresentation(width) : CinePresentation(width))
fn skinDetailSplit(skin: string, width: number): string = (skin == "index" or skin == "editorial" ? IndexSplit(width) : CineSplit(width))

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
    viewport: Viewport
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
  slot
  view
    if skin == "index" or skin == "editorial"
      IndexShell(skin=skin, viewer=viewer, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library)
        children
    else
      CineShell(skin=skin, viewer=viewer, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library)
        children

component Home
  props
    skin: string
    model: HomeModel
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
  slot
  view
    if skin == "index" or skin == "editorial"
      IndexHome(model=model, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe)
        children
    else
      CineHome(model=model, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe)
        children

component SearchSurface
  props
    skin: string
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    if skin == "index" or skin == "editorial"
      IndexSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
    else
      CineSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Row
  props
    skin: string
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    if skin == "index" or skin == "editorial"
      IndexRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
    else
      CineRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Detail
  props
    skin: string
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
  view
    if skin == "index" or skin == "editorial"
      IndexDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
    else
      CineDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)

component SearchField
  props
    skin: string
    query: string
    edit: action
  view
    if skin == "index" or skin == "editorial"
      IndexSearchField(query=query, edit=edit)
    else
      CineSearchField(query=query, edit=edit)
