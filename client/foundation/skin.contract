use Shell as DocShell, Home as DocHome, detailPresentation as DocPresentation from "../skins/doc/slots.contract"
use SkinDoc from "../renderer/levels.contract"
use Shell as ExampleShell, Home as ExampleHome, SearchSurface as ExampleSearchSurface, Row as ExampleRow, Detail as ExampleDetail, SearchField as ExampleSearchField, PlayerChrome as ExamplePlayerChrome, Guide as ExampleGuide, LiveControls as ExampleLiveControls, detailPresentation as ExamplePresentation, detailSplit as ExampleSplit from "../skins/example/slots.contract"
use PlayerView from "./player-models.contract"
use PlayerChrome as CinePlayerChrome from "../skins/cinematic/player.contract"
use PlayerChrome as IndexPlayerChrome from "../skins/index/player.contract"
use GuideModel, LiveTile, GuideFocus from "../live/models.contract"
use Guide as CineGuide from "../skins/cinematic/guide.contract"
use LiveControls as CineLiveControls, MiniGuide as CineMiniGuide from "../skins/cinematic/live.contract"
use Guide as IndexGuide from "../skins/index/guide.contract"
use LiveControls as IndexLiveControls from "../skins/index/live.contract"
use Card, FeedRow, HomeModel, SearchModel, DetailModel, Viewport, LibraryNav, LibraryModel, QuickModel, CardPreview from "./models.contract"
use Status as CineStatus, Shell as CineShell, Home as CineHome, SearchSurface as CineSearchSurface, Row as CineRow, SearchField as CineSearchField, detailPresentation as CinePresentation, detailSplit as CineSplit from "../skins/cinematic/slots.contract"
use Detail as CineDetail from "../skins/cinematic/detail.contract"
use BrowsePage as CineBrowsePage from "../skins/cinematic/browse.contract"
use Library as CineLibrary from "../skins/cinematic/library.contract"
use Shell as JellyShell, Home as JellyHome, SearchSurface as JellySearchSurface, Row as JellyRow, SearchField as JellySearchField, Status as JellyStatus, Collection as JellyCollection, detailPresentation as JellyPresentation, detailSplit as JellySplit from "../skins/jellytwin/slots.contract"
use Library as JellyLibrary from "../skins/jellytwin/library.contract"
use Detail as JellyDetail from "../skins/jellytwin/detail.contract"
use PlayerChrome as JellyPlayerChrome from "../skins/jellytwin/player.contract"
use Guide as JellyGuide from "../skins/jellytwin/guide.contract"
use LiveControls as JellyLiveControls from "../skins/jellytwin/live.contract"
use AuthStage as JellyAuthStage, AuthNotice as JellyAuthNotice, SignIn as JellySignIn, QuickConnect as JellyQuickConnect from "../skins/jellytwin/auth.contract"
use Shell as IndexShell, Home as IndexHome, SearchSurface as IndexSearchSurface, Row as IndexRow, Detail as IndexDetail, SearchField as IndexSearchField, detailPresentation as IndexPresentation, detailSplit as IndexSplit from "../skins/index/slots.contract"
use Shell as MochiShell, Home as MochiHome, SearchSurface as MochiSearchSurface, Row as MochiRow, SearchField as MochiSearchField, Status as MochiStatus, detailPresentation as MochiPresentation, detailSplit as MochiSplit from "../skins/mochi/slots.contract"
use Detail as MochiDetail from "../skins/mochi/detail.contract"
use Library as MochiLibrary, Collection as MochiCollection from "../skins/mochi/library.contract"
use PlayerChrome as MochiPlayerChrome from "../skins/mochi/player.contract"
use Guide as MochiGuide from "../skins/mochi/guide.contract"
use LiveControls as MochiLiveControls, MiniGuide as MochiMiniGuide from "../skins/mochi/live.contract"
use AuthStage as MochiAuthStage, AuthNotice as MochiAuthNotice, SignIn as MochiSignIn, QuickConnect as MochiQuickConnect from "../skins/mochi/auth.contract"
use AuthStage as CineAuthStage, AuthNotice as CineAuthNotice, SignIn as CineSignIn, QuickConnect as CineQuickConnect from "../skins/cinematic/auth.contract"
use Shell as MarqueeShell, Home as MarqueeHome, SearchSurface as MarqueeSearchSurface, Row as MarqueeRow, SearchField as MarqueeSearchField, Status as MarqueeStatus, detailPresentation as MarqueePresentation, detailSplit as MarqueeSplit from "../skins/marquee/slots.contract"
use Detail as MarqueeDetail from "../skins/marquee/detail.contract"
use Library as MarqueeLibrary, CollectionPage as MarqueeCollection from "../skins/marquee/library.contract"
use PlayerChrome as MarqueePlayerChrome from "../skins/marquee/player.contract"
use Guide as MarqueeGuide from "../skins/marquee/guide.contract"
use LiveControls as MarqueeLiveControls, MiniGuide as MarqueeMiniGuide from "../skins/marquee/live.contract"
use AuthStage as MarqueeAuthStage, AuthNotice as MarqueeAuthNotice, SignIn as MarqueeSignIn, QuickConnect as MarqueeQuickConnect from "../skins/marquee/auth.contract"

fn skinDetailPresentation(skin: string, width: number, doc: SkinDoc): string = (skin == "doc" ? DocPresentation(doc, width) : skin == "mochi" ? MochiPresentation(width) : skin == "example" ? ExamplePresentation(width) : skin == "index" or skin == "editorial" ? IndexPresentation(width) : skin == "jellytwin" ? JellyPresentation(width) : skin == "marquee" ? MarqueePresentation(width) : CinePresentation(width))
fn skinDetailSplit(skin: string, width: number): string = (skin == "mochi" ? MochiSplit(width) : skin == "example" ? ExampleSplit(width) : skin == "index" or skin == "editorial" ? IndexSplit(width) : skin == "jellytwin" ? JellySplit(width) : skin == "marquee" ? MarqueeSplit(width) : CineSplit(width))

component Shell
  props
    viewer: string
    skin: string
    skins: string[]
    chooseSkin: action
    signOut: action
    viewport: Viewport
    canLive: bool
    canLibrary: bool
    home: action
    search: action
    live: action
    library: action
    libraries: LibraryNav[]
    section: string
    openLibrary: action
    secureOrigin: string
    secureBusy: bool
    secureError: string
    goSecure: action
    beta: bool
    toggleBeta: action
    doc: SkinDoc
  slot
  view
    if skin == "doc"
      DocShell(doc=doc, viewer=viewer, skin=skin, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, home=home, search=search, live=live, libraries=libraries, section=section, openLibrary=openLibrary)
        children
    else
      if skin == "mochi"
        MochiShell(viewer=viewer, skin=skin, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library, libraries=libraries, section=section, openLibrary=openLibrary)
          children
      else
        if skin == "example"
          ExampleShell(viewer=viewer, skin=skin, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library, libraries=libraries, section=section, openLibrary=openLibrary)
            children
        else
          if skin == "index" or skin == "editorial"
            IndexShell(skin=skin, viewer=viewer, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library, libraries=libraries, section=section, openLibrary=openLibrary)
              children
          else
            if skin == "jellytwin"
              JellyShell(viewer=viewer, skin=skin, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library, libraries=libraries, section=section, openLibrary=openLibrary)
                children
            else if skin == "marquee"
              MarqueeShell(skin=skin, viewer=viewer, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library, libraries=libraries, section=section, openLibrary=openLibrary)
                children
            else
              CineShell(skin=skin, viewer=viewer, skins=skins, chooseSkin=chooseSkin, signOut=signOut, viewport=viewport, canLive=canLive, canLibrary=canLibrary, home=home, search=search, live=live, library=library, libraries=libraries, section=section, openLibrary=openLibrary, secureOrigin=secureOrigin, secureBusy=secureBusy, secureError=secureError, goSecure=goSecure, beta=beta, toggleBeta=toggleBeta)
                children

component Home
  props
    skin: string
    model: HomeModel
    active: bool
    query: string
    small: bool
    still: bool
    selectTitle: action
    observe: action
    heroIndex: number
    pickHero: action
    reachEnd: action
    reachRowEnd: action
    homeMoreLoading: bool
    rowMoreLoading: string[]
    libraries: LibraryNav[]
    openLibrary: action
    live: action
    canLive: bool
    cardPreview: CardPreview
    previewIntent: action
    playHero: action
    doc: SkinDoc
  slot
  view
    if skin == "doc"
      DocHome(doc=doc, model=model, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, playHero=playHero)
        children
    else
      if skin == "mochi"
        MochiHome(model=model, active=active, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, reachEnd=reachEnd, reachRowEnd=reachRowEnd, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading)
          children
      else
        if skin == "example"
          ExampleHome(model=model, active=active, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, reachEnd=reachEnd, reachRowEnd=reachRowEnd, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading)
            children
        else
          if skin == "index" or skin == "editorial"
            IndexHome(model=model, active=active, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, reachEnd=reachEnd, reachRowEnd=reachRowEnd, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading)
              children
          else
            if skin == "jellytwin"
              JellyHome(model=model, active=active, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, reachEnd=reachEnd, reachRowEnd=reachRowEnd, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading, libraries=libraries, openLibrary=openLibrary, live=live, canLive=canLive)
                children
            else if skin == "marquee"
              MarqueeHome(model=model, active=active, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, reachEnd=reachEnd, reachRowEnd=reachRowEnd, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading, playHero=playHero, cardPreview=cardPreview, previewIntent=previewIntent)
                children
            else
              CineHome(model=model, active=active, query=query, small=small, still=still, selectTitle=selectTitle, observe=observe, heroIndex=heroIndex, pickHero=pickHero, reachEnd=reachEnd, reachRowEnd=reachRowEnd, homeMoreLoading=homeMoreLoading, rowMoreLoading=rowMoreLoading, cardPreview=cardPreview, previewIntent=previewIntent, playHero=playHero)
                children

component SearchSurface
  props
    skin: string
    query: string
    model: SearchModel
    descriptive: SearchModel
    ai: SearchModel
    generation: number
    loading: bool
    error: bool
    aiAvailable: bool
    descriptiveState: string
    aiState: string
    openLiveProgramme: action
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    if skin == "mochi"
      MochiSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
    else
      if skin == "example"
        ExampleSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
      else
        if skin == "index" or skin == "editorial"
          IndexSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
        else
          if skin == "jellytwin"
            JellySearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
          else if skin == "marquee"
            MarqueeSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, small=small, still=still, selectTitle=selectTitle, observe=observe)
          else
            CineSearchSurface(query=query, model=model, descriptive=descriptive, ai=ai, generation=generation, loading=loading, error=error, aiAvailable=aiAvailable, descriptiveState=descriptiveState, aiState=aiState, openLiveProgramme=openLiveProgramme, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Row
  props
    skin: string
    row: FeedRow
    small: bool
    still: bool
    selectTitle: action
    observe: action
  view
    if skin == "mochi"
      MochiRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
    else
      if skin == "example"
        ExampleRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
      else
        if skin == "index" or skin == "editorial"
          IndexRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
        else
          if skin == "jellytwin"
            JellyRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
          else if skin == "marquee"
            MarqueeRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)
          else
            CineRow(row=row, small=small, still=still, selectTitle=selectTitle, observe=observe)

component Detail
  props
    skin: string
    model: DetailModel
    small: bool
    still: bool
    play: action
    playExtra: action
    selectTitle: action
    observe: action
    // The visit's ?season= (empty: the title's default season); tabs highlight this.
    season: string
  view
    if skin == "mochi"
      MochiDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
    else
      if skin == "example"
        ExampleDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
      else
        if skin == "index" or skin == "editorial"
          IndexDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
        else
          if skin == "jellytwin"
            JellyDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
          else if skin == "marquee"
            MarqueeDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe)
          else
            CineDetail(model=model, small=small, still=still, play=play, playExtra=playExtra, selectTitle=selectTitle, observe=observe, season=season)

component SearchField
  props
    skin: string
    query: string
    edit: action
  view
    if skin == "mochi"
      MochiSearchField(query=query, edit=edit)
    else
      if skin == "example"
        ExampleSearchField(query=query, edit=edit)
      else
        if skin == "index" or skin == "editorial"
          IndexSearchField(query=query, edit=edit)
        else
          if skin == "jellytwin"
            JellySearchField(query=query, edit=edit)
          else if skin == "marquee"
            MarqueeSearchField(query=query, edit=edit)
          else
            CineSearchField(query=query, edit=edit)

// Index and example scroll the route; cinematic owns its own scroll containers inside a fixed page.
component Guide
  props
    skin: string
    model: GuideModel
    small: bool
    still: bool
    zoom: number
    tile: LiveTile
    focus: GuideFocus
    watch: action
    previous: action
    next: action
    chooseDay: action
    setZoom: action
    tileMessage: action
    tileUnmute: action
    tileTuneIn: action
    retune: action
  view
    if skin == "mochi"
      column flex=1 min-height=0
        MochiGuide(model=model, small=small, still=still, zoom=zoom, tile=tile, watch=watch, chooseDay=chooseDay, setZoom=setZoom, tileMessage=tileMessage, tileUnmute=tileUnmute, tileTuneIn=tileTuneIn, retune=retune)
    else
      if skin == "example"
        scroll flex=1 min-height=0
          ExampleGuide(model=model, small=small, watch=watch, previous=previous, next=next)
      else
        if skin == "index" or skin == "editorial"
          scroll flex=1 min-height=0
            IndexGuide(model=model, small=small, watch=watch, previous=previous, next=next)
        else
          if skin == "jellytwin"
            column flex=1 min-height=0
              JellyGuide(model=model, small=small, still=still, tile=tile, watch=watch, chooseDay=chooseDay, tileMessage=tileMessage, tileUnmute=tileUnmute, tileTuneIn=tileTuneIn, retune=retune)
          else if skin == "marquee"
            column flex=1 min-height=0
              MarqueeGuide(model=model, small=small, still=still, tile=tile, watch=watch, chooseDay=chooseDay, tileMessage=tileMessage, tileUnmute=tileUnmute, tileTuneIn=tileTuneIn, retune=retune)
          else
            column flex=1 min-height=0
              CineGuide(model=model, small=small, still=still, zoom=zoom, tile=tile, focus=focus, watch=watch, chooseDay=chooseDay, setZoom=setZoom, tileMessage=tileMessage, tileUnmute=tileUnmute, tileTuneIn=tileTuneIn, retune=retune)

component LiveControls
  props
    skin: string
    lowDelay: bool
    reconnecting: bool
    delivery: string
    drift: number
    driftLabel: string
    canCatchUp: bool
    toggleLowDelay: action
    catchUp: action
    zap: action
  view
    if skin == "mochi"
      MochiLiveControls(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp, zap=zap)
    else
      if skin == "example"
        ExampleLiveControls(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp)
      else
        if skin == "index" or skin == "editorial"
          IndexLiveControls(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp)
        else
          if skin == "jellytwin"
            JellyLiveControls(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp, zap=zap)
          else if skin == "marquee"
            MarqueeLiveControls(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp, zap=zap)
          else
            CineLiveControls(lowDelay=lowDelay, reconnecting=reconnecting, delivery=delivery, drift=drift, driftLabel=driftLabel, canCatchUp=canCatchUp, toggleLowDelay=toggleLowDelay, catchUp=catchUp, zap=zap)

// Channel flicking works in every skin; skins without a mini guide show none.
component MiniGuide
  props
    skin: string
    model: GuideModel
    playing: string
    target: string
    small: bool
    still: bool
    tune: action
  view
    if skin == "mochi"
      MochiMiniGuide(model=model, playing=playing, target=target, small=small, still=still, tune=tune)
    else
      if skin == "marquee"
        MarqueeMiniGuide(model=model, playing=playing, target=target, small=small, still=still, tune=tune)
      else if skin != "example" and skin != "index" and skin != "editorial" and skin != "jellytwin"
        CineMiniGuide(model=model, playing=playing, target=target, small=small, still=still, tune=tune)

component PlayerChrome
  props
    skin: string
    model: PlayerView
    title: string
    visible: bool
    small: bool
    still: bool
    busy: bool
    serverError: string
    command: action
    seek: action
    editing: action
    close: action
    beta: bool
    toggleBeta: action
  view
    if skin == "mochi"
      MochiPlayerChrome(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close)
    else
      if skin == "example"
        ExamplePlayerChrome(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close)
      else
        if skin == "index" or skin == "editorial"
          IndexPlayerChrome(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close)
        else
          if skin == "jellytwin"
            JellyPlayerChrome(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close)
          else if skin == "marquee"
            MarqueePlayerChrome(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close)
          else
            CinePlayerChrome(model=model, title=title, visible=visible, small=small, still=still, busy=busy, serverError=serverError, command=command, seek=seek, editing=editing, close=close, beta=beta, toggleBeta=toggleBeta)

// Loading and failure moments. Cinematic draws skeletons and designed failures;
// other skins keep a plain status line.
component Status
  props
    skin: string
    kind: string
    message: string
    small: bool
    still: bool
  view
    if skin == "mochi"
      MochiStatus(kind=kind, message=message, small=small, still=still)
    else
      if skin == "index" or skin == "editorial" or skin == "example"
        text message padding=32 role="status"
      else
        if skin == "jellytwin"
          JellyStatus(kind=kind, message=message, small=small, still=still)
        else if skin == "marquee"
          MarqueeStatus(kind=kind, message=message, small=small, still=still)
        else
          CineStatus(kind=kind, message=message, small=small, still=still)

// A collection's titles in server order. Cinematic draws a browse page with a grid;
// other skins keep a back button over their own row.
component Collection
  props
    skin: string
    id: string
    name: string
    items: Card[]
    small: bool
    still: bool
    close: action
    selectTitle: action
    observe: action
  view
    if skin == "mochi"
      MochiCollection(id=id, name=name, items=items, small=small, still=still, close=close, selectTitle=selectTitle, observe=observe)
    else
      if skin == "index" or skin == "editorial" or skin == "example"
        column
          button press=close aria-label=t("ui.back") padding=16
            text t("ui.back")
          Row(skin=skin, row=FeedRow(id=id, name=name, receipt="", items=items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=small, still=still, selectTitle=selectTitle, observe=observe)
      else
        if skin == "jellytwin"
          JellyCollection(name=name, items=items, small=small, still=still, close=close, selectTitle=selectTitle, observe=observe)
        else if skin == "marquee"
          MarqueeCollection(name=name, items=items, small=small, still=still, close=close, selectTitle=selectTitle, observe=observe)
        else
          CineBrowsePage(eyebrow=t("library.collection"), name=name, items=items, small=small, still=still, close=close, selectTitle=selectTitle, observe=observe)

// A library's titles with the server's sort and filter choices. Cinematic draws the
// browse page; other skins list the titles in a row with a way to load more.
component Library
  props
    skin: string
    model: LibraryModel
    loading: bool
    moreLoading: bool
    small: bool
    still: bool
    close: action
    setSort: action
    setFilter: action
    more: action
    selectTitle: action
    observe: action
  view
    if skin == "mochi"
      MochiLibrary(model=model, loading=loading, moreLoading=moreLoading, small=small, still=still, close=close, setSort=setSort, setFilter=setFilter, more=more, selectTitle=selectTitle, observe=observe)
    else
      if skin == "index" or skin == "editorial" or skin == "example"
        column
          button press=close aria-label=t("ui.back") padding=16
            text t("ui.back")
          Row(skin=skin, row=FeedRow(id=model.id, name=model.name, receipt="", items=model.items, nextCursor="", continuation="exhausted", previewOnFocus=false, presentation=""), small=small, still=still, selectTitle=selectTitle, observe=observe)
          if model.more
            button press=more() disabled=moreLoading padding=16
              text t("library.loadMore")
      else
        if skin == "jellytwin"
          JellyLibrary(model=model, loading=loading, moreLoading=moreLoading, small=small, still=still, close=close, setSort=setSort, setFilter=setFilter, more=more, selectTitle=selectTitle, observe=observe)
        else if skin == "marquee"
          MarqueeLibrary(model=model, loading=loading, moreLoading=moreLoading, small=small, still=still, close=close, setSort=setSort, setFilter=setFilter, more=more, selectTitle=selectTitle, observe=observe)
        else
          CineLibrary(model=model, loading=loading, moreLoading=moreLoading, small=small, still=still, close=close, setSort=setSort, setFilter=setFilter, more=more, selectTitle=selectTitle, observe=observe)

// Signed-out moments. Mochi draws its own; every other skin uses Cinematic's.
component AuthStage
  props
    skin: string
    still: bool
    backdrop: string
    wordmark: string
  slot
  view
    if skin == "mochi"
      MochiAuthStage(still=still)
        children
    else
      if skin == "jellytwin"
        JellyAuthStage(still=still)
          children
      else if skin == "marquee"
        MarqueeAuthStage(still=still)
          children
      else
        CineAuthStage(still=still, backdrop=backdrop, wordmark=wordmark)
          children

component AuthNotice
  props
    skin: string
    kind: string
    still: bool
  view
    if skin == "mochi"
      MochiAuthNotice(kind=kind, still=still)
    else
      if skin == "jellytwin"
        JellyAuthNotice(kind=kind, still=still)
      else if skin == "marquee"
        MarqueeAuthNotice(kind=kind, still=still)
      else
        CineAuthNotice(kind=kind, still=still)

component SignIn
  props
    skin: string
    username: string
    password: string
    passwordAvailable: bool
    quickAvailable: bool
    error: string
    busy: bool
    still: bool
    editUsername: action
    editPassword: action
    submit: action
    quick: action
    secureOrigin: string
    secureBusy: bool
    secureError: string
    goSecure: action
  view
    if skin == "mochi"
      MochiSignIn(username=username, password=password, passwordAvailable=passwordAvailable, quickAvailable=quickAvailable, error=error, busy=busy, still=still, editUsername=editUsername, editPassword=editPassword, submit=submit, quick=quick)
    else
      if skin == "jellytwin"
        JellySignIn(username=username, password=password, passwordAvailable=passwordAvailable, quickAvailable=quickAvailable, error=error, busy=busy, still=still, editUsername=editUsername, editPassword=editPassword, submit=submit, quick=quick)
      else if skin == "marquee"
        MarqueeSignIn(username=username, password=password, passwordAvailable=passwordAvailable, quickAvailable=quickAvailable, error=error, busy=busy, still=still, editUsername=editUsername, editPassword=editPassword, submit=submit, quick=quick)
      else
        CineSignIn(username=username, password=password, passwordAvailable=passwordAvailable, quickAvailable=quickAvailable, error=error, busy=busy, still=still, editUsername=editUsername, editPassword=editPassword, submit=submit, quick=quick, secureOrigin=secureOrigin, secureBusy=secureBusy, secureError=secureError, goSecure=goSecure)

component QuickConnect
  props
    skin: string
    model: QuickModel
    error: string
    still: bool
    cancel: action
  view
    if skin == "mochi"
      MochiQuickConnect(model=model, error=error, still=still, cancel=cancel)
    else
      if skin == "jellytwin"
        JellyQuickConnect(model=model, error=error, still=still, cancel=cancel)
      else if skin == "marquee"
        MarqueeQuickConnect(model=model, error=error, still=still, cancel=cancel)
      else
        CineQuickConnect(model=model, error=error, still=still, cancel=cancel)
