// Total presentation records projected from protocol/v0/types.ts. Empty artwork means absent.
shape Card
  id: string
  kind: string
  name: string
  summary: string
  facts: string
  yearLabel: string
  durationLabel: string
  progressLabel: string
  seasonNumberLabel: string
  episodeNumberLabel: string
  year: number
  rating: string
  seasonId: string
  seasonNumber: number
  episodeNumber: number
  played: bool
  progressSeconds: number
  durationSeconds: number
  genres: string[]
  poster: string
  backdrop: string
  logo: string
  accent: string
  receipt: string

shape FeedRow
  id: string
  name: string
  receipt: string
  items: Card[]
  nextCursor: string
  continuation: string
  previewOnFocus: bool
  presentation: string

shape CardPreview
  cardId: string
  url: string
  expiresAt: number
  retryAfterSeconds: number
  generation: number

// A cached, same-origin, unexpired preview grant for one featured title.
shape HeroPreview
  id: string
  url: string
  expiresAt: number

shape HeroAction
  heroId: string
  reason: string
  reasonLabel: string
  action: string
  targetId: string
  targetKind: string
  hasPosition: bool
  positionSeconds: number
  actionLabel: string
  actionDetail: string
  progress: number

shape HomeRetryPolicy
  at: number
  attempt: number
  allowed: bool
  delaySeconds: number
  retryLimit: number

shape HomeModel
  viewer: string
  defaultSkinId: string
  skins: string[]
  hero: Card[]
  heroActions: HeroAction[]
  heroPreviewIds: string[]
  previews: HeroPreview[]
  rows: FeedRow[]
  nextCursor: string
  liveAvailable: bool
  aiAvailable: bool
  descriptiveAvailable: bool
  trailerPreviewAvailable: bool

shape LiveChannelHit
  id: string
  name: string
  number: string
  logo: string
  nowTitle: string
  nowProgress: number
  nowEndLabel: string

shape LiveProgrammeHit
  id: string
  channelId: string
  channelName: string
  channelLogo: string
  name: string
  startLabel: string
  endLabel: string
  airing: bool
  progress: number
  startsInLabel: string
  episode: string
  artwork: string
  startISO: string
  endISO: string
  startMs: number
  endMs: number
  navigable: bool

shape SearchModel
  query: string
  generation: number
  items: Card[]
  descriptive: Card[]
  ai: Card[]
  aiStatus: string
  descriptiveStatus: string
  descriptiveRetryAllowed: bool
  descriptiveRetryAfter: number
  liveChannels: LiveChannelHit[]
  liveProgrammes: LiveProgrammeHit[]

shape ExtraModel
  id: string
  name: string
  kind: string
  ready: bool

shape CastPerson
  name: string
  role: string
  portrait: string

shape Rating
  source: string
  label: string
  value: string
  score: number
  state: string

shape DetailModel
  title: Card[]
  ratings: Rating[]
  trailerId: string
  trailerReady: bool
  themeMusicUrl: string
  themeMusicExpiresAt: number
  canPlay: bool
  resumePosition: string
  resumeSeconds: number
  seasons: Card[]
  episodes: Card[]
  extras: ExtraModel[]
  cast: string[]
  castPeople: CastPerson[]
  crew: string[]
  crewPeople: CastPerson[]
  mediaFacts: string[]
  related: FeedRow[]

shape ReceiptReply
  accepted: bool

shape Viewport
  devicePixelRatio: option<number>
  width: number
  height: number
  prefersReducedMotion: bool

shape PlaybackModel
  planJson: string
  sessionId: string
  preparing: bool
  errorCode: string
  errorMessage: string
  retryAllowed: bool
  retryAfterSeconds: number
  retryLimit: number

// The selected server's sign-in state. serverKind is "ether", "jellyfin", "emby" or "plex";
// revision changes with every session or server change; pollSeconds > 0 means the server has
// no session event stream and its playback snapshot is polled at that interval.
shape AuthModel
  authenticated: bool
  passwordAvailable: bool
  quickAvailable: bool
  secureOrigin: string
  error: string
  serverId: string
  serverKind: string
  revision: number
  pollSeconds: number

shape SecureSwitchReply
  url: string
  error: string

shape QuickModel
  secret: string
  code: string
  expiresLabel: string
  expiresAt: string
  status: string
  pollIntervalSeconds: number

// more: a further page can be read; complete: the server says these are all its items
// (false with more false means the server gave no end, never that the list is whole).
shape CollectionModel
  name: string
  items: Card[]
  more: bool
  complete: bool

fn cardName(card: Card): string = t("ui.openTitleYearProgress", title=card.name, year=(card.year > 0 ? t("ui.year", year=card.yearLabel) : ""), progress=(card.played ? t("ui.watched") : card.progressSeconds > 0 and card.durationSeconds > 0 ? t("ui.progressComplete", progress=card.progressLabel) : ""))

shape LibraryOption
  id: string
  label: string

shape LibrarySortOption
  id: string
  label: string
  directions: string[]

shape LibraryNav
  id: string
  name: string
  kind: string
  backdrop: string

shape LibraryModel
  id: string
  name: string
  kind: string
  backdrop: string
  sorts: LibrarySortOption[]
  sort: string
  direction: string
  kinds: LibraryOption[]
  genres: LibraryOption[]
  kindFilter: string
  genreFilter: string
  playedFilter: string
  favoriteFilter: bool
  yearFilter: number
  canYear: bool
  canPlayed: bool
  canFavorite: bool
  items: Card[]
  more: bool

fn libraryQuery(sort: string, direction: string, kind: string, genre: string, year: string, played: string, favorite: string): string = `?sort=${encodeURIComponent(sort)}&dir=${encodeURIComponent(direction)}&kind=${encodeURIComponent(kind)}&genre=${encodeURIComponent(genre)}&year=${encodeURIComponent(year)}&played=${encodeURIComponent(played)}&fav=${encodeURIComponent(favorite)}`

shape HomeRowsPage
  rows: FeedRow[]
  nextCursor: string
  continuation: string
  requestCursor: string
  homeAt: number

shape HomeRowPage
  rowId: string
  items: Card[]
  nextCursor: string
  continuation: string
  requestCursor: string
  homeAt: number

// A skin's appearance-picker entry, generated from its skin.json (foundation/skins.generated.contract).
// preview is an app-relative asset path (assets/skins/<id>.jpg, a 1440x900 home capture
// scaled to 720x450); swatches are 3-5 CSS colours from the skin's palette, ground first.
shape SkinManifest
  id: string
  name: string
  tagline: string
  preview: string
  swatches: string[]

// A configured server, presentation-safe. status: "ready" | "signed-out" | "unreachable".
shape ServerOption
  id: string
  name: string
  kind: string
  kindLabel: string
  origin: string
  basePath: string
  selected: bool
  status: string
  viewer: string
  message: string

shape ServerList
  servers: ServerOption[]
  selectedId: string

// state: "" (nothing asked) | "checking" | "found" | "invalid" | "unreachable" | "unsupported"
// | "insecure" (plain HTTP from an HTTPS page: the browser forbids it; message says how to proceed).
shape ServerProbe
  url: string
  generation: number
  state: string
  kind: string
  kindLabel: string
  name: string
  version: string
  normalizedUrl: string
  message: string

shape ServerReply
  id: string
  error: string

// state: "" | "starting" | "waiting" | "linked" | "expired" | "failed".
shape PlexLink
  code: string
  linkUrl: string
  state: string
  expiresAt: string

shape PlexServer
  id: string
  name: string
  owned: bool
  connectionLabel: string
  recommended: bool

// Native media authorization for vela-player and vela-preview props only (foundation-private).
shape MediaAuthReply
  json: string
