// Total presentation records projected from protocol/v0/types.ts. Empty artwork means absent.
shape Card
  id: string
  kind: string
  name: string
  summary: string
  facts: string
  yearLabel: string
  durationLabel: string
  progressLabel: string
  seasonNumberLabel: string
  episodeNumberLabel: string
  year: number
  rating: string
  seasonId: string
  seasonNumber: number
  episodeNumber: number
  played: bool
  progressSeconds: number
  durationSeconds: number
  genres: string[]
  poster: string
  backdrop: string
  logo: string
  accent: string
  receipt: string

shape FeedRow
  id: string
  name: string
  receipt: string
  items: Card[]
  nextCursor: string
  continuation: string
  previewOnFocus: bool
  presentation: string

shape CardPreview
  cardId: string
  url: string
  expiresAt: number
  retryAfterSeconds: number
  generation: number

// A cached, same-origin, unexpired preview grant for one featured title.
shape HeroPreview
  id: string
  url: string
  expiresAt: number

shape HeroAction
  heroId: string
  reason: string
  reasonLabel: string
  action: string
  targetId: string
  targetKind: string
  hasPosition: bool
  positionSeconds: number
  actionLabel: string
  actionDetail: string
  progress: number

shape HomeModel
  viewer: string
  defaultSkinId: string
  skins: string[]
  hero: Card[]
  heroActions: HeroAction[]
  heroPreviewIds: string[]
  previews: HeroPreview[]
  rows: FeedRow[]
  nextCursor: string
  liveAvailable: bool
  aiAvailable: bool
  descriptiveAvailable: bool
  trailerPreviewAvailable: bool

shape LiveChannelHit
  id: string
  name: string
  number: string
  logo: string
  nowTitle: string
  nowProgress: number
  nowEndLabel: string

shape LiveProgrammeHit
  id: string
  channelId: string
  channelName: string
  channelLogo: string
  name: string
  startLabel: string
  endLabel: string
  airing: bool
  progress: number
  startsInLabel: string
  episode: string
  artwork: string
  startISO: string
  endISO: string
  startMs: number
  endMs: number
  navigable: bool

shape SearchModel
  query: string
  generation: number
  items: Card[]
  descriptive: Card[]
  ai: Card[]
  aiStatus: string
  descriptiveStatus: string
  descriptiveRetryAllowed: bool
  descriptiveRetryAfter: number
  liveChannels: LiveChannelHit[]
  liveProgrammes: LiveProgrammeHit[]

shape ExtraModel
  id: string
  name: string
  kind: string
  ready: bool

shape CastPerson
  name: string
  role: string
  portrait: string

shape Rating
  source: string
  label: string
  value: string
  score: number
  state: string

shape DetailModel
  title: Card[]
  ratings: Rating[]
  trailerId: string
  trailerReady: bool
  canPlay: bool
  resumePosition: string
  resumeSeconds: number
  seasons: Card[]
  episodes: Card[]
  extras: ExtraModel[]
  cast: string[]
  castPeople: CastPerson[]
  crew: string[]
  crewPeople: CastPerson[]
  mediaFacts: string[]
  related: FeedRow[]

shape ReceiptReply
  accepted: bool

shape Viewport
  devicePixelRatio: option<number>
  width: number
  height: number
  prefersReducedMotion: bool

shape PlaybackModel
  planJson: string
  sessionId: string
  preparing: bool
  retryAfterSeconds: number

shape AuthModel
  authenticated: bool
  passwordAvailable: bool
  quickAvailable: bool
  secureOrigin: string
  error: string

shape SecureSwitchReply
  url: string
  error: string

shape QuickModel
  secret: string
  code: string
  expiresLabel: string
  expiresAt: string
  status: string
  pollIntervalSeconds: number

shape CollectionModel
  name: string
  items: Card[]

fn cardName(card: Card): string = t("ui.openTitleYearProgress", title=card.name, year=(card.year > 0 ? t("ui.year", year=card.yearLabel) : ""), progress=(card.played ? t("ui.watched") : card.progressSeconds > 0 and card.durationSeconds > 0 ? t("ui.progressComplete", progress=card.progressLabel) : ""))

shape LibraryOption
  id: string
  label: string

shape LibrarySortOption
  id: string
  label: string
  directions: string[]

shape LibraryNav
  id: string
  name: string
  kind: string
  backdrop: string

shape LibraryModel
  id: string
  name: string
  kind: string
  backdrop: string
  sorts: LibrarySortOption[]
  sort: string
  direction: string
  kinds: LibraryOption[]
  genres: LibraryOption[]
  kindFilter: string
  genreFilter: string
  playedFilter: string
  favoriteFilter: bool
  yearFilter: number
  canYear: bool
  canPlayed: bool
  canFavorite: bool
  items: Card[]
  more: bool

fn libraryQuery(sort: string, direction: string, kind: string, genre: string, year: string, played: string, favorite: string): string = `?sort=${encodeURIComponent(sort)}&dir=${encodeURIComponent(direction)}&kind=${encodeURIComponent(kind)}&genre=${encodeURIComponent(genre)}&year=${encodeURIComponent(year)}&played=${encodeURIComponent(played)}&fav=${encodeURIComponent(favorite)}`

shape HomeRowsPage
  rows: FeedRow[]
  nextCursor: string
  continuation: string
  requestCursor: string
  homeAt: number

shape HomeRowPage
  rowId: string
  items: Card[]
  nextCursor: string
  continuation: string
  requestCursor: string
  homeAt: number

// A skin's appearance-picker entry, generated from its skin.json (foundation/skins.generated.contract).
// preview is an app-relative asset path (assets/skins/<id>.jpg, a 1440x900 home capture
// scaled to 720x450); swatches are 3-5 CSS colours from the skin's palette, ground first.
shape SkinManifest
  id: string
  name: string
  tagline: string
  preview: string
  swatches: string[]
