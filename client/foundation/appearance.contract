use SkinManifest from "./models.contract"
use resolveSkin from "./skins.generated.contract"
use SkinDoc from "../renderer/levels.contract"
use emptyDoc from "../skins/doc/slots.contract"

// One runtime skin pack the server installed: data only, validated by the data
// module (src/appearance). packJson is its canonical form for the vela-theme view.
shape PackEntry
  id: string
  name: string
  tagline: string
  engine: string
  preview: string
  backdrop: string
  wordmark: string
  swatches: string[]
  packJson: string

// The server's appearance: its default skin (an engine or a pack id), the engine
// that default runs on, the owner's force flag and every installed pack.
// An installed skin document (drawn by the doc engine).
shape DocEntry
  id: string
  name: string
  tagline: string
  url: string
  preview: string
  swatches: string[]

shape AppearanceModel
  revision: number
  defaultSkinId: string
  defaultEngineId: string
  force: bool
  packs: PackEntry[]
  docs: DocEntry[]

fn packManifest(p: PackEntry): SkinManifest = SkinManifest(id=p.id, name=p.name, tagline=p.tagline, preview=p.preview, swatches=p.swatches)

// The public appearance before and after sign-in, then the viewer event stream,
// which pushes each owner change while the app is open.
members Client
  resource appearanceBase = uiAppearance() when current(auth) as shape AppearanceModel
  state appearanceAttempt = 0
  resource appearanceLive = appearanceEvents(appearanceAttempt, appearanceBase.revision) when auth.authenticated and current(appearanceBase) as shape AppearanceModel
  task retryAppearance when auth.authenticated and failed(appearanceLive) and appearanceAttempt < 30
    after(3000, reconnectAppearance)
  action reconnectAppearance
    appearanceAttempt = appearanceAttempt + 1
  derive appearance = (current(appearanceLive) ? appearanceLive : current(appearanceBase) ? appearanceBase : AppearanceModel(revision=0, defaultSkinId="", defaultEngineId="", force=false, packs=[], docs=[]))
  // The viewer's own pick wins unless the owner forces the default.
  derive serverSkin = (appearance.defaultSkinId != "" ? appearance.defaultSkinId : current(home) ? home.defaultSkinId : "")
  derive requestedSkin = (skin == "" or appearance.force ? serverSkin : skin)
  derive activePack = first(appearance.packs.filter(p => p.id == requestedSkin))
  derive activePackJson = match activePack { case some(p) => p.packJson, case none => "" }
  derive packBackdrop = match activePack { case some(p) => p.backdrop, case none => "" }
  derive packWordmark = match activePack { case some(p) => p.wordmark, case none => "" }
  derive packSkins = appearance.packs.map(p => p.id)
  // What the engine loader and vela-engine keep: the engine of the viewer's own pick
  // (none while following the server or while the owner forces the default) and the
  // server default's engine. Hand-off waits for the server's answer and for playback to end.
  derive pickEngine = (skin == "" or appearance.force ? "" : match first(appearance.packs.filter(p => p.id == skin)) { case some(p) => p.engine, case none => resolveSkin(skin) })
  derive serverEngine = (appearance.defaultEngineId != "" ? resolveSkin(appearance.defaultEngineId) : resolveSkin(serverSkin))
  derive engineSettled = (current(appearanceBase) or current(home)) and playingId == ""
  // A skin document the viewer or server wants, drawn by the doc engine once it has loaded.
  derive activeDocUrl = match first(appearance.docs.filter(d => d.id == requestedSkin)) { case some(d) => d.url, case none => "" }
  derive docWidth = (viewport.width < 640 ? 400 : viewport.width >= 1200 ? 1300 : 900)
  resource skinDocument = uiSkinDoc(activeDocUrl, docWidth) with localeJSON when activeDocUrl != "" as shape SkinDoc
  derive docReady = activeDocUrl != "" and current(skinDocument)
  derive activeDoc = (docReady ? skinDocument : emptyDoc())
