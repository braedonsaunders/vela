use Shell as ExampleShell, Home as ExampleHome, SearchSurface as ExampleSearchSurface, SearchField as ExampleSearchField, Detail as ExampleDetail, Status as ExampleStatus, Collection as ExampleCollection, Library as ExampleLibrary, Guide as ExampleGuide, LiveControls as ExampleLiveControls, PlayerChrome as ExamplePlayerChrome, detailPresentation as ExampleDetailPresentation, detailSplit as ExampleDetailSplit from "../skins/example/slots.contract"
use Shell as DocShell, Home as DocHome, detailPresentation as DocDetailPresentation from "../skins/doc/slots.contract"

// Every installed skin, in picker order.
fn installedSkins(): string[] = ["cinematic","index","jellytwin","mochi","marquee","example","doc"]
fn defaultSkin(): string = "cinematic"
// The skin that draws server skin documents ("" when none is installed).
fn documentsSkin(): string = "doc"
// An id or alias to its skin; an unknown id is the default skin.
fn resolveSkin(id: string): string = (id == "editorial" ? "index" : (installedSkins().includes(id) ? id : defaultSkin()))
// The picker entry of each skin.
fn skinManifest(id: string): SkinManifest = (resolveSkin(id) == "index" ? SkinManifest(id="index", name=t("ui.index"), tagline=t("skin.index.tagline"), preview="assets/skins/index.jpg", swatches=["#f3f0e8","#22221e","#813b31","#e3dfd3","#bcb8ae"]) : resolveSkin(id) == "jellytwin" ? SkinManifest(id="jellytwin", name=t("jellytwin.name"), tagline=t("skin.jellytwin.tagline"), preview="assets/skins/jellytwin.jpg", swatches=["#101010","#ffffff","#00a4dc","#aa5cc3","#292929"]) : resolveSkin(id) == "mochi" ? SkinManifest(id="mochi", name=t("mochi.name"), tagline=t("skin.mochi.tagline"), preview="assets/skins/mochi.jpg", swatches=["#fff0f6","#3b1f4a","#ff7eb6","#b9a0ff","#8fe8c9"]) : resolveSkin(id) == "marquee" ? SkinManifest(id="marquee", name=t("marquee.name"), tagline=t("skin.marquee.tagline"), preview="assets/skins/marquee.jpg", swatches=["#1f2023","#eeeeee","#e9a31b","#121315","#2c2e32"]) : resolveSkin(id) == "example" ? SkinManifest(id="example", name=t("example.name"), tagline=t("skin.example.tagline"), preview="assets/skins/example.jpg", swatches=["#090b0e","#f5f1e9","#858d98"]) : resolveSkin(id) == "doc" ? SkinManifest(id="doc", name="Skin document", tagline="Draws the server's skin document.", preview="assets/skins/cinematic.jpg", swatches=["#090b0e","#f5f1e9"]) : SkinManifest(id="cinematic", name=t("ui.cinematic"), tagline=t("skin.cinematic.tagline"), preview="assets/skins/cinematic.jpg", swatches=["#090b0e","#f5f1e9","#dcb998","#c0703f","#1f5a6b"]))
// The skins the picker offers: the always-offered ones, and the server-listed ones the server lists.
fn pickerSkins(serverSkins: string[]): SkinManifest[] = ["cinematic","index","jellytwin","mochi","marquee","example"].filter(id => not ["example"].includes(id) or serverSkins.includes(id)).map(id => skinManifest(id))
// What the root reads about the active skin (page colours, detail frame, section motion).
fn skinTraits(id: string): SkinTraits = (id == "index" ? SkinTraits(page="index.page", ink="index.ink", flatDetail=true, panSections=false, barMask=false, splashOnPaper=true, detailScrim="media.overlay", detailShadow="0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)", closeBorderWidth=1, closeBorderColor="surface.line", closeBackground="surface.glass", closeInk="ink.primary") : id == "jellytwin" ? SkinTraits(page="jellytwin.page", ink="jellytwin.ink", flatDetail=true, panSections=true, barMask=false, splashOnPaper=false, detailScrim="media.overlay", detailShadow="0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)", closeBorderWidth=1, closeBorderColor="surface.line", closeBackground="surface.glass", closeInk="ink.primary") : id == "mochi" ? SkinTraits(page="mochi.page", ink="mochi.ink", flatDetail=false, panSections=true, barMask=false, splashOnPaper=true, detailScrim="mochi.scrim", detailShadow="0px 0px 0px 3px var(--mochi.ink), 10px 12px 0px 3px var(--mochi.lavender)", closeBorderWidth=3, closeBorderColor="mochi.ink", closeBackground="mochi.card", closeInk="mochi.ink") : id == "marquee" ? SkinTraits(page="marquee.page", ink="marquee.ink", flatDetail=true, panSections=false, barMask=false, splashOnPaper=false, detailScrim="media.overlay", detailShadow="0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)", closeBorderWidth=1, closeBorderColor="surface.line", closeBackground="surface.glass", closeInk="ink.primary") : id == "example" ? SkinTraits(page="surface.page", ink="ink.primary", flatDetail=false, panSections=false, barMask=false, splashOnPaper=false, detailScrim="media.overlay", detailShadow="0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)", closeBorderWidth=1, closeBorderColor="surface.line", closeBackground="surface.glass", closeInk="ink.primary") : id == "doc" ? SkinTraits(page="surface.page", ink="ink.primary", flatDetail=false, panSections=true, barMask=false, splashOnPaper=false, detailScrim="media.overlay", detailShadow="0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)", closeBorderWidth=1, closeBorderColor="surface.line", closeBackground="surface.glass", closeInk="ink.primary") : SkinTraits(page="surface.page", ink="ink.primary", flatDetail=false, panSections=true, barMask=true, splashOnPaper=false, detailScrim="media.overlay", detailShadow="0px 50px 160px var(--media.ground), 0px 0px 0px 1px var(--cinematic.glass-edge)", closeBorderWidth=1, closeBorderColor="surface.line", closeBackground="surface.glass", closeInk="ink.primary"))
fn skinDetailPresentation(skin: string, width: number, doc: SkinDoc): string = (skin == "index" ? IndexDetailPresentation(width) : skin == "jellytwin" ? JellytwinDetailPresentation(width) : skin == "mochi" ? MochiDetailPresentation(width) : skin == "marquee" ? MarqueeDetailPresentation(width) : skin == "example" ? ExampleDetailPresentation(width) : skin == "doc" ? DocDetailPresentation(doc, width) : CinematicDetailPresentation(width))
fn skinDetailSplit(skin: string, width: number, doc: SkinDoc): string = (skin == "index" ? IndexDetailSplit(width) : skin == "jellytwin" ? JellytwinDetailSplit(width) : skin == "mochi" ? MochiDetailSplit(width) : skin == "marquee" ? MarqueeDetailSplit(width) : skin == "example" ? ExampleDetailSplit(width) : CinematicDetailSplit(width))

component Shell
  props
    p: ShellProps
  inject
    activeSkin: string
    logout: action
    goHome: action
    openSearch: action
    openLive: action
  provide
    signOut = logout
    home = goHome
    search = openSearch
    live = openLive
    library = goHome
  slot
  view
    if activeSkin == "index"
      IndexShell(p=p)
        children
    else if activeSkin == "jellytwin"
      JellytwinShell(p=p)
        children
    else if activeSkin == "mochi"
      MochiShell(p=p)
        children
    else if activeSkin == "marquee"
      MarqueeShell(p=p)
        children
    else if activeSkin == "example"
      ExampleShell(p=p)
        children
    else if activeSkin == "doc"
      DocShell(p=p)
        children
    else
      CinematicShell(p=p)
        children

