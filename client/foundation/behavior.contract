use buildEngine from "./engine.contract"
use FeedRow, HomeModel, SearchModel, DetailModel, ReceiptReply, Viewport, PlaybackModel, AuthModel, QuickModel, CollectionModel, LibraryNav, LibraryModel, HomeRowsPage, HomeRowPage, CardPreview, HeroPreview, SecureSwitchReply, libraryQuery from "./models.contract"

shape Time
  epochAtZero: number
  locale: string
  formatLocale: string
  resolvedLocale: string
  timeZone: string
  utcOffset: number

shape PageState
  visibilityState: string

// The home visit's query for a library section and its browse query.
fn librarySection(id: string, query: string): string = (query == "" ? `?lib=${encodeURIComponent(id)}` : `${query}&lib=${encodeURIComponent(id)}`)

members Client
  state generation = 0
  state skin = "" persist
  state observed: string[] = []
  derive query = match first(stack(nav)) { case some(e) => searchParam(e, "q"), case none => "" }
  derive detailId = (top(nav).name == "title" ? top(nav).params.id : "")
  resource page = exactPage() as shape PageState
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  derive artDpr = match viewport.devicePixelRatio { case some(d) => d, case none => 1 }
  derive artPixels = viewport.width * artDpr
  derive artWidth = (artPixels <= 1280 ? 1280 : artPixels <= 1920 ? 1920 : artPixels <= 2560 ? 2560 : 3840)
  state capturedWebCode = ""
  state capturedFragment = false
  derive fragmentCode = match first(fragment(top(nav)).split("&").filter(p => p.startsWith("code=")).map(p => p.slice(5))) { case some(c) => c, case none => "" }
  derive webCode = (capturedWebCode != "" ? capturedWebCode : fragmentCode != "" ? fragmentCode : searchParam(top(nav), "webCode"))
  state pageOrigin = ""
  state mediaCapabilitiesJSON = ""
  action receiveCapabilities(json: string)
    mediaCapabilitiesJSON = json
  action receiveOrigin(origin: string)
    pageOrigin = origin
  derive localeJSON = `{"locale":"${time.locale}","formatLocale":"${time.formatLocale}","resolvedLocale":"${time.resolvedLocale}","timeZone":"${time.timeZone}","utcOffset":${time.utcOffset}}`
  resource auth = uiAuth(webCode, time.epochAtZero, fragmentCode != "" or capturedFragment, pageOrigin, mediaCapabilitiesJSON, localeJSON) when current(time) and pageOrigin != "" and mediaCapabilitiesJSON != "" and fragmentCode == "" and searchParam(top(nav), "webCode") == "" as shape AuthModel transient
  mutation cancelledAI as shape ReceiptReply
  task cancelEmptySearch when query.trim() == ""
    after(1, cancelSearch)
  action cancelSearch
    send cancelledAI = cancelAISearch(time.epochAtZero)
  state secureNavigate = ""
  derive secureOriginsJSON = (auth.secureOrigin == "" ? "[]" : `["${auth.secureOrigin}"]`)
  mutation secureSwitch as shape SecureSwitchReply then finishSecureSwitch
  derive secureBusy = pending(secureSwitch)
  derive secureError = match secureSwitch { case some(r) => r.error, case none => "" }
  action goSecure
    if auth.secureOrigin != "" and not secureBusy
      if auth.authenticated
        send secureSwitch = issueSecureSwitch(auth.secureOrigin, time.epochAtZero + performanceNow())
      else
        secureNavigate = `${auth.secureOrigin}/vela/`
  action finishSecureSwitch
    match secureSwitch
      case some(r)
        if auth.authenticated and auth.secureOrigin != "" and r.error == "" and r.url != ""
          secureNavigate = r.url
      case none
        homeAuthChecked = homeAuthChecked
  mutation signedOut as shape AuthModel refreshes auth
  state homeAuthChecked = false
  action logout
    homeAuthChecked = false
    send signedOut = signOut(time.epochAtZero)
    nav = open(nav, path("home"))
  mutation signedIn as shape AuthModel refreshes auth then afterSignIn
  mutation quickStarted as shape QuickModel then afterQuickStart
  mutation quickPoll as shape AuthModel refreshes auth then afterQuickPoll
  mutation quickCancelled as shape ReceiptReply
  state returnTo = ""
  task requireSignIn when current(auth) and not auth.authenticated and top(nav).name != "home"
    after(1, showSignIn)
  action showSignIn
    if top(nav).name == "title"
      returnTo = path("title", top(nav).params.id)
    else
      if top(nav).name == "extra"
        returnTo = path("extra", top(nav).params.id)
      else
        returnTo = path("watch", top(nav).params.id)
    nav = open(nav, path("home"))
  state username = ""
  state password = ""
  state quickSecret = ""
  derive authError = match signedIn { case some(r) => r.error, case none => (quickError != "" ? quickError : auth.error) }
  derive quickModel = match quickStarted { case some(r) => r, case none => QuickModel(secret="", code="", expiresAt="", expiresLabel="", status="", pollIntervalSeconds=2) }
  derive quickError = match quickPoll { case some(r) => r.error, case none => "" }
  state nextQuickPoll = 0
  task quickPolling when quickSecret != ""
    every(1000, pollCode)
  task forgetRedeemedCode when auth.authenticated and capturedWebCode != "" and fragmentCode == "" and searchParam(top(nav), "webCode") == ""
    after(1, forgetCode)
  action forgetCode
    capturedWebCode = ""
    capturedFragment = false
  task cleanWebCode when fragmentCode != "" or searchParam(top(nav), "webCode") != ""
    after(1, removeWebCode)
  action removeWebCode
    capturedWebCode = webCode
    capturedFragment = fragmentCode != ""
    if top(nav).name == "home"
      nav = replace(nav, path("home") + (query == "" ? "" : `?q=${encodeURIComponent(query)}`))
    else
      if top(nav).name == "title"
        nav = replace(nav, path("title", top(nav).params.id))
      else
        if top(nav).name == "watch"
          nav = replace(nav, path("watch", top(nav).params.id))
        else
          nav = replace(nav, path("extra", top(nav).params.id))
  action editUsername(v: string)
    username = v
  action editPassword(v: string)
    password = v
  action submitSignIn
    if username.trim() != "" and password != "" and not pending(signedIn)
      send signedIn = signIn(username.trim(), password, time.epochAtZero)
  action afterSignIn
    homeAuthChecked = false
    password = ""
    match signedIn
      case some(r)
        if r.authenticated and returnTo != ""
          nav = open(nav, returnTo)
          returnTo = ""
      case none
        password = ""
  action startCode
    send quickStarted = startQuick(time.epochAtZero, localeJSON)
  action afterQuickStart
    quickSecret = quickModel.secret
    nextQuickPoll = performanceNow() + max(1, quickModel.pollIntervalSeconds) * 1000
  action pollCode
    if not pending(quickPoll) and performanceNow() >= nextQuickPoll
      nextQuickPoll = performanceNow() + max(1, quickModel.pollIntervalSeconds) * 1000
      send quickPoll = pollQuick(quickSecret, time.epochAtZero)
  action afterQuickPoll
    match quickPoll
      case some(r)
        if r.authenticated or r.error != ""
          quickSecret = ""
        if r.authenticated
          homeAuthChecked = false
        if r.authenticated and returnTo != ""
          nav = open(nav, returnTo)
          returnTo = ""
      case none
        quickSecret = quickSecret
  action cancelCode
    send quickCancelled = cancelQuick(quickSecret, time.epochAtZero)
    quickSecret = ""
  state homeAt = 0
  state homeLocale = ""
  // Featured titles: the foundation rotates the shown hero; skins only present it.
  state heroIndex = 0
  derive heroAt = (current(home) and home.hero.length > 0 ? heroIndex % home.hero.length : 0)
  derive heroHasPreview = (previewRow == "@hero" and cardPreview.cardId != "")
  task rotateHero when top(nav).name == "home" and libraryId == "" and query == "" and page.visibilityState == "visible" and not still and current(home) and home.hero.length > 1 and previewTarget == "" and not heroHasPreview
    every(9000, nextHero)
  action nextHero
    if previewTarget == ""
      heroIndex = (heroAt + 1) % max(1, home.hero.length)
  action pickHero(i: number)
    heroIndex = i
  task captureHomeTime when auth.authenticated key=localeJSON
    after(1, stampHomeTime)
  action stampHomeTime
    homeAt = time.epochAtZero + performanceNow()
    homeLocale = localeJSON
  resource home = uiBootstrap(homeAt) with localeJSON, artWidth when auth.authenticated and homeAt > 0 and homeLocale == localeJSON as shape HomeModel
  state homeExtraRows: FeedRow[] = []
  state homeUpdatedRows: FeedRow[] = []
  state homeRowsCursor = ""
  state homeRowsLoaded = false
  state rowMoreLoading: string[] = []
  derive allHomeRows = home.rows.concat(homeExtraRows).map(r => match first(homeUpdatedRows.filter(u => u.id == r.id)) { case some(u) => u, case none => r })
  derive homeMoreCursor = (homeRowsLoaded ? homeRowsCursor : home.nextCursor)
  derive homeSurface = HomeModel(home, rows=allHomeRows, nextCursor=homeMoreCursor, previews=(previewRow == "@hero" and cardPreview.cardId != "" ? [HeroPreview(id=cardPreview.cardId, url=cardPreview.url, expiresAt=cardPreview.expiresAt)] : []))
  state previewTarget = ""
  state previewRow = ""
  state previewGeneration = 0
  state previewRetryAt = 0
  state previewAskedGeneration = -1
  state previewDwellAt = 0
  state cardPreview = CardPreview(cardId="", url="", expiresAt=0, retryAfterSeconds=0, generation=0)
  derive previewAllowed = auth.authenticated and current(home) and home.trailerPreviewAvailable and top(nav).name == "home" and libraryId == "" and query == "" and page.visibilityState == "visible" and not still and not saveData
  derive heroPreviewId = match first(home.hero.slice(heroAt, heroAt + 1)) { case some(h) => h.id, case none => "" }
  derive previewDesired = (previewAllowed ? (previewTarget != "" ? previewTarget : (home.heroPreviewIds.includes(heroPreviewId) ? heroPreviewId : "")) : "")
  mutation previewFetch as shape CardPreview then acceptPreview
  mutation previewCancelled as shape ReceiptReply queue
  task previewContext when current(home) key=`${top(nav).name}:${libraryId}:${query}:${page.visibilityState}:${still}:${saveData}:${heroAt}:${auth.authenticated}:${home.trailerPreviewAvailable}:${home.heroPreviewIds.join(",")}`
    change(clearPreview)
  action clearPreview
    previewTarget = ""
    previewRow = ""
    previewRetryAt = 0
    previewGeneration = previewGeneration + 1
    previewDwellAt = time.epochAtZero + performanceNow() + 700
    cardPreview = CardPreview(cardId="", url="", expiresAt=0, retryAfterSeconds=0, generation=previewGeneration)
    send previewCancelled = uiPreviewCancel(previewGeneration)
  action previewIntent(cardId: string, rowId: string, on: bool)
    if on and previewAllowed and cardId != "" and allHomeRows.filter(r => r.id == rowId and r.previewOnFocus and r.items.filter(c => c.id == cardId).length > 0).length > 0
      if previewTarget != cardId or previewRow != rowId
        previewTarget = cardId
        previewRow = rowId
        previewRetryAt = 0
        previewGeneration = previewGeneration + 1
        previewDwellAt = time.epochAtZero + performanceNow() + 700
        cardPreview = CardPreview(cardId="", url="", expiresAt=0, retryAfterSeconds=0, generation=previewGeneration)
        send previewCancelled = uiPreviewCancel(previewGeneration)
    else if not on and ((previewTarget != "" and (rowId == "" or rowId == previewRow) and (cardId == "" or cardId == previewTarget)) or (rowId == "" and cardId == "" and previewRow == "@hero"))
      previewTarget = ""
      previewRow = ""
      previewRetryAt = 0
      previewGeneration = previewGeneration + 1
      previewDwellAt = time.epochAtZero + performanceNow() + 700
      cardPreview = CardPreview(cardId="", url="", expiresAt=0, retryAfterSeconds=0, generation=previewGeneration)
      send previewCancelled = uiPreviewCancel(previewGeneration)
  action cancelPreviewOnScroll(x: number, y: number)
    if previewTarget != "" or previewRow == "@hero"
      previewTarget = ""
      previewRow = ""
      previewRetryAt = 0
      previewGeneration = previewGeneration + 1
      previewDwellAt = time.epochAtZero + performanceNow() + 700
      cardPreview = CardPreview(cardId="", url="", expiresAt=0, retryAfterSeconds=0, generation=previewGeneration)
      send previewCancelled = uiPreviewCancel(previewGeneration)
  task previewDwell when previewDesired != "" key=`${previewDesired}:${previewGeneration}`
    after(700, requestPreview)
  action requestPreview
    if previewDesired != "" and not pending(previewFetch)
      previewAskedGeneration = previewGeneration
      send previewFetch = uiPreviewRequest(previewDesired, previewGeneration, time.epochAtZero + performanceNow())
  action acceptPreview
    match previewFetch
      case some(p)
        if p.generation == previewGeneration and previewDesired != ""
          if p.cardId == previewDesired
            cardPreview = p
            previewRow = (previewTarget == "" ? "@hero" : previewRow)
            previewRetryAt = 0
          else if p.retryAfterSeconds > 0
            previewRetryAt = time.epochAtZero + performanceNow() + p.retryAfterSeconds * 1000
      case none
        previewRetryAt = 0
  task retryPreview when previewDesired != ""
    every(1000, pollPreview)
  action pollPreview
    if time.epochAtZero + performanceNow() >= previewDwellAt and not pending(previewFetch) and (previewAskedGeneration != previewGeneration or (previewRetryAt > 0 and time.epochAtZero + performanceNow() >= previewRetryAt))
      previewRetryAt = 0
      previewAskedGeneration = previewGeneration
      send previewFetch = uiPreviewRequest(previewDesired, previewGeneration, time.epochAtZero + performanceNow())

  derive homeMoreLoading = pending(homeRowsPage)
  mutation homeRowsPage as shape HomeRowsPage queue then appendHomeRows
  mutation homeRowPage as shape HomeRowPage queue then appendHomeRow
  task resetHomePaging when current(home) key=`${homeAt}:${artWidth}:${home.nextCursor}:${home.hero.map(h => h.id).join(",")}`
    change(clearHomePaging)
  action clearHomePaging
    homeExtraRows = []
    homeUpdatedRows = []
    homeRowsCursor = ""
    homeRowsLoaded = false
    rowMoreLoading = []
  action loadMoreHome(entry: IntersectionObserverEntry)
    if entry.isIntersecting and page.visibilityState == "visible" and top(nav).name == "home" and homeMoreCursor != "" and not pending(homeRowsPage)
      send homeRowsPage = uiHomeRows(homeMoreCursor, home.hero.map(h => h.id), homeAt, localeJSON, artWidth)
  action appendHomeRows
    match homeRowsPage
      case some(p)
        if p.homeAt == homeAt and p.requestCursor == homeMoreCursor
          homeExtraRows = homeExtraRows.concat(p.rows.filter(r => not allHomeRows.map(old => old.id).includes(r.id)))
          homeRowsCursor = p.nextCursor
          homeRowsLoaded = true
      case none
        homeRowsLoaded = homeRowsLoaded
  action loadMoreRow(rowId: string, entry: IntersectionObserverEntry)
    match first(allHomeRows.filter(r => r.id == rowId))
      case some(row)
        if entry.isIntersecting and page.visibilityState == "visible" and top(nav).name == "home" and row.nextCursor != "" and not rowMoreLoading.includes(rowId)
          rowMoreLoading = rowMoreLoading.concat([rowId])
          send homeRowPage = uiHomeRow(rowId, row.nextCursor, home.hero.map(h => h.id), homeAt, localeJSON, artWidth)
      case none
        rowMoreLoading = rowMoreLoading
  action appendHomeRow
    match homeRowPage
      case some(p)
        rowMoreLoading = rowMoreLoading.filter(id => id != p.rowId)
        match first(allHomeRows.filter(r => r.id == p.rowId))
          case some(row)
            if p.homeAt == homeAt and p.requestCursor == row.nextCursor
              homeUpdatedRows = homeUpdatedRows.filter(old => old.id != row.id).concat([FeedRow(row, items=row.items.concat(p.items.filter(item => not row.items.map(old => old.id).includes(item.id))), nextCursor=p.nextCursor, continuation=p.continuation)])
          case none
            homeUpdatedRows = homeUpdatedRows
      case none
        rowMoreLoading = rowMoreLoading
  task clearFailedRowPaging when failed(homeRowPage)
    after(1, forgetFailedRows)
  action forgetFailedRows
    rowMoreLoading = []
  task checkHomeAuth when failed(home) and auth.authenticated and not homeAuthChecked
    after(1, recheckHomeAuth)
  action recheckHomeAuth
    homeAuthChecked = true
    refresh auth
  state searchTime = 0
  state searchTimeQuery = ""
  state searchTimeGeneration = -1
  task captureSearchTime when auth.authenticated and query.trim() != "" key=`${query}:${generation}`
    after(1, stampSearchTime)
  action stampSearchTime
    searchTime = time.epochAtZero + performanceNow()
    searchTimeQuery = query
    searchTimeGeneration = generation
  resource results = uiSearch(query, generation, time.epochAtZero, searchTime) with localeJSON, artWidth when auth.authenticated and query.trim() != "" and searchTime > 0 and searchTimeQuery == query and searchTimeGeneration == generation as shape SearchModel transient
  resource descriptive = uiDescriptive(query, generation, time.epochAtZero) with localeJSON, artWidth when auth.authenticated and query.trim() != "" and home.descriptiveAvailable as shape SearchModel transient
  resource ai = uiAI(query, generation, time.epochAtZero) with localeJSON, artWidth when auth.authenticated and query.trim() != "" and home.aiAvailable as shape SearchModel transient
  // Each optional search lane's honest state for this query: "off" when the server does
  // not advertise it, "loading" until its answer for this exact query arrives, then
  // "failed" or "ready" (the lane's items may still be empty).
  derive descriptiveState = (not home.descriptiveAvailable ? "off" : failed(descriptive) and not pending(descriptive) ? "failed" : pending(descriptive) or not current(descriptive) or descriptive.query != query or descriptive.generation != generation ? "loading" : "ready")
  derive aiState = (not home.aiAvailable ? "off" : failed(ai) and not pending(ai) ? "failed" : pending(ai) or not current(ai) or ai.query != query or ai.generation != generation ? "loading" : "ready")
  resource libraries = uiLibraries() when auth.authenticated as shape LibraryNav[] else empty()
  // Home and the server's libraries are one surface: the active library and its
  // browse query live on the root home visit, so opening a title over a library
  // never deactivates it and switching sections never remounts the surface.
  derive libraryId = match first(stack(nav)) { case some(e) => searchParam(e, "lib"), case none => "" }
  derive librarySort = match first(stack(nav)) { case some(e) => searchParam(e, "sort"), case none => "" }
  derive libraryDirection = match first(stack(nav)) { case some(e) => searchParam(e, "dir"), case none => "" }
  derive libraryKind = match first(stack(nav)) { case some(e) => searchParam(e, "kind"), case none => "" }
  derive libraryGenre = match first(stack(nav)) { case some(e) => searchParam(e, "genre"), case none => "" }
  derive libraryYearText = match first(stack(nav)) { case some(e) => searchParam(e, "year"), case none => "" }
  derive libraryYear = match parseNumber(libraryYearText) { case some(n) => n, case none => 0 }
  derive libraryPlayed = match first(stack(nav)) { case some(e) => searchParam(e, "played"), case none => "" }
  derive libraryFavorite = match first(stack(nav)) { case some(e) => searchParam(e, "fav"), case none => "" }
  derive libraryKey = `${libraryId}${libraryQuery(librarySort, libraryDirection, libraryKind, libraryGenre, libraryYearText, libraryPlayed, libraryFavorite)}`
  state libraryPages = 1
  state libraryPagingEntry = ""
  derive activeLibraryPages = (libraryPagingEntry == libraryKey ? libraryPages : 1)
  resource libraryModel = uiLibrary(libraryId, librarySort, libraryDirection, libraryKind, libraryGenre, libraryYear, libraryPlayed, libraryFavorite, activeLibraryPages) with localeJSON, artWidth when auth.authenticated and libraryId != "" and libraryId != "@live" as shape LibraryModel
  derive libraryLoading = (activeLibraryPages <= 1 and (pending(libraryModel) or not current(libraryModel)))
  derive libraryMoreLoading = (activeLibraryPages > 1 and pending(libraryModel))
  // The last answer per library this session, so a revisited section shows at once.
  state snapshotVersion = 0
  resource librarySnapshots = uiLibrarySnapshots(snapshotVersion) with localeJSON, artWidth when auth.authenticated as shape LibraryModel[] else empty()
  task recordLibrarySnapshot when current(libraryModel) and libraryModel.id != "" key=`${libraryModel.id}:${libraryModel.sort}:${libraryModel.direction}:${libraryModel.items.length}:${libraryKey}`
    after(1, bumpLibrarySnapshots)
  action bumpLibrarySnapshots
    snapshotVersion = snapshotVersion + 1
  derive browseLibraries = (auth.authenticated and current(libraries) ? libraries.filter(l => l.kind != "live") : [])
  // Top-level sections in top-bar order: Home, then the server's libraries, a live library
  // becoming the Live TV panel; Live TV comes last when the server has no live library.
  derive canLiveSection = auth.authenticated and current(home) and home.liveAvailable
  derive sectionIds = ["home"].concat(auth.authenticated and current(libraries) ? libraries.filter(l => l.kind != "live" or canLiveSection).map(l => (l.kind == "live" ? "@live" : l.id)) : []).concat(canLiveSection and not (auth.authenticated and current(libraries) and libraries.filter(l => l.kind == "live").length > 0) ? ["@live"] : [])
  derive sectionIndex = max(0, sectionIds.indexOf(libraryId == "" ? "home" : libraryId))
  action openLibrary(id: string)
    libraryPages = 1
    nav = (top(nav).name == "home" ? replace(nav, path("home") + librarySection(id, "")) : open(nav, path("home") + librarySection(id, "")))
  action setLibrarySort(id: string, direction: string)
    libraryPages = 1
    nav = replace(nav, path("home") + librarySection(libraryId, libraryQuery(id, direction, libraryKind, libraryGenre, libraryYearText, libraryPlayed, libraryFavorite)))
  action setLibraryFilter(name: string, value: string)
    libraryPages = 1
    nav = replace(nav, path("home") + librarySection(libraryId, libraryQuery(librarySort, libraryDirection, (name == "kind" ? value : libraryKind), (name == "genre" ? value : libraryGenre), (name == "year" ? value : libraryYearText), (name == "played" ? value : libraryPlayed), (name == "favorite" ? value : libraryFavorite))))
  action moreLibrary
    if current(libraryModel) and libraryModel.more and not pending(libraryModel)
      libraryPages = activeLibraryPages + 1
      libraryPagingEntry = libraryKey
  // Links from builds before the shared surface used /library/:id.
  task redirectLibraryLink when top(nav).name == "library"
    after(1, followLibraryLink)
  action followLibraryLink
    if top(nav).name == "library"
      nav = open(nav, path("home") + librarySection(top(nav).params.id, ""))
  // The guide stays mounted once visited; its tile and session follow guideOpen, not mounting.
  state liveVisited = false
  task markLiveVisited when libraryId == "@live" and not liveVisited
    after(1, rememberLiveVisit)
  action rememberLiveVisit
    liveVisited = true
  // /live opens the Live TV panel of the home surface.
  task redirectLiveLink when top(nav).name == "live"
    after(1, followLiveLink)
  action followLiveLink
    if top(nav).name == "live"
      nav = open(nav, path("home") + librarySection("@live", ""))
  derive collectionId = (top(nav).name == "collection" ? top(nav).params.id : "")
  resource collection = uiCollection(collectionId) with localeJSON, artWidth when auth.authenticated and collectionId != "" as shape CollectionModel
  resource detail = uiDetail(detailId) with localeJSON, artWidth when auth.authenticated and detailId != "" as shape DetailModel
  resource related = uiRelated(detailId) with localeJSON, artWidth when auth.authenticated and detailId != "" as shape FeedRow[] else empty()
  // A show's seasons stay on the show's own visit: the chosen season is a query on it, and only
  // its episodes are read, so picking a season never remounts the page or drops the tabs.
  derive detailSeason = (top(nav).name == "title" ? searchParam(top(nav), "season") : "")
  resource seasonDetail = uiDetail(detailSeason) with localeJSON, artWidth when auth.authenticated and detailSeason != "" as shape DetailModel else empty()
  derive seasonReady = match first(seasonDetail.title) { case some(t) => t.id == detailSeason, case none => false }
  derive detailSurface = DetailModel(detail, related=(current(related) ? related : []), episodes=(detailSeason != "" and seasonReady ? seasonDetail.episodes : detail.episodes))
  derive playingId = (top(nav).name == "watch" or top(nav).name == "extra" or top(nav).name == "liveWatch" ? top(nav).params.id : "")
  resource playback = uiPlayback(playingId, top(nav).name == "extra" ? "extra" : top(nav).name == "liveWatch" ? "channel" : "title", time.epochAtZero, `${top(nav).id}`, searchParam(top(nav), "position")) when auth.authenticated and playingId != "" as shape PlaybackModel transient
  state streamAttempt = 0
  resource sessionUpdate = sessionEvents(playback.sessionId, streamAttempt) when auth.authenticated and playingId != "" and playback.sessionId != "" as shape PlaybackModel
  derive currentPlan = (current(sessionUpdate) and sessionUpdate.sessionId == playback.sessionId and sessionUpdate.planJson != "" ? sessionUpdate.planJson : playback.planJson)
  task retrySession when playingId != "" and watchModel.state != "ended" and failed(sessionUpdate) and streamAttempt < 3
    after(1500, retryStream)
  action retryStream
    streamAttempt = streamAttempt + 1
  mutation playerReceipt as shape ReceiptReply queue
  state commandId = 0
  state commandJson = ""
  mutation flushed as shape ReceiptReply
  task flushOnHide when page.visibilityState == "hidden"
    after(1, flushReceipts)
  action flushReceipts
    send flushed = flushInteractions(time.epochAtZero + performanceNow())
  mutation receipt as shape ReceiptReply queue
  derive small = viewport.width < 640
  derive still = viewport.prefersReducedMotion
  derive indexSkin = (activeSkin == "index" or activeSkin == "editorial")
  // Skins whose title page is a plain page rather than cinematic's framed overlay.
  derive flatDetail = (indexSkin or activeSkin == "jellytwin" or activeSkin == "marquee")
  derive homeSmall = (small or (indexSkin and top(nav).name == "title" and viewport.width >= 900))
  derive shellViewport = Viewport(viewport, width=(homeSmall and not small ? 360 : viewport.width))
  derive pageColor = (activeSkin == "mochi" ? "mochi.page" : indexSkin ? "index.page" : activeSkin == "jellytwin" ? "jellytwin.page" : activeSkin == "marquee" ? "marquee.page" : "surface.page")
  derive inkColor = (activeSkin == "mochi" ? "mochi.ink" : indexSkin ? "index.ink" : activeSkin == "jellytwin" ? "jellytwin.ink" : activeSkin == "marquee" ? "marquee.ink" : "ink.primary")
  // requestedSkin and activePack come from the server appearance (appearance.contract).
  derive wantedSkin = match activePack { case some(p) => p.engine, case none => (docReady ? "doc" : ["cinematic", "index", "editorial", "example", "jellytwin", "mochi", "marquee"].includes(requestedSkin) ? requestedSkin : "cinematic") }
  // A single-engine build always presents its own engine; vela-engine hands off to the wanted one.
  derive activeSkin = (buildEngine() == "" ? wantedSkin : buildEngine())

  task searchUpdates when auth.authenticated and query.trim() != "" and home.aiAvailable and (ai.aiStatus == "queued" or ai.aiStatus == "running")
    every(1500, updateSearch)

  action updateSearch
    refresh ai

  action edit(v: string)
    generation = generation + 1
    nav = replace(nav, path("home") + (v == "" ? "" : `?q=${encodeURIComponent(v)}`))
  // Counts appearance changes so the root can dissolve into the newly chosen skin.
  state skinSwitches = 0
  action chooseSkin(v: string)
    if v != activeSkin
      skinSwitches = skinSwitches + 1
    skin = v
  action follow(url: string)
    nav = go(nav, url)
  action close
    nav = back(nav)
  action goHome
    nav = (top(nav).name == "home" ? replace(nav, path("home")) : open(nav, path("home")))
  action openSearch
    nav = (top(nav).name == "home" ? replace(nav, path("home") + (query == "" ? "" : `?q=${encodeURIComponent(query)}`)) : open(nav, path("home")))
  action openLive
    libraryPages = 1
    nav = (top(nav).name == "home" ? replace(nav, path("home") + librarySection("@live", "")) : open(nav, path("home") + librarySection("@live", "")))
  action openLiveProgramme(id: string)
    match first(results.liveProgrammes.filter(p => p.id == id))
      case some(p)
        if current(results) and results.query == query and results.generation == generation
          let now = time.epochAtZero + performanceNow()
          if p.startMs <= now and now < p.endMs
            nav = push(nav, path("liveWatch", p.channelId))
          else if p.startMs <= now + 518400000
            nav = (top(nav).name == "home" ? replace(nav, path("home") + `?lib=%40live&ch=${encodeURIComponent(p.channelId)}&prog=${encodeURIComponent(p.id)}&at=${encodeURIComponent(p.startISO)}`) : open(nav, path("home") + `?lib=%40live&ch=${encodeURIComponent(p.channelId)}&prog=${encodeURIComponent(p.id)}&at=${encodeURIComponent(p.startISO)}`))
      case none
        generation = generation
  action selectTitle(id: string, kind: string, token: string)
    if kind == "channel"
      nav = push(nav, path("liveWatch", id))
    else
      if kind == "collection" or kind == "directory" or kind == "playlist"
        nav = push(nav, path("collection", id))
      else
        if kind == "season" and top(nav).name == "title" and current(detail) and detail.seasons.filter(x => x.id == id).length > 0
          nav = replace(nav, path("title", detailId) + `?season=${encodeURIComponent(id)}`)
        else
          nav = push(nav, path("title", id))
    if token != ""
      send receipt = interaction(token, "selected", time.epochAtZero + performanceNow())
  action observe(token: string, entry: IntersectionObserverEntry)
    if entry.isIntersecting and entry.intersectionRatio > 0 and token != "" and not observed.includes(token) and (top(nav).name == "home" or top(nav).name == "collection") and page.visibilityState == "visible"
      observed = observed.concat([token])
      send receipt = interaction(token, "visible", time.epochAtZero + performanceNow())
  action observeDetail(token: string, entry: IntersectionObserverEntry)
    if entry.isIntersecting and entry.intersectionRatio > 0 and token != "" and not observed.includes(token) and top(nav).name == "title" and page.visibilityState == "visible"
      observed = observed.concat([token])
      send receipt = interaction(token, "visible", time.epochAtZero + performanceNow())
  action playerMessage(json: string)
    send playerReceipt = playerEvent(json, time.epochAtZero + performanceNow())
  action playerCommand(kind: string)
    let next = commandId + 1
    commandId = next
    commandJson = `{"id":${next},"type":"${kind}"}`
  action play(id: string)
    streamAttempt = 0
    nav = push(nav, path("watch", id))
  action playHero(id: string, position: number, hasPosition: bool)
    streamAttempt = 0
    nav = push(nav, path("watch", id) + (hasPosition ? `?position=${position}` : ""))
  action playExtra(id: string)
    streamAttempt = 0
    nav = push(nav, path("extra", id))

