// The launch splash: Vela's searchlight V, played while the app boots and signs in.
// Geometry is brand/build.mjs's: the light beam reaches the baseline, the shadow
// beam stops short against it. Each beam is a motorised lamp turning about its own
// base: it powers on with a stepped flicker, makes two mirrored constant-speed
// passes with crisp reversals, then drives into the V and stops dead (1.93 s), a
// flash of full power marks the lock and the letters light up like bulbs.
// Reduced motion shows the finished mark. The app mounts it once, at the root.

// Two servo sweeps, mirrored. Each pass ramps up briefly, runs at constant speed and
// ramps down into a 40 ms dwell; the last drive into the V stops with no overshoot.
keyframes velaSweepLight
  0% rotate=20 animation-timing-function="linear"
  15.54% rotate=20 animation-timing-function="cubic-bezier(0.11, 0, 0.5, 0)"
  19.4% rotate=17.36 animation-timing-function="linear"
  43.81% rotate=-17.36 animation-timing-function="cubic-bezier(0.5, 1, 0.89, 1)"
  47.67% rotate=-20 animation-timing-function="linear"
  49.74% rotate=-20 animation-timing-function="cubic-bezier(0.11, 0, 0.5, 0)"
  53.6% rotate=-17.36 animation-timing-function="linear"
  78.01% rotate=17.36 animation-timing-function="cubic-bezier(0.5, 1, 0.89, 1)"
  81.87% rotate=20 animation-timing-function="linear"
  83.94% rotate=20 animation-timing-function="cubic-bezier(0.11, 0, 0.5, 0)"
  85.87% rotate=18.68 animation-timing-function="linear"
  98.88% rotate=0.77 animation-timing-function="cubic-bezier(0.5, 1, 0.89, 1)"
  100% rotate=0 animation-timing-function="linear"
keyframes velaSweepShadow
  0% rotate=-20 animation-timing-function="linear"
  15.54% rotate=-20 animation-timing-function="cubic-bezier(0.11, 0, 0.5, 0)"
  19.4% rotate=-17.36 animation-timing-function="linear"
  43.81% rotate=17.36 animation-timing-function="cubic-bezier(0.5, 1, 0.89, 1)"
  47.67% rotate=20 animation-timing-function="linear"
  49.74% rotate=20 animation-timing-function="cubic-bezier(0.11, 0, 0.5, 0)"
  53.6% rotate=17.36 animation-timing-function="linear"
  78.01% rotate=-17.36 animation-timing-function="cubic-bezier(0.5, 1, 0.89, 1)"
  81.87% rotate=-20 animation-timing-function="linear"
  83.94% rotate=-20 animation-timing-function="cubic-bezier(0.11, 0, 0.5, 0)"
  85.87% rotate=-18.68 animation-timing-function="linear"
  98.88% rotate=-0.77 animation-timing-function="cubic-bezier(0.5, 1, 0.89, 1)"
  100% rotate=0 animation-timing-function="linear"

keyframes velaPower
  0% opacity=0
  17.9% opacity=0
  18% opacity=1
  29.9% opacity=1
  30% opacity=0.15
  41.9% opacity=0.15
  42% opacity=1
  57.9% opacity=1
  58% opacity=0.35
  69.9% opacity=0.35
  70% opacity=1
  100% opacity=1

keyframes velaLock
  0% opacity=0
  12% opacity=0.5
  100% opacity=0

keyframes velaBulb
  0% opacity=0
  29.9% opacity=0
  30% opacity=1
  44.9% opacity=1
  45% opacity=0.25
  59.9% opacity=0.25
  60% opacity=1
  100% opacity=1

keyframes velaSplashOut
  to opacity=0

// One beam: the lamp's turning frame sits at its base, so the rotation is rigid about it.
component VelaBeam
  props
    d: string
    pivotX: number
    pivotY: number
    fill: string
    sweep: string
    still: bool
  view
    g transform=`translate(${pivotX} ${pivotY})`
      g animation=(still ? "none" : `${sweep} 1930ms linear both`)
        g transform=`translate(${-pivotX} ${-pivotY})`
          path d=d fill=fill animation=(still ? "none" : "velaPower 300ms linear both")
          path d=d fill="#ffffff" opacity=0 animation=(still ? "none" : "velaLock 420ms ease-out 1930ms both")

component VelaSplash
  props
    still: bool
    ground: string
    paper: bool
    label: string
  view
    column position="absolute" inset=0 z-index=60 align-items="center" justify-content="center" gap=22 background-color=ground background-image=(paper ? "none" : "radial-gradient(ellipse 60% 55% at 50% 46%, var(--brand.lift) 0%, var(--cinematic.scrim-clear) 70%)") role="status" aria-label=label aria-busy=true -exact-exit-animation=(still ? "velaSplashOut 160ms linear both" : "velaSplashOut 420ms ease-in both")
      // The mark, in a frame wide enough for the beams' sweep; at rest it is centred.
      svg width="min(42vmin, 300px)" height="min(26.6vmin, 190px)" viewBox="-12 2 88 55.8" overflow="visible" aria-hidden=true
        VelaBeam(d="M38 8H55L36.8 50.8 32.4 57.6Z", pivotX=34.6, pivotY=54.2, fill=(paper ? "var(--brand.paper-shadow)" : "var(--brand.shadow)"), sweep="velaSweepShadow", still=still)
        VelaBeam(d="M9 8H26.4L41 57.6H32.4Z", pivotX=36.7, pivotY=57.6, fill=(paper ? "var(--brand.paper-light)" : "var(--brand.light)"), sweep="velaSweepLight", still=still)
      svg width="min(16.4vmin, 118px)" height="min(7.3vmin, 52.6px)" viewBox="-6.25 -6.25 252.5 112.5" aria-hidden=true
        g fill="none" stroke=(paper ? "var(--brand.paper-light)" : "var(--brand.light)") stroke-width=12.5 stroke-linecap="round" stroke-linejoin="round"
          for d, i in ["M0 36L26 100L52 36", "M72 68H136A32 32 0 1 0 128.51 88.57", "M156 0V100", "M240 68A32 32 0 1 0 176 68A32 32 0 1 0 240 68M240 36V100"] key=`${i}`
            path d=d animation=(still ? "none" : `velaBulb 260ms linear ${1990 + i * 90}ms both`)
