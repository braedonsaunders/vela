// The look the foundation widgets wear (search, player chrome and menus, the guide and live
// controls, connect, status, and the routes a document leaves out): the active skin
// document's `ui` block, every key filled by the resolver. Widgets bind these values directly
// (no CSS custom properties), so the same widgets draw on every host.
shape UiTokens
  // Grounds and ink.
  page: string
  raised: string
  ink: string
  inkSecondary: string
  inkQuiet: string
  inkInverse: string
  // The skin's own colour and the ink drawn on it.
  accent: string
  onAccent: string
  // Controls, glass panels and popovers.
  control: string
  controlHover: string
  glass: string
  glassEdge: string
  glassEdgeStrong: string
  popover: string
  scrim: string
  // Progress tracks, focus, depth and loading shapes.
  track: string
  trackStrong: string
  focusHalo: string
  shadow: string
  skeleton: string
  skeletonLight: string
  alert: string
  // What is on now (live badges, the guide's now line).
  live: string
  font: string
  fontDisplay: string
  // Corner radii in px: buttons and pills, cards, panels.
  radiusControl: number
  radiusCard: number
  radiusPanel: number

// Cinematic's values (client/src/skin/ui-defaults.ts holds the same): the look before any
// document has loaded, and of every key a document leaves out.
fn cinematicUi(): UiTokens = UiTokens(page="#090b0e", raised="#15191e", ink="#f5f1e9", inkSecondary="#b6b8bb", inkQuiet="#858d98", inkInverse="#111419", accent="#dcb998", onAccent="#111419", control="#ffffff16", controlHover="#ffffff26", glass="#12151bb3", glassEdge="#ffffff1a", glassEdgeStrong="#ffffff33", popover="#111419f5", scrim="#000000bf", track="#ffffff25", trackStrong="#ffffff47", focusHalo="#dcb99833", shadow="#00000099", skeleton="#ffffff0d", skeletonLight="#ffffff12", alert="#c0703f1f", live="#e8513f", font="system-ui, -apple-system, \"Segoe UI Variable\", \"Segoe UI\", Roboto, sans-serif", fontDisplay="\"Instrument Serif\", \"Iowan Old Style\", Georgia, serif", radiusControl=999, radiusCard=14, radiusPanel=28)
