use GuideModel, GuideChannel, LiveStatus, LiveIdentity, LiveTile, GuideFocus, GuideFocusTime from "../live/models.contract"
use PlaybackModel from "./models.contract"
use PlayerView, PlayerCommandReply from "./player-models.contract"

members Client
  state guideDay = 0
  // The one place that says the guide is on screen: everything live (listings, clock, the preview
  // tile and its release) follows it, so moving the guide to another surface changes only this line.
  // A skin document may make home itself a live surface (`live.home`): home then holds the
  // guide's listings, clock and the same one preview tile, under the same release rules.
  derive liveHome = activeDoc.liveHome and current(home) and home.liveAvailable
  derive guideOpen = top(nav).name == "home" and (libraryId == "@live" or (libraryId == "" and liveHome))
  state guideZoom = 1 persist
  // A search hand-off (/?lib=@live&ch=&prog=&at=) carries only server facts; the data module
  // places `at` in the guide's local days, and the guide opens on that day, row and time.
  derive guideFocusChannel = match first(stack(nav)) { case some(e) => searchParam(e, "ch"), case none => "" }
  derive guideFocusProgramme = match first(stack(nav)) { case some(e) => searchParam(e, "prog"), case none => "" }
  derive guideFocusAt = match first(stack(nav)) { case some(e) => searchParam(e, "at"), case none => "" }
  derive guideFocusKey = (guideFocusChannel == "" ? "" : `${guideFocusChannel}|${guideFocusProgramme}|${guideFocusAt}`)
  resource guideFocusTime = uiGuideFocus(guideFocusAt, guideNow) with localeJSON when guideOpen and guideFocusAt != "" and guideNow > 0 as shape GuideFocusTime
  derive guideFocusDay = (guideFocusAt == "" ? guideDay : current(guideFocusTime) ? guideFocusTime.day : -1)
  derive guideFocus = GuideFocus(key=guideFocusKey, channelId=(guideFocusDay >= 0 ? guideFocusChannel : ""), programmeId=guideFocusProgramme, day=guideFocusDay, minute=(guideFocusAt != "" and current(guideFocusTime) ? guideFocusTime.minute : -1))
  state guideFocusApplied = ""
  task focusGuideDay when guideOpen and guideFocusKey != "" and guideFocusDay >= 0 and guideFocusApplied != guideFocusKey
    after(1, applyGuideFocus)
  action applyGuideFocus
    guideFocusApplied = guideFocusKey
    guideDay = guideFocusDay
  state guideNow = 0
  state lowDelay = false
  resource guide = uiGuide(guideNow, guideDay) with localeJSON when auth.authenticated and (guideOpen or top(nav).name == "liveWatch") and guideNow > 0 as shape GuideModel else empty()
  // The minute clock re-projects the same day in place; only another day shows the loading state.
  derive guideReady = current(guide) or (guide.day == guideDay and guide.channels.length > 0)
  derive guideMinute = floor(guideNow / 60000)
  resource liveIdentity = uiLiveIdentity(playingId, guideMinute * 60000) with localeJSON when auth.authenticated and top(nav).name == "liveWatch" and guideNow > 0 as shape LiveIdentity
  mutation liveState as shape LiveStatus queue
  derive liveView = match liveState { case some(r) => r, case none => LiveStatus(sessionId="", reconnecting=false, delivery="unknown", driftLabel="", drift=-1, canCatchUp=false) }
  derive liveControlsVisible = watchChromeVisible or (liveView.sessionId == playback.sessionId and (liveView.reconnecting or liveView.canCatchUp or liveView.delivery == "upstream-gap" or liveView.delivery == "segment-delayed" or liveView.delivery == "waiting-for-publication"))
  task startGuideClock when (guideOpen or top(nav).name == "liveWatch") and auth.authenticated and guideNow == 0
    after(1, tickGuide)
  task guideClock when (guideOpen or top(nav).name == "liveWatch") and auth.authenticated
    every(60000, tickGuide)
  // Channel flicking: up/down moves a pending target through the guide's order; it tunes once
  // the viewer pauses, so holding a key never opens a session per channel passed.
  state zapTarget = ""
  state zapSeq = 0
  task zapCommit when zapTarget != "" key=zapSeq
    after(1100, tuneZap)
  action zap(step: number)
    let ids = guide.channels.map(c => c.id)
    let n = ids.length
    if n > 0 and top(nav).name == "liveWatch"
      let i = ids.indexOf(zapTarget != "" ? zapTarget : playingId)
      let j = ((i < 0 ? 0 : i + step) % n + n) % n
      zapTarget = match first(ids.slice(j, j + 1)) { case some(id) => id, case none => "" }
      zapSeq = zapSeq + 1
  action tuneZap
    let target = zapTarget
    zapTarget = ""
    if target != "" and target != playingId and top(nav).name == "liveWatch"
      lowDelay = false
      if tileViewer != ""
        tileLast = `${tileViewer}\n${target}`
      nav = replace(nav, path("liveWatch", target))
  action stageKey(k: string, event: KeyboardEvent)
    let plain = not watchEditing and not event.metaKey and not event.ctrlKey and not event.altKey
    if top(nav).name == "liveWatch" and plain and (k == "ArrowUp" or k == "ArrowDown" or k == "PageUp" or k == "PageDown" or k == "ChannelUp" or k == "ChannelDown")
      preventDefault()
      touchWatch()
      zap(k == "ArrowUp" or k == "PageUp" or k == "ChannelUp" ? -1 : 1)
    else
      if zapTarget != "" and plain and k == "Enter"
        preventDefault()
        tuneZap()
      else
        if zapTarget != "" and k == "Escape"
          preventDefault()
          zapTarget = ""
        else
          watchKey(k, event)
  // The guide's live preview tile: one muted ambient session, tuned to the viewer's last
  // watched channel or the first that plays in server order. It exists only while the guide
  // is the visible route; leaving, hiding the tab or opening full watch releases it, so only
  // one stream ever runs. Save-Data and reduced motion wait for the viewer to tune in.
  state tileLast = "" persist
  state tileChannel = ""
  state tileManual = false
  state tileAttempt = 0
  state tileGen = 0
  state tileHeldPlan = ""
  state tileEvent = ""
  state tileCommandJson = ""
  state tileCommandId = 0
  state tileMuted = true
  state tileGivenUp = false
  state pendingWatch = ""
  state saveData = false
  derive tileViewer = (current(home) ? home.viewer : "")
  derive tileRemembered = (tileViewer != "" and tileLast.startsWith(`${tileViewer}\n`) ? tileLast.slice(tileViewer.length + 1) : "")
  derive tileCandidates = (tileRemembered != "" and guide.tuneOrder.includes(tileRemembered) ? [tileRemembered] : []).concat(guide.tuneOrder.filter(id => id != tileRemembered))
  derive tileTarget = (tileChannel != "" ? tileChannel : match first(tileCandidates.slice(tileAttempt, tileAttempt + 1)) { case some(id) => id, case none => "" })
  derive tileAllowed = tileManual or (not still and not saveData)
  // A live home gives the screen to search results while a query is open.
  derive tileWanted = auth.authenticated and guideOpen and (libraryId == "@live" or query == "") and page.visibilityState == "visible" and guideReady and tileAllowed and tileTarget != "" and pendingWatch == "" and not tileGivenUp
  resource tilePlayback = uiPlayback(tileTarget, "channel", time.epochAtZero, `tile-${tileGen}`, "", 0, 0, 0) when tileWanted as shape PlaybackModel transient
  derive tilePlan = (tileWanted and current(tilePlayback) ? tilePlayback.planJson : "")
  resource tileModel = uiPlayer(tilePlan, tileEvent, "", localeJSON) when tilePlan != "" as shape PlayerView
  derive tileFailed = tileWanted and (failed(tilePlayback) or (tilePlan != "" and current(tileModel) and tileModel.state == "failed"))
  derive tileState = (tileTarget == "" ? "off" : not tileAllowed ? "tune-in" : tileGivenUp ? "unavailable" : tilePlan != "" and current(tileModel) and tileModel.playing and not tileModel.waiting ? "playing" : "connecting")
  derive tileName = match first(guide.channels.filter(c => c.id == tileTarget)) { case some(c) => c.name, case none => "" }
  derive tileNumber = match first(guide.channels.filter(c => c.id == tileTarget)) { case some(c) => c.number, case none => "" }
  derive tile = LiveTile(channelId=tileTarget, channelName=tileName, channelNumber=tileNumber, state=tileState, muted=tileMuted, planJson=tilePlan, commandJson=tileCommandJson)
  mutation tileStopped as shape PlayerCommandReply queue then afterTileStop
  // Hold every granted session until it is released, whatever the tile shows.
  task tileHold when tilePlan != "" and tilePlan != tileHeldPlan
    after(1, holdTile)
  task tileRelease when tileHeldPlan != "" and not tileWanted
    after(1, releaseTile)
  // Leaving the guide forgets a retune and a failed run; the next visit tunes afresh.
  task tileReset when not guideOpen and (tileGivenUp or tileAttempt > 0 or tileChannel != "" or tileManual)
    after(1, resetTile)
  // An automatic tile moves on to the next channel in server order when one cannot play;
  // after three, or for a channel the viewer chose, it says so and holds nothing.
  task tileFallback when tileFailed
    after(10, nextTile)
  task tilePendingWatch when pendingWatch != ""
    after(2500, afterTileStop)
  action holdTile
    if tileHeldPlan != "" and tileHeldPlan != tilePlan
      send tileStopped = liveStop(tileHeldPlan)
    tileHeldPlan = tilePlan
    tileEvent = ""
  action stopTile
    if tileHeldPlan != ""
      send tileStopped = liveStop(tileHeldPlan)
    tileHeldPlan = ""
    tileEvent = ""
    tileGen = tileGen + 1
  action releaseTile
    stopTile()
    tileMuted = true
    tileCommandJson = ""
  action resetTile
    tileGivenUp = false
    tileAttempt = 0
    tileChannel = ""
    tileManual = false
  action nextTile
    stopTile()
    if tileChannel == "" and tileAttempt < 2
      tileAttempt = tileAttempt + 1
    else
      tileGivenUp = true
  action afterTileStop
    let id = pendingWatch
    if id != ""
      pendingWatch = ""
      openLiveWatch(id)
  // A live home's monitor flicks like the watch stage: up/down move a pending target through
  // the guide's order and it retunes once the viewer pauses, so a held key opens one session.
  state tileZapTarget = ""
  state tileZapSeq = 0
  task tileZapCommit when tileZapTarget != "" key=tileZapSeq
    after(800, commitTileZap)
  task tileZapForget when tileZapTarget != "" and not guideOpen
    after(1, forgetTileZap)
  action zapTile(step: number)
    let ids = guide.channels.map(c => c.id)
    let n = ids.length
    if n > 0 and guideOpen
      let i = ids.indexOf(tileZapTarget != "" ? tileZapTarget : tileTarget)
      let j = ((i < 0 ? 0 : i + step) % n + n) % n
      tileZapTarget = match first(ids.slice(j, j + 1)) { case some(id) => id, case none => "" }
      tileZapSeq = tileZapSeq + 1
  action commitTileZap
    let target = tileZapTarget
    tileZapTarget = ""
    if target != "" and guideOpen
      previewChannel(target)
  action forgetTileZap
    tileZapTarget = ""
  // On a live home the monitor's channel is the viewer's current channel: it is remembered.
  action previewChannel(id: string)
    retuneTile(id)
    if liveHome and tileViewer != ""
      tileLast = `${tileViewer}\n${id}`
  action homeKey(k: string, event: KeyboardEvent)
    if guideOpen and libraryId == "" and not event.metaKey and not event.ctrlKey and not event.altKey and (k == "ChannelUp" or k == "ChannelDown")
      preventDefault()
      zapTile(k == "ChannelUp" ? -1 : 1)
  // What a live home's document reads, each bound once: the listings, the tile and the
  // channel on the monitor (the one being dialled while flicking).
  derive homeGuide = (liveHome and guideReady ? [guide] : [])
  derive homeTile = (liveHome ? [tile] : [])
  derive homeTuned = (liveHome ? guide.channels.filter(c => c.id == (tileZapTarget != "" ? tileZapTarget : tileTarget)).slice(0, 1) : [])
  derive homeZapping = (tileZapTarget == "" ? "" : match first(guide.channels.filter(c => c.id == tileZapTarget)) { case some(c) => c.number, case none => "" })
  action tileMessage(json: string)
    tileEvent = json
  action tileUnmute
    let next = tileCommandId + 1
    tileCommandId = next
    let muted = not tileMuted
    tileMuted = muted
    tileCommandJson = `{"id":${next},"type":"mute","value":"${muted}"}`
  action tileTuneIn
    tileManual = true
  action retuneTile(id: string)
    if id != tileTarget
      stopTile()
      tileChannel = id
      tileAttempt = 0
      tileGivenUp = false
  action receiveNetwork(json: string)
    saveData = json.includes("\"saveData\":true")
  action tickGuide
    guideNow = time.epochAtZero + performanceNow()
  action earlierGuide
    guideDay = max(0, guideDay - 1)
  action laterGuide
    guideDay = min(6, guideDay + 1)
  action setGuideZoom(zoom: number)
    guideZoom = max(0, min(2, zoom))
  action chooseGuideDay(day: number)
    guideDay = max(0, min(6, day))
  // Full watch waits for the preview's stop, so the server never sees two of this viewer's streams.
  action watchChannel(id: string)
    if tileHeldPlan != ""
      pendingWatch = id
      stopTile()
    else
      openLiveWatch(id)
  action openLiveWatch(id: string)
    lowDelay = false
    if tileViewer != ""
      tileLast = `${tileViewer}\n${id}`
    nav = push(nav, path("liveWatch", id))
  action toggleLowDelay
    let enabled = not lowDelay
    lowDelay = enabled
    let next = watchCommandId + 1
    watchCommandId = next
    watchCommandJson = `{"id":${next},"type":"lowDelay","enabled":${enabled}}`
  action catchUpLive
    watchControl("catchUp", "")
  action liveWatchMessage(json: string)
    watchMessage(json)
    if top(nav).name == "liveWatch"
      send liveState = liveEvent(json, localeJSON)
