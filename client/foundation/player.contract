use DetailModel from "./models.contract"
use PlayerView, PlayerCommandReply, loadingPlayerView from "./player-models.contract"
use MediaAuthReply from "./models.contract"

members Client
  state watchEvent = ""
  state watchCommandJson = ""
  state watchCommandId = 0
  state watchTouched = 0
  state watchEditing = false
  mutation watchAuthorized as shape PlayerCommandReply
  // A native server's media authorization, straight to vela-player and vela-preview as private
  // props: never in a plan, a skin-readable model, an observation or a log. The handle rotates
  // with the server, principal and credential (auth.revision), retiring the host's old readers.
  resource mediaAuthorization = uiMediaAuth(auth.serverId, auth.revision) when current(auth) and auth.authenticated and auth.serverKind != "ether" as shape MediaAuthReply transient
  derive mediaAuthJson = (current(auth) and auth.authenticated and auth.serverKind != "ether" and current(mediaAuthorization) ? mediaAuthorization.json : "")
  // An empty authorization admits only same-origin Ether reads, so a native plan waits for its own.
  derive mediaReady = (auth.serverKind == "ether" or mediaAuthJson != "")
  mutation watchNativeReply as shape MediaAuthReply
  derive watchNativeMedia = match watchNativeReply { case some(r) => r.json, case none => "" }
  // Previews are Ether broker grants today; a native preview's attachment would be answered here.
  mutation previewNativeReply as shape MediaAuthReply
  derive previewNativeMedia = match previewNativeReply { case some(r) => r.json, case none => "" }
  action previewMessage(json: string)
    if json.startsWith("{\"type\":\"native-media-request\"")
      send previewNativeReply = uiNativeMedia(json, time.epochAtZero + performanceNow())
  mutation watchClosed as shape PlayerCommandReply queue
  action closeWatch
    if watchModel.stopCommandJson != ""
      send watchClosed = uiPlayerCommand(watchModel.stopCommandJson)
    nav = back(nav)
  derive watchReply = match watchAuthorized { case some(r) => (r.sessionId == playback.sessionId ? r : PlayerCommandReply(planJson="", sessionId="", error="")), case none => PlayerCommandReply(planJson="", sessionId="", error="") }
  derive watchPlan = (watchReply.sessionId == playback.sessionId and watchReply.planJson != "" ? watchReply.planJson : currentPlan)
  resource watchModel = uiPlayer(currentPlan, watchEvent, watchReply.planJson, localeJSON) when playingId != "" and watchPlan != "" as shape PlayerView
  resource watchIdentity = uiDetail(playingId, `${top(nav).id}`) with localeJSON, artWidth when auth.authenticated and top(nav).name == "watch" and playingId != "" as shape DetailModel
  // A playback that could not start, in words for the viewer ("" while it can).
  derive watchFailure = (failed(playback) ? t("ui.playbackCouldnTBeStarted") : current(playback) and playback.errorCode == "playback_capacity" ? t("player.capacity") : current(playback) and playback.errorCode != "" ? (playback.errorMessage != "" ? playback.errorMessage : t("ui.playbackCouldnTBeStarted")) : "")
  // What the chrome shows: a failed view when the start failed, the engine's view once the
  // session exists, a loading view before. The chrome (and its Close) stands throughout.
  derive watchView = (watchFailure != "" ? PlayerView(loadingPlayerView(), state="failed", waiting=false, reason=watchFailure) : current(playback) and current(watchModel) ? watchModel : loadingPlayerView())
  derive watchTitle = match first(watchIdentity.title) { case some(item) => (item.kind == "episode" and item.seasonNumber > 0 and item.episodeNumber > 0 ? t("ui.sSeasonEEpisodeTitle", season=item.seasonNumberLabel, episode=item.episodeNumberLabel, title=item.name) : item.name), case none => match first(detail.title) { case some(item) => item.name, case none => t("ui.nowPlaying") } }
  state watchHidden = false
  derive watchChromeVisible = not watchHidden or not watchModel.playing or watchEditing or watchModel.state != "playing"
  task resetWatch when playingId != "" key=playingId
    change(clearWatch)
  // The live playback info card, toggled with "i" or from the Quality menu; kept per device.
  state watchInfo = false persist
  action toggleWatchInfo
    watchInfo = not watchInfo
    touchWatch()
  action clearWatch
    watchEvent = ""
    watchCommandJson = ""
    watchAuthorized = none
    watchNativeReply = none
    watchHidden = false
    watchEditing = false
  task hideWatch when playingId != "" and watchModel.playing and not watchEditing key=watchTouched
    after(3500, hideWatchChrome)
  // Keys reach the player from the first frame: the stage takes focus whenever a
  // watch route opens (the button that opened it is gone).
  task focusWatchStage when top(nav).name == "watch" or top(nav).name == "extra" or top(nav).name == "liveWatch" key=top(nav).id
    after(1, focusStage)
  action focusStage
    focus("watch-stage")
  action hideWatchChrome
    watchHidden = true
  action touchWatch
    watchTouched = performanceNow()
    watchHidden = false
  action editWatch(v: bool)
    watchEditing = v
    watchHidden = false
  action watchMessage(json: string)
    if json.startsWith("{\"type\":\"session-command\"")
      send watchAuthorized = uiPlayerCommand(json)
    else
      if json.startsWith("{\"type\":\"session-refresh\"")
        streamAttempt = streamAttempt + 1
      else if json.startsWith("{\"type\":\"native-media-request\"")
        send watchNativeReply = uiNativeMedia(json, time.epochAtZero + performanceNow())
      else
        if json.startsWith("{\"type\":\"observation\"")
          playerMessage(json)
        else
          watchEvent = json
  action watchControl(kind: string, value: string)
    if kind == "retry"
      watchAuthorized = none
      // A start that failed (capacity, a server refusal) is asked again, with a new key.
      if watchFailure != ""
        retryPlayback()
    if not pending(watchAuthorized) or (kind != "seek" and kind != "seekBy" and kind != "switchPath")
      let next = watchCommandId + 1
      watchCommandId = next
      watchCommandJson = `{"id":${next},"type":"${kind}","value":"${encodeURIComponent(value)}"}`
      touchWatch()
  action watchSeek(value: number)
    watchControl("seek", `${value}`)
  action watchKey(k: string, event: KeyboardEvent)
    touchWatch()
    if not watchEditing and not event.isComposing and not event.metaKey and not event.ctrlKey and not event.altKey
      if k == " " or k == "k" or k == "K"
        preventDefault()
        watchControl(watchModel.playing ? "pause" : "play", "")
      if k == "ArrowLeft" or k == "j" or k == "J"
        preventDefault()
        watchControl("seekBy", "-10")
      if k == "ArrowRight" or k == "l" or k == "L"
        preventDefault()
        watchControl("seekBy", "10")
      if k == "m" or k == "M"
        preventDefault()
        watchControl("mute", "")
      if k == "i" or k == "I"
        preventDefault()
        toggleWatchInfo()
      if k == "ArrowUp" or k == "ArrowDown"
        preventDefault()
        watchControl("volume", `${max(0, min(1, watchModel.volume + (k == "ArrowUp" ? 0.05 : -0.05)))}`)
      if (k == "f" or k == "F") and watchModel.fullscreen
        watchControl("fullscreen", "")
