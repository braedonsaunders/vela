use SkinManifest from "./models.contract"
use manifest as CinematicManifest from "../skins/cinematic/manifest.contract"
use manifest as IndexManifest from "../skins/index/manifest.contract"
use manifest as ExampleManifest from "../skins/example/manifest.contract"
use manifest as JellyTwinManifest from "../skins/jellytwin/manifest.contract"
use manifest as MochiManifest from "../skins/mochi/manifest.contract"
use manifest as MarqueeManifest from "../skins/marquee/manifest.contract"

// Every compiled skin registers its manifest here (one branch per id); unknown ids
// show the cinematic entry, matching the foundation's fallback.
fn skinManifest(id: string): SkinManifest = (id == "mochi" ? MochiManifest() : id == "index" or id == "editorial" ? IndexManifest() : id == "example" ? ExampleManifest() : id == "jellytwin" ? JellyTwinManifest() : id == "marquee" ? MarqueeManifest() : CinematicManifest())

keyframes pickerVeil
  from opacity=0

keyframes pickerPanel
  from opacity=0 scale=0.96 translate="0px 18px"

keyframes pickerSheet
  from translate="0px 100%"

keyframes pickerCard
  from opacity=0 translate="0px 16px"

// The appearance picker every skin presents: large preview cards in a radio group,
// a popover-like panel on wide screens and a bottom sheet on phones. Choosing a
// card applies that skin; the root then dissolves into it.
component SkinPicker
  props
    skins: string[]
    current: string
    small: bool
    still: bool
    choose: action
    dismiss: action
  action pick(id: string)
    dismiss()
    choose(id)
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      dismiss()
  view
    column position="absolute" inset=0 z-index=300 key=keys role="dialog" aria-modal=true aria-label=t("skin.picker.title") align-items="center" justify-content=(small ? "flex-end" : "center") color="picker.ink" color-scheme="dark" font-family="system-ui, -apple-system, \"Segoe UI Variable\", \"Segoe UI\", Roboto, sans-serif" animation=(still ? "pickerVeil 160ms linear both" : "pickerVeil 320ms ease-out both")
      button press=dismiss aria-label=t("ui.close") tabindex=-1 position="absolute" inset=0 border="none" padding=0 background-color="picker.scrim" backdrop-filter="blur(16px) saturate(1.1)" cursor="default"
      column position="relative" width=(small ? "100%" : "min(1000px, calc(100vw - 64px))") max-height=(small ? "88vh" : "86vh") box-sizing="border-box" overflow-y="auto" padding=(small ? "20px 18px 28px" : "34px 36px 38px") gap=(small ? 18 : 26) border-radius=(small ? "26px 26px 0px 0px" : "28px") background-color="picker.panel" backdrop-filter="blur(30px) saturate(1.3)" border="1px solid var(--picker.edge)" box-shadow="0px 50px 140px var(--picker.shadow), inset 0px 1px 0px var(--picker.ring)" animation=(still ? "pickerVeil 200ms linear both" : small ? "pickerSheet 520ms cubic-bezier(0.16, 1, 0.3, 1) both" : "pickerPanel 520ms cubic-bezier(0.16, 1, 0.3, 1) both")
        if small
          column width=40 height=5 border-radius=3 background-color="picker.edge" align-self="center" margin-top=-6 aria-hidden=true
        row align-items="flex-start" gap=16
          column flex=1 min-width=0 gap=6
            text t("skin.picker.eyebrow") font-size=10 font-weight=650 letter-spacing="0.24em" text-transform="uppercase" color="picker.accent"
            text t("skin.picker.title") role="heading" aria-level=2 font-family="\"Instrument Serif\", Georgia, serif" font-size=(small ? 30 : 40) line-height=1.05
            text t("skin.picker.subtitle") font-size=14 line-height=1.5 color="picker.quiet"
          button press=dismiss aria-label=t("ui.close") width=40 height=40 padding=12 flex-shrink=0 box-sizing="border-box" border="1px solid var(--picker.edge)" border-radius=20 background-color="picker.control" color="picker.ink"
            image "symbol:close" width=16 height=16
        column role="radiogroup" aria-label=t("ui.appearance") display="grid" grid-template-columns=(small ? "1fr" : "repeat(auto-fill, minmax(280px, 1fr))") gap=(small ? 14 : 20)
          for id, i in skins key=id
            column animation=(still ? "pickerVeil 200ms linear both" : `pickerCard 560ms cubic-bezier(0.16, 1, 0.3, 1) ${120 + min(i, 6) * 60}ms both`)
              SkinCard(manifest=skinManifest(id), selected=(id == current), still=still, pick=pick, previousId=match skins.at((i + skins.length - 1) % skins.length) { case some(x) => x, case none => id }, nextId=match skins.at((i + 1) % skins.length) { case some(x) => x, case none => id })

// One look: its live miniature, name, tagline and palette. Arrow keys move between
// looks (radio-group semantics); Enter or Space chooses.
component SkinCard
  props
    manifest: SkinManifest
    selected: bool
    still: bool
    pick: action
    previousId: string
    nextId: string
  state lifted = false
  state shown = false
  action hover(over: bool)
    lifted = over
  action focusCard
    lifted = true
  action blurCard
    lifted = false
  action reveal
    shown = true
  action keys(k: string)
    if k == "ArrowRight" or k == "ArrowDown"
      preventDefault()
      focus(`skin-option-${nextId}`)
    if k == "ArrowLeft" or k == "ArrowUp"
      preventDefault()
      focus(`skin-option-${previousId}`)
  view
    button id=`skin-option-${manifest.id}` role="radio" aria-checked=selected aria-label=t("skin.picker.option", name=manifest.name, tagline=manifest.tagline) tabindex=(selected ? 0 : -1) testId=`skin-option-${manifest.id}` press=pick(manifest.id) key=keys hover=hover focus=focusCard blur=blurCard display="flex" flex-direction="column" gap=14 width="100%" box-sizing="border-box" padding=10 border=(selected ? "2px solid var(--picker.accent)" : "2px solid var(--picker.edge)") border-radius=22 background-color=(selected ? "picker.raised" : "picker.card") color="picker.ink" text-align="left" cursor="pointer" scale=(lifted and not still ? 1.025 : 1) translate=(lifted and not still ? "0px -4px" : "0px 0px") box-shadow=(lifted ? "0px 30px 60px -20px var(--picker.shadow)" : "0px 0px 0px transparent") transition=(still ? "background-color 160ms linear, border-color 160ms linear" : "scale 360ms cubic-bezier(0.16, 1, 0.3, 1), translate 360ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 360ms cubic-bezier(0.16, 1, 0.3, 1), background-color 160ms linear, border-color 160ms linear")
      :focus-visible
        box-shadow="0px 0px 0px 3px var(--picker.focus)"
      column position="relative" width="100%" aspect-ratio="16 / 10" border-radius=14 overflow="hidden" background-color=match manifest.swatches.at(0) { case some(c) => c, case none => "picker.card" } box-shadow="inset 0px 0px 0px 1px var(--picker.edge)"
        image manifest.preview alt="" load=reveal position="absolute" inset=0 width="100%" height="100%" object-fit="cover" opacity=(shown ? 1 : 0) transition="opacity 420ms ease-out"
        if selected
          row position="absolute" top=10 right=10 gap=6 align-items="center" padding="5px 10px 5px 6px" border-radius=999 background-color="picker.accent" color="picker.on-accent" box-shadow="0px 6px 18px var(--picker.shadow)"
            image "symbol:checkmark" width=12 height=12 aria-hidden=true
            text t("skin.picker.current") font-size=11 font-weight=700
      column gap=6 padding="0px 6px 6px"
        row align-items="center" justify-content="space-between" gap=12
          text manifest.name font-family="\"Instrument Serif\", Georgia, serif" font-size=24 line-height=1.1
          row gap=5 aria-hidden=true
            for color, c in manifest.swatches key=`${c}`
              column width=14 height=14 border-radius=7 background-color=color box-shadow="inset 0px 0px 0px 1px var(--picker.swatch-edge)"
        text manifest.tagline font-size=13 line-height=1.45 color="picker.quiet"
