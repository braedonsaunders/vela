shape GuideProgramme
  id: string
  name: string
  summary: string
  start: string
  end: string
  startLabel: string
  endLabel: string
  leftId: string
  rightId: string
  upId: string
  downId: string
  offset: number
  width: number

shape GuideChannel
  id: string
  number: string
  name: string
  favorite: bool
  now: string
  next: string
  programmes: GuideProgramme[]

shape GuideModel
  from: string
  until: string
  fromLabel: string
  untilLabel: string
  nowOffset: number
  showNow: bool
  channels: GuideChannel[]

shape LiveStatus
  sessionId: string
  reconnecting: bool
  delivery: string
  drift: number
  canCatchUp: bool
