shape GuideProgramme
  id: string
  name: string
  summary: string
  airing: bool
  ended: bool
  startsInLabel: string
  startsIn: number
  start: string
  end: string
  startLabel: string
  endLabel: string
  leftId: string
  rightId: string
  upId: string
  downId: string
  offset: number
  width: number

shape GuideChannel
  id: string
  number: string
  name: string
  favorite: bool
  logo: string
  now: string
  next: string
  programmes: GuideProgramme[]

shape GuideModel
  from: string
  until: string
  fromLabel: string
  untilLabel: string
  nowOffset: number
  showNow: bool
  ticks: GuideTick[]
  channels: GuideChannel[]

shape LiveStatus
  sessionId: string
  reconnecting: bool
  delivery: string
  driftLabel: string
  drift: number
  canCatchUp: bool

shape GuideTick
  id: string
  label: string
  offset: number

shape LiveIdentity
  title: string
