shape GuideProgramme
  id: string
  name: string
  summary: string
  airing: bool
  ended: bool
  startsInLabel: string
  startLabel: string
  endLabel: string
  leftId: string
  rightId: string
  upId: string
  downId: string
  at: number
  span: number
  progress: number
  remainingLabel: string
  durationLabel: string
  startsLabel: string
  episode: string
  rating: string
  genre: string
  tone: number
  art: string

shape GuideChannel
  id: string
  number: string
  name: string
  favorite: bool
  logo: string
  group: string
  guideIds: string[]
  listed: bool
  now: string
  next: string
  nowId: string
  nowProgress: number
  nowRemaining: string
  nextLabel: string
  nowArt: string
  nowEpisode: string
  nowGenre: string
  programmes: GuideProgramme[]

shape GuideTab
  id: string
  name: string

// A search hand-off into the guide: server ids and the local day/minute of a programme's start.
shape GuideFocus
  key: string
  channelId: string
  programmeId: string
  day: number
  minute: number

shape GuideFocusTime
  day: number
  minute: number

shape GuideDay
  offset: number
  label: string
  date: string

shape GuideModel
  day: number
  dayLabel: string
  fromLabel: string
  untilLabel: string
  minutes: number
  nowMinute: number
  nowLabel: string
  landing: number
  ticks: GuideTick[]
  days: GuideDay[]
  groups: string[]
  guides: GuideTab[]
  tuneOrder: string[]
  channels: GuideChannel[]

shape LiveStatus
  sessionId: string
  reconnecting: bool
  delivery: string
  driftLabel: string
  drift: number
  canCatchUp: bool

shape GuideTick
  id: string
  label: string
  minute: number
  hour: bool

// The guide's live preview tile. state: off, tune-in (waits for the viewer), connecting, playing, unavailable.
shape LiveTile
  channelId: string
  channelName: string
  channelNumber: string
  state: string
  muted: bool
  planJson: string
  commandJson: string

shape LiveIdentity
  title: string
