{
  "name": "vela-workspace",
  "private": true,
  "workspaces": [
    "apps/vela",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "test": "bun test ./packages ./modules ./mock-server ./apps/vela-desktop/test ./tools/parity",
    "typecheck": "bun tools/typecheck.ts",
    "check:skins": "for document in packages/protocol/fixtures/skins/cinematic.ts packages/protocol/fixtures/skins/*/document.ts; do bun tools/skin.ts check \"$document\" || exit 1; done"
  },
  "patchedDependencies": {
    "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view%2Fmasked-view@0.3.2.patch",
    "react-native-screens@4.30.1": "patches/react-native-screens@4.30.1.patch"
  }
}
