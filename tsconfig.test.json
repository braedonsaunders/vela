{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "typeRoots": ["./mock-server/node_modules/@types"]
  },
  "include": ["packages/*/test/**/*.ts", "modules/*/test/**/*.ts"]
}
