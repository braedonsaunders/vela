# Native ABI baseline: Ubuntu 22.04 / glibc 2.35. Build only in a named container.
FROM ubuntu:22.04@sha256:9abcaffc92a5279fff3a6a41635c0800ea33e528425fb389658806476e7defde
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential pkg-config python3-pip ninja-build cmake git curl ca-certificates nasm \
    libass-dev libepoxy-dev libegl1-mesa-dev libgl1-mesa-dev libvulkan-dev \
    libva-dev libvdpau-dev libasound2-dev libpulse-dev liblcms2-dev \
    libx11-dev libxext-dev libxrandr-dev libxpresent-dev libxss-dev \
    libxkbcommon-dev libdrm-dev libgbm-dev libssl-dev \
    xvfb xcompmgr openbox xauth libnss3 libgtk-3-0 libnotify4 libsecret-1-0 \
    libatspi2.0-0 libxshmfence1 libgbm1 libnspr4 uuid-runtime dbus-x11 \
    libxtst6 patchelf binutils && python3 -m pip install meson==1.10.1
WORKDIR /work
CMD ["sleep", "infinity"]
