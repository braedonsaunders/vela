<!-- A self-checking console for DownloadPaths.cs (no test framework). Windows path rules apply, so run it
     on Windows: dotnet run -c Release (or publish -r win-x64 on another host and run the exe there). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vela.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../DownloadPaths.cs" Link="DownloadPaths.cs" />
  </ItemGroup>
</Project>
