{
  "name": "vela",
  "version": "0.2.50",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "web": "expo start --web",
    "ios": "expo run:ios",
    "tvos": "EXPO_TV=1 expo run:ios",
    "export:web": "VELA_WEB_BASE=/vela expo export --platform web"
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "0.3.2",
    "@vela/core": "workspace:*",
    "@vela/guide-native": "workspace:*",
    "@vela/player": "workspace:*",
    "@vela/search-native": "workspace:*",
    "@vela/skin": "workspace:*",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "foliate-js": "github:johnfactotum/foliate-js#78914aef4466eb960965702401634c2cb348e9b1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.7",
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
