{
  "expo": {
    "name": "Vela",
    "slug": "vela",
    "icon": "./assets/brand/vela-app-icon-1024.png",
    "scheme": "vela",
    "version": "0.2.81",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b0e",
    "ios": {
      "bundleIdentifier": "app.ether.vela",
      "icon": "./assets/brand/vela-app-icon-1024.png",
      "supportsTablet": true,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Vela connects to the media servers on your network that you add, such as Ether, Jellyfin, Emby or Plex.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ether.vela",
      "versionCode": 2081
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Vela",
      "backgroundColor": "#090b0e"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-font",
      [
        "@react-native-tvos/config-tv",
        {
          "appleTVImages": {
            "iconLayers": {
              "front": "./tvos/front-1280x768.png",
              "back": "./tvos/back-1280x768.png"
            },
            "iconSmallLayers": {
              "front": "./tvos/front-400x240.png",
              "back": "./tvos/back-400x240.png"
            },
            "iconSmall2xLayers": {
              "front": "./tvos/front-800x480.png",
              "back": "./tvos/back-800x480.png"
            },
            "topShelf": "./tvos/topshelf-1920x720.png",
            "topShelf2x": "./tvos/topshelf-3840x1440.png",
            "topShelfWide": "./tvos/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./tvos/topshelf-wide-4640x1440.png"
          }
        }
      ],
      "./plugins/android-cleartext",
      "./plugins/android-signing",
      "./plugins/android-metro-inputs",
      "./plugins/android-tv-keys",
      "./plugins/android-hardware-bitmaps",
      "./plugins/android-picture-in-picture",
      "./plugins/android-config-changes",
      "./plugins/android-profileable",
      "./plugins/apple-player",
      "@vela/top-shelf"
    ]
  }
}
