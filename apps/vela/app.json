{
  "expo": {
    "name": "Vela",
    "slug": "vela",
    "scheme": "vela",
    "version": "0.2.7",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b0e",
    "ios": {
      "bundleIdentifier": "app.ether.vela",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Vela connects to the media servers on your network that you add, such as Ether, Jellyfin, Emby or Plex.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ether.vela"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Vela",
      "backgroundColor": "#090b0e"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@react-native-tvos/config-tv",
        {
          "appleTVImages": {
            "iconLayers": {
              "front": "./assets/tvos/front-1280x768.png",
              "back": "./assets/tvos/back-1280x768.png"
            },
            "iconSmallLayers": {
              "front": "./assets/tvos/front-400x240.png",
              "back": "./assets/tvos/back-400x240.png"
            },
            "iconSmall2xLayers": {
              "front": "./assets/tvos/front-800x480.png",
              "back": "./assets/tvos/back-800x480.png"
            },
            "topShelf": "./assets/tvos/topshelf-1920x720.png",
            "topShelf2x": "./assets/tvos/topshelf-3840x1440.png",
            "topShelfWide": "./assets/tvos/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/tvos/topshelf-wide-4640x1440.png"
          }
        }
      ],
      "./plugins/android-cleartext"
    ]
  }
}
