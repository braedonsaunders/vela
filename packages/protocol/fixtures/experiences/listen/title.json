{
  "schema": 1, "kind": "screen", "renderer": 20, "owner": "vela", "experience": "listen",
  "screen": "listen", "page": "title", "version": "1",
  "title": "{src.title.item.name}", "presentation": "section",
  "params": { "id": { "type": "string" }, "library": { "type": "string" } },
  "sources": {
    "title": { "from": "vela.title", "id": "{param.id}" },
    "tracks": { "from": "vela.children", "id": "{param.id}", "role": "track", "lazy": true },
    "albums": { "from": "vela.children", "id": "{param.id}", "role": "album", "lazy": true },
    "artistRows": { "from": "vela.rows", "placement": "detail", "titleId": "{param.id}", "lazy": true },
    "moreBy": { "from": "vela.children", "id": "{src.title.item.media.parents.0.id}", "role": "album", "lazy": true }
  },
  "templates": {
    "album": {
      "type": "sections", "needs": ["tracks", "moreBy"], "style": { "padding-bottom": "32px" },
      "children": [
        { "type": "box", "children": [
          { "type": "wash", "props": { "accent": "{src.title.item.accent}", "image": "{src.title.item.poster}" } },
          { "type": "box", "style": { "padding-horizontal": "28px" }, "small": { "padding-horizontal": "16px" }, "children": [
            { "type": "collectionHeader", "props": { "item": "{src.title.item}", "tracks": "{src.tracks.items}", "eyebrow": "release", "facts": "album" },
              "partTemplates": {
                "collectionHeader.cover": { "type": "cover", "props": { "kind": "square", "item": "{src.title.item}", "lift": "2" } },
                "collectionHeader.byline": { "type": "byline", "props": { "item": "{src.title.item}", "tracks": "{src.tracks.items}", "facts": "year,total" } }
              } },
            { "type": "actionBar", "props": { "item": "{src.title.item}", "tracks": "{src.tracks.items}", "sourceId": "{param.id}", "sourceName": "{src.title.item.name}", "sourceKind": "title", "buttons": "play,shuffle,heart,more" } },
            { "type": "trackTable", "props": { "tracks": "{src.tracks.items}", "sourceId": "{param.id}", "sourceName": "{src.title.item.name}", "sourceKind": "title" } },
            { "type": "box", "style": { "padding-vertical": "28px", "gap": "4px" }, "children": [
              { "type": "text", "when": [{ "test": "src.title.item.airDate" }], "text": "{src.title.item.airDate|date:long}", "style": { "font-size": "14px", "color": "$ui.inkSecondary" } },
              { "type": "repeat", "over": "src.title.item.media.facts", "as": "fact", "item":
                { "type": "text", "when": [{ "test": "fact.label", "is": "eq", "value": "Label" }], "text": "© {fact.value}", "style": { "font-size": "12px", "color": "$ui.inkQuiet" } } }
            ] }
          ] }
        ] },
        { "type": "slot", "slot": "plugin:listen.album.panel", "context": { "title": "{src.title.item.$key}" } },
        { "type": "box", "style": { "padding-horizontal": "16px" }, "when": [{ "test": "src.moreBy.items.length", "is": "gt", "value": "1" }], "children": [
          { "type": "musicShelf", "props": { "title": "{s:music.moreBy|with:name=src.title.item.media.parents.0.name}", "items": "{src.moreBy.items}", "exclude": "{param.id}", "limit": "12", "tileSize": "168", "subtitle": "year" } }
        ] }
      ]
    },
    "artist": {
      "type": "sections", "needs": ["albums", "artistRows"], "style": { "padding-bottom": "32px" },
      "children": [
        { "type": "artistHero", "props": { "item": "{src.title.item}", "albums": "{src.albums}" } },
        { "type": "box", "style": { "padding-horizontal": "28px" }, "small": { "padding-horizontal": "16px" }, "children": [
          { "type": "actionBar", "props": { "item": "{src.title.item}", "tracks": "{src.artistRows.rows.0.items}", "sourceId": "{param.id}", "sourceName": "{src.title.item.name}", "sourceKind": "title", "buttons": "play,shuffle,follow,more", "topRow": "top" } },
          { "type": "artistTop", "props": { "item": "{src.title.item}", "rows": "{src.artistRows.rows}" } }
        ] },
        { "type": "discography", "props": { "item": "{src.title.item}", "albums": "{src.albums}" } },
        { "type": "box", "style": { "padding-horizontal": "16px" }, "small": { "padding-horizontal": "4px" }, "children": [
          { "type": "musicShelf", "props": { "row": "related", "rows": "{src.artistRows.rows}", "title": "{s:music.fansAlsoLike}", "role": "artist", "limit": "20", "tileSize": "168" } }
        ] },
        { "type": "slot", "slot": "plugin:listen.artist.panel", "context": { "title": "{src.title.item.$key}" } },
        { "type": "box", "when": [{ "test": "src.title.item.summary" }], "style": { "padding-horizontal": "28px", "padding-bottom": "40px", "max-width": "860px" }, "small": { "padding-horizontal": "16px" }, "children": [
          { "type": "text", "role": "heading", "text": "{s:music.about}", "style": { "font-family": "$ui.fontDisplay", "font-size": "26px", "color": "$ui.ink", "margin-bottom": "10px" } },
          { "type": "text", "text": "{src.title.item.summary}", "style": { "font-size": "15px", "line-height": "1.6", "color": "$ui.inkSecondary" } }
        ] }
      ]
    }
  },
  "tree": {
    "type": "box", "style": { "flex": "1" }, "children": [
      { "type": "use", "template": "artist", "when": [{ "test": "src.title.item.media.role", "is": "eq", "value": "artist" }] },
      { "type": "use", "template": "album", "when": [{ "test": "src.title.item.media.class", "is": "eq", "value": "music" }, { "test": "src.title.item.media.role", "is": "ne", "value": "artist" }] },
      { "type": "spokenTitle", "when": [{ "test": "src.title.item.media.class", "is": "ne", "value": "music" }], "props": { "item": "{src.title.item}", "title": "{src.title}" } }
    ]
  }
}
