{
 "schema": 1,
 "kind": "screen",
 "renderer": 20,
 "owner": "vela",
 "experience": "read",
 "screen": "read",
 "page": "series",
 "version": "1",
 "title": "{src.title.item.name}",
 "presentation": "page",
 "params": {
  "id": {
   "type": "string"
  },
  "library": {
   "type": "string"
  }
 },
 "sources": {
  "title": {
   "from": "vela.title",
   "id": "{param.id}"
  },
  "books": {
   "from": "vela.children",
   "id": "{param.id}",
   "limit": 1000
  }
 },
 "tree": {
  "type": "box",
  "children": [
   {
    "type": "seriesHero",
    "props": {
     "item": "{src.title.item}",
     "items": "{src.books.items}"
    }
   },
   {
    "type": "bookSummary",
    "props": {
     "item": "{src.title.item}"
    }
   },
   {
    "type": "bookSeriesList",
    "props": {
     "item": "{src.title.item}",
     "items": "{src.books.items}"
    }
   }
  ]
 }
}
