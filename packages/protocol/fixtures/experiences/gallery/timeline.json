{
  "schema": 1,
  "kind": "screen",
  "renderer": 20,
  "owner": "vela",
  "experience": "gallery",
  "screen": "gallery",
  "page": "timeline",
  "version": "1",
  "title": "Photos",
  "presentation": "section",
  "params": { "library": { "type": "string" } },
  "sources": {
    "photos": { "from": "vela.photoTimeline", "library": "{param.library}" }
  },
  "tree": {
    "type": "timeline",
    "style": { "flex": "1", "min-height": "0px" },
    "props": { "items": "{src.photos}", "source": "photos", "pending": "{src.photos.$pending}", "failed": "{src.photos.$error}" }
  }
}
