-            endViewTransition(view)
+            // Vela patch (drop once react-native-screens stops ending the transition synchronously
+            // here; this call came with https://github.com/software-mansion/react-native-screens/pull/4161).
+            // This runs from the exit animation's onAnimationEnd, which Animation fires inside the
+            // outgoing screen's own View.draw. Ending the transition there detaches the screen in
